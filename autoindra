local ch = { job = "" }
local function Chest()
    if ch.job ~= tostring(game.JobId) then ch = { job = tostring(game.JobId), n = 0, t0 = os.clock(), seen = {} } end
    if ch.n >= 30 or os.clock() - ch.t0 > 60 then return HopLow(("Chest %d/30 / TTL 60s -> hop low"):format(ch.n)) end
    local r = Root()
    if not r then return end
    for _, pl in ipairs(Players:GetPlayers()) do
        local pr = pl ~= LP and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
        if pr and (pr.Position - r.Position).Magnitude < 450 then return HopLow("Có " .. pl.Name .. " gần -> né server") end
    end
    local best, bd
    for _, c in ipairs(CS:GetTagged("_ChestTagged")) do
        if not ch.seen[c] and c:IsDescendantOf(workspace) then
            local d = (c:GetPivot().Position - r.Position).Magnitude
            if not bd or d < bd then best, bd = c, d end
        end
    end
    if not best then return HopLow("Hết chest -> hop low") end
    ch.seen[best] = true
    if Go(best:GetPivot().Position, nil, ("Nhặt chest %d/30"):format(ch.n + 1)) then ch.n += 1 end
end

-- ============ elite (đủ 30 kill cho Yama; elite cũng rơi chalice) ============
local ELITE = { "diablo", "deandre", "urban" }
local ELITE_PTS = { V3(-5415, 314, -2800), V3(5350, 1005, 400), V3(-11800, 332, -8800), V3(-13200, 428, -7760), V3(-2200, 38, -10200), V3(-4900, 66, -150) }
local kT, kV, eT, eIdx = 0, nil, 0, 1
local function Kills()
    if os.clock() - kT > 2 then
        kT = os.clock()
        local r = Inv("EliteHunter", "Progress")
        kV = type(r) == "number" and r or type(r) == "string" and tonumber(r:match("%d+")) or type(r) == "table" and tonumber(r.Kills or r.Progress or r[1]) or kV
    end
    return kV
end
local function NeedElite()
    if Has("Yama") then return false end
    local k = Kills()
    return k ~= nil and k < 30
end
local function EliteQuest()
    local pg = LP:FindFirstChild("PlayerGui")
    local t = pg and pg:FindFirstChild("TrackedQuestFrame")
    local hd = t and t.Enabled and t:FindFirstChild("Frame") and t.Frame.Visible and t.Frame:FindFirstChild("header")
    local tx = hd and hd:FindFirstChild("textLabel") and hd.textLabel.Text:lower() or ""
    for _, p in ipairs(ELITE) do if tx:find(p, 1, true) then return true end end
end
local function Elite()
    local m, _, _, live, pos = Find(ELITE)
    Say(("Săn Elite (%s/30)"):format(tostring(kV)))
    if not m then return HopLow("Không có Elite -> hop low") end
    if not EliteQuest() and os.clock() - eT > 1.5 then
        eT = os.clock()
        task.spawn(Inv, "EliteHunter")
    end
    if live or (pos and pos.Magnitude > 50) then return Boss(ELITE, pos) end
    local pt = ELITE_PTS[eIdx]
    eIdx = eIdx % #ELITE_PTS + 1
    Go(pt, function() local em, _, _, lv, p = Find(ELITE) return not em or lv or (p ~= nil and p.Magnitude > 50) end, "Tuần tra tìm Elite")
end

local dT, dV = 0, false
local function Door()
    if os.clock() - dT > 1 then
        dT = os.clock()
        local p = Inv("TushitaProgress")
        if type(p) == "table" then dV = p.OpenedDoor == true end
    end
    return dV
end

local function WaitAtSpot(isHolder, serverHasCup)
    local needTushita = not Has("Tushita")
    local targetPos = P.Spot
    local desc = "Chờ tại Sea Castle"

    -- Yêu cầu: "khi có cup thì đợi ở sea castle, ko có đợi ở hydra, chỉ khi acc ko cầm cup, sever có cup , thiếu túhsita mới đợi ở hydra"
    if not isHolder and serverHasCup and needTushita then
        targetPos = P.Hydra
        desc = "Chờ tại Hydra (chuẩn bị Tushita)"
    end

    local r = Root()
    if r and (r.Position - targetPos).Magnitude > 25 then
        Go(targetPos, function() return Find(INDRA) end, desc)
    else
        Say(desc .. (" (Players: %d/12)"):format(#Players:GetPlayers()))
    end
end

local function CloneStep()
    local nh, nt = not Has("Valkyrie Helm"), not Has("Tushita")
    if not (nh or nt) then Say("HOÀN TẤT") return end
    if not Need(3) then return end

    if nt and Door() then -- cửa mở: bỏ qua Indra, đi giết Longma
        S.weapon = nil
        if not Boss({ "longma" }, P.Longma) then
            local r = Root()
            if r and (r.Position - P.Longma).Magnitude > 60 then
                Go(P.Longma, function() return Find({ "longma" }) end, "Đang tới hang Longma")
            else
                HopLow("Không có Longma -> hop low")
            end
        end
        return
    end

    if Find(INDRA) then
        if nh then
            Boss(INDRA, P.Castle)
        elseif InBag("Holy Torch") then
            Say("Thắp 5 đuốc Tushita")
            for i = 1, 5 do Inv("TushitaProgress", "Torch", i) task.wait(0.2) end
        else
            Go(P.Torch, nil, "Đi lấy Holy Torch")
            local r = Root()
            if r then Float(false) r.CFrame = CF(P.Torch) task.wait(1) end
        end
        return
    end

    local myCup = Has("God's Chalice")
    local summoning = S.sumT and (os.clock() - S.sumT < 40)

    -- 1. NẾU ACC NÀY CẦM CUP HOẶC ĐANG SUMMON
    if myCup or summoning then
        UpdatePresence()
        if summoning then
            Say("Đợi Rip Indra spawn...")
            return WaitAtSpot(true) -- Có cup: luôn đợi ở Sea Castle
        end

        local zn = false
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.Name:lower() == HAKI then zn = true end
        end

        -- Nếu pads đã mở hết, >= 12 người, và acc Haki (znwf) đã rời server
        if PadsAll() and #Players:GetPlayers() >= 12 and not zn then
            Equip("God's Chalice")
            if Go(P.Detect, nil, "Tới summon Indra") then
                local r = Root()
                pcall(function()
                    local d = workspace.Map["Boat Castle"].Summoner.Detection
                    firetouchinterest(r, d, 0)
                    firetouchinterest(r, d, 1)
                end)
                task.wait(1.5)
                S.sumT = os.clock()
                UpdatePresence()
            end
        else
            -- Có cup: luôn đợi ở Sea Castle
            WaitAtSpot(true)
        end
        return -- TUYỆT ĐỐI KHÔNG JOIN SERVER KHÁC KHI ĐANG CẦM CUP!
    end

    -- 2. ACC KHÔNG CẦM CUP
    -- Kiểm tra xem server hiện tại có ai đang cầm cup / summon không
    local serverHasCup = false
    for _, e in ipairs(Entries()) do
        if e.job == tostring(game.JobId) and e.cup then
            serverHasCup = true
            break
        end
    end
    if not serverHasCup then
        for _, pl in ipairs(Players:GetPlayers()) do
            if HasTool(pl, "God's Chalice") then
                serverHasCup = true
                break
            end
        end
    end

    if serverHasCup then
        -- Server hiện tại có cup:
        -- "chỉ khi acc ko cầm cup, sever có cup , thiếu túhsita mới đợi ở hydra, còn lại đợi sea castle"
        return WaitAtSpot(false, true)
    end

    -- Server hiện tại không có cup:
    -- Kiểm tra xem có server nào khác có cup đã ready (đã mở 3 pad) không để join vào
    -- (Yêu cầu: acc cầm cup đã return ở nhánh 1, nên ở đây CHỈ CÓ acc không cầm cup mới join)
    local readyQueues = {}
    for _, e in ipairs(GetCupQueues()) do
        if e.ready and not e.summoned and e.job ~= tostring(game.JobId) then
            table.insert(readyQueues, e)
        end
    end

    if #readyQueues > 0 then
        Say("Join server ready của " .. tostring(readyQueues[1].name))
        return Join(readyQueues[1].job)
    end

    -- Không có server ready: farm elite nếu thiếu, hoặc nhặt chest
    if NeedElite() then return Elite() end
    Chest()
end
