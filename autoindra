local function GetBlockedJobs()
    local blocked = {}
    local myJob = tostring(game.JobId)
    blocked[myJob] = true

    -- 1. Anti servers file (chung giữa tất cả acc)
    local anti = GetAntiServers()
    for jid, _ in pairs(anti) do
        blocked[tostring(jid)] = true
    end

    -- 2. Quét toàn bộ acc đang active trong folder sync (né tuyệt đối server acc khác đang đứng)
    for _, e in ipairs(Entries()) do
        if e.name ~= LP.Name and e.job and e.job ~= "" then
            blocked[tostring(e.job)] = true
        end
    end

    -- 3. Cache visited của session này
    if S.vis then
        for jid, _ in pairs(S.vis) do
            blocked[tostring(jid)] = true
        end
    end

    -- 4. Check file visited của CDKProgress nếu có
    pcall(function()
        if isfile and isfile("CDKProgress/visited.json") then
            local raw = readfile("CDKProgress/visited.json")
            local ok, dt = pcall(function() return HS:JSONDecode(raw) end)
            if ok and type(dt) == "table" then
                local now = os.time()
                for jid, v in pairs(dt) do
                    if type(v) == "number" and (now - v < 300) then
                        blocked[tostring(jid)] = true
                    end
                end
            end
        end
    end)

    return blocked
end

