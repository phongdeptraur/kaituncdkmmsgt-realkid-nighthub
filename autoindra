-- ============ haki acc (znwfhkjbc & akvqxrmpt) ============
local function EnsureHakiAura()
    local c = LP.Character
    if c and not c:FindFirstChild("HasBuso") then
        Inv("Buso")
    end
end

local function HakiStep()
    if not Need(3) then return end
    EnsureHakiAura()

    local cupQueues = GetCupQueues()
    local hereCup = nil
    for _, e in ipairs(cupQueues) do
        if e.job == tostring(game.JobId) then
            hereCup = e
            break
        end
    end

    if hereCup then
        if PadsAll() then
            UpdatePresence()
            local nextCup = GetNextCupServerNeedingHaki()
            if nextCup then
                Say(("Đủ 3 pad -> Join thẳng SV %s bật Haki"):format(tostring(nextCup.name)))
                return Join(nextCup.job)
            end
            task.wait(0.8)
            if PadsAll() then
                nextCup = GetNextCupServerNeedingHaki()
                if nextCup then
                    Say(("Đủ 3 pad -> Join thẳng SV %s bật Haki"):format(tostring(nextCup.name)))
                    return Join(nextCup.job)
                end
                return HopLow("Đủ 3 pad, nhường slot")
            end
        end

        for _, p in ipairs(PADS) do
            if not PadOpen(p) then
                Say("Đang mở pad " .. p[1])
                EnsureHakiAura()
                Eq(p[3])
                if Go(p[2] + V3(0, 3, 0), nil, "Tới pad " .. p[1]) then
                    local r = Root()
                    if r then
                        Float(false)
                        r.CFrame = CF(p[2] + V3(0, 3, 0))
                    end
                    local t = os.clock()
                    repeat
                        EnsureHakiAura()
                        Eq(p[3])
                        task.wait(0.35)
                    until PadOpen(p) or os.clock() - t > 6 or not S.Run
                end
                if PadsAll() then
                    UpdatePresence()
                    local nextCup = GetNextCupServerNeedingHaki()
                    if nextCup then
                        Say(("Đủ 3 pad -> Join thẳng SV %s bật Haki"):format(tostring(nextCup.name)))
                        return Join(nextCup.job)
                    end
                end
                return
            end
        end
        return
    end

    local nextCup = GetNextCupServerNeedingHaki()
    if nextCup then
        Say(("Join thẳng mở pad cho %s (%s)"):format(tostring(nextCup.name), tostring(nextCup.job):sub(1, 8)))
        return Join(nextCup.job)
    end

    Say("Đang chờ Clone nhặt được Cup...")
end
