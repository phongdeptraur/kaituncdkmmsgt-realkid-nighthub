-- ============ clone & auto chest ============
local ch = { job = "" }

local function IsValidChest(obj)
    if not obj or not obj.Parent or not obj:IsDescendantOf(workspace) then return false end
    if obj:GetAttribute("IsDisabled") == true then return false end
    if ch.seen and ch.seen[obj] then return false end

    local name = obj.Name
    local validName = (name == "Chest1" or name == "Chest2" or name == "Chest3"
        or name:match("^Chest%d?$") ~= nil or name:match("^Chest_%d+$") ~= nil
        or CS:HasTag(obj, "_ChestTagged"))
    if not validName then return false end

    local charModel = obj:FindFirstAncestorOfClass("Model")
    if charModel and (Players:GetPlayerFromCharacter(charModel) or charModel:FindFirstChildOfClass("Humanoid")) then
        return false
    end

    if obj:IsA("BasePart") then
        if obj.Transparency >= 0.8 then return false end
    elseif obj:IsA("Model") then
        local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if not p or p.Transparency >= 0.8 or p:GetAttribute("IsDisabled") == true then return false end
    else
        return false
    end

    return true
end

local function GetChest()
    local r = Root()
    if not r then return nil end
    local best, bd = nil, math.huge

    local function Check(obj)
        if IsValidChest(obj) then
            local ok, cf = pcall(function() return obj:GetPivot() end)
            if ok and cf then
                local d = (cf.Position - r.Position).Magnitude
                if d < bd then best, bd = obj, d end
            end
        end
    end

    -- 1. Quét tag chuẩn của Blox Fruits
    for _, c in ipairs(CS:GetTagged("_ChestTagged")) do Check(c) end

    -- 2. Quét trong thư mục ChestModels (nếu có)
    local cm = workspace:FindFirstChild("ChestModels")
    if cm then
        for _, c in ipairs(cm:GetChildren()) do Check(c) end
    end

    -- 3. Quét trực tiếp con của Workspace
    for _, c in ipairs(workspace:GetChildren()) do Check(c) end

    -- 4. Quét sâu trong Map nếu vẫn chưa thấy
    local map = workspace:FindFirstChild("Map")
    if not best and map then
        for _, c in ipairs(map:GetDescendants()) do
            if c.Name == "Chest1" or c.Name == "Chest2" or c.Name == "Chest3" then
                Check(c)
            end
        end
    end

    return best
end

local function Chest()
    if ch.job ~= tostring(game.JobId) then
        ch = { job = tostring(game.JobId), n = 0, t0 = os.clock(), seen = {}, emptyRetries = 0 }
    end

    -- Anti trùng server khi farm: Chỉ acc vào server SAU mới hop
    local isLate, olderAcc = CheckLateJoinerConflict()
    if isLate then
        return HopLow("Trùng SV với " .. tostring(olderAcc))
    end

    if ch.n >= 30 or os.clock() - ch.t0 > 75 then
        return HopLow(("Đã nhặt %d/30 chest"):format(ch.n))
    end

    local r = Root()
    if not r then return end

    local chest = GetChest()
    if not chest then
        -- Chống lỗi vừa vào server map chưa kịp stream rương đã vội Hop
        ch.emptyRetries = (ch.emptyRetries or 0) + 1
        if ch.emptyRetries <= 8 then
            Say(("Đang chờ tải rương (%d/8)..."):format(ch.emptyRetries))
            task.wait(0.6)
            return
        end
        return HopLow("Hết chest")
    end
    ch.emptyRetries = 0

    local targetPos = chest:GetPivot().Position
    local dStart = (r.Position - targetPos).Magnitude
    Say(("Nhặt chest %d/30 (%.0fm)"):format(ch.n + 1, dStart))

    Go(targetPos + V3(0, 1.5, 0), function()
        local lateNow = CheckLateJoinerConflict()
        return lateNow or not IsValidChest(chest) or InBag("God's Chalice") ~= nil
    end, ("Bay tới chest %d/30"):format(ch.n + 1))

    r = Root()
    if r and chest:IsDescendantOf(workspace) then
        local dist = (r.Position - chest:GetPivot().Position).Magnitude
        if dist <= 18 then
            local touchPart = chest:IsA("BasePart") and chest or (chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart"))
            if touchPart then
                pcall(firetouchinterest, touchPart, r, 0)
                pcall(firetouchinterest, touchPart, r, 1)
                if firesignal and pcall(function() return touchPart.Touched end) then
                    pcall(firesignal, touchPart.Touched, r)
                end
                task.wait(0.18)
                pcall(firetouchinterest, touchPart, r, 0)
                pcall(firetouchinterest, touchPart, r, 1)
                pcall(function()
                    chest:SetAttribute("IsDisabled", true)
                    if touchPart ~= chest then touchPart:SetAttribute("IsDisabled", true) end
                end)
            end
            ch.seen[chest] = true
            ch.n = ch.n + 1
        else
            ch.seen[chest] = true
        end
    else
        ch.seen[chest] = true
    end
end

-- ============ elite (nhận quest trước -> có Elite thì đánh, không có thì đi nhặt Chest) ============
local ELITE = { "diablo", "deandre", "urban" }
local kT, kV, eT = 0, nil, 0

local function Kills()
    if os.clock() - kT > 3 then
        kT = os.clock()
        local r = Inv("EliteHunter", "Progress")
        kV = type(r) == "number" and r
            or type(r) == "string" and tonumber(r:match("%d+"))
            or type(r) == "table" and tonumber(r.Kills or r.Progress or r[1])
            or kV
    end
    return kV
end

local function NeedElite()
    if Has("Yama") then return false end
    local k = Kills()
    return k ~= nil and k < 30
end

local function EliteQuest()
    local pg = LP:FindFirstChild("PlayerGui")
    local t = pg and pg:FindFirstChild("TrackedQuestFrame")
    local hd = t and t.Enabled and t:FindFirstChild("Frame") and t.Frame.Visible and t.Frame:FindFirstChild("header")
    local tx = hd and hd:FindFirstChild("textLabel") and hd.textLabel.Text:lower() or ""
    for _, p in ipairs(ELITE) do
        if tx:find(p, 1, true) then return true end
    end
    return false
end

-- Trả về true nếu đang săn Elite trong server, false nếu server không có Elite (để chuyển sang nhặt Chest)
local function TryElite()
    local isLate, olderAcc = CheckLateJoinerConflict()
    if isLate then
        HopLow("Trùng SV với " .. tostring(olderAcc))
        return true
    end

    -- Bước 1: Gọi nhận quest EliteHunter trước để game spawn boss Elite nếu có
    if not EliteQuest() and os.clock() - eT > 2.5 then
        eT = os.clock()
        pcall(Inv, "EliteHunter")
        task.wait(0.25)
    end

    -- Bước 2: Tìm xem có boss Elite trong server không
    local m, _, _, live, pos = Find(ELITE)
    if m and (live or (pos and pos.Magnitude > 50)) then
        Say(("Đang săn Elite: %s (%s/30)"):format(m.Name, tostring(kV or "?")))
        Boss(ELITE, pos)
        return true
    end

    -- Server hiện tại không có Elite -> trả về false để đi farm Chest kiếm Cup (KHÔNG hop vội!)
    return false
end

local dT, dV = 0, false
local function Door()
    if os.clock() - dT > 2 then
        dT = os.clock()
        local p = Inv("TushitaProgress")
        if type(p) == "table" then dV = p.OpenedDoor == true end
    end
    return dV
end

local function WaitAtSpot(isHolder, serverHasCup, cupHoldersList)
    local needTushita = not Has("Tushita")
    local targetPos = P.Spot
    local holderStr = (cupHoldersList and #cupHoldersList > 0) and table.concat(cupHoldersList, ",") or "Cup"
    local desc = "Đợi ở Sea Castle (Cup: " .. holderStr .. ")"

    if not isHolder and serverHasCup and needTushita then
        targetPos = P.Hydra
        desc = "Đợi ở Hydra chờ Tushita (Cup: " .. holderStr .. ")"
    end

    local r = Root()
    if r and (r.Position - targetPos).Magnitude > 25 then
        Go(targetPos, function()
            local hasCupNow = GetServerCupHolderFromFile()
            return Find(INDRA) ~= nil or (not isHolder and not hasCupNow)
        end, desc)
    else
        Say(desc .. (" [%d/12]"):format(#Players:GetPlayers()))
    end
end

local function CloneStep()
    -- Đợi 2 giây đầu khi mới vào server để Inventory và Map kịp đồng bộ
    if os.clock() - (S.spawnClock or 0) < 2 then
        Say("Đang đồng bộ dữ liệu server...")
        return
    end

    local nh, nt = not Has("Valkyrie Helm"), not Has("Tushita")
    if not (nh or nt) then
        Say("HOÀN TẤT")
        return
    end
    if not Need(3) then return end

    -- 1. Nếu Rip Indra đang xuất hiện trong server -> ưu tiên xử lý ngay
    if Find(INDRA) then
        if nh then
            Boss(INDRA, P.Castle)
        elseif InBag("Holy Torch") then
            Say("Thắp 5 đuốc Tushita")
            for i = 1, 5 do
                Inv("TushitaProgress", "Torch", i)
                task.wait(0.2)
            end
        else
            Go(P.Torch, nil, "Đi lấy Holy Torch")
            local r = Root()
            if r then
                Float(false)
                r.CFrame = CF(P.Torch)
                task.wait(1)
            end
        end
        return
    end

    local myCup = InBag("God's Chalice") ~= nil
    local summoning = S.sumT and (os.clock() - S.sumT < 35)

    -- 2. NẾU ACC NÀY ĐANG CẦM CUP HOẶC VỪA SUMMON
    if myCup or summoning then
        UpdatePresence()
        if summoning then
            Say("Đợi Rip Indra xuất hiện...")
            return WaitAtSpot(true, true, { LP.Name })
        end

        local zn = false
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.Name:lower() == HAKI then zn = true end
        end

        local padsReady = PadsAll()
        local isFullServer = (#Players:GetPlayers() >= 12)
        local allClonesJoined = AllActiveClonesInServer()

        if padsReady and not zn and (isFullServer or allClonesJoined) then
            Equip("God's Chalice")
            if Go(P.Detect, nil, "Tới bệ Summon Indra") then
                local r = Root()
                pcall(function()
                    local d = workspace.Map["Boat Castle"].Summoner.Detection
                    firetouchinterest(r, d, 0)
                    firetouchinterest(r, d, 1)
                end)
                task.wait(1.5)
                S.sumT = os.clock()
                UpdatePresence()
            end
        else
            WaitAtSpot(true, true, { LP.Name })
        end
        return
    end

    -- 3. NẾU ACC NÀY KHÔNG CẦM CUP -> KIỂM TRA SERVER HIỆN TẠI HOẶC SERVER KHÁC CÓ CUP KHÔNG
    local serverHasCup, cupHolders = GetServerCupHolderFromFile()
    if serverHasCup then
        return WaitAtSpot(false, true, cupHolders)
    end

    local readyQueues = {}
    for _, e in ipairs(GetCupQueues()) do
        if e.ready and not e.summoned and e.job ~= tostring(game.JobId) then
            table.insert(readyQueues, e)
        end
    end

    if #readyQueues > 0 then
        Say("Join server đủ 3 pad của " .. tostring(readyQueues[1].name))
        return Join(readyQueues[1].job)
    end

    -- 4. Nếu chỉ còn thiếu Tushita (đã có Valkyrie Helm) và đã mở cửa Tushita -> đi săn Longma
    if not nh and nt and Door() then
        S.weapon = nil
        if not Boss({ "longma" }, P.Longma) then
            local r = Root()
            if r and (r.Position - P.Longma).Magnitude > 60 then
                Go(P.Longma, function() return Find({ "longma" }) end, "Đang tới hang Longma")
            else
                return HopLow("Longma chưa spawn")
            end
        end
        return
    end

    -- 5. ĐI KIẾM GOD'S CHALICE:
    -- Nếu chưa đủ 30 Elite cho Yama (hoặc muốn săn Elite rơi Cup) -> kiểm tra Elite trước
    if NeedElite() then
        if TryElite() then return end
    else
        -- Kể cả khi đủ 30 kill Yama, vẫn thử nhận quest Elite vì giết Elite có tỉ lệ rơi God's Chalice
        if TryElite() then return end
    end

    -- Nếu server hiện tại không có Elite -> Đi nhặt Chest kiếm God's Chalice!
    Chest()
end

