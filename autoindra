local ELITE = { "diablo", "deandre", "urban" }
local kT, kV, eT = 0, 0, 0

local function Kills()
    if os.clock() - kT > 4 then
        kT = os.clock()
        local r = Inv("EliteHunter", "Progress")
        local parsed = type(r) == "number" and r
            or type(r) == "string" and tonumber(r:match("%d+"))
            or type(r) == "table" and tonumber(r.Kills or r.Progress or r[1])
        if parsed ~= nil then kV = parsed end
    end
    return kV or 0
end

local function NeedElite()
    if Has("Yama") then return false end
    return Kills() < 30
end

local function CheckQuest(mobName)
    local ok, res = pcall(function()
        local quest = LP.PlayerGui.Main.Quest
        if not quest.Visible then return false end
        local title = quest.Container.QuestTitle.Title.Text:gsub("-", ""):lower()
        return title:find(mobName:gsub("-", ""):lower(), 1, true) ~= nil
    end)
    return ok and res or false
end

local function TryElite()
    local isLate, olderAcc = CheckLateJoinerConflict()
    if isLate then
        HopLow("Trùng SV với " .. tostring(olderAcc))
        return true
    end

    local m, _, _, live, pos = Find(ELITE)
    if m then
        if not CheckQuest(m.Name) and os.clock() - eT > 1.5 then
            eT = os.clock()
            pcall(Inv, "EliteHunter")
        end
        Say(("Đang săn Elite: %s (%d/30)"):format(m.Name, Kills()))
        Boss(ELITE, pos)
        return true
    end

    return false
end

local function HuntLongma()
