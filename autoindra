-- ============ file sync (5s heartbeat, 60s offline) & anti trùng server ============
local ANTI_FILE = DIR .. "/anti_servers.json"
local myFile = DIR .. "/" .. LP.Name .. ".json"

local function GetAntiServers()
    local list = {}
    pcall(function()
        if isfile and isfile(ANTI_FILE) then
            local raw = readfile(ANTI_FILE)
            local ok, data = pcall(function() return HS:JSONDecode(raw) end)
            if ok and type(data) == "table" then list = data end
        end
    end)
    local now = os.time()
    local cleaned = {}
    for jid, exp in pairs(list) do
        if type(exp) == "number" and exp > now then
            cleaned[jid] = exp
        end
    end
    return cleaned
end

local function MarkServerAnti(jobId, durationSeconds)
    if not jobId or jobId == "" then return end
    durationSeconds = durationSeconds or 300
    pcall(function()
        local list = GetAntiServers()
        list[tostring(jobId)] = os.time() + durationSeconds
        writefile(ANTI_FILE, HS:JSONEncode(list))
    end)
end

-- Đọc danh sách các acc đang online (cập nhật trong vòng 60s)
local function Entries()
    local o = {}
    local ok, fl = pcall(listfiles, DIR)
    local now = os.time()
    for _, f in ipairs(ok and fl or {}) do
        local fname = f:match("[^/\\]+$") or f
        if not fname:lower():find("anti") and not fname:lower():find("visited") and not fname:lower():find("bl") then
            local ok2, raw = pcall(readfile, f)
            if ok2 and raw and raw ~= "" then
                local ok3, d = pcall(function() return HS:JSONDecode(raw) end)
                if ok3 and type(d) == "table" and d.name then
                    local age = now - (tonumber(d.t) or 0)
                    if age >= -120 and age <= 60 then
                        o[#o + 1] = d
                    elseif age > 60 then
                        pcall(delfile, f)
                    end
                end
            end
        end
    end
    return o
end

