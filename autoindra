-- ============ hop low (1-5 người + scan server sâu + anti chung sever) ============
local function FetchFullServers()
    local rawList = {}
    local browser = RS:FindFirstChild("__ServerBrowser")

    if browser then
        local completed = 0
        local totalPages = 50
        local byJob = {}

        for page = 1, totalPages do
            task.delay((page - 1) * 0.02, function()
                for _ = 1, 2 do
                    local ok, res = pcall(function() return browser:InvokeServer(page) end)
                    if ok and type(res) == "table" then
                        for jobId, data in pairs(res) do
                            local id = tostring(jobId)
                            if id ~= tostring(game.JobId) and not byJob[id] then
                                local count = (type(data) == "table" and tonumber(data.Count)) or tonumber(data) or 1
                                local reg = (type(data) == "table" and tostring(data.Region or "")) or "Unknown"

                                local numericPing = 90
                                if reg:find("Sing") then
                                    numericPing = math.random(32, 48)
                                elseif reg:find("Japan") then
                                    numericPing = math.random(85, 110)
                                elseif reg:find("Germ") then
                                    numericPing = math.random(170, 210)
                                elseif reg:find("United States") or reg:find("US") then
                                    numericPing = math.random(210, 260)
                                end

                                byJob[id] = {
                                    id = id,
                                    playing = count,
                                    max = 12,
                                    region = reg,
                                    ping = numericPing
                                }
                            end
                        end
                        break
                    end
                    task.wait(0.04)
                end
                completed = completed + 1
            end)
        end

        local start = os.clock()
        repeat task.wait(0.05) until completed >= totalPages or (os.clock() - start) >= 2.5

        for _, item in pairs(byJob) do
            table.insert(rawList, item)
        end
    end

    if #rawList == 0 then
        local cursor = ""
        local pageCount = 0

        while cursor and pageCount < 10 do
            pageCount = pageCount + 1
            local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s", 
                game.PlaceId, (cursor ~= "" and ("&cursor=" .. cursor) or ""))

            local ok, res = pcall(function() return game:HttpGet(url) end)
            if not ok or not res then break end

            local okJson, data = pcall(function() return HS:JSONDecode(res) end)
            if not okJson or not data or not data.data then break end

            for _, s in ipairs(data.data) do
                local id = tostring(s.id)
                if id ~= tostring(game.JobId) then
                    table.insert(rawList, {
                        id = id,
                        playing = tonumber(s.playing) or 0,
                        max = tonumber(s.maxPlayers) or 12,
                        ping = tonumber(s.ping) or 999,
                        region = "Unknown"
                    })
                end
            end

            cursor = data.nextPageCursor
            if not cursor or cursor == "" then break end
        end
    end
    return rawList
end

local function HopLow(why)
    if S.Hop or not S.Run then return end
    S.Hop = true
    if curTw then pcall(function() curTw:Cancel() end) curTw = nil end
    pcall(Float, false)
    Say(why or "Hop low...")

    task.spawn(function()
        local hopStart = os.clock()
        S.vis = S.vis or {}
        S.vis[tostring(game.JobId)] = true
        MarkServerAnti(game.JobId, 600)

        while S.Run and S.Hop do
            -- Fail-safe 1: Nếu là acc Haki và phát hiện có clone đang có cup chờ mở pad -> Hủy hop low, join ngay!
            if isHaki then
                local cupQueues = GetCupQueues()
                local waitingCup = nil
                for _, cq in ipairs(cupQueues) do
                    if not cq.ready and cq.job ~= tostring(game.JobId) then
                        waitingCup = cq
                        break
                    end
                end
                if waitingCup then
                    S.Hop = false
                    Say(("Phát hiện cup của %s -> Hủy hop low, Join ngay!"):format(tostring(waitingCup.name)))
                    Join(waitingCup.job)
                    return
                end
            end

            -- Fail-safe 2: Nếu quá 25s chưa hop được -> reset S.Hop để vòng lặp chính chạy lại, không bị kẹt vĩnh viễn
            if os.clock() - hopStart > 25 then
                S.Hop = false
                Say("Hop low quá 25s -> Reset trạng thái để thử lại")
                return
            end

            Say("Đang quét server vắng (anti-trùng)...")
            local blocked = GetBlockedJobs()
            local rawList = FetchFullServers()
            local pool = {}

            -- Ưu tiên 1: Lọc server 1 đến 5 người, chưa bị chặn/trùng acc khác
            for _, s in ipairs(rawList) do
                if not blocked[s.id] and s.playing >= 1 and s.playing <= 5 and s.playing < s.max then
                    table.insert(pool, s)
                end
            end

            -- Ưu tiên 2: Mở rộng lên <= 8 người
            if #pool == 0 then
                for _, s in ipairs(rawList) do
                    if not blocked[s.id] and s.playing >= 1 and s.playing <= 8 and s.playing < s.max then
                        table.insert(pool, s)
                    end
                end
            end

            -- Ưu tiên 3: Mở rộng lên <= 10 người (cho acc Haki nhường chỗ hoặc né server)
            if #pool == 0 then
                for _, s in ipairs(rawList) do
                    if not blocked[s.id] and s.playing >= 1 and s.playing <= 10 and s.playing < s.max then
                        table.insert(pool, s)
                    end
                end
            end

            -- Ưu tiên 4: Bất kỳ server nào còn chỗ (< s.max)
            if #pool == 0 then
                for _, s in ipairs(rawList) do
                    if not blocked[s.id] and s.playing < s.max then
                        table.insert(pool, s)
                    end
                end
            end

            if #pool == 0 then
                Say("Không tìm thấy server phù hợp, quét lại sau 1s...")
                S.vis = { [tostring(game.JobId)] = true }
                task.wait(1)
            else
                -- Sắp xếp: Ưu tiên ít player nhất trước (1 -> 5), ping thấp hơn trước
                table.sort(pool, function(a, b)
                    if a.playing ~= b.playing then
                        return a.playing < b.playing
                    end
                    return a.ping < b.ping
                end)

                for i = 1, math.min(#pool, 6) do
                    if not S.Run or not S.Hop then break end
                    local cand = pool[i]
                    MarkServerAnti(cand.id, 300)
                    S.vis[cand.id] = true
                    Say(("Hop low -> %s (%d người, ~%dms)"):format(cand.id:sub(1, 8), cand.playing, cand.ping))
                    TeleportToJob(cand.id)
                    task.wait(4.5)
                end
                task.wait(1)
            end
        end
    end)
end

-- ============ haki acc ============
local function HakiStep()
    if not Need(3) then return end

    -- Danh sách server có cup, ưu tiên acc ra cup sớm nhất
    local cupQueues = GetCupQueues()

    -- Kiểm tra xem server hiện tại có phải là server có cup không
    local hereCup = nil
    for _, e in ipairs(cupQueues) do
        if e.job == tostring(game.JobId) then
            hereCup = e
            break
        end
    end

    if hereCup then
        -- Đang ở server có cup -> mở pad
        if PadsAll() then
            task.wait(1)
            if PadsAll() then
                -- Nếu còn server cup khác đang chờ mở pad -> Chuyển thẳng sang server đó luôn
                local nextCup = nil
                for _, e in ipairs(cupQueues) do
                    if not e.ready and e.job ~= tostring(game.JobId) then
                        nextCup = e
                        break
                    end
                end
                if nextCup then
                    Say(("Đủ 3 pad -> Chuyển sang server cup tiếp theo (%s)"):format(tostring(nextCup.name)))
                    return Join(nextCup.job)
                else
                    return HopLow("Đủ 3 pad -> hop low nhường chỗ")
                end
            end
        end

        for _, p in ipairs(PADS) do
            if not PadOpen(p) then
                Say("Đang mở pad " .. p[1])
                Eq(p[3])
                if Go(p[2] + V3(0, 3, 0), nil, "Tới pad " .. p[1]) then
                    local r = Root()
                    if r then Float(false) r.CFrame = CF(p[2] + V3(0, 3, 0)) end
                    local t = os.clock()
                    repeat Eq(p[3]) task.wait(0.4) until PadOpen(p) or os.clock() - t > 6 or not S.Run
                end
                return
            end
        end
        return
    end

    -- Không ở server có cup: tìm server có cup chưa mở pad (ưu tiên ra sớm nhất) để join
    local targetCup = nil
    for _, e in ipairs(cupQueues) do
        if not e.ready and e.job ~= tostring(game.JobId) then
            targetCup = e
            break
        end
    end

    if targetCup then
        Say(("Ưu tiên cup sớm nhất (%s) -> Join %s"):format(tostring(targetCup.name), tostring(targetCup.job):sub(1, 8)))
        return Join(targetCup.job)
    end

    Say("Chờ clone có cup...")
end

