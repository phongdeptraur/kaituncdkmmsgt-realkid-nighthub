end

local function WaitAtSpot(isHolder, serverHasCup, cupHoldersList, unjoinedCount, notAtSpotCount, notAtSpotNames)
    local targetPos, spotName = GetRequiredSpot(isHolder)
    local holderStr = (cupHoldersList and #cupHoldersList > 0) and table.concat(cupHoldersList, ",") or "Cup"
    local desc
    if isHolder then
        if (unjoinedCount or 0) > 0 then
            desc = ("Đợi ở %s (Chưa vào SV: %d acc)"):format(spotName, unjoinedCount)
        elseif (notAtSpotCount or 0) > 0 then
            local waitList = (notAtSpotNames and #notAtSpotNames > 0) and table.concat(notAtSpotNames, ",") or (notAtSpotCount .. " acc")
            desc = ("Đợi acc tới điểm (%s)"):format(waitList)
        else
            desc = ("Đợi điều kiện spawn ở %s"):format(spotName)
        end
    else
        if spotName == "Hydra" then
            desc = "Pre-tween Hydra lấy Holy Torch (Cup: " .. holderStr .. ")"
        else
            desc = "Đợi ở Sea Castle (Cup: " .. holderStr .. ")"
        end
    end

    local r = Root()
    if r and (r.Position - targetPos).Magnitude > 25 then
        Go(targetPos, function()
            local hasCupNow = GetServerCupHolderFromFile()
            return Find(INDRA) ~= nil or (not isHolder and not hasCupNow)
        end, desc)
        if IsAtRequiredSpot(isHolder) ~= S.atSpot then
            UpdatePresence()
        end
    else
        if not S.atSpot then
            UpdatePresence()
        end
        Say(desc .. (" [%d/12]"):format(#Players:GetPlayers()))
    end
end

local function CloneStep()
    if os.clock() - (S.spawnClock or 0) < 2 then
        Say("Đang đồng bộ dữ liệu server...")
        return
    end

    local nh, nt = not Has("Valkyrie Helm"), not Has("Tushita")
    if not (nh or nt) then
        Say("HOÀN TẤT")
        return
    end
    if not Need(3) then return end

    local doorOpened = Door()
    local myCup = InBag("God's Chalice") ~= nil
    local indraObj = Find(INDRA)
    if indraObj then
        S.sumT = nil
    end
    local summoning = (not indraObj) and S.sumT and (os.clock() - S.sumT < 12)

    if IsAtRequiredSpot(myCup or summoning) ~= S.atSpot then
        UpdatePresence()
    end

    -- 1. Thứ tự ưu tiên khi Rip Indra đang xuất hiện:
    --    Mở cửa Tushita (lấy Holy Torch) -> Ngay khi mở cửa xong thì tween đi kill Indra
    if indraObj then
        if nt and not doorOpened then
            if InBag("Holy Torch") then
                Say("Thắp 5 đuốc Tushita")
                for i = 1, 5 do
                    Inv("TushitaProgress", "Torch", i)
                    task.wait(0.2)
                end
                Door(true)
            else
                Go(P.Torch, function() return Door(true) or InBag("Holy Torch") ~= nil end, "Đi lấy Holy Torch")
                local r = Root()
                if r and not Door() then
                    Float(false)
                    r.CFrame = CF(P.Torch)
                    task.wait(1)
                end
            end
        else
            Boss(INDRA, P.Castle)
        end
        return
    end

    -- 2. Nếu acc này đang cầm Cup hoặc vừa summon
    if myCup or summoning then
        UpdatePresence()
        if summoning then
            Say("Đợi Rip Indra xuất hiện...")
            return WaitAtSpot(true, true, { LP.Name }, 0, 0)
        end

        local hakiInServer = false
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsHakiName(pl.Name) then
                hakiInServer = true
                break
            end
        end

        local padsReady = PadsAll()
        local isFullServer = (#Players:GetPlayers() >= 12)
        local unjoinedCount, _, notAtSpotCount, notAtSpotNames = GetCupServerStats()

        -- Đủ 3 pad + Haki đã rời + đủ acc vào SV Cup + tất cả acc đã pre-tween tới điểm cần đến -> Spawn Indra
        if padsReady and not hakiInServer and (isFullServer or unjoinedCount == 0) and notAtSpotCount == 0 then
            Equip("God's Chalice")
            if Go(P.Detect, nil, "Tới bệ Summon Indra") then
                local r = Root()
                pcall(function()
                    local d = workspace.Map["Boat Castle"].Summoner.Detection
                    firetouchinterest(r, d, 0)
                    firetouchinterest(r, d, 1)
                end)
                task.wait(1.5)
                S.sumT = os.clock()
                UpdatePresence()
            end
        else
            WaitAtSpot(true, true, { LP.Name }, unjoinedCount, notAtSpotCount, notAtSpotNames)
        end
        return
    end

    -- 3. Nếu server hiện tại đang có Cup chờ spawn -> pre-tween tới Hydra (nếu cần mở cửa) hoặc Sea Castle
    local serverHasCup, cupHolders = GetServerCupHolderFromFile()
    if serverHasCup then
        return WaitAtSpot(false, true, cupHolders)
    end

    -- 4. Kill Longma sau cùng (khi Indra không còn trong server, không có Cup chờ spawn, và cửa đã mở)
    if nt and doorOpened then
        return HuntLongma()
    end

    -- 5. Tìm server Cup đã mở đủ 3 pad để join
    local readyQueues = {}
    for _, e in ipairs(GetCupQueues()) do
        if e.ready and not e.summoned and e.job ~= tostring(game.JobId) then
            table.insert(readyQueues, e)
        end
    end

    if #readyQueues > 0 then
        Say("Join server đủ 3 pad của " .. tostring(readyQueues[1].name))
        return Join(readyQueues[1].job)
    end

    -- 6. Săn Elite nếu chưa đủ 30/30, ngược lại tập trung nhặt Chest
    if NeedElite() then
        if TryElite() then return end
    end

    Chest()
end

