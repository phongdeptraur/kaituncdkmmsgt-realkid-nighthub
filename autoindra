local function GetCupQueues()
    local cups = {}
    for _, e in ipairs(Entries()) do
        if e.cup and not e.summoned and e.job and e.job ~= "" then
            if e.job ~= tostring(game.JobId) or Players:FindFirstChild(e.name) then
