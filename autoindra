    local notAtSpotNames = {}

    for _, e in ipairs(entries) do
        if not e.isHaki and not IsHakiName(e.name) then
            local eJob = tostring(e.job or "")
            local inPlayersHere = (Players:FindFirstChild(e.name) ~= nil)
            local inAnyCupServer = (eJob ~= "" and cupJobs[eJob] == true)
                or (cupJobs[myJob] == true and inPlayersHere)
            if not inAnyCupServer then
                unjoinedCount = unjoinedCount + 1
                table.insert(unjoinedNames, e.name)
            elseif cupJobs[myJob] == true and (eJob == myJob or inPlayersHere) then
                local readySpot = (e.name == LP.Name)
                    and IsAtRequiredSpot(InBag("God's Chalice") ~= nil or (S.sumT and (os.clock() - S.sumT < 12)))
                    or (eJob == myJob and e.atSpot == true)
                if not readySpot then
                    notAtSpotCount = notAtSpotCount + 1
                    table.insert(notAtSpotNames, e.name)
                end
            end
        end
    end

    return unjoinedCount, unjoinedNames, notAtSpotCount, notAtSpotNames
end

local function CheckLateJoinerConflict()
    local myJob = tostring(game.JobId)
    local myJoin = tonumber(S.joinTime) or os.time()

    for _, e in ipairs(Entries()) do
        if e.name ~= LP.Name and not e.isHaki and not IsHakiName(e.name) and e.job == myJob and Players:FindFirstChild(e.name) then
            local otherJoin = tonumber(e.joinTime) or 0
            if myJoin > otherJoin or (myJoin == otherJoin and LP.Name > e.name) then
                return true, e.name
            end
        end
    end
    return false, nil
end

local function GetBlockedJobs()
    local blocked = {}
    local myJob = tostring(game.JobId)
    blocked[myJob] = true

    local anti = GetAntiServers()
    for jid, _ in pairs(anti) do
        blocked[tostring(jid)] = true
    end

    for _, e in ipairs(Entries()) do
        if e.name ~= LP.Name and e.job and e.job ~= "" then
            blocked[tostring(e.job)] = true
        end
    end

    if S.vis then
        for jid, _ in pairs(S.vis) do
            blocked[tostring(jid)] = true
        end
    end

    return blocked
end

