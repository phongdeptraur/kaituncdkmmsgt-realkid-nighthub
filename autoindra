                local cupQueues = GetCupQueues()
                for _, cq in ipairs(cupQueues) do
                    if not cq.ready and cq.job ~= tostring(game.JobId) then
                        S.Hop = false
                        Say(("Phát hiện cup của %s -> Join ngay!"):format(tostring(cq.name)))
                        Join(cq.job)
                        return
                    end
                end
            else
                if InBag("God's Chalice") then
                    S.Hop = false
                    Say("Đã có God's Chalice -> Hủy Hop!")
                    return
                end
                for _, cq in ipairs(GetCupQueues()) do
                    if cq.ready and not cq.summoned and cq.job ~= tostring(game.JobId) then
                        S.Hop = false
                        Say(("Server %s đã mở 3 pad -> Join ngay!"):format(tostring(cq.name)))
                        Join(cq.job)
                        return
                    end
                end
            end

            if os.clock() - hopStart > 20 then
                S.Hop = false
                Say("Hop quá 20s -> Reset thử lại")
                return
            end

            local blocked = GetBlockedJobs()
            local rawList = FetchFullServers()
            local pool = {}

            for _, s in ipairs(rawList) do
                if not blocked[s.id] and s.playing >= 1 and s.playing <= 5 and s.playing < s.max then
                    table.insert(pool, s)
                end
            end

            if #pool == 0 then
                for _, s in ipairs(rawList) do
                    if not blocked[s.id] and s.playing >= 1 and s.playing <= 8 and s.playing < s.max then
                        table.insert(pool, s)
                    end
                end
            end

            if #pool == 0 then
                for _, s in ipairs(rawList) do
                    if not blocked[s.id] and s.playing >= 1 and s.playing <= 10 and s.playing < s.max then
                        table.insert(pool, s)
                    end
                end
            end

            if #pool == 0 then
                Say(("[%s] Chưa lọc được server, quét lại..."):format(reason))
                S.vis = { [tostring(game.JobId)] = true }
                task.wait(0.5)
            else
                table.sort(pool, function(a, b)
                    if a.playing ~= b.playing then return a.playing < b.playing end
                    return a.ping < b.ping
                end)

                for i = 1, math.min(#pool, 6) do
                    if not S.Run or not S.Hop then break end
                    if not isHaki and InBag("God's Chalice") then
                        S.Hop = false
                        return
                    end
                    local cand = pool[i]
                    MarkServerAnti(cand.id, 180)
                    S.vis[cand.id] = true
                    Say(("[%s] -> %s (%d/%d | %dms)"):format(reason, cand.id:sub(1, 8), cand.playing, cand.max, cand.ping))
                    TeleportToJob(cand.id)
                    task.wait(3.5)
                end
            end
        end
    end)
end

