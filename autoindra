local curTw, conn
local function Float(on)
    local r = Root()
    if not r then return end
    local b = r:FindFirstChild("AxF")
    if on then
        if not b then b = Instance.new("BodyVelocity") b.Name, b.MaxForce, b.Velocity, b.Parent = "AxF", V3(1e9, 1e9, 1e9), V3(), r end
    else
        if b then b:Destroy() end
