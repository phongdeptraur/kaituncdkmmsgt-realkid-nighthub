local function Fly(pos, abort, desc)
    if not S.Run or S.Hop then return false end
    local r, h = Root()
    if not r or not h or h.Health <= 0 then return false end
    h.Sit = false
    Float(true)

    local snapCount = 0
    local snapPos = nil

    while S.Run and not S.Hop do
        r, h = Root()
        if not r or not h or h.Health <= 0 or (abort and abort()) then return false end
        local d = (r.Position - pos).Magnitude
        if d <= 15 then
            r.CFrame = CF(pos)
            break
        end

        local tw = TS:Create(r, TweenInfo.new(d / SPEED, Enum.EasingStyle.Linear), { CFrame = CF(pos) })
        curTw = tw
        tw:Play()

        local lastDist = d
        local checkT = os.clock()
        local rubberbanded = false

        while S.Run and tw.PlaybackState == Enum.PlaybackState.Playing do
            task.wait(0.05)
            r, h = Root()
            if not r or not h or h.Health <= 0 or S.Hop or (abort and abort()) then
                tw:Cancel()
                return false
            end
            r.AssemblyLinearVelocity = V3()
            local curDist = (r.Position - pos).Magnitude
            if desc then Say(("%s (%.0fm)"):format(desc, curDist)) end

            if os.clock() - checkT >= 0.22 then
                checkT = os.clock()
                if curDist >= lastDist - 8 then
                    if snapPos and (r.Position - snapPos).Magnitude < 45 then
                        snapCount = snapCount + 1
                    else
                        snapPos = r.Position
                        snapCount = 1
                    end

                    if snapCount >= 5 then
                        tw:Cancel()
                        Float(false)
                        Say("Bị giật vị trí 5 lần -> Dừng 1s về Verified Spot...")
                        task.wait(1)
                        snapCount = 0
                        snapPos = nil
                        Float(true)
                        rubberbanded = true
                        break
                    end
                elseif curDist < lastDist - 25 then
                    snapCount = 0
                end
                lastDist = curDist
            end
        end

        if not rubberbanded then
            r = Root()
            if S.Run and r and (r.Position - pos).Magnitude <= 25 then
                r.CFrame = CF(pos)
            end
            break
        end
    end
    return S.Run
end

-- Thoát khỏi Cursed Ship (Sea 2) và Submerged Island (Sea 3) trước khi Tween hoặc chuyển Sea
EscapeZones = function(targetPos, abort)
    local r = Root()
    if not r or not S.Run or S.Hop then return false end

    -- Sea 2: Đang ở trong Cursed Ship (bán kính 4000 stud quanh 909.51, 125.37, 32864.02)
    if Sea() == 2 and (r.Position - P.Ship).Magnitude <= 4000 then
        if not targetPos or (targetPos - P.Ship).Magnitude > 4000 then
            if Fly(P.Ship, abort, "Đang tới cửa rời Cursed Ship") then
                pcall(function()
                    local v = (type(vector) == "table" and type(vector.create) == "function")
                        and vector.create(-6508.55810546875, 89.03500366210938, -132.83999633789062)
                        or P.ShipOut
                    RS:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer("requestEntrance", v)
                end)
                task.wait(1.2)
            else
                return false
            end
        end
    end

    -- Sea 3: Đang ở dưới Submerged Island (bán kính 3000 stud quanh 11279.25, -2138.93, 9873.44)
    r = Root()
    if r and Sea() == 3 and (r.Position - P.Sub).Magnitude <= 3000 then
        if not targetPos or (targetPos - P.Sub).Magnitude > 3000 then
            if Fly(P.SubTp, abort, "Đang ra tàu ngầm rời Submerged Island") then
                pcall(function()
                    RS:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RF/SubmarineTransportation"):InvokeServer("InitiateTeleport", "Tiki Outpost")
                end)
                task.wait(1.5)
            else
                return false
            end
        end
    end

    return true
end

local function Go(pos, abort, desc)
    if not S.Run or S.Hop then return false end
    if not EscapeZones(pos, abort) then return false end
    for _ = 1, 2 do
        local r = Root()
        if not r or not S.Run or (abort and abort()) then return false end
        local direct = (r.Position - pos).Magnitude
        if direct < 1200 or Sea() ~= 3 or not Has("Valkyrie Helm") then break end
        local best, bt = nil, direct - 600
        for _, u in ipairs(EDGES) do
            local d1 = (r.Position - u.g).Magnitude + (u.e - pos).Magnitude
            if d1 < bt then best, bt = u, d1 end
            for _, v in ipairs(EDGES) do
                local d2 = (r.Position - u.g).Magnitude + (u.e - v.g).Magnitude + (v.e - pos).Magnitude
                if d2 < bt then best, bt = u, d2 end
            end
        end
        if not best then break end
        if not Fly(best.g + V3(0, 2, 0), abort, "Vào cổng gần nhất") then return false end
        for _ = 1, 5 do
            local c = Root()
            if not S.Run or not c or (c.Position - best.g).Magnitude > 250 then break end
            Float(false)
            c.CFrame = CF(best.g)
            Inv("requestEntrance", best.rq)
            Inv("requestEntrance", best.e)
            task.wait(0.25)
        end
        if S.Run then Float(true) end
    end
    return Fly(pos, abort, desc or "Đang di chuyển")
end

