-- ============ clone & auto chest ============
local ch = { job = "" }

local function GetChest()
    local r = Root()
    if not r then return nil end

    local tagged = CS:GetTagged("_ChestTagged")
    local huge = math.huge
    local best = nil
    local inSub = (r.Position - P.Sub).Magnitude <= 3000

    for i = 1, #tagged do
        local obj = tagged[i]
        if obj and obj.Parent and not obj:GetAttribute("IsDisabled") and not (ch.seen and ch.seen[obj]) then
            local hasTouch = obj:FindFirstChild("TouchInterest") or obj:FindFirstChildWhichIsA("TouchTransmitter", true)
            if hasTouch then
                local ok, cf = pcall(function() return obj:GetPivot() end)
                if ok and cf then
                    -- Bỏ qua rương dưới Submerged Island nếu nhân vật đang ở trên mặt đất
                    if inSub or (cf.Position - P.Sub).Magnitude > 3000 then
                        local magnitude = (cf.Position - r.Position).Magnitude
                        if magnitude <= huge then
                            best = obj
                            huge = magnitude
                        end
                    end
                end
            end
        end
    end

    if not best then
        for i = 1, #tagged do
            local obj = tagged[i]
            if obj and obj.Parent and not obj:GetAttribute("IsDisabled") and not (ch.seen and ch.seen[obj]) then
                local ok, cf = pcall(function() return obj:GetPivot() end)
                if ok and cf then
                    if inSub or (cf.Position - P.Sub).Magnitude > 3000 then
                        local magnitude = (cf.Position - r.Position).Magnitude
                        if magnitude <= huge then
                            best = obj
                            huge = magnitude
                        end
                    end
                end
            end
        end
    end

    return best
end

local function Chest()
    if ch.job ~= tostring(game.JobId) then
        ch = { job = tostring(game.JobId), n = 0, t0 = os.clock(), seen = {}, emptyRetries = 0 }
    end

    local isLate, olderAcc = CheckLateJoinerConflict()
    if isLate then
        return HopLow("Trùng SV với " .. tostring(olderAcc))
    end

    if ch.n >= 30 or os.clock() - ch.t0 > 80 then
        return HopLow(("Đã nhặt %d/30 chest"):format(ch.n))
    end

    local r = Root()
    if not r then return end

    local chest = GetChest()
    if not chest then
        ch.emptyRetries = (ch.emptyRetries or 0) + 1
        if ch.emptyRetries <= 8 then
            Say(("Đang quét rương (%d/8)..."):format(ch.emptyRetries))
            task.wait(0.5)
            return
        end
        return HopLow("Hết chest")
    end
    ch.emptyRetries = 0

    local targetPos = chest:GetPivot().Position
    local dStart = (r.Position - targetPos).Magnitude
    Say(("Nhặt chest %d/30 (%.0fm)"):format(ch.n + 1, dStart))

    Go(targetPos, function()
        local lateNow = CheckLateJoinerConflict()
        return lateNow
            or not chest.Parent
            or chest:GetAttribute("IsDisabled") == true
            or InBag("God's Chalice") ~= nil
    end, ("Bay tới chest %d/30"):format(ch.n + 1))

    r = Root()
    if r and chest and chest.Parent then
        local dist = (r.Position - chest:GetPivot().Position).Magnitude
        if dist <= 15 then
            local now2 = tick()
            local touchPart = chest:IsA("BasePart") and chest or (chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart"))
            while S.Run and chest and chest.Parent and not chest:GetAttribute("IsDisabled") and tick() - now2 < 1.1 do
                r = Root()
                if not r then break end
                r.CFrame = chest:GetPivot()
                pcall(firetouchinterest, chest, r, 0)
                pcall(firetouchinterest, chest, r, 1)
                if firesignal then pcall(firesignal, chest.Touched, r) end
                if touchPart and touchPart ~= chest then
                    pcall(firetouchinterest, touchPart, r, 0)
                    pcall(firetouchinterest, touchPart, r, 1)
                    if firesignal then pcall(firesignal, touchPart.Touched, r) end
                end
                task.wait(0.1)
            end
            pcall(function()
                if not chest:GetAttribute("IsDisabled") then
                    chest:SetAttribute("IsDisabled", true)
                end
            end)
            ch.seen[chest] = true
            ch.n = ch.n + 1
        else
            ch.seen[chest] = true
        end
    else
        ch.seen[chest] = true
    end
end

