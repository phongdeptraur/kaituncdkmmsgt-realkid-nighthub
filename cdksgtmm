-- Đọc và dọn các mục đã quá hạn trong file TTL (20s cho đặt chỗ trước, 60s cho acc đang farm)
local function ReadActiveTTLClaims()
    local now = os.time()
    local claims = {}
    for _, path in ipairs(TTL_FILES) do
        pcall(function()
            if isfile and isfile(path) then
                local raw = readfile(path)
                local ok, dt = pcall(HttpService.JSONDecode, HttpService, raw)
                if ok and type(dt) == "table" then
                    for jid, info in pairs(dt) do
                        if type(jid) == "string" and #jid >= 20 then
                            local ts = type(info) == "table" and tonumber(info.time or info.ts or info.timestamp) or tonumber(info)
                            local uid = type(info) == "table" and tostring(info.userId or info.uid or info.user or "") or ""
                            local uname = type(info) == "table" and tostring(info.name or info.user or "") or ""
                            local joined = type(info) == "table" and tonumber(info.joined or ts) or ts
                            local mode = type(info) == "table" and tostring(info.mode or "") or ""
                            local state = type(info) == "table" and tostring(info.state or "active") or "active"
                            local ttlLimit = (state == "reserving") and 20 or BONES_TTL
                            if ts and (now - ts) <= ttlLimit then
                                local prev = claims[jid]
                                if not prev or (joined and prev.joined and joined < prev.joined) then
                                    claims[jid] = {
                                        time = ts,
                                        joined = joined or ts,
                                        userId = uid,
                                        name = uname,
                                        mode = mode,
                                        state = state
                                    }
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
    return claims
end

local function WriteActiveTTLClaims(claims)
    local encoded = HttpService:JSONEncode(claims)
    for _, path in ipairs(TTL_FILES) do
        pcall(writefile, path, encoded)
    end
end

local function FormatFarmAccStatus(claims)
    local list = claims or ReadActiveTTLClaims()
    local seenM, seenE = {}, {}
    local mCnt, eCnt = 0, 0
    for jid, info in pairs(list) do
        local key = (info.userId ~= "" and info.userId) or (info.name ~= "" and info.name) or jid
        if info.mode == "Bones/Mastery" and not seenM[key] then
            seenM[key] = true
            mCnt += 1
        elseif info.mode == "Ectoplasm" and not seenE[key] then
            seenE[key] = true
            eCnt += 1
        end
    end
    return (" [Acc Farm: %d Mastery | %d Ecto]"):format(mCnt, eCnt)
end

