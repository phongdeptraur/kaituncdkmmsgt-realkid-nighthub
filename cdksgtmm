            end

            TweenToPosition(POS_PRE_HOP_INDRA, CONFIG.TweenSpeed, bossPatterns)

            local postHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if postHrp and (postHrp.Position - POS_PRE_HOP_INDRA).Magnitude <= 50 then
                Engine.HasPreTweenedIndra = true
                return true
            end
        end
        task.wait(0.2)
    end
    return false
end

-- [CƠ CHẾ GETMM]: Bắt buộc Tween đến Castle on the Sea / Cake Loaf trước khi Hop
local function EnsureZoneArrivalBeforeHop(bossName, targetPos, zoneLabel, bossPatterns)
    local isDough = (bossName == "Dough King" or bossName == "Cake Prince")
    if (isDough and Engine.HasArrivedAtLoaf) or (not isDough and Engine.HasArrivedAtCastle) then
        return true
    end

    while Engine.IsRunning do
        if bossPatterns and ScanBossEntity(bossPatterns) then
            return false
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hrp and hum and hum.Health > 0 then
            local dist = (hrp.Position - targetPos).Magnitude
            if dist <= CONFIG.ArrivalRadius then
                if isDough then Engine.HasArrivedAtLoaf = true else Engine.HasArrivedAtCastle = true end
                if Engine.StatusLabel then
                    Engine.StatusLabel.Text = string.format("Trạng thái: ✅ Đã xác nhận đến %s (Cách: %.0f)! Sẵn sàng Hop...", zoneLabel, dist)
                end
                return true
