local function equipCombatTool(): Tool?
    local char = LocalPlayer.Character
    if not char then return nil end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.ToolTip == "Sword" or equipped:GetAttribute("WeaponType") == "Melee" or equipped:GetAttribute("WeaponType") == "Sword") then
        return equipped
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.ToolTip == "Melee" or item.ToolTip == "Sword" or item:GetAttribute("WeaponType") == "Melee" or item:GetAttribute("WeaponType") == "Sword") then
                hum:EquipTool(item)
                return item
            end
        end
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                hum:EquipTool(item)
                return item
            end
        end
