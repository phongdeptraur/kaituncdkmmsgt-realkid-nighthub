-- [ULTRA-FAST MULTI-SOURCE INVENTORY ENGINE & ANTI-RESET QUEST REGISTRY]
-- =========================================================================
local Inventory = {
    Weapons = {},
    Materials = {},
    PermanentOwned = {
        Tushita = false,        Valkyrie = false,
        Fractal = false,
        Yama = false
    }
}

local function SafeRequire(inst)
    if not inst or not inst:IsA("ModuleScript") then return nil end
    local ok, res = pcall(require, inst)
    return ok and res or nil
end

function Inventory:FastScan()
    -- 1. Quét tức thì trực tiếp trên Character & Backpack (Microsecond latency)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")

    if char then
        for _, item in ipairs(char:GetChildren()) do
            local low = item.Name:lower()
            if low:find("valkyrie") then self.PermanentOwned.Valkyrie = true end
            if low:find("yama") then self.PermanentOwned.Yama = true end
            if low:find("tushita") then self.PermanentOwned.Tushita = true end
            if low:find("fractal") or low:find("mirror") then self.PermanentOwned.Fractal = true end
        end
    end

    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            local low = item.Name:lower()
            if low:find("valkyrie") then self.PermanentOwned.Valkyrie = true end
            if low:find("yama") then self.PermanentOwned.Yama = true end
            if low:find("tushita") then self.PermanentOwned.Tushita = true end
            if low:find("fractal") or low:find("mirror") then self.PermanentOwned.Fractal = true end
        end
    end

    -- 2. Quét bộ nhớ cache Client từ ItemReplicationService
    pcall(function()
        local irsInst = ReplicatedStorage:FindFirstChild("ItemReplicationService")
        local cfgInst = ReplicatedStorage:FindFirstChild("ItemConfig")
        local IRS = SafeRequire(irsInst)
        local CfgStorage = cfgInst and cfgInst:FindFirstChild("Storage") and SafeRequire(cfgInst.Storage)
        local KeysModule = irsInst and irsInst:FindFirstChild("KEYS") and SafeRequire(irsInst.KEYS)

        if IRS and IRS._UserCache then
            local userItems = IRS._UserCache[LocalPlayer.UserId]
            if userItems and typeof(userItems.GetItems) == "function" then
                local quantityKey = KeysModule and KeysModule.QUANTITY or "Quantity"
                local masteryKey = KeysModule and KeysModule.MASTERY or "Mastery"
                local quantities = userItems:GetItems(quantityKey)
                local masteries = userItems:GetItems(masteryKey) or {}

                local masteryMap = {}
                for _, entry in pairs(masteries) do
                    if entry.ItemId and entry.Value then
                        masteryMap[tostring(entry.ItemId)] = tonumber(entry.Value) or 0
                    end
                end

                if quantities then
                    for _, itemEntry in pairs(quantities) do
                        local itemId = tostring(itemEntry.ItemId or "")
                        local count = tonumber(itemEntry.Value) or 1
                        local label = itemId

                        if CfgStorage and typeof(CfgStorage.match) == "function" then
                            pcall(function()
                                local matchData = CfgStorage.match(itemId):unwrap()
                                if matchData and matchData.Index then
                                    label = matchData.Index.DebugLabel or matchData.Index.StorageKey or label
                                end
                            end)
                        end

                        label = label:gsub(" %[.-%]", "")
                        local lowLabel = label:lower()
                        local lowId = itemId:lower()

                        if lowLabel:find("valkyrie") or lowId:find("valkyrie") then self.PermanentOwned.Valkyrie = true end
                        if lowLabel:find("yama") or lowId:find("yama") then self.PermanentOwned.Yama = true end
                        if lowLabel:find("tushita") or lowId:find("tushita") then self.PermanentOwned.Tushita = true end
                        if lowLabel:find("fractal") or lowLabel:find("mirror") or lowId:find("fractal") or lowId:find("mirror") then self.PermanentOwned.Fractal = true end

                        self.Weapons[label] = { Mastery = masteryMap[itemId] or 0, Quantity = count }
                    end
                end
            end
        end
    end)

    -- 3. Gọi Remote Server getInventory đồng bộ nếu vẫn chưa tìm đủ
    if not (self.PermanentOwned.Tushita and self.PermanentOwned.Valkyrie and self.PermanentOwned.Fractal and self.PermanentOwned.Yama) then
        pcall(function()
            local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
            if commF then
                local invList = commF:InvokeServer("getInventory")
                if typeof(invList) == "table" then
                    for _, item in pairs(invList) do
                        local name = tostring(item.Name or item.Item or "")
                        local lowName = name:lower()
                        local count = tonumber(item.Count or item.Value or 1) or 1
                        local mast = tonumber(item.Mastery or 0) or 0

                        if lowName:find("valkyrie") then self.PermanentOwned.Valkyrie = true end
                        if lowName:find("yama") then self.PermanentOwned.Yama = true end
                        if lowName:find("tushita") then self.PermanentOwned.Tushita = true end
                        if lowName:find("fractal") or lowName:find("mirror") then self.PermanentOwned.Fractal = true end

                        self.Weapons[name] = { Mastery = mast, Quantity = count }
                    end
                end
            end
        end)
    end

    -- 4. Đồng bộ quyền sở hữu dựa trên trang bị hiện có (Không gọi LoadItem gây giật túi đồ)
    if (char and char:FindFirstChild("Yama")) or (bp and bp:FindFirstChild("Yama")) then
        self.PermanentOwned.Yama = true
    end
    if (char and char:FindFirstChild("Tushita")) or (bp and bp:FindFirstChild("Tushita")) then
        self.PermanentOwned.Tushita = true
    end
end

function Inventory:SyncFromMemory()
    self:FastScan()
end

function Inventory:SyncRemoteAsync()
    task.spawn(function()
        self:FastScan()
    end)
end

local function CheckHasYama(): boolean
    if Inventory.PermanentOwned.Yama then return true end
    Inventory:FastScan()
    return Inventory.PermanentOwned.Yama
end

function Inventory:HasItem(target)
    target = target:lower()
    if target:find("valkyrie") and self.PermanentOwned.Valkyrie then return true end
    if target:find("yama") and (self.PermanentOwned.Yama or CheckHasYama()) then return true end
    if target:find("tushita") and self.PermanentOwned.Tushita then return true end
    if target:find("fractal") and self.PermanentOwned.Fractal then return true end

    self:FastScan()

    if target:find("valkyrie") and self.PermanentOwned.Valkyrie then return true end
    if target:find("yama") and (self.PermanentOwned.Yama or CheckHasYama()) then return true end
    if target:find("tushita") and self.PermanentOwned.Tushita then return true end
    if target:find("fractal") and self.PermanentOwned.Fractal then return true end

    for name in pairs(self.Weapons) do
        local low = name:lower()
        if low:find(target) then
            if target:find("valkyrie") then self.PermanentOwned.Valkyrie = true end
            if target:find("yama") then self.PermanentOwned.Yama = true end
            if target:find("tushita") then self.PermanentOwned.Tushita = true end
            if target:find("fractal") then self.PermanentOwned.Fractal = true end
            return true
        end
    end
    return false
end

function Inventory:GetMastery(swordName)
    local char, bp = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
    local itemTool = (char and char:FindFirstChild(swordName)) or (bp and bp:FindFirstChild(swordName))
    if itemTool and itemTool:FindFirstChild("Level") then
        return tonumber(itemTool.Level.Value) or 0
    end
    for name, data in pairs(self.Weapons) do
        if name:lower():find(swordName:lower()) then
            return tonumber(data.Mastery) or 0
        end
    end
    return 0
end

