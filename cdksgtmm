local function WaitForFastPlayerLoad()
    while not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
        local t = LocalPlayer.Team
        if not t or (t.Name ~= "Marines" and t.Name ~= "Marine") then
            RefreshRemotes()
            if CommF then pcall(function() CommF:InvokeServer("SetTeam2", "Marines") end) end
        end
        task.wait(0.15)
    end
    State.PlayerFullyLoaded = true
    if typeof(Engine) == "table" then Engine.CharacterLoaded = true end
end

-- Vòng lặp điều khiển nhiệm vụ chính (Chạy sau khi chọn Team & Load xong nhân vật)
task.spawn(function()
    WaitForFastPlayerLoad()
    repeat task.wait(0.2) until Engine.InventoryVerified
    CheckPostTeamRemotes() -- Chỉ check remote sau khi chọn Team & load xong nhân vật

    -- Quét kỹ 2 lần đầu để đảm bảo Ectoplasm & Dark Fragment không bị nhận nhầm là 0
    for _ = 1, 3 do
        if SyncItemsPreTeamAndInGame() then break end
        task.wait(0.5)
    end

    while State.Running do
        pcall(function()
            SyncItemsPreTeamAndInGame()
            UpdateProgressUI()

            local cfg = getgenv().AutoConfig or { GetMM = true, GetCDK = true, GetSGT = true }
            local it  = State.Items

            -- ==================================================================
            -- MỤC 1 & 2: GET MM (1. Valkyrie Helm -> 2. Mirror Fractal)
            -- ==================================================================
            if cfg.GetMM and (not it.ValkyrieHelm or not it.MirrorFractal) then
                State.NeedRemainInSea2 = false
                if not CheckIsSea3() then
                    TeleportToSea3()
                    return
                end
                if not it.ValkyrieHelm then
                    State.CurrentTask = "👑 [STT 1 - GetMM] Đang làm nhiệm vụ lấy Valkyrie Helm (Rip_Indra)..."
                    if typeof(HandleGetValkyrieHelm) == "function" then
                        HandleGetValkyrieHelm()
                    end
                    return
                elseif not it.MirrorFractal then
                    State.CurrentTask = "🪞 [STT 2 - GetMM] Đang làm nhiệm vụ lấy Mirror Fractal (Dough King)..."
                    if typeof(HandleGetMirrorFractal) == "function" then
                        HandleGetMirrorFractal()
                    end
                    return
                end
            end

            -- ==================================================================
            -- MỤC 3 & 4: GET CDK - PHẦN KIẾM (3. Tushita -> 4. Yama)
            -- ==================================================================
            if cfg.GetCDK and (not it.Tushita or not it.Yama) then
                State.NeedRemainInSea2 = false
                if not CheckIsSea3() then
                    TeleportToSea3()
                    return
                end
                if not it.Tushita then
                    State.CurrentTask = "⚔️ [STT 3 - GetCDK] Đang làm nhiệm vụ lấy kiếm Tushita..."
                    if typeof(HandleGetTushita) == "function" then
                        HandleGetTushita()
                    end
                    return
                elseif not it.Yama then
                    State.CurrentTask = "🗡️ [STT 4 - GetCDK] Đang làm nhiệm vụ rút kiếm Yama..."
                    if typeof(HandleGetYama) == "function" then
                        HandleGetYama()
                    end
                    return
                end
            end

            -- ==================================================================
            -- MỤC 5: GET SGT (5. Skull Guitar - Ngay sau Yama)
            -- ==================================================================
            if cfg.GetSGT and not it.SkullGuitar then
                HandleAutoSkullGuitarWorkflow()
                return
            end

            -- ==================================================================
            -- HOÀN TẤT GET CDK (Khi đã có Yama & Tushita: Farm 350 Mas -> 6 Quest -> Rèn CDK)
            -- ==================================================================
            if cfg.GetCDK and not it.CDK and it.Tushita and it.Yama then
                State.NeedRemainInSea2 = false
                if not CheckIsSea3() then
                    TeleportToSea3()
                    return
                end
                if it.TushitaMas < 350 or it.YamaMas < 350 then
                    State.CurrentTask = string.format(
                        "📈 [GetCDK] Đang farm 350 Mastery (Tushita: %d/350 | Yama: %d/350)...",
                        it.TushitaMas, it.YamaMas
                    )
                    if typeof(HandleFarmMasteryCDK) == "function" then
                        HandleFarmMasteryCDK()
                    end
                    return
                elseif cfg.GetCDK then
                    State.CurrentTask = "🔥 [GetCDK] Đã đủ 350 Mastery 2 kiếm -> Đang làm 6 nhiệm vụ Alucard & Rèn CDK..."
                    if typeof(HandleCDKQuestsAndCraft) == "function" then
                        HandleCDKQuestsAndCraft()
                    end
                    return
                end
            end

            State.CurrentTask = "✅ Đã hoàn thành toàn bộ các mục được bật trong AutoConfig!"
        end)
        task.wait(0.5)
    end
end)
