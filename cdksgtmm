local function TweenToPosition(targetPos, speed)
    if not Engine.IsRunning or not Engine.CharacterLoaded or Engine.IsHopping then return nil end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    speed = speed or CONFIG.TweenSpeed
    if Engine.CurrentTween then
        pcall(function() Engine.CurrentTween:Cancel() end)
        Engine.CurrentTween = nil
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    local head = char:FindFirstChild("Head")
    if head and not head:FindFirstChild("axiom_bv") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "axiom_bv"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.zero
        bv.Parent = head
    end

    Engine.IsTweening = true
    local reached = false

    while Engine.IsRunning and not reached and not Engine.IsHopping do
        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then break end

        local currentDist = (hrp.Position - targetPos).Magnitude
        if currentDist <= 6 then
            reached = true
            break
        end

        local duration = currentDist / speed
        local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
        Engine.CurrentTween = tw
        tw:Play()

        local lagbackTriggered = false
        local lastDistToTarget = currentDist

        local monitorConn = RunService.Heartbeat:Connect(function()
            if not Engine.IsRunning or not hrp or not hrp.Parent or Engine.IsHopping then return end
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            local distNow = (hrp.Position - targetPos).Magnitude
            if distNow - lastDistToTarget > 25 then
                lagbackTriggered = true
            else
                if distNow < lastDistToTarget then lastDistToTarget = distNow end
            end
        end)

        while tw.PlaybackState == Enum.PlaybackState.Playing and not lagbackTriggered and not Engine.IsHopping do
            task.wait(0.05)
        end
        monitorConn:Disconnect()

        if lagbackTriggered then
            pcall(function() tw:Cancel() end)
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.8)
        else
            if (hrp.Position - targetPos).Magnitude <= 8 then reached = true end
            break
        end
    end

    Engine.IsTweening = false
    return true
end

