local pT, pE, pG = 0, -1, -1
local function Poll()
    if os.clock() - pT > 0.8 then
        pT = os.clock()
        local p = Inv("CDKQuest", "Progress")
        if type(p) == "table" then pE, pG = tonumber(p.Evil) or -1, tonumber(p.Good) or -1 end
    end
    return pE, pG
end
local function QS(v)
    if v == -3 or v == -4 or v == -5 then return -v - 2, -v - 3 end
    return nil, math.min(math.max(v, 0), 3)
end

local function Dim(n)
    local d = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild(n)
    local sp, r = d and d:FindFirstChild("Spawn"), Root()
    if not (sp and r and (r.Position - sp.Position).Magnitude <= 1500) then return false end
    S.noAttack = false
    if Farm(sp.Position, 800, "Đang diệt quái trong " .. n) then return true end
    for _, x in ipairs(d:GetDescendants()) do
        if x:IsA("ProximityPrompt") and x.Enabled then
            if Go(x.Parent:GetPivot().Position, nil, "Đang thắp đuốc trong " .. n) then
                x.HoldDuration = 0
                pcall(fireproximityprompt, x)
                task.wait(0.4)
            end
            return true
        end
    end
    local e = d:FindFirstChild("Exit")
    if e then
        local pos = e:GetPivot().Position
        Go(pos, nil, "Đang thoát khỏi " .. n)
        r = Root()
        if r and S.Run then Float(false) r.CFrame = CF(pos) task.wait(0.5) if S.Run then Float(true) end end
    end
    return true
end

local function Haze(n)
    n = n:lower()
    local w = workspace:FindFirstChild("_WorldOrigin")
    for _, k in ipairs({ "EnemySpawns", "PlayerSpawns" }) do
        local f = w and w:FindFirstChild(k)
        for _, d in ipairs(f and f:GetDescendants() or {}) do
            if d:IsA("BasePart") and (d.Name:lower():find(n, 1, true) or d.Parent.Name:lower():find(n, 1, true)) then return d.Position end
        end
    end
end

local function Y1()
    S.noAttack = true
