local function GetCurrentPingMs()
    local ping = 0
    pcall(function()
        local netStats = Stats and Stats:FindFirstChild("Network")
        local ssi = netStats and netStats:FindFirstChild("ServerStatsItem")
        local dataPing = ssi and ssi:FindFirstChild("Data Ping")
        if dataPing then
            ping = math.floor(tonumber(dataPing:GetValue()) or 0)
        end
    end)
    if ping <= 0 then
        pcall(function()
            ping = math.floor((LocalPlayer:GetNetworkPing() or 0) * 1000)
        end)
    end
    return ping
end

