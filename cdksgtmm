ScanCrossContinentalBoss = function(bossPatterns)
    local containers = { workspace:FindFirstChild("Enemies"), workspace, ReplicatedStorage }
    for _, container in ipairs(containers) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                local lowName = child.Name:lower()
                for _, pat in ipairs(bossPatterns) do
                    local lowPat = pat:lower()
                    if lowName == lowPat or lowName:find(lowPat) then
                        local hum = child:FindFirstChildOfClass("Humanoid") or child:FindFirstChild("Humanoid")
                        local root = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Head") or child.PrimaryPart
                        local hp = hum and tonumber(hum.Health) or nil
                        local maxHp = hum and tonumber(hum.MaxHealth) or nil
                        if not hp or hp > 0 then
                            local isInWs = (container ~= ReplicatedStorage) and (root ~= nil)
                            return true, hp, maxHp, isInWs, child, root, hum
                        end
                    end
                end
            end
        end
    end
    return false, nil, nil, false, nil, nil, nil
end

local function ScanBossEntity(patterns)
    local act, _, _, _, child, root, hum = ScanCrossContinentalBoss(patterns)
    return act, child, root, hum
end

local CachedTikiBossKilled = nil
local LastTikiBossCheckTick = 0

local function CheckTikiBossKilled()
    if CachedTikiBossKilled == true then
        return true
    end
    local now = os.clock()
    -- Cache kết quả trong 10s tránh spam remote
    if CachedTikiBossKilled ~= nil and (now - LastTikiBossCheckTick < 10) then
        return CachedTikiBossKilled
    end
    LastTikiBossCheckTick = now

    local ok, res = pcall(function()
        local args = { "AskKilledTikiBoss" }
        local netMod = ReplicatedStorage:WaitForChild("Modules", 3)
        local net = netMod and netMod:WaitForChild("Net", 3)
        local rf = net and (net:FindFirstChild("RF/SubmarineWorkerSpeak") or net:WaitForChild("RF/SubmarineWorkerSpeak", 3))
        if rf then
            return rf:InvokeServer(unpack(args))
        end
        return false
    end)

    if ok and res == true then
        CachedTikiBossKilled = true
        return true
    elseif ok and res == false then
        CachedTikiBossKilled = false
        return false
    end
    return (CachedTikiBossKilled == true)
end

