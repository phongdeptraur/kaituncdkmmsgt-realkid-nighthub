local function Fly(pos, abort, desc)
    if not S.Run or S.RK or S.Main or S.FragFarm or S.Hopping then return false end
    local r, h = Root()
    if not r or not h or h.Health <= 0 then return false end
    StopTween()
    h.Sit = false
    Float(true)

    local snapCount = 0
    local snapPos = nil

    while S.Run and not S.RK and not S.Main and not S.FragFarm and not S.Hopping do
        r, h = Root()
        if not r or not h or h.Health <= 0 or (abort and abort()) then
            StopTween()
            return false
        end
        local d = (r.Position - pos).Magnitude
        if d <= 15 then
            r.CFrame = CF(pos)
            r.AssemblyLinearVelocity = V3()
            break
        end

        local flatLook = V3(pos.X, r.Position.Y, pos.Z)
        local targetCF = (flatLook - r.Position).Magnitude > 1 and CF(pos, pos + (flatLook - r.Position).Unit) or CF(pos)
        local g = r:FindFirstChild("AxG")
        if g then g.CFrame = targetCF end

        local tw = TweenService:Create(r, TweenInfo.new(d / SPEED, Enum.EasingStyle.Linear), { CFrame = CF(pos) })
        curTw = tw
        tw:Play()

        local lastDist = d
        local checkT = os.clock()
        local rubberbanded = false

        while S.Run and tw.PlaybackState == Enum.PlaybackState.Playing do
            task.wait(0.03)
            r, h = Root()
            if not S.Run or not r or not h or h.Health <= 0 or S.RK or S.Main or S.FragFarm or S.Hopping or (abort and abort()) then
                StopTween()
                return false
            end
            if S.noAttack then Unequip() end
            h.Sit = false
            r.AssemblyLinearVelocity = V3()
            r.AssemblyAngularVelocity = V3()
            local curDist = (r.Position - pos).Magnitude
            if desc then Say(("%s (còn %.0fm)"):format(desc, curDist)) end

            local dt = os.clock() - checkT
            if dt >= 0.25 then
                checkT = os.clock()
                local minProgress = math.max(12, SPEED * dt * 0.45)
                if curDist > 22 and (lastDist - curDist) < minProgress then
                    if snapPos and (r.Position - snapPos).Magnitude < 50 then
                        snapCount = snapCount + 1
                    else
                        snapPos = r.Position
                        snapCount = 1
                    end

                    if snapCount >= 4 then
                        StopTween()
                        -- Giữ nguyên Float(true) để treo nhân vật trên không, tuyệt đối không thả rơi tự do
                        Float(true)
                        r.AssemblyLinearVelocity = V3()
                        if not S.target then
                            Say("Bị giật vị trí -> Giữ vị trí & đồng bộ lại...")
                        end
                        local waitT = os.clock()
                        local holdDur = S.target and 0.15 or 0.4
                        while S.Run and os.clock() - waitT < holdDur do
                            if S.RK or S.Main or S.FragFarm or S.Hopping or (abort and abort()) then
                                return false
                            end
                            local crRoot = Root()
                            if crRoot then crRoot.AssemblyLinearVelocity = V3() end
                            task.wait(0.03)
                        end
                        snapCount = 0
                        snapPos = nil
                        r, h = Root()
                        if not S.Run or not r or not h or h.Health <= 0 or (abort and abort()) then
                            return false
                        end
                        h.Sit = false
                        Float(true)
                        rubberbanded = true
                        break
                    end
                elseif (lastDist - curDist) >= minProgress then
                    snapCount = 0
                    snapPos = nil
                end
                lastDist = curDist
            end
        end

        if curTw == tw then curTw = nil end

        if not rubberbanded then
            r = Root()
            if S.Run and r and (r.Position - pos).Magnitude <= 25 then
                r.CFrame = CF(pos)
                r.AssemblyLinearVelocity = V3()
            end
            break
        end
    end
    return S.Run
end

-- Thoát khỏi Cursed Ship (Sea 2) và Submerged Island (Sea 3) trước khi Tween hoặc bật RealKid
local function EscapeZones(targetPos, abort)
    local r = Root()
    if not r or not S.Run or S.Hopping then return false end
    -- Sea 2: Đang ở trong Cursed Ship (xung quanh 4000 stud điểm 909.51, 125.37, 32864.02)
    if Sea() == 2 and (r.Position - P.Ship).Magnitude <= 4000 then
        if not targetPos or (targetPos - P.Ship).Magnitude > 4000 then
            if Fly(P.Ship, abort, "Đang tới cửa rời Cursed Ship") then
                pcall(function()
                    local v = (type(vector) == "table" and type(vector.create) == "function")
                        and vector.create(-6508.55810546875, 89.03500366210938, -132.83999633789062)
                        or P.ShipOut
                    RS:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer("requestEntrance", v)
                end)
                task.wait(1.2)
            else
                return false
            end
        end
    end
    -- Sea 3: Đang ở dưới Submerged Island (xung quanh 3000 stud điểm 11279.25, -2138.93, 9873.44)
    r = Root()
    if r and Sea() == 3 and (r.Position - P.Sub).Magnitude <= 3000 then
        if not targetPos or (targetPos - P.Sub).Magnitude > 3000 then
            if Fly(P.SubTp, abort, "Đang ra tàu ngầm rời Submerged Island") then
                pcall(function()
                    RS:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RF/SubmarineTransportation"):InvokeServer("InitiateTeleport", "Tiki Outpost")
                end)
                task.wait(1.5)
            else
                return false
            end
        end
    end
    return true
end

-- Smart Portal 2 chiều: tính cả lộ trình 1 cổng và 2 cổng liên tiếp (Mansion <-> Castle <-> Hydra)
local EDGES = {}
for _, p in ipairs(PORTALS) do
    EDGES[#EDGES + 1] = { g = p[1], e = p[2], rq = p[4] }
    EDGES[#EDGES + 1] = { g = p[2], e = p[1], rq = p[3] }
end

local function Go(pos, abort, desc)
    local r = Root()
    if not r or not S.Run or S.RK or S.Main or S.FragFarm or S.Hopping then return false end
    if not EscapeZones(pos, abort) then return false end
    for _ = 1, 2 do
        r = Root()
        if not r or not S.Run or (abort and abort()) then return false end
        local direct = (r.Position - pos).Magnitude
        if direct < 1200 or Sea() ~= 3 or not Has("Valkyrie Helm") then break end
        local bestU, bt = nil, direct - 600
        for _, u in ipairs(EDGES) do
            local d1 = (r.Position - u.g).Magnitude + (u.e - pos).Magnitude
            if d1 < bt then bestU, bt = u, d1 end
            for _, v in ipairs(EDGES) do
                local d2 = (r.Position - u.g).Magnitude + (u.e - v.g).Magnitude + (v.e - pos).Magnitude
                if d2 < bt then bestU, bt = u, d2 end
            end
        end
        if not bestU then break end
        if not Fly(bestU.g + V3(0, 2, 0), abort, "Đang vào cổng gần nhất") then return false end
        for _ = 1, 5 do
            if not S.Run or (abort and abort()) then return false end
            local c = Root()
            if not c or (c.Position - bestU.g).Magnitude > 250 then break end
            Float(false)
            c.CFrame = CF(bestU.g)
            Inv("requestEntrance", bestU.rq)
            Inv("requestEntrance", bestU.e)
            task.wait(0.25)
        end
        if S.Run then Float(true) end
    end
    return Fly(pos, abort, desc or "Đang di chuyển")
end

