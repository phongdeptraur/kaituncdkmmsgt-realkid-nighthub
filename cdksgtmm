                    RS:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RF/SubmarineTransportation"):InvokeServer("InitiateTeleport", "Tiki Outpost")
                end)
                task.wait(1.5)
            else
                return false
            end
        end
    end
    return true
end

-- Smart Portal 2 chiều: tính cả lộ trình 1 cổng và 2 cổng liên tiếp (Mansion <-> Castle <-> Hydra)
local EDGES = {}
for _, p in ipairs(PORTALS) do
    EDGES[#EDGES + 1] = { g = p[1], e = p[2], rq = p[4] }
    EDGES[#EDGES + 1] = { g = p[2], e = p[1], rq = p[3] }
end

local function Go(pos, abort, desc)
    local r = Root()
    if not r or not S.Run or S.RK or S.Main or S.FragFarm or S.Hopping then return false end
    if not EscapeZones(pos, abort) then return false end
    for _ = 1, 2 do
        r = Root()
        if not r or not S.Run or (abort and abort()) then return false end
        local direct = (r.Position - pos).Magnitude
        if direct < 1200 or Sea() ~= 3 or not Has("Valkyrie Helm") then break end
        local bestU, bt = nil, direct - 600
        for _, u in ipairs(EDGES) do
            local d1 = (r.Position - u.g).Magnitude + (u.e - pos).Magnitude
            if d1 < bt then bestU, bt = u, d1 end
            for _, v in ipairs(EDGES) do
                local d2 = (r.Position - u.g).Magnitude + (u.e - v.g).Magnitude + (v.e - pos).Magnitude
                if d2 < bt then bestU, bt = u, d2 end
            end
        end
        if not bestU then break end
        if not Fly(bestU.g + V3(0, 2, 0), abort, "Đang vào cổng gần nhất") then return false end
        for _ = 1, 5 do
            if not S.Run or (abort and abort()) then return false end
            local c = Root()
            if not c or (c.Position - bestU.g).Magnitude > 250 then break end
            Float(false)
            c.CFrame = CF(bestU.g)
            Inv("requestEntrance", bestU.rq)
            Inv("requestEntrance", bestU.e)
            task.wait(0.25)
        end
        if S.Run then Float(true) end
    end
    return Fly(pos, abort, desc or "Đang di chuyển")
end

