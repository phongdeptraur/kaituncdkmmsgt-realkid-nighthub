-- [ALUCARD FRAGMENT SCANNER] Throttled Inventory Material Reader (1.5s Cache)
-- =========================================================================
local _lastAlucardScan = 0
local _cachedAlucardCount = 0
local function GetAlucardFragmentCount(force)
    local now = tick()
    if not force and (now - _lastAlucardScan < 1.5) then
        return _cachedAlucardCount
    end
    _lastAlucardScan = now
    pcall(function()
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF then
            local inv = commF:InvokeServer("getInventory")
            if type(inv) == "table" then
                local found = 0
                for _, item in ipairs(inv) do
                    if type(item) == "table" then
                        local iName = item.Name or item.name
                        if iName == "Alucard Fragment" then
                            found = tonumber(item.Count or item.count or item.Value or item.value or 1) or 1
                            break
                        end
                    end
                end
                _cachedAlucardCount = found
            end
        end
    end)
    return _cachedAlucardCount
end

