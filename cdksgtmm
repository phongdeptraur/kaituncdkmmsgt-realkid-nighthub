-- =========================================================================
local function ScanCrossContinentalBoss(bossPatterns)
    local containers = {
        workspace:FindFirstChild("Enemies"),
        workspace,
        ReplicatedStorage
    }

    for _, container in ipairs(containers) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                local lowName = child.Name:lower()
                for _, pat in ipairs(bossPatterns) do
                    local lowPat = pat:lower()
                    if lowName == lowPat or lowName:find(lowPat) then
                        local hum = child:FindFirstChildOfClass("Humanoid") or child:FindFirstChild("Humanoid")
                        local root = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Head") or child.PrimaryPart

                        local hp = nil
                        local maxHp = nil
                        if hum then
                            hp = tonumber(hum.Health)
                            maxHp = tonumber(hum.MaxHealth)
                        end

                        if not hp or hp > 0 then
                            local isInWorkspace = (container ~= ReplicatedStorage) and (root ~= nil)
                            return true, hp, maxHp, isInWorkspace, child, root, hum
                        end
                    end
                end
            end
        end
    end

    for _, pat in ipairs(bossPatterns) do
        local inRS = ReplicatedStorage:FindFirstChild(pat)
        if inRS then
            local hum = inRS:FindFirstChildOfClass("Humanoid") or inRS:FindFirstChild("Humanoid")
            return true, hum and hum.Health, hum and hum.MaxHealth, false, inRS, nil, hum
        end
        local enemies = workspace:FindFirstChild("Enemies")
        local inEnemies = enemies and enemies:FindFirstChild(pat)
        if inEnemies then
            local hum = inEnemies:FindFirstChildOfClass("Humanoid") or inEnemies:FindFirstChild("Humanoid")
            local root = inEnemies:FindFirstChild("HumanoidRootPart") or inEnemies:FindFirstChild("Head") or inEnemies.PrimaryPart
            return true, hum and hum.Health, hum and hum.MaxHealth, true, inEnemies, root, hum
        end
    end

    return false, nil, nil, false, nil, nil, nil
end

local function GetBossPercentageStatus(bossPatterns)
    local active, hp, maxHp, inWs, model, root, hum = ScanCrossContinentalBoss(bossPatterns)
    if not active then
        return false, "Status: ❌", nil, nil, nil
    end

    if hp and maxHp and maxHp > 0 then
        local pct = math.clamp(math.floor((hp / maxHp) * 100), 0, 100)
        return true, string.format("Status: ✅ [%d%%]", pct), model, root, hum
    end

    return true, "Status: ✅ [100%]", model, root, hum
end

