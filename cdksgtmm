-- =========================================================================
local function ResolveHazeIslandCFrame(islandOrMobName: string): CFrame?
    local nameLower = islandOrMobName:lower()

    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    if worldOrigin then
        local enemySpawns = worldOrigin:FindFirstChild("EnemySpawns")
        if enemySpawns then
            for _, spawnPart in ipairs(enemySpawns:GetChildren()) do
                if string.find(spawnPart.Name:lower(), nameLower) and spawnPart:IsA("BasePart") then
                    return spawnPart.CFrame
                end
            end
        end

        local playerSpawns = worldOrigin:FindFirstChild("PlayerSpawns")
        if playerSpawns then
            for _, teamFolder in ipairs(playerSpawns:GetChildren()) do
                for _, spawnModel in ipairs(teamFolder:GetChildren()) do
                    if string.find(spawnModel.Name:lower(), nameLower) then
                        local part = spawnModel:FindFirstChildWhichIsA("BasePart", true)
                        if part then return part.CFrame end
                    end
                end
            end
        end
    end

    for _, child in ipairs(ReplicatedStorage:GetChildren()) do
        if string.find(child.Name:lower(), nameLower) then
            local part = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChildWhichIsA("BasePart", true)
            if part and part:IsA("BasePart") and part.Position.Magnitude > 100 then
                return part.CFrame
            end
        end
    end

    for nodeName, pos in pairs(VERIFIED_ISLAND_NODES) do
        if string.find(nameLower, nodeName:lower()) or string.find(nodeName:lower(), nameLower) then
            return CFrame.new(pos)
        end
    end

    return nil
end

