            if hum then hum:UnequipTools() end
        end)
        return
    end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local hitList = {}
    local primaryTargetHead = nil

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, mob in ipairs(enemiesFolder:GetChildren()) do
            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            if mob ~= char and mobRoot and mobHum and mobHum.Health > 0 then
                if (root.Position - mobRoot.Position).Magnitude <= Engine.AttackRadius then
                    table.insert(hitList, mob)
                    if not primaryTargetHead and mob:FindFirstChild("Head") then primaryTargetHead = mob.Head end
                end
            end
