    -- QUY TẮC YAMA 1: TỰ ĐỘNG THÁO VŨ KHÍ & NGỪNG ĐÁNH ĐỂ TANK QUÁI TỤT MÁU
    if Engine.ActiveCDKMode == "Yama1" then
