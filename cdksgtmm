local function CheckPlayerNear(radius)
    radius = radius or MASTERY_NEAR_RADIUS
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false, nil, 0 end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local pHum = p.Character:FindFirstChildOfClass("Humanoid")
            if pRoot and pHum and pHum.Health > 0 then
                local dist = (pRoot.Position - myRoot.Position).Magnitude
                if dist <= radius then return true, p.DisplayName or p.Name, dist end
            end
        end
    end
    return false, nil, 0
end

local function isDealerVisited(pos)
    for _, vPos in ipairs(Engine.VisitedDealers) do
        if (pos - vPos).Magnitude <= 150 then return true end
    end
    return false
end

local function findClosestUnvisitedBoatDealer()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = root and root.Position or Vector3.zero
    local candidates = {}
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        for _, npc in ipairs(npcs:GetChildren()) do
            if npc:IsA("Model") and string.find(npc.Name:lower(), "boat dealer") and not string.find(npc.Name:lower(), "luxury") then
                local nRoot = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart")
                if nRoot and not isDealerVisited(nRoot.Position) then
                    table.insert(candidates, { Model = npc, Position = nRoot.Position, Distance = (nRoot.Position - myPos).Magnitude })
                end
            end
        end
    end
    for _, dockPos in ipairs(DOCK_ANCHOR_NODES) do
        if not isDealerVisited(dockPos) then
            local rep = false
            for _, c in ipairs(candidates) do
                if (c.Position - dockPos).Magnitude <= 180 then rep = true; break end
            end
            if not rep then
                table.insert(candidates, { Model = nil, Position = dockPos, Distance = (dockPos - myPos).Magnitude })
            end
        end
    end
    table.sort(candidates, function(a, b) return a.Distance < b.Distance end)
    return candidates[1]
end

