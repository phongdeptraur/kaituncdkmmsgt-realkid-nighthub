local function ExecuteBoneFarmForSword(swordName, currentMastery)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    EquipSpecificSword(swordName)

    local targetMob = nil
    local shortestDist = math.huge
    local enemiesFolder = workspace:FindFirstChild("Enemies")

    if enemiesFolder then
        for _, mob in ipairs(enemiesFolder:GetChildren()) do
            local mHum = mob:FindFirstChildOfClass("Humanoid")
            local mRoot = mob:FindFirstChild("HumanoidRootPart")
            if mRoot and mHum and mHum.Health > 0 and table.find(BONE_NPCS, mob.Name) then
                local d = (hrp.Position - mRoot.Position).Magnitude
                if d < shortestDist then
                    shortestDist = d
                    targetMob = mob
                end
            end
        end
    end

    if targetMob and targetMob:FindFirstChild("HumanoidRootPart") and targetMob:FindFirstChildOfClass("Humanoid") then
        TakeHauntedBoneQuest(targetMob.Name)

        local mPos = targetMob.HumanoidRootPart.Position + Vector3.new(0, 14, 0)
        local distToMob = (hrp.Position - mPos).Magnitude

        if distToMob > 60 then
            TweenToPosition(mPos, 240)
        else
            hrp.CFrame = CFrame.new(mPos, targetMob.HumanoidRootPart.Position)
            BringNearbyMobs(targetMob.HumanoidRootPart.CFrame, targetMob.Name, 3)
            EnsureBuso()
        end
    else
        if (hrp.Position - POS_HAUNTED_CASTLE).Magnitude > 80 then
            lblStatus.Text = string.format("Trạng thái: 🏰 Bay về Haunted Castle cày [%s: %d/350]...", swordName, currentMastery)
            TweenToPosition(POS_HAUNTED_CASTLE, 240)
        end
    end
end

