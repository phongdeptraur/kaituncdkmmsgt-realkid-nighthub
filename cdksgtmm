        CachedCDKStatus.YamaDone = true
        CachedCDKStatus.TushitaDone = true
        CachedCDKStatus.AllDone = true
        CachedCDKStatus.ReadyBoss = true
        CachedCDKStatus.TotalCompleted = 6
        CachedCDKStatus.SyncSource = "Inventory Verified"
        CachedCDKStatus.Summary = "👑 ĐÃ HOÀN TẤT VÀ SỞ HỮU CURSED DUAL KATANA!"
        return CachedCDKStatus
    end

    CachedCDKStatus.DoorBroken = true
    pcall(function()
        local cursedMap = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Turtle") and workspace.Map.Turtle:FindFirstChild("Cursed")
        if cursedMap and cursedMap:FindFirstChild("Breakable") then
            CachedCDKStatus.DoorBroken = false
        end
    end)

    pcall(function()
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF then
            local doorProgress = commF:InvokeServer("CDKQuest", "OpenDoor")
            if doorProgress == "can" or doorProgress == true or fragments >= 6 then
                CachedCDKStatus.DoorStatus = "Ready to Open"
            else
                CachedCDKStatus.DoorStatus = CachedCDKStatus.DoorBroken and "Door Opened" or "Blocked / Incomplete"
            end
        end
    end)

    local rawEvil = 0
    local rawGood = 0
    pcall(function()
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF then
            local data = commF:InvokeServer("CDKQuest", "Progress")
            if typeof(data) ~= "table" then data = commF:InvokeServer("CDKQuest") end

            if typeof(data) == "table" then
                rawEvil = tonumber(data.Evil or data.evil or data.Yama or 0) or (data.Evil == true and 3) or 0
                rawGood = tonumber(data.Good or data.good or data.Tushita or 0) or (data.Good == true and 3) or 0
            end
        end
    end)

    CachedCDKStatus.RawEvil = rawEvil
    CachedCDKStatus.RawGood = rawGood

    local evilDone = 0
    local goodDone = 0

    if rawEvil >= 3 then evilDone = 3
    elseif rawEvil == 2 or rawEvil == -5 then evilDone = 2
    elseif rawEvil == 1 or rawEvil == -4 then evilDone = 1 end

    if rawGood >= 3 then goodDone = 3
    elseif rawGood == 2 or rawGood == -5 then goodDone = 2
    elseif rawGood == 1 or rawGood == -4 then goodDone = 1 end

    local totalProgress = math.clamp(math.max(evilDone + goodDone, fragments), 0, 6)

    if totalProgress >= 6 then
        evilDone = 3
        goodDone = 3
    elseif totalProgress == 5 then
        if evilDone >= 3 then
            goodDone = 2
        elseif goodDone >= 3 then
            evilDone = 2
        else
            evilDone = 3
            goodDone = 2
        end
    elseif totalProgress == 4 then
        if evilDone >= 3 then
            goodDone = 1
        elseif goodDone >= 2 then
            evilDone = 2
        else
            evilDone = 3
            goodDone = 1
        end
    elseif totalProgress == 3 then
        if goodDone > 0 then
            evilDone = math.max(0, 3 - goodDone)
        else
            evilDone = 3
            goodDone = 0
        end
    elseif totalProgress == 2 then
        if goodDone > 0 then
            evilDone = math.max(0, 2 - goodDone)
        else
            evilDone = 2
            goodDone = 0
        end
    elseif totalProgress == 1 then
        if goodDone > 0 then
            evilDone = 0
        else
            evilDone = 1
        end
    end

    CachedCDKStatus.TotalCompleted = totalProgress
    CachedCDKStatus.evilDone = evilDone
    CachedCDKStatus.goodDone = goodDone

    CachedCDKStatus.Yama1 = (evilDone >= 1)
    CachedCDKStatus.Yama2 = (evilDone >= 2)
    CachedCDKStatus.Yama3 = (evilDone >= 3)
    CachedCDKStatus.YamaPedestalBurned = (rawEvil >= 4 or (evilDone >= 3 and totalProgress >= 6))

    if evilDone == 0 then CachedCDKStatus.CurrentYamaTrial = "Trial 1: Pain & Suffering"
    elseif evilDone == 1 then CachedCDKStatus.CurrentYamaTrial = "Trial 2: Haze of Misery"
    elseif evilDone == 2 then CachedCDKStatus.CurrentYamaTrial = "Trial 3: Fear the Reaper"
    elseif CachedCDKStatus.YamaPedestalBurned then CachedCDKStatus.CurrentYamaTrial = "Hoàn thành 100% cuộn Yama"
    else CachedCDKStatus.CurrentYamaTrial = "Đã xong 3 Trial (Chờ đốt bệ)" end

    CachedCDKStatus.Tushita1 = (goodDone >= 1)
    CachedCDKStatus.Tushita2 = (goodDone >= 2)
    CachedCDKStatus.Tushita3 = (goodDone >= 3)
    CachedCDKStatus.TushitaPedestalBurned = (rawGood >= 4 or (goodDone >= 3 and totalProgress >= 6))

    if goodDone == 0 then CachedCDKStatus.CurrentTushitaTrial = "Trial 1: Dokkan"
    elseif goodDone == 1 then CachedCDKStatus.CurrentTushitaTrial = "Trial 2: With the Wind (Raid)"
    elseif goodDone == 2 then CachedCDKStatus.CurrentTushitaTrial = "Trial 3: Soulless (Cake Queen)"
    elseif CachedCDKStatus.TushitaPedestalBurned then CachedCDKStatus.CurrentTushitaTrial = "Hoàn thành 100% cuộn Tushita"
    else CachedCDKStatus.CurrentTushitaTrial = "Đã xong 3 Trial (Chờ đốt bệ)" end

    CachedCDKStatus.YamaDone = (evilDone >= 3)
    CachedCDKStatus.TushitaDone = (goodDone >= 3)
    CachedCDKStatus.AllDone = (evilDone >= 3 and goodDone >= 3)
    CachedCDKStatus.ReadyBoss = (CachedCDKStatus.YamaPedestalBurned and CachedCDKStatus.TushitaPedestalBurned) or (totalProgress >= 6)

    if CachedCDKStatus.ReadyBoss then
        CachedCDKStatus.Summary = string.format("🟢 Sẵn sàng diệt Boss CDK! [%d/6 Mảnh Alucard]", fragments)
    elseif CachedCDKStatus.AllDone then
        CachedCDKStatus.Summary = string.format("🟡 Xong 6 Trial! Đang đốt 2 bệ [%d/6 Mảnh Alucard]", fragments)
    else
        CachedCDKStatus.Summary = string.format("⚔️ Xong: %d/6 [%d Mảnh Alucard] | Yama: [%d/3] | Tushita: [%d/3]", totalProgress, fragments, evilDone, goodDone)
    end

    return CachedCDKStatus
end

