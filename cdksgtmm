local function LoadIgnoredJobs()
    local ignored = {}
    local now = os.time()
    local myUid = tostring(LP.UserId)

    local function addJob(id)
        if type(id) == "string" then
            local s = id:match("^%s*(.-)%s*$")
            if #s >= 20 and s:find("-", 1, true) then ignored[s] = true end
        end
    end

    local activeClaims = ReadActiveTTLClaims()
    for jid, info in pairs(activeClaims) do
        if info.userId ~= myUid and info.name ~= LP.Name then
            addJob(jid)
        end
    end

    local function parseData(dt, isTTLFile)
        if type(dt) == "table" then
            if type(dt.VisitedJobs) == "table" then
                for k, v in pairs(dt.VisitedJobs) do if v then addJob(k) end end
            end
            for _, k in ipairs({ "jobIds", "jobs", "servers", "JobIds", "Visited", "visited", "blacklisted", "anti" }) do
                if type(dt[k]) == "table" then
                    for _, v in pairs(dt[k]) do addJob(type(v) == "table" and (v.id or v.JobId) or v) end
                end
            end
            for k, v in pairs(dt) do
                if type(v) == "table" then
                    local ts = tonumber(v.time or v.ts or v.timestamp or v.lastUpdate)
                    local uid = tostring(v.userId or v.uid or v.user or "")
                    if ts then
                        if (now - ts) <= BONES_TTL and uid ~= myUid and tostring(v.name or "") ~= LP.Name then
                            addJob(k)
                            addJob(v.id or v.JobId)
                        end
                    else
                        addJob(k)
                        addJob(v.id or v.JobId)
                    end
                elseif type(v) == "number" then
                    if v > 1700000000 then
                        local ttlLimit = isTTLFile and BONES_TTL or 300
                        if (now - v) <= ttlLimit then addJob(k) end
                    else
                        addJob(k)
                    end
                elseif type(v) == "boolean" and v then
                    addJob(k)
                elseif type(v) == "string" then
                    addJob(k)
                    addJob(v)
                end
            end
        elseif type(dt) == "string" and not isTTLFile then
            for jid in dt:gmatch("[%w%-%_]+") do
                if #jid >= 20 and jid:find("-", 1, true) then addJob(jid) end
            end
        end
    end

    if BASE and type(BASE.VisitedJobs) == "table" then
        for k, v in pairs(BASE.VisitedJobs) do if v then addJob(k) end end
    end

    local checkFiles = {
        VF,
        "RealKidHop_" .. tostring(LP.UserId) .. ".json",
        "RealKidHop_Visited.json",
        "RealKid_Visited.json",
        "RealKidHub/visited.json",
        "RealKidHub/jobid.json",
        "RealKidHub/bones.json",
        "RealKidHub/anti_collision.json",
        "RealKidHub/anticollision.json",
        "RealKidHub/anti_colocation.json",
        "anti_collision.json",
        "anticollision.json",
        "anti_colocation.json",
        "anti_server.json",
        "anti_job.json",
        "bones_job.json",
        "bones_visited.json",
        "Bones_Visited.json",
        "BonesProgress/visited.json",
        "BonesProgress/jobid.json",
        "FarmBones/visited.json",
        "FarmBones/jobid.json",
        "bones.json",
        "Bones.json",
        "collision.json",
        "server_visited.json",
        "visited_servers.json",
        "visited.json",
        "jobids.json"
    }

    for _, path in ipairs(checkFiles) do
        pcall(function()
            if isfile and isfile(path) then
                local raw = readfile(path)
                local ok, dt = pcall(HttpService.JSONDecode, HttpService, raw)
                local isTTL = path:lower():find("bone", 1, true) or path:lower():find("colli", 1, true) or path:lower():find("anti", 1, true)
                if ok and dt then parseData(dt, isTTL) else parseData(raw, isTTL) end
            end
        end)
    end

    pcall(function()
        if type(listfiles) == "function" then
            for _, folder in ipairs({ "CDKProgress", "RealKidHub", "BonesProgress", "FarmBones" }) do
                if isfolder and isfolder(folder) then
                    for _, fp in ipairs(listfiles(folder)) do
                        local lfp = fp:lower()
                        if lfp:find("bone", 1, true) or lfp:find("colli", 1, true) or lfp:find("visit", 1, true) or lfp:find("anti", 1, true) or lfp:find("job", 1, true) then
                            pcall(function()
                                local raw = readfile(fp)
                                local ok, dt = pcall(HttpService.JSONDecode, HttpService, raw)
                                local isTTL = lfp:find("bone", 1, true) or lfp:find("colli", 1, true) or lfp:find("anti", 1, true) or lfp:find("ttl", 1, true)
                                if ok and dt then parseData(dt, isTTL) else parseData(raw, isTTL) end
                            end)
                        end
                    end
                end
            end
        end
    end)

    return ignored
end

