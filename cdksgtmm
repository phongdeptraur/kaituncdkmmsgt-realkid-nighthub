    if Engine.HasPreTweenedIndra then
        return true
    end

    while Engine.IsRunning and not Engine.IsHopping do
        if bossPatterns and ScanBossEntity(bossPatterns) then
            return false
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hrp and hum and hum.Health > 0 then
            local dist = (hrp.Position - POS_PRE_HOP_INDRA).Magnitude
            if dist <= 50 then
                Engine.HasPreTweenedIndra = true
                if Engine.StatusLabel then
                    Engine.StatusLabel.Text = string.format("Trạng thái: ✅ Đã Pre-Tween đến điểm chờ Indra (Cách: %.0f)! Sẵn sàng Hop Indra...", dist)
                end
                return true
            end

            if Engine.StatusLabel then
