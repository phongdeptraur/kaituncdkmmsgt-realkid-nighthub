local function ProcessCDKPipeline(cdkProg, timeDisplay)
    if not cdkProg then return end
    RenderCDKQuestLabels(cdkProg)

    local desiredStage = nil
    local desiredHub = "RealKid"
    local desiredConfig = nil

    if not cdkProg.YamaDone then
        Engine.CDKBossStartTime = nil
        if cdkProg.evilDone == 0 then
            desiredStage = "Yama1"
            desiredHub = "RealKid"
            desiredConfig = REALKID_CONFIG_YAMA_BASE
            lblCDKBoss.Text = "👑 Cursed Skeleton Boss: ⚪ Đang làm Yama 1: Pain & Suffering..."
            lblCDKBoss.TextColor3 = Color3.fromRGB(180, 190, 200)
            lblStatus.Text = string.format("Trạng thái: 🛡️ [GIAI ĐOẠN 1: YAMA 1] TỰ ĐỘNG THÁO VŨ KHÍ & ĐỨNG TANK QUÁI (Tụt dưới 15%% HP)... %s", timeDisplay)
            
            -- TỰ ĐỘNG THÁO SẠCH VŨ KHÍ KHI LÀM YAMA 1
            pcall(function()
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum:UnequipTools() end
            end)
        elseif cdkProg.evilDone == 1 then
            desiredStage = "Yama2"
            desiredHub = "RealKid"
            desiredConfig = REALKID_CONFIG_YAMA_BASE
            lblCDKBoss.Text = "👑 Cursed Skeleton Boss: ⚪ Đang làm Yama 2: Haze of Misery..."
            lblCDKBoss.TextColor3 = Color3.fromRGB(180, 190, 200)
            lblStatus.Text = string.format("Trạng thái: ⚔️ [GIAI ĐOẠN 1: YAMA 2] RealKid đang làm Haze of Misery (Lùng chém quái chấm tím)... %s", timeDisplay)
        else
            desiredStage = "Yama3"
            desiredHub = "RealKid"
            desiredConfig = REALKID_CONFIG_YAMA_HOP
            lblCDKBoss.Text = "👑 Cursed Skeleton Boss: ⚪ Đang làm Yama 3: Fear the Reaper (Hop Săn Soul Reaper)..."
            lblCDKBoss.TextColor3 = Color3.fromRGB(255, 215, 0)
            lblStatus.Text = string.format("Trạng thái: ⚔️ [GIAI ĐOẠN 1: YAMA 3] RealKid đang làm Fear the Reaper (Tự Hop Săn Soul Reaper & Hell)... %s", timeDisplay)
        end
    elseif not cdkProg.TushitaDone then
        Engine.CDKBossStartTime = nil
        if cdkProg.goodDone == 0 then
            desiredStage = "Tushita1"
            desiredHub = "RealKid"
            desiredConfig = REALKID_CONFIG_TUSHITA
            lblCDKBoss.Text = "👑 Cursed Skeleton Boss: ⚪ Yama ĐÃ XONG! Đang làm Tushita 1: Dokkan..."
            lblCDKBoss.TextColor3 = Color3.fromRGB(180, 190, 200)
            lblStatus.Text = string.format("Trạng thái: ⚔️ [GIAI ĐOẠN 2: TUSHITA 1] Yama ĐÃ XONG! RealKid đang nói chuyện 3 Thuyền Trưởng... %s", timeDisplay)
        elseif cdkProg.goodDone == 1 then
            desiredStage = "Tushita2"
            desiredHub = "DualHub"
            desiredConfig = REALKID_CONFIG_TUSHITA
            lblCDKBoss.Text = "👑 Cursed Skeleton Boss: ⚪ Đang làm Tushita 2 (Night Hub + RealKid Auto Tushita)..."
            lblCDKBoss.TextColor3 = Color3.fromRGB(255, 140, 50)
            lblStatus.Text = string.format("Trạng thái: 🏰 [GIAI ĐOẠN 2: TUSHITA 2] Chạy ĐỒNG THỜI Night Hub (1 lần) & RealKid chờ Castle Pirate Raid... %s", timeDisplay)
        else
            desiredStage = "Tushita3"
            desiredHub = "RealKid"
            desiredConfig = REALKID_CONFIG_TUSHITA

            local inHeaven = IsInHeavenlyDimension()
            local cqModel, cqHum = ScanEntityMobFuzzy("cake queen")
            local isCakeQueenAlive = (cqModel and cqHum and cqHum.Health > 0)

            if inHeaven then
                Tushita3Controller.WaitingForHeavenly = false
                Tushita3Controller.CakeQueenSeen = false
                lblCDKBoss.Text = "👑 Cursed Skeleton Boss: 🟢 ĐANG Ở HEAVENLY DIMENSION! Đang hoàn thành bệ Tushita..."
                lblCDKBoss.TextColor3 = Color3.fromRGB(80, 255, 140)
                lblStatus.Text = "Trạng thái: 🍰 ĐÃ VÀO HEAVENLY DIMENSION! RealKid đang xử lý quái & thắp đuốc nhận mảnh thứ 6..."
            elseif Tushita3Controller.WaitingForHeavenly then
                local elapsedWait = os.clock() - Tushita3Controller.WaitStartTime
                local remainWait = math.max(0, 5 - math.floor(elapsedWait))
                lblCDKBoss.Text = string.format("👑 Cursed Skeleton Boss: ⏳ Đã hạ Cake Queen! Chờ dịch chuyển (%ds/5s)...", math.floor(elapsedWait))
                lblCDKBoss.TextColor3 = Color3.fromRGB(255, 215, 0)
                lblStatus.Text = string.format("Trạng thái: 🍰 Đã hạ Cake Queen! Đang đếm ngược %d giây để kiểm tra Heavenly Dimension...", remainWait)

                if elapsedWait >= 5 then
                    if IsInHeavenlyDimension() then
                        Tushita3Controller.WaitingForHeavenly = false
                        lblStatus.Text = "Trạng thái: 🟢 Đã xác nhận vào Heavenly Dimension thành công!"
                    else
                        Tushita3Controller.WaitingForHeavenly = false
                        lblStatus.Text = "Trạng thái: ⚠️ Hết 5s sau khi hạ Cake Queen mà KHÔNG vào Heavenly Dimension! Hop Low Server..."
                        Engine:HopLowServer()
                    end
                end
            else
                if isCakeQueenAlive then
                    Tushita3Controller.CakeQueenSeen = true
                    local hpPct = math.floor((cqHum.Health / cqHum.MaxHealth) * 100)
                    lblCDKBoss.Text = string.format("👑 Cursed Skeleton Boss: ⚪ Phát hiện Cake Queen (%d%% HP)! RealKid đang áp sát tiêu diệt...", hpPct)
                    lblCDKBoss.TextColor3 = Color3.fromRGB(255, 180, 210)
                    lblStatus.Text = string.format("Trạng thái: 🍰 [TUSHITA 3] Phát hiện Cake Queen (%d%% HP)! Đang đánh để kích hoạt Heavenly Dimension... %s", hpPct, timeDisplay)
                else
                    if Tushita3Controller.CakeQueenSeen then
                        Tushita3Controller.CakeQueenSeen = false
                        Tushita3Controller.WaitingForHeavenly = true
                        Tushita3Controller.WaitStartTime = os.clock()
                        lblStatus.Text = "Trạng thái: 🍰 Cake Queen đã bị tiêu diệt! Bắt đầu chờ 5s để dịch chuyển vào Heavenly Dimension..."
                    else
                        lblCDKBoss.Text = "👑 Cursed Skeleton Boss: 🔴 Server không có Cake Queen! Đang Hop Low Server..."
                        lblCDKBoss.TextColor3 = Color3.fromRGB(255, 100, 100)
                        lblStatus.Text = "Trạng thái: 🍰 [TUSHITA 3] Quét 1 lần: Server KHÔNG CÓ Cake Queen & KHÔNG ở Heavenly Dimension -> Hop Low Server tìm boss!"
                        Engine:HopLowServer()
                    end
                end
            end
        end
    else
        desiredStage = "CDKBoss"
        desiredHub = "RealKid"
        desiredConfig = REALKID_CONFIG_BOSS

        Tushita3Controller.WaitingForHeavenly = false
        Tushita3Controller.CakeQueenSeen = false

        if not Engine.CDKBossStartTime then
            Engine.CDKBossStartTime = os.clock()
        end

        local elapsedBossWait = os.clock() - Engine.CDKBossStartTime
        local remainBossHop = math.max(0, 240 - math.floor(elapsedBossWait))
        local mRemain = math.floor(remainBossHop / 60)
        local sRemain = math.floor(remainBossHop % 60)

        if cdkProg.ReadyBoss then
            lblCDKBoss.Text = string.format("👑 Cursed Skeleton Boss: 🟢 ĐÃ ĐỐT 2 BỆ! Diệt Boss CDK (Hop sau: %02d:%02d)", mRemain, sRemain)
            lblCDKBoss.TextColor3 = Color3.fromRGB(80, 255, 140)
            lblStatus.Text = string.format("Trạng thái: 👑 ĐÃ XONG 6 TRIAL & ĐỐT 2 BỆ! RealKid đang triệu hồi diệt Boss CDK [Đã chờ %ds/240s]... %s", math.floor(elapsedBossWait), timeDisplay)
        else
            lblCDKBoss.Text = string.format("👑 Cursed Skeleton Boss: 🟡 XONG 6 TRIAL! Đang đốt 2 bệ (Hop sau: %02d:%02d)", mRemain, sRemain)
            lblCDKBoss.TextColor3 = Color3.fromRGB(255, 215, 0)
            lblStatus.Text = string.format("Trạng thái: ⚔️ ĐÃ XONG 6/6 TRIAL! Đang đốt 2 bệ [Đã chờ %ds/240s]... %s", math.floor(elapsedBossWait), timeDisplay)
        end

        if elapsedBossWait >= 240 and not Engine.IsHopping then
            local hasCDKNow = Scanner:HasItem("cursed dual katana") or Scanner:HasItem("cdk") or (Scanner:GetSwordMastery("Cursed Dual Katana") > 0)
            if not hasCDKNow then
                lblStatus.Text = string.format("Trạng thái: ⏰ ĐÃ QUÁ 4 PHÚT (%02d:%02d) XONG 6 TRIAL MÀ CHƯA CÓ CDK! Đang tự động Hop Low Server...", math.floor(elapsedBossWait / 60), math.floor(elapsedBossWait % 60))
                Engine:HopLowServer()
            end
        end
    end

    -- KÍCH HOẠT CHUYỂN BƯỚC
    if Engine.ActiveCDKMode ~= desiredStage then
        warn(string.format("[AXIOM CDK PIPELINE] BƯỚC THỰC THI THAY ĐỔI: %s -> %s!", tostring(Engine.ActiveCDKMode), desiredStage))
        Engine.ActiveCDKMode = desiredStage

        if desiredHub == "DualHub" then
            WriteRealKidConfig(desiredConfig)
            if not Engine.NightHubRaidFired then
                Engine.NightHubRaidFired = true
                Engine.NightHubRunning = true
                EnsureNightHubKey()
                WriteNightHubConfig(NIGHTHUB_CONFIG_CASTLE_RAID)
                warn("[AXIOM CDK] Ghi đè Night Hub Castle Raid! Đợi 1s và chạy...")
                LaunchNightHub(1.0)
            end
            warn(string.format("[AXIOM CDK] Ghi đè RealKid: %s! Đợi 1s và chạy...", desiredStage))
            LaunchRealKid(1.0)
        elseif desiredHub == "NightHub" then
            if Engine.RealkidRunning then Engine.RealkidRunning = false end
            Engine.NightHubRunning = true
            getgenv()._NightHubExecuted = true
            EnsureNightHubKey()
            WriteNightHubConfig(desiredConfig)
            warn(string.format("[AXIOM CDK] Ghi đè Night Hub: %s! Đợi 1s và chạy lại...", desiredStage))
            LaunchNightHub(1.0)
        else
            if Engine.NightHubRunning then
                Engine.NightHubRunning = false
                Engine.CurrentNightHubMode = nil
                getgenv()._NightHubExecuted = nil
            end
            Engine.RealkidRunning = true
            WriteRealKidConfig(desiredConfig)
            warn(string.format("[AXIOM CDK] Ghi đè file RealKid: %s -> Đợi 1s rồi chạy lại script!", desiredStage))
            LaunchRealKid(1.0)
        end
    end
end

-- DAEMON ĐẾM NGƯỢC 5S & TỰ ĐỘNG REFRESH TIẾN TRÌNH CDK
local cdkCountdownDaemon = task.spawn(function()
    while Engine.IsRunning do
        if Engine.InCDKMode then
            local now = os.clock()

            if SharedCDK.IsFetching and (now - SharedCDK.FetchStartedAt > 3.0) then
                SharedCDK.IsFetching = false
                SharedCDK.NextRefreshTime = now + 5.0
            end

            local remaining = math.max(0, SharedCDK.NextRefreshTime - now)

            if (remaining <= 0 or not SharedCDK.Data) and not SharedCDK.IsFetching then
                SharedCDK.IsFetching = true
                SharedCDK.FetchStartedAt = now
                SharedCDK.NextRefreshTime = now + 5.0

                task.spawn(function()
                    local ok, res = pcall(function()
                        return Scanner:GetCDKQuestStatus()
                    end)
                    if ok and res then
                        SharedCDK.Data = res
                        local elapsed = os.clock() - Engine.ServerJoinTime
                        local tDisp = string.format("[%02d:%02d/20:00]", math.floor(elapsed / 60), math.floor(elapsed % 60))
                        pcall(ProcessCDKPipeline, res, tDisp)
                    end
                    SharedCDK.IsFetching = false
                end)
            end

            local completed = (SharedCDK.Data and SharedCDK.Data.TotalCompleted) or 0
            local frags = (SharedCDK.Data and SharedCDK.Data.AlucardFragments) or 0
            lblCDKHeader.Text = string.format("⚔️ TIẾN TRÌNH CDK: [%d/6 XONG] | ALUCARD: [%d/6] (Làm mới sau: %.1fs)", completed, frags, remaining)
        end
        task.wait(0.1)
    end
end)
table.insert(Engine.Threads, cdkCountdownDaemon)

