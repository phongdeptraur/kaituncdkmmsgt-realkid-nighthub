local function getActiveCastleRaidMobs()
    local aliveRaidMobs = {}
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return aliveRaidMobs end

    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if mob:IsA("Model") then
            local mRoot = (mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart) :: BasePart?
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if mRoot and hum and hum.Health > 0 then
                local distToCastle = (mRoot.Position - CASTLE_CHECK_CFRAME.Position).Magnitude
                local isRaidMobName = (table.find(RAID_ENEMY_LIST, mob.Name) ~= nil) or (string.find(mob.Name:lower(), "raid") ~= nil)

                if distToCastle <= 2200 or isRaidMobName then
                    table.insert(aliveRaidMobs, mob)
                end
            end
        end
    end

    return aliveRaidMobs
end

local function resolveCakeQueenTelemetry()
    local myRoot = getRoot()
    local result = {
        Found = false,
        Entity = nil,
        RootPart = nil,
        Health = 0,
        MaxHealth = 0,
        Distance = nil,
        Source = "None",
    }

    local function inspectEntity(inst: Instance, sourceTag: string): boolean
        if inst:IsA("Model") and string.find(inst.Name:lower(), "cake queen") then
            local hum = inst:FindFirstChildOfClass("Humanoid")
            local rPart = (inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")) :: BasePart?

            local hp = hum and hum.Health or 0
            local maxHp = hum and hum.MaxHealth or 0

            local dist = nil
            if myRoot and rPart then
                dist = math.floor((myRoot.Position - rPart.Position).Magnitude)
            end

            result.Found = true
            result.Entity = inst
            result.RootPart = rPart
            result.Health = hp
            result.MaxHealth = maxHp
            result.Distance = dist
            result.Source = sourceTag
            return true
        end
        return false
    end

    local wsEnemies = workspace:FindFirstChild("Enemies")
    if wsEnemies then
        for _, child in ipairs(wsEnemies:GetChildren()) do
            if inspectEntity(child, "Workspace.Enemies") then
                return result
            end
        end
    end

    for _, child in ipairs(workspace:GetChildren()) do
        if inspectEntity(child, "Workspace") then
            return result
        end
    end

    for _, child in ipairs(ReplicatedStorage:GetChildren()) do
        if inspectEntity(child, "ReplicatedStorage") then
            return result
        end
    end

    return result
end

