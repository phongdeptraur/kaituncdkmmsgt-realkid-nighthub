                        loadstring(game:HttpGet(FRAG_URL))()
                    end)
                    if not ok then
                        warn("[AutoFrag]", err)
                        G._FragFarmLoaded = nil
                    end
                end)
            end
            task.wait(1)
            return
        elseif S.FragFarm then
            S.FragFarm = false
            S.FragTarget = nil
            return HopLow("Đã đủ 5,000 Fragment -> Hop Low để lấy Skull Guitar")
        end
        local jid = tostring(game.JobId)
        local now = os.clock()
        if S.SGTNearJob ~= jid then
            S.SGTNearJob = jid
            S.SGTNearAcc = 0
            S.SGTNearLast = now
        end
        local dt = math.min(now - (S.SGTNearLast or now), 1)
        S.SGTNearLast = now

        local r = Root()
        local nearPl, nearDist = nil, nil
        if r then
            for _, pl in ipairs(Players:GetPlayers()) do
                if pl ~= LP and pl.Character then
                    local pr = pl.Character:FindFirstChild("HumanoidRootPart")
                    if pr then
                        local dist = (pr.Position - r.Position).Magnitude
                        if dist <= 500 then
                            nearPl, nearDist = pl, dist
                            break
                        end
                    end
                end
            end
        end

        if nearPl then
            S.SGTNearAcc = (S.SGTNearAcc or 0) + dt
            if S.SGTNearAcc >= 55 then
                S.SGTNearAcc = 0
                return HopLow(("Đủ 4 nguyên liệu SGT nhưng có %s ở gần (%.0fm) tích lũy %.0fs/60s -> Hop Low"):format(nearPl.Name, nearDist, 55))
            end
        end
    end
    Hop(nil, { GuitarEnabled = true, SearchEnabled = false })
end

