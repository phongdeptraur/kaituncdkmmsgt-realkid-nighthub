local HopCFG = { MaxPages = 100, MaxPlayers = 8, PageRetries = 2, PageStartDelay = 0.02, ScanTimeout = 7 }

function Engine:HopLowServer()
    if self.IsHopping then return end
    self.IsHopping = true
    -- Xóa đăng ký server cũ trước khi hop để không giữ chỗ ảo
    pcall(function() self:UpdateMasterySession(false) end)
    pcall(function() self:UpdateCakeQueenSession(false, false) end)
    pcall(function() self:UpdateEctoSession(false) end)
    pcall(function() self:UpdateBonesSession(false) end)
    if self.StatusLabel then
        self.StatusLabel.Text = "Trạng thái: 🌐 Đang quét 100 trang tìm Low Server (≤ 8 players, né clone Mastery)..."
    end

    task.spawn(function()
        while Engine.IsRunning and self.IsHopping do
            local occupiedMap = {}
            if State.FarmingEctoWithRealKid or (CheckIsSea2() and State.Items.Ectoplasm < 250) then
                occupiedMap = self:GetOccupiedEctoServersMap()
                if self.StatusLabel then
                    self.StatusLabel.Text = "Trạng thái: 🌐 Đang quét 100 trang tìm Low Server (né server có clone farm Ecto)..."
                end
            elseif State.FarmingBonesWithRealKid or (CheckIsSea3() and State.Items.Bones < 500) then
                occupiedMap = self:GetOccupiedBonesServersMap()
                if self.StatusLabel then
                    self.StatusLabel.Text = "Trạng thái: 🌐 Đang quét 100 trang tìm Low Server (né server có clone farm Bones)..."
                end
            else
                occupiedMap = self:GetOccupiedMasteryServersMap()
            end
            local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
            local pool = {}
            if browser then
                local byJob = {}
                local completed = 0
                for page = 1, HopCFG.MaxPages do
                    task.delay((page - 1) * HopCFG.PageStartDelay, function()
                        local ok, res = pcall(function() return browser:InvokeServer(page) end)
                        if ok and type(res) == "table" then
                            for jobId, data in pairs(res) do
                                if type(data) == "table" then
                                    local count = tonumber(data.Count) or 99
                                    local id = tostring(jobId)
                                    if not Engine:IsVisited(id) and not occupiedMap[id] and count <= HopCFG.MaxPlayers then
                                        byJob[id] = { JobId = id, Count = count }
                                    end
                                end
                            end
                        end
                        completed = completed + 1
                    end)
                end
                local deadline = os.clock() + HopCFG.ScanTimeout
                repeat task.wait(0.05) until completed >= HopCFG.MaxPages or os.clock() >= deadline
                for _, s in pairs(byJob) do
                    if not occupiedMap[s.JobId] then
                        table.insert(pool, s)
                    end
                end
                table.sort(pool, function(a, b) return a.Count < b.Count end)
            end

            if #pool > 0 then
                for _, srv in ipairs(pool) do
                    if not Engine.IsRunning then break end
                    if not occupiedMap[srv.JobId] then
                        if self.CurrentObjective == "MasteryFarm" then
                            pcall(function() self:UpdateMasterySession(true, srv.JobId) end)
                        elseif State.FarmingEctoWithRealKid then
                            pcall(function() self:UpdateEctoSession(true, srv.JobId) end)
                        elseif State.FarmingBonesWithRealKid then
                            pcall(function() self:UpdateBonesSession(true, srv.JobId) end)
                        end
                        DirectTeleportToJob(srv.JobId, game.PlaceId)
                        task.wait(CONFIG.ApiJoinDelay)
                    end
                end
            else
                local okApi, response = pcall(function()
                    return game:HttpGet(string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId))
                end)
                if okApi and response then
                    local okJ, data = pcall(HttpService.JSONDecode, HttpService, response)
                    if okJ and data and data.data then
                        for _, sData in ipairs(data.data) do
                            local id = tostring(sData.id or "")
                            if sData.playing and sData.playing <= HopCFG.MaxPlayers and not Engine:IsVisited(id) and not self:IsServerOccupiedByMasteryClone(id) then
                                if self.CurrentObjective == "MasteryFarm" then
                                    pcall(function() self:UpdateMasterySession(true, id) end)
                                end
                                DirectTeleportToJob(id, game.PlaceId)
                                task.wait(CONFIG.ApiJoinDelay)
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

