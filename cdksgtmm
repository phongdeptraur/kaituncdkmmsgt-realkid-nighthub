function Engine:Unload()
    self.IsRunning = false
    self.FastAttackActive = false
    self.NightHubRunning = false
    self.RealkidRunning = false
    self.IsHopping = false
    self.CDKBossStartTime = nil
    getgenv()._NightHubExecuted = nil

    if self.CurrentTween then pcall(function() self.CurrentTween:Cancel() end) end

    local char = LocalPlayer.Character
    if char then
        local head = char:FindFirstChild("Head")
        if head and head:FindFirstChild("axiom_bv") then head.axiom_bv:Destroy() end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end

    for _, conn in ipairs(self.Connections) do
        if conn and typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
    end
    table.clear(self.Connections)

    for _, th in ipairs(self.Threads) do
        if th and coroutine.status(th) ~= "dead" then pcall(task.cancel, th) end
    end
    table.clear(self.Threads)

    for _, inst in ipairs(self.Instances) do pcall(function() inst:Destroy() end) end
    table.clear(self.Instances)

    getgenv()._AxiomTushitaMaster = nil
end

