local function MountUI(gui)
    local mounted = false
    if typeof(gethui) == "function" then
        pcall(function()
            local target = gethui()
            if target and typeof(target) == "Instance" then
                gui.Parent = target
                if gui.Parent == target then mounted = true end
            end
        end)
    end

    if not mounted then
        if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
            pcall(syn.protect_gui, gui)
        elseif typeof(protectgui) == "function" then
            pcall(protectgui, gui)
        end

        pcall(function()
            gui.Parent = CoreGui
            if gui.Parent == CoreGui then mounted = true end
        end)
    end

    if not mounted then
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
            if pg then
                gui.Parent = pg
                if gui.Parent == pg then mounted = true end
            end
        end)
    end
    return mounted
end

