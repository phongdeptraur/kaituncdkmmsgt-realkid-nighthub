-- CDK Latch
getgenv().CDK_LATCH = getgenv().CDK_LATCH or {
    InitialQueueChecked = false,
    ActiveEvil = nil, ActiveGood = nil,
    Yama1Done = false, Yama2Done = false, Yama3Done = false, YamaCompleted = false,
    Tushita1Done = false, Tushita2Done = false, Tushita3Done = false, TushitaCompleted = false,
    AlucardFragments = 0,
}

local _lastCDKProgressPoll = 0
local _lastAlucardPoll = 0
local _cachedAlucardCount = 0

local function GetCDKQuestStatus(forcePoll)
    local Latch = getgenv().CDK_LATCH
    local commF = GetCommF()
    local now = os.clock()

    if commF and (forcePoll or (now - _lastCDKProgressPoll >= 0.8)) then
        _lastCDKProgressPoll = now
        local prog = SafeInvokeServer(commF, 1.0, "CDKQuest", "Progress")
        if type(prog) == "table" then
            local rawE, rawG = tonumber(prog.Evil), tonumber(prog.Good)
            if rawE then
                if rawE == -3 then
                    Latch.ActiveEvil = -3
                elseif rawE == -4 then
                    Latch.Yama1Done = true; Latch.ActiveEvil = -4
                elseif rawE == -5 then
                    Latch.Yama1Done = true; Latch.Yama2Done = true; Latch.ActiveEvil = -5
                else
                    Latch.ActiveEvil = nil
                    if rawE == 1 then
                        Latch.Yama1Done = true
                    elseif rawE == 2 then
                        Latch.Yama1Done = true; Latch.Yama2Done = true
                    elseif rawE == 3 or rawE == 4 then
                        Latch.Yama1Done = true; Latch.Yama2Done = true; Latch.Yama3Done = true; Latch.YamaCompleted = true
                    end
                end
            end
            if rawG then
                if rawG == -3 then
                    Latch.ActiveGood = -3
                elseif rawG == -4 then
                    Latch.Tushita1Done = true; Latch.ActiveGood = -4
                elseif rawG == -5 then
                    Latch.Tushita1Done = true; Latch.Tushita2Done = true; Latch.ActiveGood = -5
                else
                    Latch.ActiveGood = nil
                    if rawG == 1 then
                        Latch.Tushita1Done = true
                    elseif rawG == 2 then
                        Latch.Tushita1Done = true; Latch.Tushita2Done = true
                    elseif rawG == 3 or rawG == 4 then
                        Latch.Tushita1Done = true; Latch.Tushita2Done = true; Latch.Tushita3Done = true; Latch.TushitaCompleted = true
                    end
                end
            end
        end
    end

    -- Đọc Alucard Fragment từ IRS (0ms latency)
    local alucardCount = _cachedAlucardCount
    if forcePoll or (now - _lastAlucardPoll >= 3.0) then
        _lastAlucardPoll = now
        local items = FetchIRSItems("QUANTITY")
        if HasTableEntries(items) then
            for k, v in pairs(items) do
                local rawId = (type(v) == "table" and (v.ItemId or v.Name or v.Item)) or k
                local name = ResolveItemName(rawId)
                if name:find("Alucard") then
                    local cnt = (type(v) == "table" and tonumber(v.Value or v.Count)) or tonumber(v) or 1
                    if cnt > alucardCount then alucardCount = cnt end
                end
            end
        else
            local inv = SafeInvokeInventory(commF, 1.2)
            if type(inv) == "table" then
                for _, item in ipairs(inv) do
                    if type(item) == "table" then
                        local name = tostring(item.Name or item.name or "")
                        if name:find("Alucard") then
                            local cnt = tonumber(item.Count or item.count or item.Value or item.value) or 1
                            if cnt > alucardCount then alucardCount = cnt end
                        end
                    end
                end
            end
        end
        _cachedAlucardCount = alucardCount
    end

    if alucardCount > Latch.AlucardFragments then
        Latch.AlucardFragments = alucardCount
        if Latch.ActiveEvil == -3 then Latch.Yama1Done = true; Latch.ActiveEvil = nil
        elseif Latch.ActiveEvil == -4 then Latch.Yama2Done = true; Latch.ActiveEvil = nil
        elseif Latch.ActiveEvil == -5 then Latch.Yama3Done = true; Latch.YamaCompleted = true; Latch.ActiveEvil = nil
        elseif Latch.ActiveGood == -3 then Latch.Tushita1Done = true; Latch.ActiveGood = nil
        elseif Latch.ActiveGood == -4 then Latch.Tushita2Done = true; Latch.TushitaCompleted = true; Latch.ActiveGood = nil
        elseif Latch.ActiveGood == -5 then Latch.Tushita3Done = true; Latch.TushitaCompleted = true; Latch.ActiveGood = nil end
    else
        alucardCount = math.max(alucardCount, Latch.AlucardFragments)
    end

    if alucardCount >= 3 then Latch.Yama1Done = true; Latch.Yama2Done = true; Latch.Yama3Done = true; Latch.YamaCompleted = true end
    if alucardCount >= 6 then Latch.Tushita1Done = true; Latch.Tushita2Done = true; Latch.Tushita3Done = true; Latch.TushitaCompleted = true end

    local evilDone = (Latch.Yama1Done and 1 or 0) + (Latch.Yama2Done and 1 or 0) + (Latch.Yama3Done and 1 or 0)
    local goodDone = (Latch.Tushita1Done and 1 or 0) + (Latch.Tushita2Done and 1 or 0) + (Latch.Tushita3Done and 1 or 0)

    return {
        evilDone = evilDone, goodDone = goodDone,
        currentEvil = Latch.ActiveEvil, currentGood = Latch.ActiveGood,
        YamaDone = Latch.YamaCompleted or (evilDone >= 3),
        TushitaDone = Latch.TushitaCompleted or (goodDone >= 3),
        Yama1Done = Latch.Yama1Done, Yama2Done = Latch.Yama2Done, Yama3Done = Latch.Yama3Done,
        Tushita1Done = Latch.Tushita1Done, Tushita2Done = Latch.Tushita2Done, Tushita3Done = Latch.Tushita3Done,
        AlucardFragments = alucardCount
    }
end

