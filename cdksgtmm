local function LoadIgnoredJobs()
    local ignored = {}
    local now = os.time()
    local myUid = tostring(LP.UserId)

    local function addJob(id)
        if type(id) == "string" then
            local s = id:match("^%s*(.-)%s*$")
            if #s >= 20 and s:find("-", 1, true) then ignored[s] = true end
        end
    end

    local activeClaims = ReadActiveTTLClaims()
    for jid, info in pairs(activeClaims) do
        if info.userId ~= myUid and info.name ~= LP.Name then
            addJob(jid)
        end
    end

    local function parseData(dt, isTTLFile)
        if type(dt) == "table" then
            if type(dt.VisitedJobs) == "table" then
                for k, v in pairs(dt.VisitedJobs) do if v then addJob(k) end end
            end
            for _, k in ipairs({ "jobIds", "jobs", "servers", "JobIds", "Visited", "visited", "blacklisted", "anti" }) do
                if type(dt[k]) == "table" then
                    for _, v in pairs(dt[k]) do addJob(type(v) == "table" and (v.id or v.JobId) or v) end
                end
            end
            for k, v in pairs(dt) do
                if type(v) == "table" then
                    local ts = tonumber(v.time or v.ts or v.timestamp or v.lastUpdate)
                    local uid = tostring(v.userId or v.uid or v.user or "")
                    if ts then
                        if (now - ts) <= BONES_TTL and uid ~= myUid and tostring(v.name or "") ~= LP.Name then
                            addJob(k)
                            addJob(v.id or v.JobId)
                        end
                    else
                        addJob(k)
                        addJob(v.id or v.JobId)
                    end
                elseif type(v) == "number" then
                    if v > 1700000000 then
                        local ttlLimit = isTTLFile and BONES_TTL or 300
                        if (now - v) <= ttlLimit then addJob(k) end
                    else
                        addJob(k)
                    end
                elseif type(v) == "boolean" and v then
                    addJob(k)
                elseif type(v) == "string" then
                    addJob(k)
                    addJob(v)
                end
            end
        elseif type(dt) == "string" and not isTTLFile then
            for jid in dt:gmatch("[%w%-%_]+") do
                if #jid >= 20 and jid:find("-", 1, true) then addJob(jid) end
            end
        end
    end

    if BASE and type(BASE.VisitedJobs) == "table" then
        for k, v in pairs(BASE.VisitedJobs) do if v then addJob(k) end end
    end

    local checkFiles = {
        VF,
        "RealKidHop_" .. tostring(LP.UserId) .. ".json",
        "RealKidHop_Visited.json",
        "RealKid_Visited.json",
        "RealKidHub/visited.json",
        "RealKidHub/jobid.json",
        "RealKidHub/bones.json",
        "RealKidHub/anti_collision.json",
        "RealKidHub/anticollision.json",
        "RealKidHub/anti_colocation.json",
        "anti_collision.json",
        "anticollision.json",
        "anti_colocation.json",
        "anti_server.json",
        "anti_job.json",
        "bones_job.json",
        "bones_visited.json",
        "Bones_Visited.json",
        "BonesProgress/visited.json",
        "BonesProgress/jobid.json",
        "FarmBones/visited.json",
        "FarmBones/jobid.json",
        "bones.json",
        "Bones.json",
        "collision.json",
        "server_visited.json",
        "visited_servers.json",
        "visited.json",
        "jobids.json"
    }

    for _, path in ipairs(checkFiles) do
        pcall(function()
            if isfile and isfile(path) then
                local raw = readfile(path)
                local ok, dt = pcall(HttpService.JSONDecode, HttpService, raw)
                local isTTL = path:lower():find("bone", 1, true) or path:lower():find("colli", 1, true) or path:lower():find("anti", 1, true)
                if ok and dt then parseData(dt, isTTL) else parseData(raw, isTTL) end
            end
        end)
    end

    pcall(function()
        if type(listfiles) == "function" then
            for _, folder in ipairs({ "CDKProgress", "RealKidHub", "BonesProgress", "FarmBones" }) do
                if isfolder and isfolder(folder) then
                    for _, fp in ipairs(listfiles(folder)) do
                        local lfp = fp:lower()
                        if lfp:find("bone", 1, true) or lfp:find("colli", 1, true) or lfp:find("visit", 1, true) or lfp:find("anti", 1, true) or lfp:find("job", 1, true) then
                            pcall(function()
                                local raw = readfile(fp)
                                local ok, dt = pcall(HttpService.JSONDecode, HttpService, raw)
                                local isTTL = lfp:find("bone", 1, true) or lfp:find("colli", 1, true) or lfp:find("anti", 1, true) or lfp:find("ttl", 1, true)
                                if ok and dt then parseData(dt, isTTL) else parseData(raw, isTTL) end
                            end)
                        end
                    end
                end
            end
        end
    end)

    return ignored
end

local function HopLow(reason, avoidMode)
    if not S.Run or S.Hopping then return end
    S.Hopping = true
    local finalReason = reason or "Đang quét server vắng (1-7 người)..."
    local isAvoid = (avoidMode == true or type(avoidMode) == "string")
    local claimMode = type(avoidMode) == "string" and avoidMode or "Bones/Mastery"
    LogHopReason((isAvoid and "HopLow [Né SV]: " or "HopLow [Ngẫu nhiên]: ") .. finalReason)
    ReleaseServerClaim()
    Float(false)
    Say(finalReason)

    local function TeleportToJob(jobId)
        if not jobId or jobId == "" or jobId == tostring(game.JobId) then return end
        local browser = RS:FindFirstChild("__ServerBrowser")
        if browser then
            local ok = pcall(function() browser:InvokeServer("teleport", jobId) end)
            if not ok then
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LP) end)
            end
        else
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LP) end)
        end
    end

    task.spawn(function()
        local vis = {}
        if isAvoid then
            pcall(function() vis = HttpService:JSONDecode(readfile(VF)) end)
            local now = os.time()
            for k, v in pairs(vis) do if type(v) ~= "number" or now - v > 300 then vis[k] = nil end end
            vis[tostring(game.JobId)] = now
        end

        while S.Run do
            local ignored = isAvoid and LoadIgnoredJobs() or nil
            local function isIgnored(id)
                if not id or id == "" or id == tostring(game.JobId) then return true end
                if isAvoid then
                    if vis[id] then return true end
                    if ignored and ignored[id] then return true end
                end
                return false
            end

            local byJob, pool, completed = {}, {}, 0
            local fastFound = 0
            local br = RS:FindFirstChild("__ServerBrowser")
            if br then
                local totalPages = 150
                for page = 1, totalPages do
                    task.spawn(function()
                        for _ = 1, 2 do
                            if not S.Run then break end
                            local ok, res = pcall(function() return br:InvokeServer(page) end)
                            if ok and type(res) == "table" then
                                for jobId, data in pairs(res) do
                                    local id = tostring(jobId)
                                    if not isIgnored(id) and not byJob[id] then
                                        local count = (type(data) == "table" and tonumber(data.Count)) or tonumber(data) or 99
                                        if count >= 1 and count <= 7 then
                                            local reg = (type(data) == "table" and tostring(data.Region or "")) or "Unknown"
                                            local numericPing = 90
                                            if reg:find("Sing") then
                                                numericPing = 40
                                            elseif reg:find("Japan") then
                                                numericPing = 95
                                            elseif reg:find("Germ") then
                                                numericPing = 190
                                            elseif reg:find("United States") or reg:find("US") then
                                                numericPing = 235
                                            end
                                            byJob[id] = { id = id, cnt = count, ping = numericPing, region = reg }
                                            if count <= 5 and numericPing <= 100 then
                                                fastFound += 1
                                            end
                                        end
                                    end
                                end
                                break
                            end
                            task.wait(0.04)
                        end
                        completed += 1
                    end)
                end

                local start = os.clock()
                repeat
                    task.wait(0.05)
                    local elapsed = os.clock() - start
                until not S.Run or completed >= totalPages or elapsed >= 3.5 or (elapsed >= 0.45 and fastFound >= 12)

                for _, sv in pairs(byJob) do
                    pool[#pool + 1] = sv
                end
            end

            if #pool == 0 and S.Run then
                local cursor = ""
                local pageCount = 0
                while cursor and pageCount < 50 and S.Run do
                    pageCount += 1
                    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
                        game.PlaceId, (cursor ~= "" and "&cursor=" .. cursor or ""))
                    local ok, res = pcall(function() return game:HttpGet(url) end)
                    if not ok or not res then break end
                    local okJson, data = pcall(function() return HttpService:JSONDecode(res) end)
                    if not okJson or not data or not data.data then break end

                    for _, s in ipairs(data.data) do
                        local id = tostring(s.id)
                        local playing = tonumber(s.playing) or 99
                        local maxP = tonumber(s.maxPlayers) or 12
                        if playing >= 1 and playing <= 7 and playing < maxP and not isIgnored(id) and not byJob[id] then
                            local item = {
                                id = id,
                                cnt = playing,
                                ping = tonumber(s.ping) or 999,
                                region = "Unknown"
                            }
                            byJob[id] = item
                            pool[#pool + 1] = item
                        end
                    end

                    if #pool >= 15 then break end
                    cursor = data.nextPageCursor
                    if not cursor or cursor == "" then break end
                end
            end

            if not S.Run then break end
            if #pool == 0 then
                if isAvoid then
                    vis = { [tostring(game.JobId)] = os.time() }
                end
                Say("Chưa thấy server <=7 người, đang quét lại...")
            else
                local tLow, tMid, tHigh = {}, {}, {}
                for _, sv in ipairs(pool) do
                    if sv.ping <= 100 then
                        tLow[#tLow + 1] = sv
                    elseif sv.ping <= 180 then
                        tMid[#tMid + 1] = sv
                    else
                        tHigh[#tHigh + 1] = sv
                    end
                end
                local function shuffle(arr)
                    for i = #arr, 2, -1 do
                        local j = math.random(i)
                        arr[i], arr[j] = arr[j], arr[i]
                    end
                end
                shuffle(tLow)
                shuffle(tMid)
                shuffle(tHigh)
                pool = {}
                for _, group in ipairs({ tLow, tMid, tHigh }) do
                    for _, sv in ipairs(group) do
                        pool[#pool + 1] = sv
                    end
                end

                local myUid = tostring(LP.UserId)
                for i = 1, math.min(#pool, 8) do
                    if not S.Run then break end
                    local sv = pool[i]
                    if sv.id ~= "" and sv.id ~= tostring(game.JobId) then
                        local lockedSuccess = true
                        if isAvoid then
                            lockedSuccess = false
                            local rosterNow = ReadFarmRoster()
                            local conflict = false
                            for uid, info in pairs(rosterNow) do
                                if uid ~= myUid and (info.jobId == sv.id or info.reservedJobId == sv.id) then
                                    conflict = true
                                    break
                                end
                            end

                            if not conflict then
                                local ts = os.time()
                                rosterNow[myUid] = {
                                    userId = myUid,
                                    name = LP.Name,
                                    jobId = "",
                                    reservedJobId = sv.id,
                                    reserveTime = ts,
                                    joined = ts,
                                    time = ts,
                                    mode = claimMode,
                                    state = "reserving"
                                }
                                WriteFarmRoster(rosterNow)
                                -- Chờ 0.08s rồi đọc lại file để khóa chống trùng tuyệt đối nếu 2 acc đặt cùng mili-giây
                                task.wait(0.08)
                                local verifyRoster = ReadFarmRoster()
                                local wonLock = (verifyRoster[myUid] and verifyRoster[myUid].reservedJobId == sv.id)
                                if wonLock then
                                    for uid, info in pairs(verifyRoster) do
                                        if uid ~= myUid and (info.jobId == sv.id or info.reservedJobId == sv.id) then
                                            if not IsHigherPriority(ts, myUid, info.reserveTime > 0 and info.reserveTime or info.joined, uid) then
                                                wonLock = false
                                                break
                                            end
                                        end
                                    end
                                end

                                if wonLock then
                                    lockedSuccess = true
                                    S.farmStatus = FormatFarmAccStatus(verifyRoster)
                                    vis[sv.id] = os.time()
                                    pcall(writefile, VF, HttpService:JSONEncode(vis))
                                elseif verifyRoster[myUid] then
                                    verifyRoster[myUid] = nil
                                    WriteFarmRoster(verifyRoster)
                                end
                            end
                        end

                        if lockedSuccess then
                            Say(("Đang sang server %s (%d/7 người, ~%dms)"):format(sv.id:sub(1, 8), sv.cnt, sv.ping))
                            TeleportToJob(sv.id)
                            task.wait(2.2)
                        end
                    end
                end
            end
            task.wait(0.25)
        end
    end)
end

-- Anti-Colocation: Acc vào trước ở lại farm, acc vào sau lập tức Hop Low sang server trống đã đặt chỗ
local function CheckAntiColocation(spotCenter, label)
    local jid = tostring(game.JobId)
    local myUid = tostring(LP.UserId)
    local now = os.time()
    local roster = ReadFarmRoster()

    if S.AntiJob ~= jid then
        S.AntiJob = jid
        local myEntry = roster[myUid]
        if myEntry and (myEntry.jobId == jid or myEntry.reservedJobId == jid) and myEntry.joined then
            S.AntiJoined = myEntry.joined
        else
            S.AntiJoined = now
        end
        S.LastHB = 0
    end

    local myJoined = S.AntiJoined or now

    -- 1. Kiểm tra trong file Roster xem có acc nào trong dàn đang ở cùng JobId này không
    for uid, info in pairs(roster) do
        if uid ~= myUid and info.jobId == jid then
            if not IsHigherPriority(myJoined, myUid, info.joined, uid) then
                HopLow(("Trùng server %s với acc vào trước %s -> Hop Low né"):format(
                    label,
                    tostring(info.name ~= "" and info.name or uid)
                ), label)
                return true
            end
        end
    end

    -- 2. Ghi xác nhận tôi đang giữ server này (xóa reservedJobId vì đã vào nơi)
    if os.clock() - (S.LastHB or 0) >= 2.0 then
        S.LastHB = os.clock()
        roster[myUid] = {
            userId = myUid,
            name = LP.Name,
            jobId = jid,
            reservedJobId = "",
            reserveTime = 0,
            joined = myJoined,
            time = now,
            mode = label,
            state = "active"
        }
        WriteFarmRoster(roster)
    end
    S.farmStatus = FormatFarmAccStatus(roster)

    -- 3. Kiểm tra người chơi thực tế trong server:
    -- Nếu là acc cùng dàn -> Acc vào trước ở lại, acc vào sau mới hop. Nếu là người lạ ở bãi -> Hop né.
    local r = Root()
    if r then
        local atSpot = (not spotCenter) or ((r.Position - spotCenter).Magnitude <= 1000)
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP and pl.Character then
                local pr = pl.Character:FindFirstChild("HumanoidRootPart")
                if pr then
                    local nearMe = atSpot and ((pr.Position - r.Position).Magnitude <= 450)
                    local nearSpot = spotCenter and ((pr.Position - spotCenter).Magnitude <= 600)
                    if nearMe or nearSpot then
                        local plUid = tostring(pl.UserId)
                        local altInfo = roster[plUid]
                        if altInfo then
                            if not IsHigherPriority(myJoined, myUid, altInfo.joined, plUid) then
                                HopLow(("Nhường bãi %s cho acc vào trước %s -> Hop Low né"):format(label, pl.Name), label)
                                return true
                            end
                        else
                            HopLow(("Phát hiện người lạ %s chung bãi %s -> Hop Low né"):format(pl.Name, label), label)
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

-- ============================ ELITE ROSTER, 15M BLACKLIST & PRE-RESERVATION HOP ============================
local function ReadEliteRoster()
    local now = os.time()
    local roster = {}
    pcall(function()
        if isfile and isfile(ELITE_ROSTER_FILE) then
            local raw = readfile(ELITE_ROSTER_FILE)
            local ok, dt = pcall(HttpService.JSONDecode, HttpService, raw)
            if ok and type(dt) == "table" then
                for uid, info in pairs(dt) do
                    if type(info) == "table" then
                        local ts = tonumber(info.time) or 0
                        local resTs = tonumber(info.reserveTime) or 0
                        local hasActiveJob = type(info.jobId) == "string" and #info.jobId >= 20 and (now - ts) <= ELITE_TTL
                        local hasValidRes = type(info.reservedJobId) == "string" and #info.reservedJobId >= 20 and (now - resTs) <= 20
                        if hasActiveJob or hasValidRes then
                            roster[tostring(uid)] = {
                                userId = tostring(info.userId or uid),
                                name = tostring(info.name or ""),
                                jobId = hasActiveJob and tostring(info.jobId) or "",
                                reservedJobId = hasValidRes and tostring(info.reservedJobId) or "",
                                reserveTime = hasValidRes and resTs or 0,
                                joined = tonumber(info.joined) or ts or now,
                                time = ts,
                                state = hasActiveJob and "active" or "reserving"
                            }
                        end
                    end
                end
            end
        end
    end)
    return roster
end

local function WriteEliteRoster(roster)
    pcall(writefile, ELITE_ROSTER_FILE, HttpService:JSONEncode(roster))
end

