local function IsMobAlive(mob)
    if not mob or not mob.Parent then return false end
    local hum = mob:FindFirstChildOfClass("Humanoid")
    local root = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart or mob:FindFirstChild("Torso")
    if hum and hum.Health > 0 and root then
        return true, root, hum
    end
    return false, nil, nil
end

local function ReleaseMagnetMob(mob)
    local entry = MagnetRegistry[mob]
    if not entry then return end
    if entry.Root and entry.Root.Parent then
        entry.Root.Anchored = false
        entry.Root.CanCollide = true
        entry.Root.AssemblyLinearVelocity = Vector3.zero
        entry.Root.AssemblyAngularVelocity = Vector3.zero
    end
    if entry.Hum and entry.Hum.Parent then
        pcall(function()
            entry.Hum.PlatformStand = false
            entry.Hum.WalkSpeed = 16
        end)
    end
    if entry.BodyPos and entry.BodyPos.Parent then
        pcall(function() entry.BodyPos:Destroy() end)
    end
    MagnetRegistry[mob] = nil
end

local function ClearAllMagnetMobs()
    for mob in pairs(MagnetRegistry) do
        ReleaseMagnetMob(mob)
    end
    StaticClusterPos = nil
    CurrentAnchorMob = nil
end

local function RegisterMagnetMob(mob, root, hum)
    if MagnetRegistry[mob] then return end
    pcall(function()
        hum.PlatformStand = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    end)
    root.Anchored = false
    root.CanCollide = false
    local bp = root:FindFirstChild("AxiomMagnetBP") or Instance.new("BodyPosition")
    bp.Name = "AxiomMagnetBP"
    bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bp.P = 300000
    bp.D = 3000
    bp.Position = root.Position
    bp.Parent = root
    MagnetRegistry[mob] = { Mob = mob, Root = root, Hum = hum, BodyPos = bp }
end

local function FindNewAnchorMob(playerPos)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil, nil end
    local bestMob, bestRoot, shortestDist = nil, nil, math.huge
    for _, mob in ipairs(enemies:GetChildren()) do
        if mob ~= LocalPlayer.Character and not string.find(mob.Name:lower(), "reaper") then
            local alive, root = IsMobAlive(mob)
            if alive then
                local dist = (root.Position - playerPos).Magnitude
                if dist <= MAGNET_RADIUS and dist < shortestDist then
                    shortestDist = dist
                    bestMob = mob
                    bestRoot = root
                end
            end
        end
    end
    return bestMob, bestRoot
end

