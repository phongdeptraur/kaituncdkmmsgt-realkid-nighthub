local dimState = {}
local function Dim(n)
    local d = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild(n)
    local sp, r = d and d:FindFirstChild("Spawn"), Root()
    if not (sp and r and (r.Position - sp.Position).Magnitude <= 1500) then
        if dimState[n] then
            dimState[n] = nil
        end
        if S.inDim == n then
            S.inDim, S.dimPair, S.isDimBlacklisted, S.onDimAttack = nil, nil, nil, nil
        end
        return false
    end
    S.noAttack = false

    local st = dimState[n]
    if not st then
        st = { tried = {}, count = 0, blacklist = {}, track = {} }
        dimState[n] = st
    end

    local function IsBlacklisted(m)
        local exp = st.blacklist[m]
        if not exp then return false end
        if os.clock() >= exp then
            st.blacklist[m] = nil
            st.track[m] = nil
            return false
        end
        return true
    end

    local function GetValidDimMobs()
        local list = {}
        local cr = Root()
        for _, m in ipairs(workspace.Enemies:GetChildren()) do
            local h, p = m:FindFirstChildOfClass("Humanoid"), m:FindFirstChild("HumanoidRootPart")
            if h and p and h.Health > 0 and not IsBlacklisted(m) and (p.Position - sp.Position).Magnitude <= 800 then
                local dist = cr and (p.Position - cr.Position).Magnitude or 0
                list[#list + 1] = { m = m, h = h, p = p, d = dist }
            end
        end
        table.sort(list, function(a, b) return a.d < b.d end)
        return list
    end

    local function HasValidDimMobs()
        return #GetValidDimMobs() > 0
    end

    local function GetMinBlacklistRem()
        local now, minRem = os.clock(), nil
        for m, exp in pairs(st.blacklist) do
            if m and m.Parent then
                local h, p = m:FindFirstChildOfClass("Humanoid"), m:FindFirstChild("HumanoidRootPart")
                if h and p and h.Health > 0 and (p.Position - sp.Position).Magnitude <= 800 then
                    local rem = exp - now
                    if rem > 0 and (not minRem or rem < minRem) then
                        minRem = rem
                    end
                else
                    st.blacklist[m] = nil
                    st.track[m] = nil
                end
            else
                st.blacklist[m] = nil
                st.track[m] = nil
            end
        end
        return minRem
    end

    S.inDim = n
    S.isDimBlacklisted = IsBlacklisted
    S.onDimAttack = function(targets)
        local now = os.clock()
        for _, item in ipairs(targets) do
            local m = item.m
            local h = m and m:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and not IsBlacklisted(m) then
                local tr = st.track[m]
                if not tr then
                    tr = { startHp = h.Health, hits = 0, lastHitT = 0, confirmed = false }
                    st.track[m] = tr
                end
                if h.Health < tr.startHp - 0.1 then
                    tr.confirmed = true
                    tr.startHp = h.Health
                    tr.hits = 0
                elseif not tr.confirmed then
                    if now - tr.lastHitT >= 0.25 then
                        tr.hits += 1
                        tr.lastHitT = now
                    end
                    if tr.hits >= 3 and (now - tr.lastHitT) >= 0.22 then
                        st.blacklist[m] = now + 30
                        st.track[m] = nil
                    end
                end
            end
        end
    end

    local function EngageDimMobs(mobs)
        if not mobs or #mobs == 0 then return false end
        local pair = { mobs[1].m }
        if mobs[2] then pair[2] = mobs[2].m end
        S.dimPair = pair
        Fight(mobs[1].m, mobs[1].p)
        pcall(Attack)
        return true
    end

    local curMobs = GetValidDimMobs()
    if #curMobs > 0 then
        return EngageDimMobs(curMobs)
    end
    S.dimPair = nil

    if st.count < 3 then
        r = Root()
        local bestP, bestPos, bestDist = nil, nil, math.huge
        for _, x in ipairs(d:GetDescendants()) do
            if x:IsA("ProximityPrompt") and x.Enabled and not st.tried[x] then
                local okP, piv = pcall(function() return x.Parent:GetPivot() end)
                local pos = okP and piv and piv.Position
                if pos and r then
                    local dist = (r.Position - pos).Magnitude
                    if dist < bestDist then
                        bestP, bestPos, bestDist = x, pos, dist
                    end
                end
            end
        end
        if bestP and bestPos then
            if Go(bestPos, HasValidDimMobs, ("%s: Đang tới đuốc (%d/3)"):format(n, st.count + 1)) then
                r = Root()
                if r and (r.Position - bestPos).Magnitude <= 25 then
                    bestP.HoldDuration = 0
                    pcall(fireproximityprompt, bestP)
                    st.tried[bestP] = true
                    st.count += 1
                    Float(true)
                    r.CFrame = CF(r.Position + V3(0, 22, 0))
                    r.AssemblyLinearVelocity = V3()
                    Say(("%s: Đã bật đuốc %d/3, check quái ngay..."):format(n, st.count))
                    local t0 = os.clock()
                    while S.Run and os.clock() - t0 < 0.65 do
                        local spawned = GetValidDimMobs()
                        if #spawned > 0 then
                            return EngageDimMobs(spawned)
                        end
                        task.wait(0.03)
                    end
                end
            end
            return true
        end
    end

    local e = d:FindFirstChild("Exit")
    if e then
        local pos = e:GetPivot().Position
        Say(n .. ": Đã qua 3 đuốc -> Đang tới cửa ra...")
        if Go(pos, HasValidDimMobs, n .. ": Đang tới cửa ra") then
            r = Root()
            if r and S.Run then
                Float(false)
                r.CFrame = CF(pos)
                task.wait(0.8)
                if S.Run then Float(true) end
            end
        end
    end

    r = Root()
    if r and (r.Position - sp.Position).Magnitude <= 1500 then
        local mobsAfter = GetValidDimMobs()
        if #mobsAfter > 0 then
            return EngageDimMobs(mobsAfter)
        end
        local remBl = GetMinBlacklistRem()
        if remBl then
            Go(sp.Position + V3(0, 60, 0), HasValidDimMobs, ("%s: Đợi hết blacklist quái (%.0fs)..."):format(n, remBl))
        else
            Say(n .. ": Chưa ra được cửa -> Làm lại 1 vòng 3 đuốc...")
            table.clear(st.tried)
            st.count = 0
        end
    else
        dimState[n] = nil
        S.inDim, S.dimPair, S.isDimBlacklisted, S.onDimAttack = nil, nil, nil, nil
    end
    return true
end

