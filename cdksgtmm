local function Pre(pos, abort, desc)
    local key = tostring(game.JobId) .. "_" .. tostring(pos)
    if S.pre == key then return true end
    if Go(pos, abort, desc) then S.pre = key return true end
    return false
end

local function Search(dest, pre, pats, check)
    if G._RKHop == game.JobId then return Hop(dest) end
    local function here()
        if check then return check() end
        if pats then
            -- Nhận diện boss ngay cả khi đang nằm trong ReplicatedStorage (chưa stream vào workspace)
            local m = Find(pats)
            return m ~= nil
        end
        return false
    end
    if here() then return end
    if pre and not Pre(pre, here, "Đang Pre-tween kiểm tra " .. dest) then return end
    Say("Đang kiểm tra " .. dest .. " trong server...")
    for _ = 1, (check and 10 or 6) do
        if here() then return end
        task.wait(0.25)
    end
    Hop(dest)
end

