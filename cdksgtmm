local function GetStatLevel(statName)
    local d = LP:FindFirstChild("Data")
    local st = d and d:FindFirstChild("Stats")
    local s = st and st:FindFirstChild(statName)
    local lv = s and s:FindFirstChild("Level")
    return lv and tonumber(lv.Value) or 0
end

local function GetDataNum(key)
    local d = LP:FindFirstChild("Data")
    local v = d and d:FindFirstChild(key)
    return v and tonumber(v.Value) or 0
end

local function AddPoint(statName, amount)
    amount = math.floor(tonumber(amount) or 0)
    if amount <= 0 then return end
    local args = {
        "AddPoint",
        statName,
        amount
    }
    pcall(function()
        RS:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer(unpack(args))
    end)
end

local function DistributeRemainderMeleeDefense()
    local pts = GetDataNum("Points")
    if pts <= 0 then return end

    local meleeLv = GetStatLevel("Melee")
    local defLv = GetStatLevel("Defense")
    local meleeCap = math.max(0, 2800 - meleeLv)
    local defCap = math.max(0, 2800 - defLv)

    local half = math.floor(pts / 2)
    local addMelee = math.min(half, meleeCap)
    local addDef = math.min(pts - addMelee, defCap)

    if addDef < (pts - addMelee) then
        addMelee = math.min(pts - addDef, meleeCap)
    end

    if addMelee > 0 then
        AddPoint("Melee", addMelee)
        task.wait(0.25)
    end
    if addDef > 0 then
        AddPoint("Defense", addDef)
        task.wait(0.25)
    end
end

local function HasInvestedOtherStats()
    for _, name in ipairs({ "Melee", "Defense", "Gun", "Demon Fruit" }) do
        if GetStatLevel(name) > 1 then
            return true
        end
    end
    return false
end

local function EnsureSwordStat()
    local d = LP:FindFirstChild("Data")
    if not d then
        Say("Đang chờ dữ liệu nhân vật tải...")
        return false
    end

    local swordLv = GetStatLevel("Sword")
    if swordLv >= 2800 then
        if S.NeedDistribute then
            S.NeedDistribute = false
            DistributeRemainderMeleeDefense()
        end
        if S.FragFarm and (S.FragTarget or 2500) <= 2500 then
            S.FragFarm = false
            S.FragTarget = nil
            HopLow("Đã đủ 2800 Sword Stat sau khi farm Fragment -> Hop Low tiếp tục")
            return false
        end
        return true
    end

    if S.RK or S.Main then
        HopLow("Stat Sword chưa đủ 2800 (" .. swordLv .. "/2800) -> Hop Low xử lý Stat")
        return false
    end

    if G._Indra and G._Indra.Run and type(G._Indra.Stop) == "function" then
        pcall(G._Indra.Stop)
    end

    S.cur = ("Stat Sword (%d/2800)"):format(swordLv)
    local pts = GetDataNum("Points")
    local needSword = 2800 - swordLv

    if pts >= needSword then
        Say(("Đang cộng %d điểm vào Sword (%d -> 2800)..."):format(needSword, swordLv))
        AddPoint("Sword", needSword)
        task.wait(0.4)
        DistributeRemainderMeleeDefense()
        return GetStatLevel("Sword") >= 2800
    end

    if HasInvestedOtherStats() then
        local frags = GetDataNum("Fragments")
        if frags >= 2500 then
            Say("Đang Reset Stat (2,500 Fragments) để nâng 2800 Sword...")
            Inv("BlackbeardReward", "Refund", "1")
            task.wait(0.2)
            Inv("BlackbeardReward", "Refund", "2")
            task.wait(0.6)

            local newSword = GetStatLevel("Sword")
            local newPts = GetDataNum("Points")
            local toAdd = math.min(2800 - newSword, newPts)
            if toAdd > 0 then
                Say(("Đang nâng %d điểm vào Sword (mục tiêu 2800)..."):format(toAdd))
                AddPoint("Sword", toAdd)
                task.wait(0.4)
            end

            Say("Đang chia đều điểm dư vào Melee và Defense...")
            DistributeRemainderMeleeDefense()
            S.NeedDistribute = false

            if S.FragFarm then
                S.FragFarm = false
                HopLow("Đã Reset & nâng đủ 2800 Sword -> Hop Low tiếp tục")
            end
            return GetStatLevel("Sword") >= 2800
        else
            S.FragFarm = true
            S.FragTarget = 2500
            S.noAttack = false
            S.target = nil
            if S.Fly then Float(false) end
            Say(("Thiếu Fragment để Reset Stat (%d/2500) -> Đang chạy Auto Farm Fragment..."):format(frags))

            if G._FragFarmLoaded ~= game.JobId then
                G._FragFarmLoaded = game.JobId
                task.spawn(function()
                    local ok, err = pcall(function()
                        loadstring(game:HttpGet(FRAG_URL))()
                    end)
                    if not ok then
                        warn("[AutoFrag]", err)
                        G._FragFarmLoaded = nil
                    end
                end)
            end
            task.wait(1)
            return false
        end
    else
        if pts > 0 then
            AddPoint("Sword", math.min(needSword, pts))
            task.wait(0.3)
        end
        return true
    end
end

