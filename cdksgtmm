local function HopLowElite(reason)
    if not S.Run or S.Hopping then return end
    S.Hopping = true
    local finalReason = reason or "Đang quét server tìm Elite..."
    LogHopReason("HopLowElite [Đặt trước & Né SV Elite]: " .. finalReason)
    ReleaseEliteClaim()
    Float(false)
    Say(finalReason)

    local function TeleportToJob(jobId)
        if not jobId or jobId == "" or jobId == tostring(game.JobId) then return end
        local browser = RS:FindFirstChild("__ServerBrowser")
        if browser then
            local ok = pcall(function() browser:InvokeServer("teleport", jobId) end)
            if not ok then
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LP) end)
            end
        else
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LP) end)
        end
    end

    task.spawn(function()
        local vis = { [tostring(game.JobId)] = os.time() }
        local myUid = tostring(LP.UserId)

        while S.Run do
            local now = os.time()
            for k, v in pairs(vis) do
                if now - v > 300 then vis[k] = nil end
            end

            -- Chỉ đọc elite_roster & elite_killed_bl -> thoải mái hop vào server đang farm Bones/Mastery
            local eliteRoster = ReadEliteRoster()
            local killedBL = ReadEliteKilledBL()
            local busyEliteJobs = {}
            for uid, info in pairs(eliteRoster) do
                if uid ~= myUid then
                    if info.jobId ~= "" then busyEliteJobs[info.jobId] = true end
                    if info.reservedJobId ~= "" then busyEliteJobs[info.reservedJobId] = true end
                end
            end

            local function isEliteIgnored(id)
                if not id or id == "" or id == tostring(game.JobId) then return true end
                if vis[id] then return true end
                if killedBL[id] then return true end
                if busyEliteJobs[id] then return true end
                return false
            end

            local byJob, pool, completed = {}, {}, 0
            local fastFound = 0
            local br = RS:FindFirstChild("__ServerBrowser")
            if br then
                local totalPages = 150
                for page = 1, totalPages do
                    task.spawn(function()
                        for _ = 1, 2 do
                            if not S.Run then break end
                            local ok, res = pcall(function() return br:InvokeServer(page) end)
                            if ok and type(res) == "table" then
                                for jobId, data in pairs(res) do
                                    local id = tostring(jobId)
                                    if not isEliteIgnored(id) and not byJob[id] then
                                        local count = (type(data) == "table" and tonumber(data.Count)) or tonumber(data) or 99
                                        if count >= 1 and count <= 7 then
                                            local reg = (type(data) == "table" and tostring(data.Region or "")) or "Unknown"
                                            local numericPing = 90
                                            if reg:find("Sing") then
                                                numericPing = 40
                                            elseif reg:find("Japan") then
                                                numericPing = 95
                                            elseif reg:find("Germ") then
                                                numericPing = 190
                                            elseif reg:find("United States") or reg:find("US") then
                                                numericPing = 235
                                            end
                                            byJob[id] = { id = id, cnt = count, ping = numericPing, region = reg }
                                            if count <= 5 and numericPing <= 100 then
                                                fastFound += 1
                                            end
                                        end
                                    end
                                end
                                break
                            end
                            task.wait(0.04)
                        end
                        completed += 1
                    end)
                end

                local start = os.clock()
                repeat
                    task.wait(0.05)
                    local elapsed = os.clock() - start
                until not S.Run or completed >= totalPages or elapsed >= 3.5 or (elapsed >= 0.45 and fastFound >= 12)

                for _, sv in pairs(byJob) do
                    pool[#pool + 1] = sv
                end
            end

            if #pool == 0 and S.Run then
                local cursor = ""
                local pageCount = 0
                while cursor and pageCount < 50 and S.Run do
                    pageCount += 1
                    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
                        game.PlaceId, (cursor ~= "" and "&cursor=" .. cursor or ""))
                    local ok, res = pcall(function() return game:HttpGet(url) end)
                    if not ok or not res then break end
                    local okJson, data = pcall(function() return HttpService:JSONDecode(res) end)
                    if not okJson or not data or not data.data then break end

                    for _, s in ipairs(data.data) do
                        local id = tostring(s.id)
                        local playing = tonumber(s.playing) or 99
                        local maxP = tonumber(s.maxPlayers) or 12
                        if playing >= 1 and playing <= 7 and playing < maxP and not isEliteIgnored(id) and not byJob[id] then
                            local item = {
                                id = id,
                                cnt = playing,
                                ping = tonumber(s.ping) or 999,
                                region = "Unknown"
                            }
                            byJob[id] = item
                            pool[#pool + 1] = item
                        end
                    end

                    if #pool >= 15 then break end
                    cursor = data.nextPageCursor
                    if not cursor or cursor == "" then break end
                end
            end

            if not S.Run then break end
            if #pool == 0 then
                vis = { [tostring(game.JobId)] = os.time() }
                Say("Chưa thấy server Elite trống, đang quét lại...")
            else
                local tLow, tMid, tHigh = {}, {}, {}
                for _, sv in ipairs(pool) do
                    if sv.ping <= 100 then
                        tLow[#tLow + 1] = sv
                    elseif sv.ping <= 180 then
                        tMid[#tMid + 1] = sv
                    else
                        tHigh[#tHigh + 1] = sv
                    end
                end
                local function shuffle(arr)
                    for i = #arr, 2, -1 do
                        local j = math.random(i)
                        arr[i], arr[j] = arr[j], arr[i]
                    end
                end
                shuffle(tLow)
                shuffle(tMid)
                shuffle(tHigh)
                pool = {}
                for _, group in ipairs({ tLow, tMid, tHigh }) do
                    for _, sv in ipairs(group) do
                        pool[#pool + 1] = sv
                    end
                end

                for i = 1, math.min(#pool, 8) do
                    if not S.Run then break end
                    local sv = pool[i]
                    if sv.id ~= "" and sv.id ~= tostring(game.JobId) then
                        local rosterNow = ReadEliteRoster()
                        local killedNow = ReadEliteKilledBL()
                        local conflict = killedNow[sv.id] == true
                        if not conflict then
                            for uid, info in pairs(rosterNow) do
                                if uid ~= myUid and (info.jobId == sv.id or info.reservedJobId == sv.id) then
                                    conflict = true
                                    break
                                end
                            end
                        end

                        if not conflict then
                            local ts = os.time()
                            rosterNow[myUid] = {
                                userId = myUid,
                                name = LP.Name,
                                jobId = "",
                                reservedJobId = sv.id,
                                reserveTime = ts,
                                joined = ts,
                                time = ts,
                                state = "reserving"
                            }
                            WriteEliteRoster(rosterNow)
                            -- Khóa kiểm tra chéo 0.08s chống 2 acc Elite đặt trùng cùng thời điểm
                            task.wait(0.08)
                            local verifyRoster = ReadEliteRoster()
                            local wonLock = (verifyRoster[myUid] and verifyRoster[myUid].reservedJobId == sv.id)
                            if wonLock then
                                for uid, info in pairs(verifyRoster) do
                                    if uid ~= myUid and (info.jobId == sv.id or info.reservedJobId == sv.id) then
                                        local otherTs = info.reserveTime > 0 and info.reserveTime or info.joined
                                        if not IsHigherPriority(ts, myUid, otherTs, uid) then
                                            wonLock = false
                                            break
                                        end
                                    end
                                end
                            end

                            if wonLock then
                                S.farmStatus = FormatEliteAccStatus(verifyRoster)
                                vis[sv.id] = os.time()
                                Say(("Đặt trước SV Elite %s (%d/7 người, ~%dms)"):format(sv.id:sub(1, 8), sv.cnt, sv.ping))
                                TeleportToJob(sv.id)
                                task.wait(2.2)
                            elseif verifyRoster[myUid] then
                                verifyRoster[myUid] = nil
                                WriteEliteRoster(verifyRoster)
                            end
                        end
                    end
                end
            end
            task.wait(0.25)
        end
    end)
end

local function CheckEliteAntiColocation()
    local jid = tostring(game.JobId)
    local myUid = tostring(LP.UserId)
    local now = os.time()
    local roster = ReadEliteRoster()

    if S.EliteAntiJob ~= jid then
        S.EliteAntiJob = jid
        local myEntry = roster[myUid]
        if myEntry and (myEntry.jobId == jid or myEntry.reservedJobId == jid) and myEntry.joined then
            S.EliteAntiJoined = myEntry.joined
        else
            S.EliteAntiJoined = now
        end
        S.EliteLastHB = 0
    end

    local myJoined = S.EliteAntiJoined or now

    -- 1. Kiểm tra trùng server trong elite_roster.json (acc vào trước ở lại, acc vào sau hop né)
    for uid, info in pairs(roster) do
        if uid ~= myUid and info.jobId == jid then
            if not IsHigherPriority(myJoined, myUid, info.joined, uid) then
                HopLowElite(("Trùng server Elite với %s -> Hop Low né"):format(
                    tostring(info.name ~= "" and info.name or uid)
                ))
                return true
            end
        end
    end

    -- 2. Kiểm tra nếu server này nằm trong blacklist 15p đã kill Elite (và không thấy Elite sống)
    local killedBL = ReadEliteKilledBL()
    if killedBL[jid] and not Find(ELITE) then
        HopLowElite("Server đã kill Elite (Blacklist 15p) -> Hop Low")
        return true
    end

    -- 3. Ghi xác nhận giữ slot server Elite (heartbeat mỗi 2s)
    if os.clock() - (S.EliteLastHB or 0) >= 2.0 then
        S.EliteLastHB = os.clock()
        roster[myUid] = {
            userId = myUid,
            name = LP.Name,
            jobId = jid,
            reservedJobId = "",
            reserveTime = 0,
            joined = myJoined,
            time = now,
            state = "active"
        }
        WriteEliteRoster(roster)
    end
    S.farmStatus = FormatEliteAccStatus(roster)

    -- 4. Kiểm tra thực tế trong server nếu có acc Elite khác đang đứng cùng server
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP then
            local plUid = tostring(pl.UserId)
            local altInfo = roster[plUid]
            if altInfo and not IsHigherPriority(myJoined, myUid, altInfo.joined, plUid) then
                HopLowElite(("Nhường server Elite cho acc vào trước %s -> Hop Low né"):format(pl.Name))
                return true
            end
        end
    end

    return false
end

local function Hop(dest, over)
    if not S.Run then return end
    local isGuitar = over and over.GuitarEnabled
    if not EscapeZones(isGuitar and Sea() == 2 and P.Ship or nil) then return end
    local key = (dest or "") .. HttpService:JSONEncode(over or {})
    if G._RKHop == game.JobId then
        if G._RKD ~= key then
            HopLow("Đổi mục tiêu RealKidHop -> Hop Low refresh")
            return
        end
        if S.RK and G._RKHopStart then
            local elapsed = os.clock() - G._RKHopStart
            if dest == "Dough King" and elapsed >= 1200 then
                HopLow("Chạy RealKidHop tìm Dough King quá 20 phút vẫn ở trong server -> Hop Low ngẫu nhiên")
            elseif (dest == "Pirate Raid" or dest == "Soul Reaper" or dest == "Cake Queen") and elapsed >= 300 then
                HopLow(("Chạy RealKidHop tìm %s quá 5 phút vẫn ở trong server -> Hop Low ngẫu nhiên"):format(dest))
            end
        end
        return
    end
    local targetLbl = dest or (isGuitar and "Skull Guitar" or "Custom")
    LogHopReason("RealKidHop: Chạy tìm " .. tostring(targetLbl))
    G._RKHop, G._RKD, G._RKLbl, S.RK = game.JobId, key, targetLbl, S.cur
    G._RKHopStart, G._RKHopDest = os.clock(), tostring(dest or "")
    Say("Đang chạy RealKidHop tìm: " .. tostring(G._RKLbl))
    local cfg = {}
    for k, v in pairs(BASE) do cfg[k] = v end
    local f = "RealKidHop_" .. LP.UserId .. ".json"
    pcall(function()
        local old = HttpService:JSONDecode(readfile(f))
        if type(old.VisitedJobs) == "table" then cfg.VisitedJobs = old.VisitedJobs end
    end)
    for jid in pairs(LoadIgnoredJobs()) do
        cfg.VisitedJobs[jid] = true
    end
    if dest then cfg.Destination = dest end
    for k, v in pairs(over or {}) do cfg[k] = v end
    pcall(writefile, f, HttpService:JSONEncode(cfg))
    Float(false)
    task.spawn(function()
        G.Key = RK_KEY
        local ok, e = pcall(function() loadstring(game:HttpGet(RK_URL))() end)
        if not ok then warn("[Auto]", e) end
    end)
end

