local function Float(on)
    local r, h = Root()
    if not r then
        S.Fly = on
        return
    end
    local b = r:FindFirstChild("AxF")
    local g = r:FindFirstChild("AxG")
    if on then
        if h then
            h.Sit = false
            h.PlatformStand = false
        end
        if not b then
            b = Instance.new("BodyVelocity")
            b.Name, b.MaxForce, b.Velocity, b.P, b.Parent = "AxF", V3(9e9, 9e9, 9e9), V3(), 1e4, r
        end
        if not g then
            g = Instance.new("BodyGyro")
            g.Name, g.MaxTorque, g.P, g.D, g.CFrame, g.Parent = "AxG", V3(9e9, 9e9, 9e9), 9e4, 500, r.CFrame, r
        end
        r.AssemblyLinearVelocity = V3()
        r.AssemblyAngularVelocity = V3()
    else
        StopTween()
        if b then b:Destroy() end
        if g then g:Destroy() end
        if r.Parent then
            for _, p in ipairs(r.Parent:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide, p.CanTouch = true, true end
            end
        end
    end
    S.Fly = on
