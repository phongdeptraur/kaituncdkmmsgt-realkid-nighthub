            elseif hasTushita and hasValkyrie and hasFractal and not hasYama then
                Engine.CurrentObjective = "Yama"
                if Engine.CurrentNightHubMode ~= "Yama" then
                    lblStatus.Text = "Trạng thái: ⚔️ Đã có Mirror Fractal! Đang thiếu kiếm Yama -> Bật Night Hub Auto Yama... " .. timeDisplay
                    DispatchNightHubInstant("Yama")
                end
            elseif yamaMastery < 350 or tushitaMastery < 350 then
                if Engine.NightHubRunning then
                    Engine.NightHubRunning = false
                    Engine.CurrentNightHubMode = nil
                    getgenv()._NightHubExecuted = nil
                end
                Engine.CurrentObjective = "MasteryFarm"

                if yamaMastery < 350 then
                    lblStatus.Text = string.format("Trạng thái: ⚔️ Đang cày Bone Haunted Castle (Gom 2-3 quái) cho YAMA [%d/350]... %s", yamaMastery, timeDisplay)
                    ExecuteBoneFarmForSword("Yama", yamaMastery)
                elseif tushitaMastery < 350 then
                    lblStatus.Text = string.format("Trạng thái: ⚔️ Yama đã đủ 350! Đang cày Bone (Gom 2-3 quái) cho TUSHITA [%d/350]... %s", tushitaMastery, timeDisplay)
                    ExecuteBoneFarmForSword("Tushita", tushitaMastery)
                end
            else
                SwitchUIToCDKMode()
                Engine.CurrentObjective = "AutoCDK"

                if Engine.NightHubRunning and Engine.ActiveCDKMode ~= "Tushita2" then
                    Engine.NightHubRunning = false
                    Engine.CurrentNightHubMode = nil
                    getgenv()._NightHubExecuted = nil
                end

                if hasCDK then
                    Engine.CDKBossStartTime = nil
                    lblCDKBoss.Text = "👑 Cursed Skeleton Boss: 🟢 ĐÃ HOÀN THÀNH LẤY CDK!"
                    lblCDKBoss.TextColor3 = Color3.fromRGB(80, 255, 140)
                    lblStatus.Text = "Trạng thái: 👑 HOÀN TẤT TẤT CẢ! BẠN ĐÃ SỞ HỮU CURSED DUAL KATANA (CDK) TRONG KHO ĐỒ! " .. timeDisplay
                    lblStatus.TextColor3 = Color3.fromRGB(80, 255, 140)
                else
                    local cdkProg = SharedCDK.Data or Scanner:GetCDKQuestStatus()
                    ProcessCDKPipeline(cdkProg, timeDisplay)
                end
            end
        end

        task.wait(0.3)
    end
end)
