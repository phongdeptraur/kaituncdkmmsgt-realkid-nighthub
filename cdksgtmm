                                    end
                                end
                            else
                                Engine.CurrentCombatTarget = nil
                                Engine.WaitingCakeQueenCoop = false
                                Engine.HasArrivedCakeQueenCoop = false
                                Engine.CakeQueenCoopApproved = false
                                -- Vẫn log Online = true vào cakequeen_session.txt, chỉ xóa tín hiệu boss của server hiện tại
                                pcall(function() Engine:UpdateCakeQueenSession(false, true, false) end)

                                if Engine.WasTargetingCakeQueen and (not Engine.WaitingHeavenlyUntil or os.clock() > Engine.WaitingHeavenlyUntil) then
                                    Engine.WaitingHeavenlyUntil = os.clock() + 6 -- Chờ 6s để game chuyển cảnh teleport vào Heavenly Dimension
                                    Engine.WasTargetingCakeQueen = false
                                end

                                if Engine.WaitingHeavenlyUntil and os.clock() < Engine.WaitingHeavenlyUntil then
                                    local remainWait = math.ceil(Engine.WaitingHeavenlyUntil - os.clock())
                                    lblStatus.Text = string.format("Trạng thái: ⏳ [CDK TUSHITA 3] Đã diệt Cake Queen! Đang chờ teleport vào Heavenly Dimension (%ds)...", remainWait)
                                    if (root.Position - CAKE_QUEEN_SPAWN.Position).Magnitude > 25 then
                                        TweenToPosition(CAKE_QUEEN_SPAWN.Position, CONFIG.TweenSpeed)
                                    end
                                else
                                    Engine.WaitingHeavenlyUntil = nil
                                    local totalOnlineClones = Engine:GetOnlineCakeQueenClonesCount()
                                    if totalOnlineClones <= 1 then
                                        lblStatus.Text = "Trạng thái: 🌐 [SOLO CAKE QUEEN - 1 ACC ONLINE] Chỉ còn mình online -> Hop RealKid + NightAPI (Cake Queen)... " .. timeDisplay
                                        DispatchRealKidHop("Cake Queen", true)
                                    else
                                        local coopSig = Engine:GetBestCakeQueenCoopSignal(false)
                                        if coopSig and coopSig.JobId then
                                            lblStatus.Text = string.format("Trạng thái: 🤝 [CO-OP CAKE QUEEN] Ưu tiên Hop vào tín hiệu của %s (Job: %s | %d/%d ng | Online: %d acc)... %s", tostring(coopSig.HostName), coopSig.JobId:sub(1, 8), coopSig.Players, coopSig.MaxPlayers, totalOnlineClones, timeDisplay)
                                            if (os.clock() - (Engine.LastCoopJoinAttempt or 0)) >= 1.0 then
                                                Engine.LastCoopJoinAttempt = os.clock()
                                                DirectTeleportToJob(coopSig.JobId, coopSig.PlaceId)
                                            end
                                        else
                                            lblStatus.Text = string.format("Trạng thái: 🌐 [CDK TUSHITA 3 - %d ACC ONLINE] Chưa có tín hiệu -> Hop RealKid + NightAPI (Cake Queen)... %s", totalOnlineClones, timeDisplay)
                                            DispatchRealKidHop("Cake Queen", true)
                                        end
                                    end
                                end
                            end
                        end
                    end

                else
                    -- NHIỆM VỤ CUỐI: CURSED SKELETON BOSS
                    pcall(function() Engine:UpdateCakeQueenSession(false, true, true) end)
                    if Inventory:HasItem("cursed dual katana") then
                        Engine.BringMob = false; _G.BringMobs = false; ClearAllMagnetMobs(); Engine.CurrentCombatTarget = nil
                        lblStatus.Text = "Trạng thái: 👑 [CDK HOÀN TẤT] 🎉 ĐÃ SỞ HỮU CURSED DUAL KATANA!"
                    else
                        Engine.ActiveCDKMode = "CDK_Boss"; Engine.BringMob = true; _G.BringMobs = true
                        pcall(function()
                            commF:InvokeServer("CDKQuest", "Progress", "Good")
                            commF:InvokeServer("CDKQuest", "Progress", "Evil")
                            commF:InvokeServer("CDKQuest", "StartTrial", "Boss")
                            commF:InvokeServer("CDKQuest", "SpawnBoss")
                        end)
                        local bAct, _, _, _, bMod, bRoot, bHum = ScanCrossContinentalBoss({ "Cursed Skeleton", "Skeleton Boss" })
                        if bAct and bRoot and bHum and bHum.Health > 0 then
                            Engine.CurrentCombatTarget = bMod
                            EquipSpecificSword("Tushita")
                            lblStatus.Text = string.format("Trạng thái: 💀 [CDK FINAL] Diệt Cursed Skeleton Boss (%.0f/%.0f)...", bHum.Health, bHum.MaxHealth)
                            FlyOverTarget(bRoot)
                        else
                            Engine.CurrentCombatTarget = nil
                            local stagingPos = Vector3.new(-12318.2, 601.9, -6538.7)
                            TweenToPosition(stagingPos, CONFIG.TweenSpeed)
                            pcall(function()
                                local door = workspace.Map.Turtle.Cursed.BossDoor
                                local doorPos = door:IsA("BasePart") and door.Position or door:GetPivot().Position
                                TweenToPosition(doorPos, CONFIG.TweenSpeed)
                                commF:InvokeServer("CDKQuest", "OpenDoor", "Boss")
                                commF:InvokeServer("CDKQuest", "StartTrial", "Boss")
                                commF:InvokeServer("CDKQuest", "SpawnBoss")
                            end)
                        end
                    end
                end
            end
        end

        task.wait(0.2)
    end
end)

-- =========================================================================
-- [UNLOAD KERNEL]
-- =========================================================================
function Engine:Unload()
    pcall(function() self:UpdateMasterySession(false) end)
    pcall(function() self:UpdateCakeQueenSession(false, true, true) end)
    self.IsRunning = false
    self.FastAttackActive = false
    self.BringMob = false
    _G.BringMobs = false
    self.NoClipActive = false
    self.IsHopping = false
    self.CurrentCombatTarget = nil
    self.WaitReaper = false

    if self.CurrentTween then pcall(function() self.CurrentTween:Cancel() end) end
    ClearAllMagnetMobs()

    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("__AxiomFlightStabilizer") then hrp.__AxiomFlightStabilizer:Destroy() end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true; part.CanTouch = true end
        end
    end

    for _, conn in ipairs(self.Connections) do
        if conn and typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
    end
    for _, inst in ipairs(self.Instances) do pcall(function() inst:Destroy() end) end
    getgenv()._AxiomTushitaMaster = nil
    end

btnUnload.MouseButton1Click:Connect(function() Engine:Unload() end)

