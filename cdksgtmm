local stN = {}
local function CDK()
    if not Need(3) then return end
    local y, t = Mas("Yama"), Mas("Tushita")
    if y < 350 or t < 350 then
        S.cdkStatus = nil
        S.noAttack = false
        local needSw = (y < 350) and "Yama" or "Tushita"
        Bag(needSw, true)
        if CheckAntiColocation(P.Haunted, "Bones/Mastery") then return end
        return Main({ auto_farm_general = true, weapon_choice = "Sword" }, ("Đang farm Mastery (%s): Yama %d/350 | Tushita %d/350"):format(needSw, y, t))
    end
    S.farmStatus = nil
    local E, Gd = Poll()
    S.cdkStatus = (" [Good: %d | Bad: %d]"):format(Gd, E)
    if S.Main or (S.RK and S.RK ~= "Cursed Dual Katana" and tostring(S.RK):sub(1, 6) ~= "CDK - ") then
        return HopLow("Đã đủ 350 Mastery -> Hop Low làm nhiệm vụ CDK")
    end

    if E == -1 or Gd == -1 then
        Say("Đang kiểm tra tiến độ 6 nhiệm vụ CDK...")
        return
    end
    local alu = Cnt("Alucard Fragment")
    local ea, ed = QS(E)
    local ga, gd = QS(Gd)
    local runGood = (ga ~= nil) or (E == -2 and gd < 3)

    if not runGood and alu < 6 and ed < 3 and ea == 1 then
        S.noAttack = true
        Unequip()
    end

    Inv("CDKQuest", "OpenDoor", true)

    local function start(k)
        stN[k] = (stN[k] or 0) + 1
        if stN[k] > 10 then
            stN[k] = 0
            return HopLow("Nhận nhiệm vụ CDK nhánh " .. k .. " quá 10 lần không được -> Hop Low")
        end
        if stN[k] > 8 then
            local r = Root()
            if r and (r.Position - P.Temple).Magnitude > 25 then Go(P.Temple, nil, "Remote nhận quest lỗi -> tween tới đền CDK") end
        end
        Say("Đang nhận nhiệm vụ CDK nhánh " .. k .. " (lần " .. stN[k] .. "/10)...")
        Inv("CDKQuest", "OpenDoor")
        Inv("CDKQuest", "OpenDoor", true)
        Inv("CDKQuest", "Progress", k)
        Inv("CDKQuest", "StartTrial", k)
        pT = 0
        task.wait(0.4)
    end
    if ea then stN.Evil = 0 end
    if ga then stN.Good = 0 end
    if not runGood and alu < 6 and ed < 3 then
        local step = "CDK - Yama Q" .. (ea or "?")
        if S.RK and S.RK ~= step then return HopLow("Đã xong " .. tostring(S.RK) .. " -> Hop Low qua " .. step) end
        S.cur = step
        if ea ~= 1 then Bag("Yama") end
        if not ea then return start("Evil") end
        ({ Y1, Y2, Y3 })[ea]()
    elseif alu < 6 and gd < 3 then
        local step = "CDK - Tushita Q" .. (ga or "?")
        if S.RK and S.RK ~= step then return HopLow("Đã xong " .. tostring(S.RK) .. " -> Hop Low qua " .. step) end
        S.cur = step
        if ga ~= 1 then Bag("Tushita") end
        if not ga then return start("Good") end
        ({ T1, T2, T3 })[ga]()
    else
        if alu < 6 then
            invT = 0
            alu = Cnt("Alucard Fragment")
        end
        if alu < 6 then
            pT = 0
            Say(("Chưa đủ 6/6 nhiệm vụ CDK (%d/6 Alucard Fragment) -> Đang đồng bộ lại..."):format(alu))
            task.wait(0.5)
            return
        end
        local step = "CDK - Boss Cuối"
        if S.RK and S.RK ~= step then return HopLow("Đã xong " .. tostring(S.RK) .. " -> Hop Low qua " .. step) end
        S.cur = step
        Bag("Tushita")
        Final()
    end
end

