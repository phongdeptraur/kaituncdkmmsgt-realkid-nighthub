function Engine:CheckSameScriptCloneInServer()
    local myUid = tostring(LocalPlayer.UserId)
    local curJob = tostring(game.JobId)
    local now = os.time()
    local myClaim = self.MasteryServerClaimTime or now
    local sessions = self:ReadAndCleanMasterySessions()

    -- 1. Kiểm tra trong mastery_session.txt xem có clone nào đang ở chung JobId hoặc trong danh sách Players không
    for uid, info in pairs(sessions) do
        if tostring(uid) ~= myUid then
            local sameJob = (tostring(info.JobId) == curJob)
            local inServerPlayer = Players:GetPlayerByUserId(tonumber(uid) or 0) ~= nil
            if sameJob or inServerPlayer then
                local otherClaim = tonumber(info.ClaimTime) or 0
                -- Nếu clone kia đã vào/claim server trước (hoặc cùng lúc nhưng UserId nhỏ hơn) thì acc này chủ động Hop Low
                if otherClaim < myClaim or (otherClaim == myClaim and (tonumber(uid) or 0) < LocalPlayer.UserId) then
                    return true, tostring(info.Name or uid)
                end
            end
        end
    end

    -- 2. Kiểm tra trực tiếp trong game xem có player nào khác gắn bộ ổn định bay của script (__AxiomFlightStabilizer) không
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hrp:FindFirstChild("__AxiomFlightStabilizer") then
                local pUid = tostring(p.UserId)
                local pSession = sessions[pUid]
                if not pSession then
                    -- Nếu player đó chạy chung script nhưng chưa ghi session hoặc đang ở chung server, ưu tiên theo UserId để 1 acc ở lại, 1 acc hop
                    if p.UserId < LocalPlayer.UserId then
                        return true, p.DisplayName or p.Name
                    end
                end
            end
        end
    end

    return false, nil
end

