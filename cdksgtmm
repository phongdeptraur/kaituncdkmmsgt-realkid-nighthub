local function SyncItemsPreTeamAndInGame()
    local foundAny = false
    local matCounts = {
        ["Mirror Fractal"] = 0,
        ["Dark Fragment"]  = 0,
        ["Bones"]          = 0,
        ["Ectoplasm"]      = 0,
    }

    -- Quét qua ItemReplicationService (Hoạt động ngay cả khi chưa chọn Team)
    pcall(function()
        local irsInst = ReplicatedStorage:FindFirstChild("ItemReplicationService")
        local cfgInst = ReplicatedStorage:FindFirstChild("ItemConfig")
        local IRS = (typeof(SafeRequire) == "function" and SafeRequire(irsInst)) or (irsInst and require(irsInst))
        local CfgStorage = cfgInst and cfgInst:FindFirstChild("Storage") and ((typeof(SafeRequire) == "function" and SafeRequire(cfgInst.Storage)) or require(cfgInst.Storage))
        local KeysModule = irsInst and irsInst:FindFirstChild("KEYS") and ((typeof(SafeRequire) == "function" and SafeRequire(irsInst.KEYS)) or require(irsInst.KEYS))

        if IRS and IRS._UserCache then
            local userItems = IRS._UserCache[LocalPlayer.UserId] or IRS._UserCache[tostring(LocalPlayer.UserId)]
            if userItems and typeof(userItems.GetItems) == "function" then
                local categoriesToScan = {
                    KeysModule and KeysModule.MOVESET or "Moveset",
                    KeysModule and KeysModule.MATERIAL or "Material",
                    KeysModule and KeysModule.ACCESSORY or "Accessory",
                    KeysModule and KeysModule.QUANTITY or "Quantity"
                }

                for _, catKey in ipairs(categoriesToScan) do
                    local okCat, items = pcall(function() return userItems:GetItems(catKey) end)
                    if okCat and type(items) == "table" then
                        for _, itemEntry in pairs(items) do
                            foundAny = true
                            local itemId = tostring(itemEntry.ItemId or itemEntry.Name or "")
                            local count = tonumber(itemEntry.Value or itemEntry.Count or itemEntry.Quantity or 1) or 1
                            local label = itemId

                            if CfgStorage and typeof(CfgStorage.match) == "function" then
                                pcall(function()
                                    local matchData = CfgStorage.match(itemId):unwrap()
                                    if matchData and matchData.Index then
                                        label = matchData.Index.DebugLabel or matchData.Index.StorageKey or label
                                    end
                                end)
                            end

                            label = label:gsub(" %[.-%]", "")

                            if label == "Tushita" then State.Items.Tushita = true end
                            if label == "Yama" then State.Items.Yama = true end
                            if label == "Skull Guitar" then State.Items.SkullGuitar = true end
                            if label == "Cursed Dual Katana" then State.Items.CDK = true end
                            if label == "Valkyrie Helm" then State.Items.ValkyrieHelm = true end

                            if matCounts[label] ~= nil then
                                matCounts[label] = math.max(matCounts[label], count)
                            end
                        end
                    end
                end
            end
        end
    end)

    -- Nếu đã vào Team và CommF sẵn sàng, quét bổ sung getInventory
    RefreshRemotes()
    if LocalPlayer.Team ~= nil and CommF then
        local ok, invList = pcall(function() return CommF:InvokeServer("getInventory") end)
        if ok and type(invList) == "table" and next(invList) ~= nil then
            foundAny = true
            for _, item in pairs(invList) do
                if type(item) == "table" then
                    local name = tostring(item.Name or item.Item or "")
                    local count = tonumber(item.Count or item.Quantity or 1) or 1
                    local mas = tonumber(item.Mastery or 0) or 0

                    if name == "Tushita" then
                        State.Items.Tushita = true
                        State.Items.TushitaMas = math.max(State.Items.TushitaMas, mas)
                    elseif name == "Yama" then
                        State.Items.Yama = true
                        State.Items.YamaMas = math.max(State.Items.YamaMas, mas)
                    elseif name == "Skull Guitar" then
                        State.Items.SkullGuitar = true
                    elseif name == "Cursed Dual Katana" then
                        State.Items.CDK = true
                    elseif name == "Valkyrie Helm" then
                        State.Items.ValkyrieHelm = true
                    elseif matCounts[name] ~= nil then
                        matCounts[name] = count
                    end
                end
            end
        end
    end

    State.Items.MirrorFractal = (matCounts["Mirror Fractal"] >= 1) or State.Items.MirrorFractal
    State.Items.DarkFragment  = matCounts["Dark Fragment"]
    State.Items.Bones         = matCounts["Bones"]
    State.Items.Ectoplasm     = matCounts["Ectoplasm"]

    -- Đồng bộ ngược lại bảng Inventory (nếu có)
    if typeof(Inventory) == "table" and Inventory.PermanentOwned then
        Inventory.PermanentOwned.Valkyrie = State.Items.ValkyrieHelm
        Inventory.PermanentOwned.Fractal  = State.Items.MirrorFractal
        Inventory.PermanentOwned.Tushita  = State.Items.Tushita
        Inventory.PermanentOwned.Yama     = State.Items.Yama
    end

    return foundAny
end

