local function Equip(name)
    if S.noAttack then
        Unequip()
        return nil
    end
    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    if not c:FindFirstChild("HasBuso") then Inv("Buso") end
    local t = c:FindFirstChildOfClass("Tool")
    if name then
        if name ~= "Sword" then
            if t and t.Name == name then return t end
            local b = LP.Backpack:FindFirstChild(name)
            if not b and os.clock() - lastLoad > 1 then
                lastLoad = os.clock()
                Inv("LoadItem", name)
                b = LP.Backpack:WaitForChild(name, 0.4)
            end
            if b and not S.noAttack then
                h:EquipTool(b)
                return b
            end
        end
        if t and t.ToolTip == "Sword" then return t end
        for _, i in ipairs(LP.Backpack:GetChildren()) do
            if i:IsA("Tool") and i.ToolTip == "Sword" then
                if not S.noAttack then
                    h:EquipTool(i)
                    return i
                end
            end
        end
        return (t and t.ToolTip == "Sword") and t or nil
    else
        if t and t.ToolTip == "Melee" then return t end
        for _, i in ipairs(LP.Backpack:GetChildren()) do
            if i:IsA("Tool") and i.ToolTip == "Melee" then
                if not S.noAttack then h:EquipTool(i) return i end
            end
        end
        if t and t.ToolTip == "Sword" then return t end
        for _, i in ipairs(LP.Backpack:GetChildren()) do
            if i:IsA("Tool") and i.ToolTip == "Sword" then
                if not S.noAttack then h:EquipTool(i) return i end
            end
        end
    end
    return t
end

