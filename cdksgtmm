    if type(decoded) == "table" then
        local rawClones = type(decoded.Clones) == "table" and decoded.Clones or {}
        local rawSignals = type(decoded.Signals) == "table" and decoded.Signals or {}

        for uid, cInfo in pairs(rawClones) do
            if type(cInfo) == "table" and tonumber(cInfo.Timestamp) and (now - tonumber(cInfo.Timestamp)) <= CONFIG.CakeQueenSessionTimeout then
                data.Clones[tostring(uid)] = cInfo
            else
                modified = true
            end
        end

        for jobId, sInfo in pairs(rawSignals) do
            local jStr = tostring(jobId)
            local pCnt = type(sInfo) == "table" and tonumber(sInfo.Players) or 0
            local mCnt = type(sInfo) == "table" and tonumber(sInfo.MaxPlayers) or 12
            local isNotExpired = type(sInfo) == "table" and tonumber(sInfo.Timestamp) and (now - tonumber(sInfo.Timestamp)) <= CONFIG.CakeQueenSessionTimeout
            local hasCloneWithBossInJob = false
            for _, cInfo in pairs(data.Clones) do
                if tostring(cInfo.JobId) == jStr and cInfo.HasCakeQueen ~= false then
                    hasCloneWithBossInJob = true
                    break
                end
            end

            if isNotExpired and hasCloneWithBossInJob and pCnt < mCnt then
                data.Signals[jStr] = sInfo
            else
                modified = true
            end
        end
    end

    if modified and typeof(writefile) == "function" then
        pcall(function()
            writefile(CONFIG.CakeQueenSessionFile, HttpService:JSONEncode(data))
        end)
    end

    return data
end

function Engine:UpdateCakeQueenSession(hasCakeQueen, forceDeleteServerSignal, isOfflineFromCoop)
    if typeof(writefile) ~= "function" then return end
    local now = os.time()
    local myUid = tostring(LocalPlayer.UserId)
    local curJob = tostring(game.JobId)
    local data = self:ReadAndCleanCakeQueenSessions()

    local playerCount = #Players:GetPlayers()
    local maxPlayers = tonumber(Players.MaxPlayers) or 12
    local isServerFull = (playerCount >= maxPlayers)

    -- Acc được tính là đang Online trong hệ thống CakeQueen Co-op khi đang ở nhiệm vụ Tushita 3 và chưa vào HeavenlyDimension
    local isOnlineCoop = (not isOfflineFromCoop) and (self.ActiveCDKMode == "Tushita3") and (not self.WasInsideHeavenly) and self.IsRunning

    if isOnlineCoop and curJob ~= "" then
        if hasCakeQueen then
            if not self.CakeQueenClaimTime then
                self.CakeQueenClaimTime = now
            end
        else
            self.CakeQueenClaimTime = nil
        end

        data.Clones[myUid] = {
            UserId       = LocalPlayer.UserId,
            Name         = tostring(LocalPlayer.Name),
            JobId        = curJob,
            PlaceId      = game.PlaceId,
            Online       = true,
            HasCakeQueen = (hasCakeQueen == true),
            AtCoopPoint  = (hasCakeQueen == true and self.HasArrivedCakeQueenCoop == true),
            Attacking    = (hasCakeQueen == true and self.CakeQueenCoopApproved == true),
            Timestamp    = now,
            ClaimTime    = self.CakeQueenClaimTime or now
        }

        if hasCakeQueen and not isServerFull and not forceDeleteServerSignal then
            local existing = data.Signals[curJob]
            data.Signals[curJob] = {
                JobId      = curJob,
                PlaceId    = game.PlaceId,
                HostUserId = (existing and existing.HostUserId) or LocalPlayer.UserId,
                HostName   = (existing and existing.HostName) or tostring(LocalPlayer.Name),
                ClaimTime  = (existing and tonumber(existing.ClaimTime)) or self.CakeQueenClaimTime or now,
                Players    = playerCount,
                MaxPlayers = maxPlayers,
                Timestamp  = now
            }
        else
            local anyOtherCloneWithBoss = false
            for uid, cInfo in pairs(data.Clones) do
                if tostring(uid) ~= myUid and tostring(cInfo.JobId) == curJob and cInfo.HasCakeQueen == true then
                    anyOtherCloneWithBoss = true
                    break
                end
            end
            if forceDeleteServerSignal or isServerFull or not anyOtherCloneWithBoss then
                data.Signals[curJob] = nil
            end
        end
        self.LastCakeQueenSessionWrite = os.clock()
    else
        self.CakeQueenClaimTime = nil
        local hadMyClone = (data.Clones[myUid] ~= nil)
        data.Clones[myUid] = nil

        local anyOtherCloneWithBoss = false
        for uid, cInfo in pairs(data.Clones) do
            if tostring(uid) ~= myUid and tostring(cInfo.JobId) == curJob and cInfo.HasCakeQueen == true then
                anyOtherCloneWithBoss = true
                break
            end
        end

        if forceDeleteServerSignal or not anyOtherCloneWithBoss or isServerFull then
            data.Signals[curJob] = nil
        elseif not hadMyClone then
            return
        end
    end

    pcall(function()
        writefile(CONFIG.CakeQueenSessionFile, HttpService:JSONEncode(data))
    end)
end

function Engine:GetOnlineCakeQueenClonesCount()
