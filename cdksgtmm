        Search("Cake Queen", P.Coop, { "cake queen" })
    end
end

local function Final()
    S.noAttack = false
    local cdkSw = InBag("Yama") and "Yama" or "Tushita"
    S.weapon = cdkSw
    Bag(cdkSw, true)
    Inv("CDKQuest", "Progress", "Good")
    Inv("CDKQuest", "Progress", "Evil")
    Inv("CDKQuest", "StartTrial", "Boss")
    Inv("CDKQuest", "SpawnBoss")
    if not Boss({ "cursed skeleton", "skeleton boss" }, P.Temple) then
        Go(P.Temple, nil, "Đang tới đền CDK gọi Cursed Skeleton Boss")
        pcall(function()
            Go(workspace.Map.Turtle.Cursed.BossDoor:GetPivot().Position, nil, "Đang mở cửa Cursed Skeleton Boss")
            Inv("CDKQuest", "OpenDoor", "Boss")
            Inv("CDKQuest", "StartTrial", "Boss")
            Inv("CDKQuest", "SpawnBoss")
        end)
