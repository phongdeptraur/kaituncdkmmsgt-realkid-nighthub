    end
    for _, d in ipairs(DOCKS) do c[#c + 1] = { false, d } end
    local best, bd
    for _, e in ipairs(c) do
        local seen = false
        for _, v in ipairs(visD) do if (e[2] - v).Magnitude <= 150 then seen = true end end
        local d = (e[2] - r.Position).Magnitude
