function Engine:GetCakeQueenCoopStatusInCurrentServer()
    local data = self:ReadAndCleanCakeQueenSessions()
    local curJob = tostring(game.JobId)
    local myUid = tostring(LocalPlayer.UserId)

    local totalOnlineClones = 1
    local totalClonesInServer = 1
    local readyAtCoopCount = (self.HasArrivedCakeQueenCoop or self.CakeQueenCoopApproved) and 1 or 0

    for uid, cInfo in pairs(data.Clones) do
        if tostring(uid) ~= myUid then
            totalOnlineClones = totalOnlineClones + 1
            if tostring(cInfo.JobId) == curJob then
                local p = Players:GetPlayerByUserId(tonumber(uid) or 0)
                if p then
                    totalClonesInServer = totalClonesInServer + 1
                    local pRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    local physicallyAtCoop = pRoot and ((pRoot.Position - POS_CAKE_QUEEN_COOP).Magnitude <= 45) or false
                    if cInfo.AtCoopPoint == true or cInfo.Attacking == true or physicallyAtCoop then
                        readyAtCoopCount = readyAtCoopCount + 1
                    end
                    if cInfo.Attacking == true then
                        self.CakeQueenCoopApproved = true
                    end
                end
            end
        end
    end

    -- Nếu chỉ còn mỗi mình mình online (totalOnlineClones <= 1) -> Không cần đợi Co-op nữa mà đánh luôn!
    local isSoloOnline = (totalOnlineClones <= 1)
    if isSoloOnline or readyAtCoopCount >= CONFIG.CakeQueenCoopMinClones then
        self.CakeQueenCoopApproved = true
    end

    return self.CakeQueenCoopApproved, readyAtCoopCount, totalClonesInServer, totalOnlineClones, isSoloOnline
end

function Engine:GetBestCakeQueenCoopSignal(onlyHigherPriorityThanMine)
    local data = self:ReadAndCleanCakeQueenSessions()
    local curJob = tostring(game.JobId)
    local myClaim = self.CakeQueenClaimTime or os.time()

    local clonesPerJob = {}
    for _, cInfo in pairs(data.Clones) do
        local jId = tostring(cInfo.JobId or "")
        if jId ~= "" then
            clonesPerJob[jId] = (clonesPerJob[jId] or 0) + 1
        end
    end

    local myJobClones = clonesPerJob[curJob] or 1
    local candidates = {}

    for jobId, sInfo in pairs(data.Signals) do
        local jStr = tostring(jobId)
        local pCnt = tonumber(sInfo.Players) or 0
        local mCnt = tonumber(sInfo.MaxPlayers) or 12
        if jStr ~= curJob and pCnt < mCnt then
            local cCount = clonesPerJob[jStr] or 1
            local sClaim = tonumber(sInfo.ClaimTime) or 0
            local sHostUid = tonumber(sInfo.HostUserId) or 0

            local allowed = true
            if onlyHigherPriorityThanMine then
                if cCount > myJobClones then
                    allowed = true
                elseif cCount == myJobClones then
                    allowed = (sClaim < myClaim) or (sClaim == myClaim and sHostUid < LocalPlayer.UserId)
                else
                    allowed = false
                end
            end

            if allowed then
                table.insert(candidates, {
                    JobId      = jStr,
                    PlaceId    = sInfo.PlaceId or game.PlaceId,
                    HostName   = sInfo.HostName or "Clone",
                    HostUserId = sHostUid,
                    Players    = pCnt,
                    MaxPlayers = mCnt,
                    Clones     = cCount,
                    ClaimTime  = sClaim
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        if a.Clones ~= b.Clones then
            return a.Clones > b.Clones
        end
        return a.ClaimTime < b.ClaimTime
    end)

    return candidates[1]
end

