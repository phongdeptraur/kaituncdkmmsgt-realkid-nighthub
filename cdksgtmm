local function CheckPlayerNear(radius)
    radius = radius or MASTERY_NEAR_RADIUS
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false, nil, 0 end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local pHum = p.Character:FindFirstChildOfClass("Humanoid")
            if pRoot and pHum and pHum.Health > 0 then
                local dist = (pRoot.Position - myRoot.Position).Magnitude
                if dist <= radius then
                    return true, p.DisplayName or p.Name, dist
                end
            end
        end
    end
    return false, nil, 0
end

