    if S.inDim then
        dimTargets = {}
        local seen = {}
        if type(S.dimPair) == "table" then
            for _, m in ipairs(S.dimPair) do
                if m and m.Parent and not seen[m] and not (S.isDimBlacklisted and S.isDimBlacklisted(m)) then
                    local h, p = m:FindFirstChildOfClass("Humanoid"), m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
