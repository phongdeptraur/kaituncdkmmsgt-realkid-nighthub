local function SafeRequire(moduleInstance)
    if not moduleInstance or not moduleInstance:IsA("ModuleScript") then return nil end
    local ok, result = pcall(require, moduleInstance)
    return ok and result or nil
end

local function GetIRSComponents()
    local rep = game:GetService("ReplicatedStorage")
    local irsInst = rep:FindFirstChild("ItemReplicationService")
    local cfgInst = rep:FindFirstChild("ItemConfig")

    local IRS = SafeRequire(irsInst)
    local Cfg = SafeRequire(cfgInst)
    local Storage = nil
    if cfgInst and cfgInst:FindFirstChild("Storage") then Storage = SafeRequire(cfgInst.Storage) end
    local Keys = nil
    if irsInst and irsInst:FindFirstChild("KEYS") then Keys = SafeRequire(irsInst.KEYS) end
    return IRS, Cfg, Storage, Keys
end

function InventoryEngine.New()
    local self = setmetatable({}, InventoryEngine)
    self:_Initialize()
    return self
end

function InventoryEngine:_Initialize()
    if ScannerState.IsInitialized then return end

    local CommE = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommE")
    if CommE and CommE:IsA("RemoteEvent") then
        local conn = CommE.OnClientEvent:Connect(function(...)
            local packet = {...}
            if packet[1] and typeof(packet[1]) == "string" and string.find(packet[1], "Item") then
                self:Sync()
            end
        end)
        table.insert(Engine.Connections, conn)
    end

    local bp = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer:WaitForChild("Backpack", 2)
    if bp then
        local c1 = bp.ChildAdded:Connect(function() self:_FastToolIndex() end)
        local c2 = bp.ChildRemoved:Connect(function() self:_FastToolIndex() end)
        table.insert(Engine.Connections, c1)
        table.insert(Engine.Connections, c2)
    end

    self:Sync()
    ScannerState.IsInitialized = true
end

function InventoryEngine:_FastToolIndex()
    table.clear(ScannerState.Tools)
    local function IndexContainer(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then ScannerState.Tools[item.Name] = item end
        end
    end
    IndexContainer(LocalPlayer:FindFirstChild("Backpack"))
    IndexContainer(LocalPlayer.Character)
end

function InventoryEngine:Sync()
    local now = os.clock()
    if now - ScannerState.LastSyncTimestamp < ScannerState.SyncDebounce then return true end
    ScannerState.LastSyncTimestamp = now

    table.clear(ScannerState.Materials)
    table.clear(ScannerState.Weapons)
    self:_FastToolIndex()

    local IRS, ItemConfig, ItemConfigStorage, KeysModule = GetIRSComponents()
    local memoryCacheHit = false

    if IRS and IRS._UserCache then
        local userItems = IRS._UserCache[ScannerState.UserId]
        if userItems and typeof(userItems.GetItems) == "function" then
            local quantityKey = KeysModule and KeysModule.QUANTITY or "Quantity"
            local masteryKey = KeysModule and KeysModule.MASTERY or "Mastery"

            local quantities = userItems:GetItems(quantityKey)
            local masteries = userItems:GetItems(masteryKey)

            local masteryMap = {}
            if masteries then
                for _, entry in pairs(masteries) do
                    if entry.ItemId and entry.Value then masteryMap[entry.ItemId] = entry.Value end
                end
            end

            if quantities then
                for _, itemEntry in pairs(quantities) do
                    local itemId = itemEntry.ItemId
                    local count = itemEntry.Value or 0
                    local label = nil
                    local category = "Unknown"

                    if ItemConfigStorage and typeof(ItemConfigStorage.match) == "function" then
                        pcall(function()
                            local matchData = ItemConfigStorage.match(itemId):unwrap()
                            if matchData and matchData.Index then
                                label = matchData.Index.DebugLabel or matchData.Index.StorageKey
                                category = matchData.Display and matchData.Display.Category or "Unknown"
                            end
                        end)
                    end

                    label = label and label:gsub(" %[.-%]", "") or tostring(itemId)

                    if category == "Material" or count > 1 or string.find(label:lower(), "fractal") or string.find(label:lower(), "alucard") then
                        ScannerState.Materials[label] = count
                    end

                    ScannerState.Weapons[label] = {
                        Category = category,
                        Mastery = masteryMap[itemId] or 0,
                        Quantity = count
                    }
                end
                memoryCacheHit = true
            end
        end
    end

    if not memoryCacheHit then
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF and commF:IsA("RemoteFunction") then
            local ok, inventoryData = pcall(function() return commF:InvokeServer("getInventory") end)
            if ok and typeof(inventoryData) == "table" then
                for _, item in pairs(inventoryData) do
                    local name = item.Name or item.Item or "Unknown"
                    local count = item.Count or item.Value or 1
                    local itemType = item.Type or "Unknown"

                    if itemType == "Material" or string.find(tostring(name):lower(), "fractal") or string.find(tostring(name):lower(), "alucard") then
                        ScannerState.Materials[name] = count
                    end

                    ScannerState.Weapons[name] = {
                        Category = itemType,
                        Mastery = item.Mastery or 0,
                        Quantity = count
                    }
                end
            end
        end
    end

    return true
end

