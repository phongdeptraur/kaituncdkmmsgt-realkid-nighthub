    S.weapon = nil
    Unequip()
    local bestP, bd = nil, math.huge
    local myR = Root()
    for _, m in ipairs(workspace.Enemies:GetChildren()) do
        if m.Name == "Forest Pirate" then
            local mh = m:FindFirstChildOfClass("Humanoid")
            local mr = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if mh and mr and mh.Health > 0 then
                local d = myR and (myR.Position - mr.Position).Magnitude or 0
                if d < bd then bestP, bd = mr, d end
            end
        end
    end
    local targetPos = bestP and (bestP.CFrame * CF(0, 0, 3)).Position or V3(-13223.5, 428.2, -7766.1)
    if myR and (myR.Position - targetPos).Magnitude <= 20 and bestP then
        Say("Yama Q1: Đang đứng im để Forest Pirate đánh chết (Đã tắt Fast Attack)...")
        Float(true)
