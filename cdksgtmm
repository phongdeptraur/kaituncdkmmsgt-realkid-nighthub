    end

    local charsFolder = workspace:FindFirstChild("Characters")
    if charsFolder then
        for _, mob in ipairs(charsFolder:GetChildren()) do
            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            if mob ~= char and mobRoot and mobHum and mobHum.Health > 0 then
                if (root.Position - mobRoot.Position).Magnitude <= Engine.AttackRadius then
                    table.insert(hitList, mob)
                    if not primaryTargetHead and mob:FindFirstChild("Head") then primaryTargetHead = mob.Head end
                end
            end
        end
    end

    if #hitList == 0 then return end

    local activeTool = char:FindFirstChildOfClass("Tool") or EquipCombatTool()
    if not activeTool then return end

    EnsureBuso()

    local hitPartsArray = {}
    for _, mob in ipairs(hitList) do
        local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head")
        table.insert(hitPartsArray, { [1] = mob, [2] = mRoot })
        table.insert(hitPartsArray, mob)
    end

    if not primaryTargetHead and hitList[1] then
        primaryTargetHead = hitList[1]:FindFirstChild("Head") or hitList[1]:FindFirstChild("HumanoidRootPart")
    end

    local netModules = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")

    pcall(function()
        if netModules then
            local netReq = require(netModules)
            local regAttack = netReq:RemoteEvent("RegisterAttack", true)
            local regHit = netReq:RemoteEvent("RegisterHit", true)
            if regAttack and regHit then
                regAttack:FireServer(0)
                regHit:FireServer(primaryTargetHead, hitPartsArray, {}, "078da5141")
            end
        end
    end)

    if netModules then
        local regAttackDirect = netModules:FindFirstChild("RE/RegisterAttack")
        local regHitDirect = netModules:FindFirstChild("RE/RegisterHit")
        if regAttackDirect and regAttackDirect:IsA("RemoteEvent") then regAttackDirect:FireServer() end
        local callHash = tostring(LocalPlayer.UserId):sub(2, 4) .. tostring(coroutine.running()):sub(11, 15)
        if regHitDirect and regHitDirect:IsA("RemoteEvent") and primaryTargetHead then
            regHitDirect:FireServer(primaryTargetHead, hitPartsArray, {}, callHash)
        end

        if ObfuscatedRemote and RemoteId and primaryTargetHead then
            local obfuscatedKey = string.gsub("RE/RegisterHit", ".", function(c)
                return string.char(bit32.bxor(string.byte(c), math.floor(workspace:GetServerTimeNow() / 10 % 10) + 1))
            end)
            local seedVal = 0
            pcall(function() seedVal = netModules.seed:InvokeServer() * 2 end)
            local payloadHash = bit32.bxor(RemoteId + 909090, seedVal)
            pcall(function() ObfuscatedRemote:FireServer(obfuscatedKey, payloadHash, primaryTargetHead, hitPartsArray) end)
        end
    end
end

