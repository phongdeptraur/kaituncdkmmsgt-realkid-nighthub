local function MPos(m, r)
    if r then return r.Position end
    local ok, cf = pcall(function() return m:GetPivot() end)
    return (ok and cf and cf.Position) or (m:FindFirstChild("WorldPivot") and m.WorldPivot.Position) or nil
end

local function Fight(m, root)
    if not S.Run or S.RK or S.Main or S.FragFarm or S.Hopping then return end
    S.noAttack = false
    S.target = m
    local r = Root()
    local mp = MPos(m, root)
    if not r or not mp then return end
    local h = m:FindFirstChildOfClass("Humanoid")
    local hp = (h and h.MaxHealth > 0) and math.floor(h.Health / h.MaxHealth * 100) or 100
    local p = mp + V3(0, 26, 0)
    if (r.Position - p).Magnitude > 35 then
        Go(p, function()
            local curP = MPos(m, root)
            return S.target ~= m or not m.Parent or (h and h.Health <= 0) or (curP and (curP - mp).Magnitude > 40)
        end, ("Đang bay tới đánh %s (%d%% HP)"):format(m.Name, hp))
    else
        Say(("Đang đánh: %s (%d%% HP)"):format(m.Name, hp))
        Float(true)
        r.CFrame = CF(p)
        r.AssemblyLinearVelocity = V3()
    end
end

local function Find(pats)
    local wo = workspace:FindFirstChild("_WorldOrigin")
    for _, c in ipairs({ workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Characters"), workspace, RS, wo }) do
        for _, m in ipairs(c and c:GetChildren() or {}) do
            if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
                local n = m.Name:lower()
                for _, p in ipairs(pats) do
                    if n:find(p, 1, true) then
                        local h = m:FindFirstChildOfClass("Humanoid")
                        if not h or h.Health > 0 then
                            local r = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or m.PrimaryPart
                            local pos = MPos(m, r)
                            local live = (c ~= RS and r ~= nil and h ~= nil)
                            return m, r, h, live, pos
                        end
                    end
                end
            end
        end
    end
end

local function Boss(pats, at)
    local m, r, h, live, pos = Find(pats)
    if not m then return false end
    if live then
        Fight(m, r)
    else
        local dst = (pos and pos.Magnitude > 50) and pos or at
        if dst then
            Go(dst, function()
                local bm, _, _, lv = Find(pats)
                return not bm or lv
            end, "Đang bay tới vị trí " .. m.Name)
        end
    end
    return true
end

local function Farm(c, rad, lbl)
