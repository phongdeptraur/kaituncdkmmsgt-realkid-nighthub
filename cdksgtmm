                            while Engine.IsRunning and not HasHolyTorch() and not Engine.IsHopping do
                                lblStatus.Text = "Trạng thái: 🔥 [TUSHITA] Có Rip Indra! Tween tới Waterfall lấy Holy Torch..."
                                TweenToPosition(POS_HOLY_TORCH_TOWER, CONFIG.TweenSpeed)

                                local currentChar = LocalPlayer.Character
                                local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
                                if currentHrp then
                                    currentHrp.CFrame = CFrame.new(POS_HOLY_TORCH_TOWER)
                                    Engine.NoClipActive = false
                                    currentHrp.Anchored = false
                                    currentHrp.AssemblyLinearVelocity = Vector3.zero
                                    local s1 = currentHrp:FindFirstChild("__AxiomFlightStabilizer")
                                    if s1 then s1:Destroy() end
                                    for _, part in ipairs(currentChar:GetDescendants()) do
                                        if part:IsA("BasePart") then part.CanCollide = true; part.CanTouch = true end
                                    end
                                    task.wait(1.0)
                                    Engine.NoClipActive = true
                                end
                                if HasHolyTorch() or not ScanBossEntity({ "rip_indra True Form", "rip_indra" }) then break end
                            end
                        else
                            -- Nếu đã đủ điều kiện 30/30 Elite Yama hoặc đã có sẵn Yama trước khi get Tushita:
                            -- Bắt buộc Pre-Tween đến điểm (5325.75, 1004.77, 275.70) trước khi Hop Indra (NightAPI + RealKidHop)
                            if hasYama or Engine.EliteKills >= 30 then
                                local indraPatterns = { "rip_indra", "rip_indra True Form" }
                                local arrivedPrePoint = EnsurePreTweenBeforeIndraHop(indraPatterns)
                                if arrivedPrePoint and VerifyBossAbsent(indraPatterns) then
                                    lblStatus.Text = "Trạng thái: 🌐 [TUSHITA - PRETWEEN XONG] Bật RealKidHop + NightAPI (Rip Indra)... " .. timeDisplay
                                    DispatchRealKidHop("Rip Indra", true)
                                end
                            else
                                -- Chưa có Yama và Elite < 30: Chạy song song tìm Indra (NightAPI + RealKidHop) kết hợp săn Elite
                                DispatchRealKidHop("Rip Indra", false)

                                local indraNightServers = GetValidNightServers("Rip Indra")
                                if #indraNightServers > 0 then
                                    Engine.CurrentCombatTarget = nil
                                    if Engine.CurrentTween then
                                        pcall(function() Engine.CurrentTween:Cancel() end)
                                        Engine.CurrentTween = nil
                                    end
                                    lblStatus.Text = string.format("Trạng thái: 🚨 [NIGHT API] Phát hiện %d server Rip Indra! Dừng Elite -> Join Indra ngay!", #indraNightServers)
                                    JoinAllNightApiServers("Rip Indra")
                                else
                                    local eliteTarget = CachedRadarData.EliteTarget or scanForElite()
                                    if eliteTarget and eliteTarget.Instance and eliteTarget.Root then
                                        pcall(function()
                                            local commF = GetCommF()
                                            if commF then commF:InvokeServer("EliteHunter") end
                                        end)

                                        Engine.CurrentCombatTarget = eliteTarget.Instance
                                        lblStatus.Text = string.format("Trạng thái: 👹 [PARALLEL YAMA+TUSHITA] Đang diệt Elite %s [HP: %.0f | %d/30] & Canh API Indra...", eliteTarget.ExactName, eliteTarget.Health, Engine.EliteKills)
                                        FlyOverTarget(eliteTarget.Root, true)
                                        ForceEquipMelee()
                                    else
                                        Engine.CurrentCombatTarget = nil
                                        local eliteNightServers = GetValidNightServers("Elite Hunter")
                                        if #eliteNightServers > 0 then
                                            lblStatus.Text = string.format("Trạng thái: 🌐 [PARALLEL YAMA+TUSHITA] Ko có Indra -> Hop NightAPI Elite (%d sv) [Elite: %d/30]...", #eliteNightServers, Engine.EliteKills)
                                            JoinAllNightApiServers("Elite Hunter")
                                        else
                                            lblStatus.Text = string.format("Trạng thái: 🔍 [PARALLEL YAMA+TUSHITA] Đang chờ NightAPI Indra/Elite & RealKidHop Indra [Elite: %d/30]... %s", Engine.EliteKills, timeDisplay)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

            -- =====================================================================
            -- 2. CƠ CHẾ GET MM (VALKYRIE HELM & MIRROR FRACTAL) TỪ GETMM.TXT
            -- =====================================================================
            elseif cfg.GetMM and not hasValkyrie then
                Engine.CurrentObjective = "Valkyrie"
                Engine.MirrorTeleported = false
                local indraPatterns = { "rip_indra", "rip_indra True Form" }
                local iActive, iModel, iRoot, iHum = ScanBossEntity(indraPatterns)

                if iActive and iModel and iRoot and iHum and iHum.Health > 0 then
                    Engine.CurrentCombatTarget = iModel
                    lblStatus.Text = string.format("Trạng thái: 🛡️ [VALKYRIE] Khóa mục tiêu rip_indra [HP: %.0f/%.0f]!", iHum.Health, iHum.MaxHealth)
                    FlyOverTarget(iRoot)
                    ForceEquipMelee()
                else
                    Engine.CurrentCombatTarget = nil
                    local arrivedCastle = EnsureZoneArrivalBeforeHop("Rip Indra", POS_CASTLE, "Castle on the Sea", indraPatterns)
                    if arrivedCastle and VerifyBossAbsent(indraPatterns) then
                        lblStatus.Text = "Trạng thái: 🛡️ [VALKYRIE] Đã kiểm tra Sea Castle -> Hop RealKid + NightAPI (Rip Indra)... " .. timeDisplay
                        DispatchRealKidHop("Rip Indra", true)
                    end
                end

            elseif cfg.GetMM and not hasFractal then
                Engine.CurrentObjective = "DoughKing"
                local doughPatterns = { "Dough King" }
                local dActive, dModel, dRoot, dHum = ScanBossEntity(doughPatterns)

                if dActive and dModel and dRoot and dHum and dHum.Health > 0 then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local distToLoaf = (hrp.Position - POS_LOAF).Magnitude
                        if distToLoaf > 500 and not Engine.MirrorTeleported then
                            lblStatus.Text = string.format("Trạng thái: 🍩 Phát hiện Dough King! Bay tới Cake Loaf (Cách: %.0f)...", distToLoaf)
                            TweenToPosition(POS_LOAF, CONFIG.TweenSpeed)
                        elseif not Engine.MirrorTeleported then
                            ExecuteLoafMirrorSequence()
                        else
                            Engine.CurrentCombatTarget = dModel
                            lblStatus.Text = string.format("Trạng thái: 🍩 Khóa mục tiêu Dough King [HP: %.0f/%.0f]!", dHum.Health, dHum.MaxHealth)
                            FlyOverTarget(dRoot)
                            ForceEquipMelee()
                        end
                    end
                else
                    Engine.CurrentCombatTarget = nil
                    Engine.MirrorTeleported = false
                    local arrivedLoaf = EnsureZoneArrivalBeforeHop("Dough King", POS_LOAF, "Cake Loaf", doughPatterns)
                    if arrivedLoaf and VerifyBossAbsent(doughPatterns) then
                        lblStatus.Text = "Trạng thái: 🍩 [MIRROR FRACTAL] Đã kiểm tra Cake Loaf -> Hop RealKid + NightAPI (Dough King)... " .. timeDisplay
                        DispatchRealKidHop("Dough King", true)
                    end
                end

            -- =====================================================================
            -- 3. THIẾU YAMA -> SĂN ĐỦ 30 ELITE HOẶC RÚT KIẾM THÁC NƯỚC
            -- =====================================================================
            elseif cfg.GetCDK and not hasYama then
                Engine.CurrentObjective = "Yama"
                local currentKills = Engine.EliteKills

                if currentKills >= 30 then
                    PullSealedKatanaFlow(currentKills)
                else
                    local eliteTarget = CachedRadarData.EliteTarget or scanForElite()
                    if eliteTarget and eliteTarget.Instance and eliteTarget.Root then
                        pcall(function()
                            local commF = GetCommF()
                            if commF then commF:InvokeServer("EliteHunter") end
                        end)
                        Engine.CurrentCombatTarget = eliteTarget.Instance
                        lblStatus.Text = string.format("Trạng thái: 👹 [YAMA] Khóa dính %s [HP: %.0f] (Đã diệt: %d/30)!", eliteTarget.ExactName, eliteTarget.Health, currentKills)
                        FlyOverTarget(eliteTarget.Root)
                        ForceEquipMelee()
                    else
                        Engine.CurrentCombatTarget = nil
                        lblStatus.Text = string.format("Trạng thái: 🌐 [YAMA] Không có Elite (%d/30) -> Hop RealKid + NightAPI (Elite Hunter)... %s", currentKills, timeDisplay)
                        DispatchRealKidHop("Elite Hunter", true)
                    end
                end

            -- =====================================================================
            -- 4. ĐỦ 4 ITEM -> CHECK STAT SWORD 2800 (RESET STAT / CAKE PRINCE) & CÀY MASTERY 350
            -- =====================================================================
            elseif cfg.GetCDK and (yamaMastery < 350 or tushitaMastery < 350) then
                local lpData = LocalPlayer:FindFirstChild("Data")
                local lpStats = lpData and lpData:FindFirstChild("Stats")
                local swordStatLv = (lpStats and lpStats:FindFirstChild("Sword") and lpStats.Sword:FindFirstChild("Level")) and tonumber(lpStats.Sword.Level.Value) or 1
                local freePoints = (lpData and lpData:FindFirstChild("Points")) and tonumber(lpData.Points.Value) or 0
                local curFragments = (lpData and lpData:FindFirstChild("Fragments")) and tonumber(lpData.Fragments.Value) or 0

                local function AllocateSwordMaxAndSplitDefenseMelee()
                    local commF = GetCommF()
                    if not commF then return end
                    local dNow = LocalPlayer:FindFirstChild("Data")
                    local sNow = dNow and dNow:FindFirstChild("Stats")
                    local swLv = (sNow and sNow:FindFirstChild("Sword") and sNow.Sword:FindFirstChild("Level")) and tonumber(sNow.Sword.Level.Value) or 1
                    local pts = (dNow and dNow:FindFirstChild("Points")) and tonumber(dNow.Points.Value) or 0

                    -- Nâng full 2800 cho Sword trước
                    local needSword = math.max(0, 2800 - swLv)
                    if needSword > 0 and pts > 0 then
                        local toAddSword = math.min(pts, needSword)
                        pcall(function() commF:InvokeServer("AddPoint", "Sword", toAddSword) end)
                        task.wait(0.25)
                    end

                    -- Dư bao nhiêu chia đều cho Defense và Melee
                    pts = (dNow and dNow:FindFirstChild("Points")) and tonumber(dNow.Points.Value) or 0
                    swLv = (sNow and sNow:FindFirstChild("Sword") and sNow.Sword:FindFirstChild("Level")) and tonumber(sNow.Sword.Level.Value) or 1
                    if pts > 0 and swLv >= 2800 then
                        local halfPts = math.floor(pts / 2)
                        local otherHalf = pts - halfPts
                        if halfPts > 0 then
                            pcall(function() commF:InvokeServer("AddPoint", "Defense", halfPts) end)
                        end
                        if otherHalf > 0 then
                            pcall(function() commF:InvokeServer("AddPoint", "Melee", otherHalf) end)
                        end
                        task.wait(0.2)
                        local remPts = (dNow and dNow:FindFirstChild("Points")) and tonumber(dNow.Points.Value) or 0
                        if remPts > 0 then
                            pcall(function() commF:InvokeServer("AddPoint", "Defense", remPts) end)
                            pcall(function() commF:InvokeServer("AddPoint", "Melee", remPts) end)
                        end
                    end
                end

                if swordStatLv < 2800 then
                    local neededForSword = 2800 - swordStatLv
                    if freePoints >= neededForSword then
                        lblStatus.Text = string.format("Trạng thái: 📈 [STAT] Đang nâng full 2800 Sword (Hiện tại: Lv.%d) & chia đều điểm dư...", swordStatLv)
                        AllocateSwordMaxAndSplitDefenseMelee()
                    elseif curFragments >= 2500 then
                        lblStatus.Text = string.format("Trạng thái: 🔄 [RESET STAT] Sword Lv.%d < 2800 | Đủ %df -> Mua Refund Stat (2,500f)...", swordStatLv, curFragments)
                        local commF = GetCommF()
                        if commF then
                            pcall(function()
                                commF:InvokeServer("BlackbeardReward", "Refund", "1")
                                commF:InvokeServer("BlackbeardReward", "Refund", "2")
                            end)
                        end
                        task.wait(0.5)
                        AllocateSwordMaxAndSplitDefenseMelee()
                    else
                        -- Không đủ 2500 Fragment để Reset Stat -> Săn Cake Prince hoặc Hop RealKid + NightAPI ("Cake Prince")
                        Engine.CurrentObjective = "CakePrinceFrag"
                        Engine.HauntedStagingReached = false
                        local cpPatterns = { "Cake Prince", "Dough King" }
                        local cpActive, cpModel, cpRoot, cpHum = ScanBossEntity(cpPatterns)

                        if cpActive and cpModel and cpRoot and cpHum and cpHum.Health > 0 then
                            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local distToLoaf = (hrp.Position - POS_LOAF).Magnitude
                                if distToLoaf > 500 and not Engine.MirrorTeleported then
                                    lblStatus.Text = string.format("Trạng thái: 👑 [THIẾU FRAG %d/2500f] Phát hiện %s! Bay tới Cake Loaf (Cách: %.0f)...", curFragments, cpModel.Name, distToLoaf)
                                    TweenToPosition(POS_LOAF, CONFIG.TweenSpeed)
                                elseif not Engine.MirrorTeleported then
                                    ExecuteLoafMirrorSequence()
                                else
                                    Engine.CurrentCombatTarget = cpModel
                                    lblStatus.Text = string.format("Trạng thái: 👑 [THIẾU FRAG %d/2500f] Đang diệt %s [HP: %.0f/%.0f]...", curFragments, cpModel.Name, cpHum.Health, cpHum.MaxHealth)
                                    FlyOverTarget(cpRoot)
                                    ForceEquipMelee()
                                end
                            end
                        else
                            Engine.CurrentCombatTarget = nil
                            Engine.MirrorTeleported = false
                            local arrivedLoaf = EnsureZoneArrivalBeforeHop("Cake Prince", POS_LOAF, "Cake Loaf", cpPatterns)
                            if arrivedLoaf and VerifyBossAbsent(cpPatterns) then
                                lblStatus.Text = string.format("Trạng thái: 👑 [THIẾU FRAG %d/2500f] Đã check Cake Loaf -> Hop RealKid + NightAPI (Cake Prince)... %s", curFragments, timeDisplay)
                                DispatchRealKidHop("Cake Prince", true)
                            end
                        end
                        task.wait(0.2)
                        continue
                    end
                elseif freePoints > 0 then
                    AllocateSwordMaxAndSplitDefenseMelee()
                end

                Engine.CurrentObjective = "MasteryFarm"
                local swordTarget = (yamaMastery < 350) and "Yama" or "Tushita"
                local currentProg = (yamaMastery < 350) and yamaMastery or tushitaMastery

                -- 1. Kiểm tra nếu có player chạy chung script này trong cùng server -> Hop Low Server né clone
                local hasSameClone, cloneName = Engine:CheckSameScriptCloneInServer()
                if hasSameClone and not Engine.IsHopping then
                    lblStatus.Text = string.format("Trạng thái: ⚠️ Phát hiện acc chung script (%s) cùng server -> Hop Low Server!", tostring(cloneName))
                    Engine:HopLowServer()
                    continue
                end

                -- Đảm bảo ghi nhận trạng thái của acc vào mastery_session.txt ngay khi vào MasteryFarm (và định kỳ mỗi 5s)
                if (os.clock() - (Engine.LastMasterySessionWrite or 0)) >= CONFIG.MasterySessionInterval then
                    pcall(function() Engine:UpdateMasterySession(true) end)
                end

                -- 2. Kiểm tra nếu có player ở gần tích lũy đủ 3 phút (180s) -> Hop Low Server
                local isNear, nearPlayerName, nearDist = CheckPlayerNear(MASTERY_NEAR_RADIUS)
                local now = os.clock()
                local dt = now - (Engine.LastNearTick or now)
                Engine.LastNearTick = now
                if isNear and dt > 0 and dt < 5 then
                    Engine.MasteryNearAccumulator = Engine.MasteryNearAccumulator + dt
                end

                local accM, accS = math.floor(Engine.MasteryNearAccumulator / 60), math.floor(Engine.MasteryNearAccumulator % 60)
                if Engine.MasteryNearAccumulator >= MASTERY_NEAR_MAX_TIME and not Engine.IsHopping then
                    lblStatus.Text = string.format("Trạng thái: ⚠️ Có người ở gần đủ 3 phút tích lũy (%02d:%02d) -> Hop Low Server!", accM, accS)
                    Engine:HopLowServer()
                    continue
                end

                Engine.BringMob = true
                _G.BringMobs = true
                Engine.ActiveCDKMode = nil
                Engine.WaitReaper = false
                EquipSpecificSword(swordTarget)

                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not Engine.HauntedStagingReached and hrp and ((hrp.Position - POS_HAUNTED_CASTLE).Magnitude <= 450 or (hrp.Position - HAUNTED_STAGING_CF.Position).Magnitude <= 350) then
                    Engine.HauntedStagingReached = true
                end

                if not Engine.HauntedStagingReached then
                    lblStatus.Text = string.format("Trạng thái: 🏰 [MASTERY %s] Tween đến Haunted Castle...", swordTarget)
                    TweenToPosition(HAUNTED_STAGING_CF.Position, CONFIG.TweenSpeed)
                    Engine.HauntedStagingReached = true
                else
                    local nearInfo = isNear and string.format(" [⚠️ Gần: %s (%.0fm) | %02d:%02d]", nearPlayerName, nearDist, accM, accS) or ""
                    lblStatus.Text = string.format("Trạng thái: 🏰 Cày Mastery [%s: %d/350]%s", swordTarget, currentProg, nearInfo)

                    local enemies = workspace:FindFirstChild("Enemies")
                    local closestMob, shortestDist = nil, math.huge
                    if enemies and hrp then
                        for _, mob in ipairs(enemies:GetChildren()) do
                            local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                            local hum = mob:FindFirstChildOfClass("Humanoid")
                            if mRoot and hum and hum.Health > 0 and (mRoot.Position - POS_HAUNTED_CASTLE).Magnitude < 1200 then
                                local d = (mRoot.Position - hrp.Position).Magnitude
                                if d < shortestDist then shortestDist = d; closestMob = mob end
                            end
                        end
                    end
                    if closestMob then
                        Engine.CurrentCombatTarget = closestMob
                        local mRoot = closestMob:FindFirstChild("HumanoidRootPart") or closestMob.PrimaryPart
                        if mRoot then FlyOverTarget(mRoot) end
                    else
                        Engine.CurrentCombatTarget = nil
                    end
                end

            -- =====================================================================
            -- 5. ĐỦ MASTERY -> CHẠY 6 NHIỆM VỤ CDK & BOSS CUỐI
            -- =====================================================================
            else
                if Engine.CurrentObjective == "MasteryFarm" then
                    pcall(function() Engine:UpdateMasterySession(false) end)
                end
                SwitchUIToCDKMode()
                Engine.CurrentObjective = "AutoCDK"
                Engine.HauntedStagingReached = false
                Engine.MasteryNearAccumulator = 0

                local commF = GetCommF()
                if not commF then task.wait(0.5); continue end
                pcall(function() commF:InvokeServer("CDKQuest", "OpenDoor", true) end)

                if not getgenv().CDK_LATCH.InitialQueueChecked then
                    getgenv().CDK_LATCH.InitialQueueChecked = true
                    local okProg, initProg = pcall(function() return commF:InvokeServer("CDKQuest", "Progress") end)
                    if okProg and type(initProg) == "table" then
                        local e, g = tonumber(initProg.Evil), tonumber(initProg.Good)
                        if e and g and e < 0 and g < 0 and (e == -2 or g == -2) then
                            lblStatus.Text = "Trạng thái: ⚠️ Cả 2 quest âm có -2 -> Hop Low Server!"
                            Engine:HopLowServer()
                            task.wait(1)
                            continue
                        end
                    end
                end

                local cdk = GetCDKQuestStatus()
                local evilVal = tonumber(cdk.currentEvil) or -1
                local goodVal = tonumber(cdk.currentGood) or -1
                Engine.CurrentGood = goodVal

                if not cdk.YamaDone and (not getgenv().CDK_LATCH.ActiveEvil or getgenv().CDK_LATCH.ActiveEvil >= 0) then
                    pcall(function()
                        commF:InvokeServer("CDKQuest", "OpenDoor")
                        commF:InvokeServer("CDKQuest", "OpenDoor", true)
                        commF:InvokeServer("CDKQuest", "Progress", "Evil")
                        commF:InvokeServer("CDKQuest", "StartTrial", "Evil")
                    end)
                    task.wait(0.2)
                    cdk = GetCDKQuestStatus(true)
                    evilVal = tonumber(cdk.currentEvil) or -1
                elseif cdk.YamaDone and not cdk.TushitaDone and (not getgenv().CDK_LATCH.ActiveGood or getgenv().CDK_LATCH.ActiveGood >= 0) then
                    pcall(function()
                        commF:InvokeServer("CDKQuest", "OpenDoor")
                        commF:InvokeServer("CDKQuest", "OpenDoor", true)
                        commF:InvokeServer("CDKQuest", "Progress", "Good")
                        commF:InvokeServer("CDKQuest", "StartTrial", "Good")
                    end)
                    task.wait(0.2)
                    cdk = GetCDKQuestStatus(true)
                    goodVal = tonumber(cdk.currentGood) or -1
                    Engine.CurrentGood = goodVal
                end

                lblCDKYama1.Text = "1. Yama: Đau Đớn: " .. (cdk.Yama1Done and "🟢 XONG" or (evilVal == -3 and "▶ ĐANG LÀM" or "⚪ CHƯA"))
                lblCDKYama2.Text = "2. Yama: Sương Mù: " .. (cdk.Yama2Done and "🟢 XONG" or (evilVal == -4 and "▶ ĐANG LÀM" or "⚪ CHƯA"))
                lblCDKYama3.Text = "3. Yama: Tử Thần: " .. (cdk.Yama3Done and "🟢 XONG" or (evilVal == -5 and "▶ ĐANG LÀM" or "⚪ CHƯA"))
                lblCDKTushita1.Text = "4. Tushita: Thuyền Trưởng: " .. (cdk.Tushita1Done and "🟢 XONG" or (goodVal == -3 and "▶ ĐANG LÀM" or "⚪ CHƯA"))
                lblCDKTushita2.Text = "5. Tushita: Pirate Raid: " .. (cdk.Tushita2Done and "🟢 XONG" or (goodVal == -4 and "▶ ĐANG LÀM" or "⚪ CHƯA"))
                lblCDKTushita3.Text = "6. Tushita: Cake Queen: " .. (cdk.Tushita3Done and "🟢 XONG" or (goodVal == -5 and "▶ ĐANG LÀM" or "⚪ CHƯA"))
                lblAlucard.Text = string.format("💎 Alucard Fragment: %d/6%s", cdk.AlucardFragments, cdk.AlucardFragments >= 6 and " 🟢 [ĐỦ 6/6]" or "")

                if not cdk.YamaDone then
                    if evilVal == -3 or cdk.evilDone == 0 then
                        Engine.WaitReaper = false; Engine.ActiveCDKMode = "Yama1"; Engine.CurrentCombatTarget = nil
                        Engine.BringMob = false; _G.BringMobs = false; ClearAllMagnetMobs(); ManageCombatTool(true)
                        lblStatus.Text = "Trạng thái: 🛡️ [CDK YAMA 1] Đang Tank Forest Pirate..."
                        local pirate = workspace:FindFirstChild("Enemies") and workspace.Enemies:FindFirstChild("Forest Pirate")
                        local pRoot = pirate and (pirate:FindFirstChild("HumanoidRootPart") or pirate.PrimaryPart)
                        TweenToPosition(pRoot and (pRoot.CFrame * CFrame.new(0, 0, 3)).Position or Vector3.new(-13223.5, 428.2, -7766.1), CONFIG.TweenSpeed)

                    elseif evilVal == -4 or cdk.evilDone == 1 then
                        Engine.WaitReaper = false; Engine.ActiveCDKMode = "Yama2"; Engine.BringMob = true; _G.BringMobs = true
                        EquipSpecificSword("Yama")
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local localHazeMob = nil
                        local enemies = workspace:FindFirstChild("Enemies")
                        if enemies then
                            for _, enemy in ipairs(enemies:GetChildren()) do
                                if enemy:IsA("Model") and enemy:FindFirstChild("HazeESP") then
                                    local hum = enemy:FindFirstChildOfClass("Humanoid")
                                    local mRoot = enemy:FindFirstChild("HumanoidRootPart")
                                    if hum and hum.Health > 0 and mRoot then localHazeMob = enemy; break end
                                end
                            end
                        end
                        if localHazeMob then
                            Engine.CurrentCombatTarget = localHazeMob
                            lblStatus.Text = string.format("Trạng thái: ⚔️ [CDK YAMA 2] Diệt quái Haze: %s...", localHazeMob.Name)
                            FlyOverTarget(localHazeMob:FindFirstChild("HumanoidRootPart"))
                        else
                            Engine.CurrentCombatTarget = nil
                            local questHaze = LocalPlayer:FindFirstChild("QuestHaze")
                            local activeIslands = {}
                            if questHaze and hrp then
                                for _, folder in ipairs(questHaze:GetChildren()) do
                                    if folder:IsA("IntValue") and folder.Value > 0 then
                                        local cf = ResolveHazeIslandCFrame(folder.Name)
                                        if cf then table.insert(activeIslands, { Name = folder.Name, CFrame = cf, Distance = (hrp.Position - cf.Position).Magnitude }) end
                                    end
                                end
                            end
                            table.sort(activeIslands, function(a, b) return a.Distance < b.Distance end)
