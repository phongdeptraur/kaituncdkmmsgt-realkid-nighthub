local function UpdateRadarCycle3S()
    local indraExists = false
    pcall(function()
        local rsIndra = ReplicatedStorage:FindFirstChild("rip_indra True Form")
        local wsEnemies = workspace:FindFirstChild("Enemies")
        local wsIndra = wsEnemies and wsEnemies:FindFirstChild("rip_indra")
        if rsIndra or wsIndra or workspace:FindFirstChild("rip_indra") then
            indraExists = true
        end
    end)
    CachedRadarData.IndraExists = indraExists

    local doughAct, doughStat, doughM, doughR, doughH = GetBossPercentageStatus({"Dough King"})
    CachedRadarData.DoughActive = doughAct
    CachedRadarData.DoughStatus = doughStat
    CachedRadarData.DoughModel = doughM
    CachedRadarData.DoughRoot = doughR
    CachedRadarData.DoughHum = doughH

    local cakeAct, cakeStat = GetBossPercentageStatus({"Cake Queen"})
    CachedRadarData.CakeActive = cakeAct
    CachedRadarData.CakeStatus = cakeStat

    local longmaAct, longmaStat = GetBossPercentageStatus({"Longma"})
    CachedRadarData.LongmaActive = longmaAct
    CachedRadarData.LongmaStatus = longmaStat

    local reaperAct, reaperStat = GetBossPercentageStatus({"Soul Reaper"})
    CachedRadarData.ReaperActive = reaperAct
    CachedRadarData.ReaperStatus = reaperStat

    local eliteTarget = scanForElite()
    CachedRadarData.EliteTarget = eliteTarget
    if eliteTarget then
        local eHp, eMax = eliteTarget.Health, eliteTarget.MaxHealth
        if eHp and eMax and eMax > 0 then
            local pct = math.clamp(math.floor((eHp / eMax) * 100), 0, 100)
            CachedRadarData.EliteStatus = string.format("Status: ✅ [%d%%] (%s)", pct, eliteTarget.ExactName)
        else
            CachedRadarData.EliteStatus = string.format("Status: ✅ [100%%] (%s)", eliteTarget.ExactName)
        end
    else
        CachedRadarData.EliteStatus = "Status: ❌"
    end

    if not Engine.InCDKMode then
        lblIndraRadar.Text = "⚔️ rip_indra: " .. (CachedRadarData.IndraExists and "Status: ✅" or "Status: ❌")
        lblIndraRadar.TextColor3 = CachedRadarData.IndraExists and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(180, 180, 180)

        lblDoughRadar.Text = "🍩 Dough King: " .. CachedRadarData.DoughStatus
        lblDoughRadar.TextColor3 = CachedRadarData.DoughActive and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(180, 180, 180)

        lblCakeRadar.Text = "🍰 Cake Queen: " .. CachedRadarData.CakeStatus
        lblCakeRadar.TextColor3 = CachedRadarData.CakeActive and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(180, 180, 180)

        lblLongmaRadar.Text = "🐲 Longma: " .. CachedRadarData.LongmaStatus
        lblLongmaRadar.TextColor3 = CachedRadarData.LongmaActive and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(180, 180, 180)

        lblReaperRadar.Text = "👻 Soul Reaper: " .. CachedRadarData.ReaperStatus
        lblReaperRadar.TextColor3 = CachedRadarData.ReaperActive and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(180, 180, 180)

        lblEliteRadar.Text = "👹 Elite Boss: " .. CachedRadarData.EliteStatus
        lblEliteRadar.TextColor3 = (CachedRadarData.EliteTarget ~= nil) and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(180, 180, 180)
    end
end

