local function CheckBackpackRareFruitsAndNotify()
    local containers = {}
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then table.insert(containers, bp) end
    if LocalPlayer.Character then table.insert(containers, LocalPlayer.Character) end
    if #containers == 0 then return end

    local foundFruits = {}
    for _, container in ipairs(containers) do
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name
                local low = name:lower()
                local tip = tostring(item.ToolTip or "")

                -- Loại trừ trái đã ăn (trái đã ăn có ToolTip == "Blox Fruit" hoặc tên dạng "Kitsune-Kitsune" không có chữ "fruit")
                local isEatenFruitSkill = (tip == "Blox Fruit") or (name:find("-") ~= nil and not low:find("fruit"))
                -- Loại trừ vũ khí / nguyên liệu trùng tên Dragon
                local isWeaponExclude = low:find("talon") or low:find("trident") or low:find("heart") or low:find("storm") or low:find("scale")
                -- Chỉ nhận diện Fruit cầm tay thực sự (tên có chữ "fruit" hoặc có EatRemote bên trong)
                local isPhysicalFruit = (not isEatenFruitSkill) and (not isWeaponExclude) and (low:find("fruit") ~= nil or item:FindFirstChild("EatRemote") ~= nil)

                if isPhysicalFruit then
                    if low:find("kitsune") or low:find("dragon") then
                        if not Engine.NotifiedFruits[name] then
                            Engine.NotifiedFruits[name] = true
                            table.insert(foundFruits, name)
                        end
                    end
                end
            end
        end
    end

    if #foundFruits > 0 and request_ then
        local fruitListStr = table.concat(foundFruits, ", ")
        local msgContent = string.format(
            "<@%s> 🎉 **PHÁT HIỆN TRÁI HIẾM CẦM TAY (BACKPACK/HAND)!**\n👤 **Account:** `%s`\n🍎 **Fruit (Cầm tay):** `%s`\n🌐 **JobId:** `%s`",
            CONFIG.DiscordPingId,
            tostring(LocalPlayer.Name),
            fruitListStr,
            tostring(game.JobId)
        )
        task.spawn(function()
            pcall(function()
                request_({
                    Url = CONFIG.DiscordWebhook,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({ content = msgContent })
                })
            end)
        end)
    end
end

