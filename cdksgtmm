function Engine:LoadVisitedHistory()
    local data = SafeReadJsonFile(CONFIG.VisitedFile)
    if type(data) == "table" then
        local now = os.time()
        local cleaned = {}
        for jId, t in pairs(data) do
            if type(t) == "number" and (now - t < CONFIG.BlacklistDuration) then
                cleaned[tostring(jId)] = t
            end
        end
        self.VisitedServers = cleaned
        return
    end
    self.VisitedServers = {}
end

function Engine:RecordServer(jobId)
    if not jobId or tostring(jobId) == "" then return end
    self.VisitedServers[tostring(jobId)] = os.time()
    if typeof(writefile) == "function" then
        pcall(function()
            if typeof(makefolder) == "function" and (typeof(isfolder) ~= "function" or not isfolder("CDKProgress")) then makefolder("CDKProgress") end writefile(CONFIG.VisitedFile, HttpService:JSONEncode(self.VisitedServers)) end)
    end
end

function Engine:IsVisited(jobId)
    if not jobId then return true end
    local id = tostring(jobId)
    if id == tostring(game.JobId) then return true end
    local t = self.VisitedServers[id]
    if not t then return false end
    if (os.time() - t >= CONFIG.BlacklistDuration) then
        self.VisitedServers[id] = nil
        return false
    end
    return true
end

