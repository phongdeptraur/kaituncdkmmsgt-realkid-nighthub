-- [MASTERY SESSION COORDINATOR (mastery_session.txt) - UPDATE 5S / TIMEOUT 60S]
-- =========================================================================
function Engine:ReadAndCleanMasterySessions()
    local sessions = {}
    local modified = false
    local now = os.time()

    local decoded = SafeReadJsonFile(CONFIG.MasterySessionFile)
    if type(decoded) == "table" then
        for uid, info in pairs(decoded) do
            if type(info) == "table" and tonumber(info.Timestamp) then
                if (now - tonumber(info.Timestamp)) <= CONFIG.MasterySessionTimeout then
                    sessions[tostring(uid)] = info
                else
                    modified = true
                end
            else
                modified = true
            end
        end
    end

    if modified and typeof(writefile) == "function" then
        pcall(function()
            writefile(CONFIG.MasterySessionFile, HttpService:JSONEncode(sessions))
        end)
    end

    return sessions
end

function Engine:UpdateMasterySession(isActiveMastery, targetJobOverride)
    if typeof(writefile) ~= "function" then return end
    local now = os.time()
    local myUid = tostring(LocalPlayer.UserId)
    local sessions = self:ReadAndCleanMasterySessions()

    if isActiveMastery then
        if not self.MasteryServerClaimTime then
            self.MasteryServerClaimTime = now
        end
        sessions[myUid] = {
            UserId    = LocalPlayer.UserId,
            Name      = tostring(LocalPlayer.Name),
            JobId     = tostring(targetJobOverride or game.JobId),
            Timestamp = now,
            ClaimTime = self.MasteryServerClaimTime
        }
        self.LastMasterySessionWrite = os.clock()
    else
        self.MasteryServerClaimTime = nil
        if sessions[myUid] ~= nil then
            sessions[myUid] = nil
        else
            return
        end
    end

    pcall(function()
        writefile(CONFIG.MasterySessionFile, HttpService:JSONEncode(sessions))
    end)
end

function Engine:IsServerOccupiedByMasteryClone(jobId)
    if not jobId or tostring(jobId) == "" then return false end
    local targetJob = tostring(jobId)
    local myUid = tostring(LocalPlayer.UserId)
    local sessions = self:ReadAndCleanMasterySessions()

    for uid, info in pairs(sessions) do
        if tostring(uid) ~= myUid and tostring(info.JobId) == targetJob then
            return true, info.Name or uid
        end
    end
    return false, nil
end

