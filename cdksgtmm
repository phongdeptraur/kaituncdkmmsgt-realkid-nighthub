        return CachedIRS, CachedKEYS, CachedItemId, CachedCfgStorage
    end
    ModulesChecked = true

    pcall(function()
        local irsInst = ReplicatedStorage:FindFirstChild("ItemReplicationService")
        if irsInst then
            CachedIRS = SafeRequire(irsInst, 0.6)
            if irsInst:FindFirstChild("KEYS") then
                CachedKEYS = SafeRequire(irsInst.KEYS, 0.4)
            end
        end
    end)

    pcall(function()
        local econ = ReplicatedStorage:FindFirstChild("Economy")
        if econ and econ:FindFirstChild("ItemId") then
            CachedItemId = SafeRequire(econ.ItemId, 0.6)
        end
    end)

    pcall(function()
        local cfgInst = ReplicatedStorage:FindFirstChild("ItemConfig")
        if cfgInst and cfgInst:FindFirstChild("Storage") then
            CachedCfgStorage = SafeRequire(cfgInst.Storage, 0.6)
        end
    end)

    return CachedIRS, CachedKEYS, CachedItemId, CachedCfgStorage
end

local function FetchIRSItems(keyName)
    local IRS, KEYS = GetInventoryModules()
    if not IRS then return {} end
    local qKey = (KEYS and KEYS[keyName]) or keyName

    -- 1. Gọi trực tiếp ItemReplicationService:GetItems(qKey) (hỗ trợ cả Dictionary và Array)
    if typeof(IRS.GetItems) == "function" then
        local ok, res = pcall(function() return IRS:GetItems(qKey) end)
        if ok and HasTableEntries(res) then return res end
    end

    -- 2. Kiểm tra trong IRS._UserCache (hỗ trợ cả number và string UserId)
    if IRS._UserCache then
        local uEntry = IRS._UserCache[LocalPlayer.UserId] or IRS._UserCache[tostring(LocalPlayer.UserId)]
        if uEntry and typeof(uEntry.GetItems) == "function" then
            local ok, res = pcall(function() return uEntry:GetItems(qKey) end)
            if ok and HasTableEntries(res) then return res end
        end
    end
    return {}
end

local ResolvedNameCache = {}
local function ResolveItemName(itemId)
    if not itemId then return "" end
    local sId = tostring(itemId)
    if ResolvedNameCache[sId] then return ResolvedNameCache[sId] end

    -- Nếu bản thân itemId đã là chuỗi ký tự tên item (chứa chữ cái), trả về ngay
    if type(itemId) == "string" and itemId:match("%a+") then
        ResolvedNameCache[sId] = itemId:gsub(" %[.-%]", "")
        return ResolvedNameCache[sId]
    end

    local _, _, ItemIdMod, CfgStorage = GetInventoryModules()
    local name = ""
    if ItemIdMod and typeof(ItemIdMod.getDataFromId) == "function" then
        pcall(function()
            local data = ItemIdMod.getDataFromId(itemId)
            if data and typeof(data.unwrap) == "function" then
                local unwrapped = data:unwrap()
                if unwrapped then
                    name = tostring(unwrapped.StorageKey or unwrapped.DebugLabel or "")
                end
            end
        end)
    end
    if name == "" and CfgStorage and typeof(CfgStorage.match) == "function" then
        pcall(function()
            local matchData = CfgStorage.match(itemId):unwrap()
            if matchData and matchData.Index then
                name = tostring(matchData.Index.DebugLabel or matchData.Index.StorageKey or "")
            end
        end)
    end
    if name == "" then
        name = tostring(itemId)
    end
    name = name:gsub(" %[.-%]", "")
    ResolvedNameCache[sId] = name
    return name
end


