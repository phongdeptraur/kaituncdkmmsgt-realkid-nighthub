-- [CDK STATUS & MONOTONIC PERSISTENT LATCH - DUAL PARALLEL SCAN]
-- =========================================================================
getgenv().CDK_LATCH = getgenv().CDK_LATCH or {
    InitialQueueChecked = false,
    ActiveEvil = nil,
    ActiveGood = nil,
    Yama1Done = false,
    Yama2Done = false,
    Yama3Done = false,
    YamaCompleted = false,
    Tushita1Done = false,
    Tushita2Done = false,
    Tushita3Done = false,
    TushitaCompleted = false,
    AlucardFragments = 0,
}

local _lastCDKProgressPoll = 0
local function PollCDKProgressContinuous()
    local now = os.clock()
    if now - _lastCDKProgressPoll < 0.6 then return end
    _lastCDKProgressPoll = now

    local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
    if not commF then return end

    local ok, prog = pcall(function()
        return commF:InvokeServer("CDKQuest", "Progress")
    end)

    if ok and type(prog) == "table" then
        local Latch = getgenv().CDK_LATCH
        local rawE = tonumber(prog.Evil)
        local rawG = tonumber(prog.Good)

        -- [EVIL / YAMA PROGRESSION]: Bỏ qua -2 vì khi Good đang chạy, Evil sẽ tự thành -2
        if rawE and rawE ~= -2 then
            if rawE == -3 then
                Latch.ActiveEvil = -3
            elseif rawE == -4 then
                -- Nhận diện -4 -> Tự động hiểu nhiệm vụ 1 đã xong, đang làm nhiệm vụ 2
                Latch.Yama1Done = true
                Latch.ActiveEvil = -4
            elseif rawE == -5 then
                -- Nhận diện -5 -> Tự động hiểu nhiệm vụ 1 và 2 đã xong, đang làm nhiệm vụ 3
                Latch.Yama1Done = true
                Latch.Yama2Done = true
                Latch.ActiveEvil = -5
            elseif rawE == 1 then
                Latch.Yama1Done = true
                if Latch.ActiveEvil == -3 then Latch.ActiveEvil = nil end
            elseif rawE == 2 then
                Latch.Yama1Done = true
                Latch.Yama2Done = true
                if Latch.ActiveEvil == -4 then Latch.ActiveEvil = nil end
            elseif rawE == 3 or rawE == 4 then
                Latch.Yama1Done = true
                Latch.Yama2Done = true
                Latch.Yama3Done = true
                Latch.YamaCompleted = true
                Latch.ActiveEvil = nil
            end
        end

        -- [GOOD / TUSHITA PROGRESSION]: Bỏ qua -2 vì khi Evil đang chạy, Good sẽ tự thành -2
        if rawG and rawG ~= -2 then
            if rawG == -3 then
                Latch.ActiveGood = -3
            elseif rawG == -4 then
                -- Nhận diện -4 -> Tự động hiểu nhiệm vụ 1 đã xong, đang làm nhiệm vụ 2
                Latch.Tushita1Done = true
                Latch.ActiveGood = -4
            elseif rawG == -5 then
                -- Nhận diện -5 -> Tự động hiểu nhiệm vụ 1 và 2 đã xong, đang làm nhiệm vụ 3
                Latch.Tushita1Done = true
                Latch.Tushita2Done = true
                Latch.ActiveGood = -5
            elseif rawG == 1 then
                Latch.Tushita1Done = true
                if Latch.ActiveGood == -3 then Latch.ActiveGood = nil end
            elseif rawG == 2 then
                Latch.Tushita1Done = true
                Latch.Tushita2Done = true
                if Latch.ActiveGood == -4 then Latch.ActiveGood = nil end
            elseif rawG == 3 or rawG == 4 then
                Latch.Tushita1Done = true
                Latch.Tushita2Done = true
                Latch.Tushita3Done = true
                Latch.TushitaCompleted = true
                Latch.ActiveGood = nil
            end
        end
    end
end

local function GetCDKQuestStatus()
    local Latch = getgenv().CDK_LATCH

    -- Quét tiến trình liên tục, tự động nâng cấp nhiệm vụ khi status chuyển từ -3 sang -4, -5
    pcall(PollCDKProgressContinuous)

    local evilDone = 0
    local goodDone = 0

    local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
    if not commF then
        local remotes = ReplicatedStorage:WaitForChild("Remotes", 2)
        commF = remotes and remotes:FindFirstChild("CommF_")
    end

    -- [KIỂM TRA SỐ LƯỢNG ALUCARD FRAGMENT TRONG TÚI ĐỒ]
    local alucardCount = 0
    if commF then
        pcall(function()
            local inv = commF:InvokeServer("getInventory")
            if type(inv) == "table" then
                for _, item in ipairs(inv) do
                    if type(item) == "table" then
                        local name = tostring(item.Name or item.name or "")
                        if name == "Alucard Fragment" or name == "AlucardFragment" or name:find("Alucard") then
                            local cnt = tonumber(item.Count or item.count or item.Value or item.value) or 1
                            if cnt > alucardCount then
                                alucardCount = cnt
                            end
                        end
                    end
                end
            end
        end)
    end

    -- Nếu mảnh Alucard tăng -> Hoàn thành quest tương ứng
    if alucardCount > Latch.AlucardFragments then
        Latch.AlucardFragments = alucardCount
        if Latch.ActiveEvil == -3 then
            Latch.Yama1Done = true
            Latch.ActiveEvil = nil
        elseif Latch.ActiveEvil == -4 then
            Latch.Yama2Done = true
            Latch.ActiveEvil = nil
        elseif Latch.ActiveEvil == -5 then
            Latch.Yama3Done = true
            Latch.YamaCompleted = true
            Latch.ActiveEvil = nil
        elseif Latch.ActiveGood == -3 then
            Latch.Tushita1Done = true
            Latch.ActiveGood = nil
        elseif Latch.ActiveGood == -4 then
            Latch.Tushita2Done = true
            Latch.ActiveGood = nil
        elseif Latch.ActiveGood == -5 then
            Latch.Tushita3Done = true
            Latch.TushitaCompleted = true
            Latch.ActiveGood = nil
        end
    else
        alucardCount = math.max(alucardCount, Latch.AlucardFragments)
    end

    if alucardCount >= 3 then
        Latch.Yama1Done = true
        Latch.Yama2Done = true
        Latch.Yama3Done = true
        Latch.YamaCompleted = true
    end
    if alucardCount >= 6 then
        Latch.Tushita1Done = true
        Latch.Tushita2Done = true
        Latch.Tushita3Done = true
        Latch.TushitaCompleted = true
    end

    if Latch.Yama3Done or Latch.YamaCompleted then
        Latch.Yama1Done = true
        Latch.Yama2Done = true
        Latch.Yama3Done = true
        Latch.YamaCompleted = true
        evilDone = 3
    else
        local cntE = 0
        if Latch.Yama1Done then cntE = cntE + 1 end
        if Latch.Yama2Done then cntE = cntE + 1 end
        if Latch.Yama3Done then cntE = cntE + 1 end
        evilDone = math.max(evilDone, cntE)
        if evilDone >= 3 then Latch.YamaCompleted = true end
    end

    if Latch.Tushita3Done or Latch.TushitaCompleted then
        Latch.Tushita1Done = true
        Latch.Tushita2Done = true
        Latch.Tushita3Done = true
        Latch.TushitaCompleted = true
        goodDone = 3
    else
        local cntG = 0
        if Latch.Tushita1Done then cntG = cntG + 1 end
        if Latch.Tushita2Done then cntG = cntG + 1 end
        if Latch.Tushita3Done then cntG = cntG + 1 end
        goodDone = math.max(goodDone, cntG)
        if goodDone >= 3 then Latch.TushitaCompleted = true end
    end

    local isYamaDone = Latch.YamaCompleted or (evilDone >= 3)
    local isTushitaDone = Latch.TushitaCompleted or (goodDone >= 3)

    if QuestMemory then
        QuestMemory.Yama1Done = Latch.Yama1Done
        QuestMemory.Yama2Done = Latch.Yama2Done
        QuestMemory.Yama3Done = Latch.Yama3Done
        QuestMemory.YamaCompleted = isYamaDone
        QuestMemory.Tushita1Done = Latch.Tushita1Done
        QuestMemory.Tushita2Done = Latch.Tushita2Done
        QuestMemory.Tushita3Done = Latch.Tushita3Done
        QuestMemory.TushitaCompleted = isTushitaDone
    end

    return {
        evilDone = evilDone,
        goodDone = goodDone,
        currentEvil = Latch.ActiveEvil,
        currentGood = Latch.ActiveGood,
        YamaDone = isYamaDone,
        TushitaDone = isTushitaDone,
        Yama1Done = Latch.Yama1Done,
        Yama2Done = Latch.Yama2Done,
        Yama3Done = Latch.Yama3Done,
        Yama1 = Latch.Yama1Done,
        Yama2 = Latch.Yama2Done,
        Yama3 = Latch.Yama3Done,
        Tushita1Done = Latch.Tushita1Done,
        Tushita2Done = Latch.Tushita2Done,
        Tushita3Done = Latch.Tushita3Done,
        Tushita1 = Latch.Tushita1Done,
        Tushita2 = Latch.Tushita2Done,
        Tushita3 = Latch.Tushita3Done,
        AllDone = (isYamaDone and isTushitaDone),
        AlucardFragments = alucardCount
    }
end

