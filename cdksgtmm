                        local hasValidRes = type(info.reservedJobId) == "string" and #info.reservedJobId >= 20 and (now - resTs) <= 20
                        if hasActiveJob or hasValidRes then
                            roster[tostring(uid)] = {
                                userId = tostring(info.userId or uid),
                                name = tostring(info.name or ""),
                                jobId = hasActiveJob and tostring(info.jobId) or "",
                                reservedJobId = hasValidRes and tostring(info.reservedJobId) or "",
                                reserveTime = hasValidRes and resTs or 0,
                                joined = tonumber(info.joined) or ts or now,
                                time = ts,
                                mode = tostring(info.mode or ""),
                                state = hasActiveJob and "active" or "reserving"
                            }
                        end
                    end
                end
            end
        end
    end)

    for _, path in ipairs(TTL_FILES) do
        pcall(function()
            if isfile and isfile(path) then
                local raw = readfile(path)
                local ok, dt = pcall(HttpService.JSONDecode, HttpService, raw)
                if ok and type(dt) == "table" then
                    for jid, info in pairs(dt) do
                        if type(jid) == "string" and #jid >= 20 and type(info) == "table" then
                            local ts = tonumber(info.time or info.ts) or 0
                            local uid = tostring(info.userId or "")
                            local state = tostring(info.state or "active")
                            local limit = (state == "reserving") and 20 or BONES_TTL
                            if uid ~= "" and (now - ts) <= limit and not roster[uid] then
                                roster[uid] = {
                                    userId = uid,
                                    name = tostring(info.name or ""),
                                    jobId = (state ~= "reserving") and jid or "",
                                    reservedJobId = (state == "reserving") and jid or "",
                                    reserveTime = (state == "reserving") and ts or 0,
                                    joined = tonumber(info.joined) or ts,
                                    time = ts,
                                    mode = tostring(info.mode or ""),
                                    state = state
                                }
                            end
                        end
                    end
                end
            end
        end)
    end

    return roster
end

local function WriteFarmRoster(roster)
    pcall(writefile, ROSTER_FILE, HttpService:JSONEncode(roster))
    local legacy = {}
    for uid, info in pairs(roster) do
        local targetJid = (info.jobId ~= "" and info.jobId) or info.reservedJobId
        if targetJid and #targetJid >= 20 then
            local prev = legacy[targetJid]
            if not prev or IsHigherPriority(info.joined, uid, prev.joined, prev.userId) then
                legacy[targetJid] = {
                    time = math.max(info.time or 0, info.reserveTime or 0),
                    joined = info.joined,
                    userId = uid,
                    name = info.name,
                    mode = info.mode,
                    state = (info.jobId ~= "") and "active" or "reserving"
                }
            end
        end
    end
    local encoded = HttpService:JSONEncode(legacy)
    for _, path in ipairs(TTL_FILES) do
        pcall(writefile, path, encoded)
    end
end

local function ReadActiveTTLClaims()
    local roster = ReadFarmRoster()
    local claims = {}
    for uid, info in pairs(roster) do
        for _, jid in ipairs({ info.jobId, info.reservedJobId }) do
            if type(jid) == "string" and #jid >= 20 then
                local prev = claims[jid]
                if not prev or IsHigherPriority(info.joined, uid, prev.joined, prev.userId) then
                    claims[jid] = {
                        time = math.max(info.time or 0, info.reserveTime or 0),
                        joined = info.joined,
                        userId = uid,
                        name = info.name,
                        mode = info.mode,
                        state = (jid == info.jobId) and "active" or "reserving"
                    }
                end
            end
        end
    end
    return claims
end

