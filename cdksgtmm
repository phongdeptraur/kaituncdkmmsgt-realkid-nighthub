local function resolveRootPart(inst: Instance): BasePart?
    if not inst then return nil end
    local root = inst:FindFirstChild("HumanoidRootPart")
        or (inst:IsA("Model") and inst.PrimaryPart)
        or inst:FindFirstChildWhichIsA("BasePart", true)

    if root and root:IsA("BasePart") then
        return root
    end
    return nil
end

local function scanForElite()
    local containers = {
        { Container = workspace:FindFirstChild("Enemies"), Tag = "Workspace.Enemies" },
        { Container = ReplicatedStorage, Tag = "ReplicatedStorage" },
        { Container = workspace, Tag = "Workspace" },
    }

    for _, entry in ipairs(containers) do
        local container = entry.Container
        if not container then continue end

        for _, child in ipairs(container:GetChildren()) do
            local nameLower = child.Name:lower()

            for _, kw in ipairs(ELITE_KEYWORDS) do
                if string.find(nameLower, kw) then
                    local hum = child:FindFirstChildOfClass("Humanoid") or child:FindFirstChildWhichIsA("Humanoid", true)
                    local root = resolveRootPart(child)
                    local hp = hum and hum.Health or 0
                    local maxHp = hum and hum.MaxHealth or 0

                    if root and (not hum or hp > 0) then
                        return {
                            Instance = child,
                            Root = root,
                            Hum = hum,
                            ExactName = child.Name,
                            CFrame = root.CFrame,
                            Health = hp,
                            MaxHealth = maxHp,
                            Source = entry.Tag,
                        }
                    end
                end
            end
        end
    end

    local wsEnemies = workspace:FindFirstChild("Enemies")
    if wsEnemies then
        for _, desc in ipairs(wsEnemies:GetDescendants()) do
            if desc:IsA("Model") then
                local nameLower = desc.Name:lower()
                for _, kw in ipairs(ELITE_KEYWORDS) do
                    if string.find(nameLower, kw) then
                        local root = resolveRootPart(desc)
                        if root then
                            local hum = desc:FindFirstChildOfClass("Humanoid")
                            local hp = hum and hum.Health or 0
                            local maxHp = hum and hum.MaxHealth or 0
                            return {
                                Instance = desc,
                                Root = root,
                                Hum = hum,
                                ExactName = desc.Name,
                                CFrame = root.CFrame,
                                Health = hp,
                                MaxHealth = maxHp,
                                Source = "Workspace.Enemies.DeepScan",
                            }
                        end
                    end
                end
            end
        end
    end

    return nil
