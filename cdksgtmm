local function IsMobAlive(mob)
    if not mob or not mob.Parent then return false end
    local hum = mob:FindFirstChildOfClass("Humanoid")
    local root = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart or mob:FindFirstChild("Torso")
    if hum and hum.Health > 0 and root then
        return true, root, hum
    end
    return false, nil, nil
end

local function ReleaseMagnetMob(mob)
    local entry = MagnetRegistry[mob]
    if not entry then return end

    if entry.Root and entry.Root.Parent then
        entry.Root.Anchored = false
        entry.Root.CanCollide = true
        entry.Root.AssemblyLinearVelocity = Vector3.zero
        entry.Root.AssemblyAngularVelocity = Vector3.zero
    end

    if entry.Hum and entry.Hum.Parent then
        pcall(function()
            entry.Hum.PlatformStand = false
            entry.Hum.WalkSpeed = 16
        end)
    end

    if entry.BodyPos and entry.BodyPos.Parent then
        pcall(function() entry.BodyPos:Destroy() end)
    end

    MagnetRegistry[mob] = nil
end

local function ClearAllMagnetMobs()
    for mob in pairs(MagnetRegistry) do
        ReleaseMagnetMob(mob)
    end
    StaticClusterPos = nil
    CurrentAnchorMob = nil
    Engine.CurrentMagnetPos = nil
end

local function RegisterMagnetMob(mob, root, hum)
    if MagnetRegistry[mob] then return end

    pcall(function()
        hum.PlatformStand = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    end)

    root.Anchored = false
    root.CanCollide = false

    local bp = root:FindFirstChild("AxiomMagnetBP") or Instance.new("BodyPosition")
    bp.Name = "AxiomMagnetBP"
    bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bp.P = 300000
    bp.D = 3000
    bp.Position = root.Position
    bp.Parent = root

    MagnetRegistry[mob] = {
        Mob = mob,
        Root = root,
        Hum = hum,
        BodyPos = bp
    }
end

local function FindNewAnchorMob(playerPos)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil, nil end

    local bestMob = nil
    local bestRoot = nil
    local shortestDist = math.huge

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob ~= LocalPlayer.Character and not string.find(mob.Name:lower(), "reaper") then
            local alive, root, _ = IsMobAlive(mob)
            if alive then
                local dist = (root.Position - playerPos).Magnitude
                if dist <= MAGNET_RADIUS and dist < shortestDist then
                    shortestDist = dist
                    bestMob = mob
                    bestRoot = root
                end
            end
        end
    end
    return bestMob, bestRoot
end

local magnetConn = RunService.Stepped:Connect(function()
    if not Engine.IsRunning or not Engine.BringMob or not _G.BringMobs or Engine.IsHopping or Engine.ActiveCDKMode == "Yama1" or Engine.ActiveCDKMode == "Tushita1" or Engine.WaitReaper or Engine.CurrentGood == -3 then
        if next(MagnetRegistry) or StaticClusterPos then ClearAllMagnetMobs() end
        return
    end

    BoostSimulationRadius()

    local char = LocalPlayer.Character
    local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not playerRoot then
        if next(MagnetRegistry) or StaticClusterPos then ClearAllMagnetMobs() end
        return
    end
    local playerPos = playerRoot.Position

    -- 1. KIỂM TRA QUÁI MỎ NEO (ANCHOR MOB) HIỆN TẠI
    local anchorAlive, aRoot, _ = IsMobAlive(CurrentAnchorMob)

    -- Nếu quái mỏ neo đã chết hoặc mất: Kiểm tra xem bãi cũ còn quái gom nào sống không
    if not anchorAlive then
        CurrentAnchorMob = nil
        local substituteMob = nil
        local substituteRoot = nil

        for mob, entry in pairs(MagnetRegistry) do
            local alive, root, _ = IsMobAlive(mob)
            if alive then
                substituteMob = mob
                substituteRoot = root
                break
            end
        end

        if substituteMob and substituteRoot then
            -- Còn quái ở bãi cũ: Kế thừa vị trí tĩnh bãi cũ để gom nốt, không di chuyển bãi
            CurrentAnchorMob = substituteMob
        else
            -- ĐÃ DIỆT SẠCH TOÀN BỘ QUÁI Ở BÃI CŨ -> TÌM VỊ TRÍ QUÁI MỚI ĐỂ LẬP MỎ NEO MỚI
            ClearAllMagnetMobs()
            local newMob, newRoot = FindNewAnchorMob(playerPos)
            if newMob and newRoot then
                CurrentAnchorMob = newMob
                StaticClusterPos = newRoot.Position
            else
                StaticClusterPos = nil
                Engine.CurrentMagnetPos = nil
                return
            end
        end
    end

    -- Nếu chưa có vị trí tĩnh thì chốt vị trí mỏ neo hiện tại
    if not StaticClusterPos and aRoot then
        StaticClusterPos = aRoot.Position
    end

    if not StaticClusterPos then return end
    Engine.CurrentMagnetPos = StaticClusterPos

    -- 2. QUÉT VÀ KÉO TẤT CẢ QUÁI XUNG QUANH VỀ CHÍNH XÁC VỊ TRÍ TĨNH (STATIC POSITION)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    local candidates = {}
    for _, mob in ipairs(enemies:GetChildren()) do
        if mob ~= char and mob ~= CurrentAnchorMob and not string.find(mob.Name:lower(), "reaper") then
            local alive, root, hum = IsMobAlive(mob)
            if alive then
                local dist = (root.Position - StaticClusterPos).Magnitude
                if dist <= MAGNET_RADIUS then
                    table.insert(candidates, { Mob = mob, Root = root, Hum = hum, Dist = dist })
                end
            end
        end
    end

    table.sort(candidates, function(a, b) return a.Dist < b.Dist end)

    local activeTargetLookup = {}
    if CurrentAnchorMob then activeTargetLookup[CurrentAnchorMob] = true end

    local selectCount = math.min(MAX_MAGNET_MOBS, #candidates)
    for i = 1, selectCount do
        local cand = candidates[i]
        activeTargetLookup[cand.Mob] = true
        if not MagnetRegistry[cand.Mob] then
            RegisterMagnetMob(cand.Mob, cand.Root, cand.Hum)
        end
    end

    -- 3. KHÓA CHẶT TỌA ĐỘ VÀ VẬN TỐC TẠI VỊ TRÍ CỐ ĐỊNH, CHỐNG BAY LOẠN XẠ
    local targetCF = CFrame.new(StaticClusterPos)
    local dropList = {}

    for mob, entry in pairs(MagnetRegistry) do
        local alive, root, _ = IsMobAlive(mob)
        if not alive or not activeTargetLookup[mob] then
            table.insert(dropList, mob)
        else
            root.Anchored = false
            root.CanCollide = false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = targetCF

            if entry.BodyPos and entry.BodyPos.Parent then
                entry.BodyPos.Position = StaticClusterPos
            end
        end
    end

    for _, dropMob in ipairs(dropList) do
        ReleaseMagnetMob(dropMob)
    end
end)
table.insert(Engine.Connections, magnetConn)

