-- Inventory
local inv, invT = {}, 0
local function K(s) return tostring(s or ""):gsub(" %[.-%]", ""):lower():gsub("%W", "") end
local function Items()
    if os.clock() - invT > 2 then
        invT = os.clock()
        local n, done = {}, false
        local function put(nm, c, m)
            if (c or 0) <= 0 then return end
            local k = K(nm)
            local o = n[k]
            n[k] = { c = math.max(o and o.c or 0, c), m = math.max(o and o.m or 0, m or 0) }
            local s = tostring(nm):lower()
            if s:find("valkyrie") then n.valkyriehelm = n[k] end
            if s:find("mirror") and s:find("fractal") then n.mirrorfractal = n[k] end
        end
        task.spawn(function()
            pcall(function()
                local irM = RS:WaitForChild("ItemReplicationService", 5)
                local kM = irM and irM:WaitForChild("KEYS", 5)
                local idM = RS:WaitForChild("Economy", 5) and RS.Economy:WaitForChild("ItemId", 5)
                if not (irM and kM and idM) then return end
                local IR, KEYS, ID = require(irM), require(kM), require(idM)
                local t0 = os.clock()
                while S.Run and not IR.IsInitialized and os.clock() - t0 < 8 do task.wait(0.2) end
                if not IR.IsInitialized then return end
                local mast = {}
                pcall(function()
                    for k, e in pairs(IR:GetItems(KEYS.MASTERY)) do
                        if type(e) == "table" then mast[tostring(e.ItemId or k)] = tonumber(e.Value or e.Mastery) or 0 end
                    end
                end)
                for _, it in pairs(IR:GetItems(KEYS.QUANTITY)) do
                    local c = tonumber(it.Value) or 0
                    if c > 0 then
                        local ok, d = pcall(function() return ID.getDataFromId(it.ItemId):unwrap() end)
                        if ok and d then
                            local m = mast[tostring(it.ItemId)] or 0
                            for _, nm in ipairs({ d.StorageKey, d.DisplayName, d.Name }) do
                                if nm then put(nm, c, m) end
                            end
                        end
                    end
                end
            end)
            done = true
        end)
        while S.Run and not done do task.wait(0.05) end
        for _, i in pairs(Inv("getInventory") or {}) do
            if type(i) == "table" and i.Name then put(i.Name, tonumber(i.Count) or 1, tonumber(i.Mastery) or 0) end
        end
        if next(n) then inv = n end
    end
    return inv
end
