local function SGT()
    S.noAttack = false
    local ecto, df, bones = Cnt("Ectoplasm"), Cnt("Dark Fragment"), math.max(Cnt("Bones"), Cnt("Bone"))
    S.sgtStatus = string.format(" [SGT NL: Ecto %d/250 | DF %d/1 | Bones %d/500]", ecto, df, bones)
    Say()

    if df < 1 and Sea() == 2 and Boss(DARKBEARD, P.Dark) then return end

    if ecto < 250 then
        if S.RK then
            return HopLow("Chuyển sang farm Ectoplasm -> Hop Low né SV", "Ectoplasm")
        end
        if not Need(2) then return end
        S.farmStatus = FormatFarmAccStatus()
        if CheckAntiColocation(P.Ship, "Ectoplasm") then return end
        local opSw, opMas = EquipOpportunisticMasterySword()
        local ectoDesc = opSw
            and ("Đang farm Ectoplasm: %d/250 [Tranh thủ Mas %s: %d/350]"):format(ecto, opSw, opMas)
            or ("Đang farm Ectoplasm: %d/250"):format(ecto)
        return Main({ AutoFarmMaterialSkullGuitar = true, weapon_choice = "Sword", AutoRandomBones = false }, ectoDesc)
    end

    if df < 1 and ecto >= 250 then
        if S.Main or (G._RKHop == game.JobId and G._RKLbl == "Skull Guitar") then
            ReleaseServerClaim()
            return HopLow("Đã đủ 250 Ectoplasm -> Hop Low refresh tìm Darkbeard")
        end
        if not Need(2) then return end
        if Boss(DARKBEARD, P.Dark) then return end
        Search("Darkbeard", P.Dark, DARKBEARD)
        return
    end

    if bones < 500 then
        if S.RK then
            return HopLow("Chuyển sang farm Bones -> Hop Low né SV", "Bones")
        end
        if not Need(3) then return end
        S.farmStatus = FormatFarmAccStatus()
        if CheckAntiColocation(P.Haunted, "Bones") then return end
        local opSw, opMas = EquipOpportunisticMasterySword()
        local bonesDesc = opSw
            and ("Đang farm Bones: %d/500 [Tranh thủ Mas %s: %d/350]"):format(bones, opSw, opMas)
            or ("Đang farm Bones: %d/500"):format(bones)
        return Main({ auto_farm_general = true, selected_farm_target = "Bones", weapon_choice = "Sword", AutoRandomBones = false }, bonesDesc)
    end

    if ecto >= 250 and df >= 1 and bones >= 500 then
        if S.Main then
            ReleaseServerClaim()
            return HopLow("Đã đủ 500 Bones -> Hop Low tiếp tục làm Skull Guitar")
        end
        local frags = GetDataNum("Fragments")
        if frags < 5000 then
            S.sgtStatus = string.format(" [SGT Frag: %d/5000]", frags)
            if S.RK or S.Main then
                return HopLow(("Đủ 3 nguyên liệu SGT nhưng thiếu Fragment (%d/5000) -> Hop Low farm Fragment"):format(frags))
            end
            S.FragFarm = true
            S.FragTarget = 5000
            S.target = nil
            if S.Fly then Float(false) end
            Say(("Đủ 3 nguyên liệu SGT nhưng thiếu Fragment (%d/5000) -> Đang chạy Auto Farm Fragment..."):format(frags))
            if G._FragFarmLoaded ~= game.JobId then
                G._FragFarmLoaded = game.JobId
                task.spawn(function()
                    local ok, err = pcall(function()
                        loadstring(game:HttpGet(FRAG_URL))()
                    end)
                    if not ok then
                        warn("[AutoFrag]", err)
                        G._FragFarmLoaded = nil
                    end
                end)
            end
            task.wait(1)
            return
        elseif S.FragFarm then
            S.FragFarm = false
            S.FragTarget = nil
            return HopLow("Đã đủ 5,000 Fragment -> Hop Low để lấy Skull Guitar")
        end

        if not Need(3) then return end

        local jid = tostring(game.JobId)
        local now = os.clock()
        local isFM, fmDetail, fmRemMin = CheckFullMoonNight()

        if G._RKHop == game.JobId and G._RKLbl == "Skull Guitar" then
            if S.SGTFinalJob ~= jid then
                S.SGTFinalJob = jid
                S.SGTFinalStart = now
            end

            local elapsed = now - (S.SGTFinalStart or now)
            if not isFM then
                if elapsed >= 60 then
                    S.SGTFinalStart = now
                    return HopLow(("Đủ 4 NL SGT, chạy RealKidHop sau 1p chưa có Full Moon (%s) -> Hop Low"):format(fmDetail))
                end
                local rem60 = math.max(0, 60 - elapsed)
                S.sgtStatus = string.format(" [SGT: Đang chạy RK-Hop tìm FM (Hop sau: %ds)]", math.ceil(rem60))
                Say()
            else
                if elapsed >= 600 then
                    S.SGTFinalStart = now
                    return HopLow("Đủ 4 nguyên liệu SGT và chạy RealKidHop quá 10 phút -> Hop Low")
                end

                if S.SGTNearJob ~= jid then
                    S.SGTNearJob = jid
                    S.SGTNearAcc = 0
                    S.SGTNearLast = now
                end
                local dt = math.min(now - (S.SGTNearLast or now), 1)
                S.SGTNearLast = now

                local r = Root()
                local nearPl, nearDist = nil, nil
                if r then
                    for _, pl in ipairs(Players:GetPlayers()) do
                        if pl ~= LP and pl.Character then
                            local pr = pl.Character:FindFirstChild("HumanoidRootPart")
                            if pr then
                                local dist = (pr.Position - r.Position).Magnitude
                                if dist <= 500 then
                                    nearPl, nearDist = pl, dist
                                    break
                                end
                            end
                        end
                    end
                end

                if nearPl then
                    S.SGTNearAcc = (S.SGTNearAcc or 0) + dt
                    if S.SGTNearAcc >= 55 then
                        S.SGTNearAcc = 0
                        return HopLow(("Đủ 4 nguyên liệu SGT nhưng có %s ở gần (%.0fm) tích lũy %.0fs/60s -> Hop Low"):format(nearPl.Name, nearDist, 55))
                    end
                end

                local rem10m = math.max(0, 600 - elapsed)
                local min10 = math.floor(rem10m / 60)
                local sec10 = math.floor(rem10m % 60)

                if nearPl then
                    local remNear = math.max(0, 55 - (S.SGTNearAcc or 0))
                    local minNear = math.floor(remNear / 60)
                    local secNear = math.floor(remNear % 60)
                    S.sgtStatus = string.format(" [SGT Hop sau: %dp%02ds (Gần %s) | Max: %dp%02ds | FM: ~%.1fp]", minNear, secNear, nearPl.Name, min10, sec10, fmRemMin)
                else
                    S.sgtStatus = string.format(" [SGT Hop sau: %dp%02ds | FM còn: ~%.1fp]", min10, sec10, fmRemMin)
                end
                Say()
            end
        else
            S.SGTFinalJob = nil
            S.SGTFinalStart = nil
            S.sgtStatus = " [SGT: Đang bật RealKidHop (GuitarEnabled)...]"
            Say()
        end
    end
    Hop(nil, { GuitarEnabled = true, SearchEnabled = false })
end

