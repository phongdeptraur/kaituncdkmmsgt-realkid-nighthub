local function Float(on)
    local r = Root()
    if not r then return end
    local b = r:FindFirstChild("AxF")
    if on then
        if not b then
            b = Instance.new("BodyVelocity")
            b.Name, b.MaxForce, b.Velocity, b.Parent = "AxF", V3(1e9, 1e9, 1e9), V3(), r
        end
    else
        if b then b:Destroy() end
        for _, p in ipairs(r.Parent:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide, p.CanTouch = true, true end end
    end
    S.Fly = on
end

local function Unload()
    if not S.Run then return end
    S.Run = false; if G._Indra and type(G._Indra.Stop) == "function" then pcall(G._Indra.Stop) end
    if ReleaseServerClaim then pcall(ReleaseServerClaim) end
    if curTw then pcall(function() curTw:Cancel() end) curTw = nil end
    if conn then pcall(function() conn:Disconnect() end) conn = nil end
    pcall(Float, false)
    if gui then pcall(function() gui:Destroy() end) end
    if G._AxiomLite == S then G._AxiomLite = nil end
end
