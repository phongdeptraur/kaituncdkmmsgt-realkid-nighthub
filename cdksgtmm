            pcall(function() vis = HttpService:JSONDecode(readfile(VF)) end)
            local now = os.time()
            for k, v in pairs(vis) do if type(v) ~= "number" or now - v > 300 then vis[k] = nil end end
            vis[tostring(game.JobId)] = now
        end

        while S.Run do
            local ignored = isAvoid and LoadIgnoredJobs() or nil
            local function isIgnored(id)
                if not id or id == "" or id == tostring(game.JobId) then return true end
                if isAvoid then
                    if vis[id] then return true end
                    if ignored and ignored[id] then return true end
                end
                return false
            end

            local byJob, pool, completed = {}, {}, 0
            local fastFound = 0
            local br = RS:FindFirstChild("__ServerBrowser")
            if br then
                local totalPages = 150
                for page = 1, totalPages do
                    task.spawn(function()
                        for _ = 1, 2 do
                            if not S.Run then break end
                            local ok, res = pcall(function() return br:InvokeServer(page) end)
                            if ok and type(res) == "table" then
                                for jobId, data in pairs(res) do
                                    local id = tostring(jobId)
                                    if not isIgnored(id) and not byJob[id] then
                                        local count = (type(data) == "table" and tonumber(data.Count)) or tonumber(data) or 99
                                        if count >= 1 and count <= 7 then
                                            local reg = (type(data) == "table" and tostring(data.Region or "")) or "Unknown"
                                            local numericPing = 90
                                            if reg:find("Sing") then
                                                numericPing = 40
                                            elseif reg:find("Japan") then
                                                numericPing = 95
                                            elseif reg:find("Germ") then
                                                numericPing = 190
                                            elseif reg:find("United States") or reg:find("US") then
                                                numericPing = 235
                                            end
                                            byJob[id] = { id = id, cnt = count, ping = numericPing, region = reg }
                                            if count <= 5 and numericPing <= 100 then
                                                fastFound += 1
                                            end
                                        end
                                    end
                                end
                                break
                            end
                            task.wait(0.04)
                        end
                        completed += 1
                    end)
                end

                local start = os.clock()
                repeat
                    task.wait(0.05)
                    local elapsed = os.clock() - start
                until not S.Run or completed >= totalPages or elapsed >= 3.5 or (elapsed >= 0.35 and fastFound >= 2)

                for _, sv in pairs(byJob) do
                    pool[#pool + 1] = sv
                end
            end

            if #pool == 0 and S.Run then
                local cursor = ""
                local pageCount = 0
                while cursor and pageCount < 50 and S.Run do
                    pageCount += 1
                    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
                        game.PlaceId, (cursor ~= "" and "&cursor=" .. cursor or ""))
                    local ok, res = pcall(function() return game:HttpGet(url) end)
                    if not ok or not res then break end
                    local okJson, data = pcall(function() return HttpService:JSONDecode(res) end)
                    if not okJson or not data or not data.data then break end

                    for _, s in ipairs(data.data) do
                        local id = tostring(s.id)
                        local playing = tonumber(s.playing) or 99
                        local maxP = tonumber(s.maxPlayers) or 12
                        if playing >= 1 and playing <= 7 and playing < maxP and not isIgnored(id) and not byJob[id] then
                            local item = {
                                id = id,
                                cnt = playing,
                                ping = tonumber(s.ping) or 999,
                                region = "Unknown"
                            }
                            byJob[id] = item
                            pool[#pool + 1] = item
                        end
                    end

                    if #pool >= 10 then break end
                    cursor = data.nextPageCursor
                    if not cursor or cursor == "" then break end
                end
            end

            if not S.Run then break end
            if #pool == 0 then
                if isAvoid then
                    vis = { [tostring(game.JobId)] = os.time() }
                end
                Say("Chưa thấy server <=7 người, đang quét lại...")
            else
                if isAvoid then
                    local tLow, tMid, tHigh = {}, {}, {}
                    for _, sv in ipairs(pool) do
                        if sv.ping <= 100 then
                            tLow[#tLow + 1] = sv
                        elseif sv.ping <= 180 then
                            tMid[#tMid + 1] = sv
                        else
                            tHigh[#tHigh + 1] = sv
                        end
                    end
                    local function shuffle(arr)
                        for i = #arr, 2, -1 do
                            local j = math.random(i)
                            arr[i], arr[j] = arr[j], arr[i]
                        end
                    end
                    shuffle(tLow)
                    shuffle(tMid)
                    shuffle(tHigh)
                    pool = {}
                    for _, group in ipairs({ tLow, tMid, tHigh }) do
                        for _, sv in ipairs(group) do
                            pool[#pool + 1] = sv
                        end
                    end
                else
                    for i = #pool, 2, -1 do
                        local j = math.random(i)
                        pool[i], pool[j] = pool[j], pool[i]
                    end
                end
                for i = 1, math.min(#pool, 10) do
                    if not S.Run then break end
                    local sv = pool[i]
                    if sv.id ~= "" and sv.id ~= tostring(game.JobId) then
                        local skip = false
                        if isAvoid then
                            local freshClaims = ReadActiveTTLClaims()
                            local cl = freshClaims[sv.id]
                            if cl and cl.userId ~= tostring(LP.UserId) and cl.name ~= LP.Name then
                                skip = true
                            else
                                local ts = os.time()
                                freshClaims[sv.id] = {
                                    time = ts,
                                    joined = ts,
                                    userId = tostring(LP.UserId),
                                    name = LP.Name,
                                    mode = claimMode,
                                    state = "reserving"
                                }
                                WriteActiveTTLClaims(freshClaims)
                                S.farmStatus = FormatFarmAccStatus(freshClaims)
                            end
                            vis[sv.id] = os.time()
                            pcall(writefile, VF, HttpService:JSONEncode(vis))
                        end
                        if not skip then
                            Say(("Đang sang server %s (%d/7 người, ~%dms)"):format(sv.id:sub(1, 8), sv.cnt, sv.ping))
                            TeleportToJob(sv.id)
                            task.wait(0.55)
                        end
                    end
                end
            end
            task.wait(0.25)
        end
    end)
end

-- Anti-Colocation & Heartbeat TTL 60s
local function CheckAntiColocation(spotCenter, label)
    local jid = tostring(game.JobId)
    local myUid = tostring(LP.UserId)
    local now = os.time()

    if S.AntiJob ~= jid then
        S.AntiJob = jid
        local initClaims = ReadActiveTTLClaims()
        local myRes = initClaims[jid]
        if myRes and (myRes.userId == myUid or myRes.name == LP.Name) and myRes.joined then
            S.AntiJoined = myRes.joined
        else
            S.AntiJoined = now
        end
        S.LastHB = 0
    end

    local claims = ReadActiveTTLClaims()
    local curClaim = claims[jid]
    local otherIsBot = curClaim and curClaim.userId ~= "" and curClaim.userId ~= myUid and curClaim.name ~= LP.Name

    if otherIsBot then
        local cJoined = curClaim.joined or 0
        local mJoined = S.AntiJoined or now
        local shouldYield = (cJoined < mJoined) or (cJoined == mJoined and (tonumber(myUid) or 0) > (tonumber(curClaim.userId) or 0))
        if shouldYield then
            HopLow(("Trùng server %s với acc %s (TTL còn %ds) -> Hop Low né"):format(
                label,
                tostring(curClaim.name ~= "" and curClaim.name or curClaim.userId),
                math.max(0, BONES_TTL - (now - (curClaim.time or now)))
            ), label)
            return true
        end
    end

    if os.clock() - (S.LastHB or 0) >= 4.5 then
        S.LastHB = os.clock()
        claims[jid] = {
            time = now,
            joined = S.AntiJoined or now,
            userId = myUid,
            name = LP.Name,
            mode = label,
            state = "active"
        }
        WriteActiveTTLClaims(claims)
    end
    S.farmStatus = FormatFarmAccStatus(claims)

    local r = Root()
    if r then
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP and pl.Character then
                local pr = pl.Character:FindFirstChild("HumanoidRootPart")
                if pr then
                    local nearMe = (pr.Position - r.Position).Magnitude <= 450
                    local nearSpot = spotCenter and (pr.Position - spotCenter).Magnitude <= 600
                    if nearMe or nearSpot then
                        local plUid = tostring(pl.UserId)
                        local isKnownAlt = otherIsBot and (curClaim.userId == plUid or curClaim.name == pl.Name)
                        if not isKnownAlt or (tonumber(myUid) or 0) > (tonumber(plUid) or 0) then
                            HopLow(("Phát hiện %s chung bãi %s -> Hop Low né"):format(pl.Name, label), label)
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

