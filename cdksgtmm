                            TweenToPosition((pirateRoot.CFrame * CFrame.new(0, 0, 3)).Position, CONFIG.TweenSpeed)
                        else
                            TweenToPosition(Vector3.new(-13223.5, 428.2, -7766.1), CONFIG.TweenSpeed)
                        end

                    -- TRIAL 2: THE HAZE (Chỉ chạy khi Q1 xong: cdk.evilDone == 1 hoặc evilVal == -4)
                    elseif evilVal == -4 or cdk.evilDone == 1 then
                        Engine.WaitReaper = false
                        Engine.ActiveCDKMode = "Yama2"
                        Engine.BringMob = true
                        _G.BringMobs = true
                        EquipSpecificSword("Yama")

                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")

                        local localHazeMob = nil
                        local enemies = workspace:FindFirstChild("Enemies")
                        if enemies then
                            for _, enemy in ipairs(enemies:GetChildren()) do
                                if enemy:IsA("Model") and enemy:FindFirstChild("HazeESP") then
                                    local hum = enemy:FindFirstChildOfClass("Humanoid")
                                    local mRoot = enemy:FindFirstChild("HumanoidRootPart")
                                    if hum and hum.Health > 0 and mRoot then
                                        localHazeMob = enemy
                                        break
                                    end
                                end
                            end
                        end

                        if localHazeMob then
                            Engine.CurrentCombatTarget = localHazeMob
                            local mRoot = localHazeMob:FindFirstChild("HumanoidRootPart")
                            if mRoot and hrp then
                                lblStatus.Text = string.format("Trạng thái: ⚔️ [CDK YAMA 2] Khóa quái Haze %s -> Bring Mob & Fast Attack 24/7!", localHazeMob.Name)
                                local targetPos = mRoot.Position + Vector3.new(0, 30, 0)
                                if (hrp.Position - targetPos).Magnitude > 15 then
                                    TweenToPosition(targetPos, CONFIG.TweenSpeed)
                                else
                                    hrp.CFrame = CFrame.lookAt(targetPos, mRoot.Position)
                                    hrp.AssemblyLinearVelocity = Vector3.zero
                                    hrp.AssemblyAngularVelocity = Vector3.zero
                                end
                            end
                        else
                            Engine.CurrentCombatTarget = nil
                            local questHaze = LocalPlayer:FindFirstChild("QuestHaze")
                            local activeIslands = {}

                            if questHaze and hrp then
                                for _, folder in ipairs(questHaze:GetChildren()) do
                                    if folder:IsA("IntValue") and folder.Value > 0 then
                                        local targetCF = ResolveHazeIslandCFrame(folder.Name)
                                        if targetCF then
                                            local dist = (hrp.Position - targetCF.Position).Magnitude
                                            table.insert(activeIslands, { Name = folder.Name, CFrame = targetCF, Distance = dist })
                                        end
                                    end
                                end
                            end

                            table.sort(activeIslands, function(a, b) return a.Distance < b.Distance end)

                            if #activeIslands > 0 then
                                local targetIsland = activeIslands[1]
                                lblStatus.Text = string.format("Trạng thái: ⛵ [CDK YAMA 2] Bay tới đảo Haze gần nhất: %s (%.0f studs)...", targetIsland.Name, targetIsland.Distance)
                                TweenToPosition((targetIsland.CFrame * CFrame.new(0, 30, 0)).Position, CONFIG.TweenSpeed)
                            else
                                lblStatus.Text = "Trạng thái: 🔍 [CDK YAMA 2] Đang quét tìm các đảo Haze hoạt động..."
                            end
                        end

                    -- TRIAL 3: FEAR THE REAPER (Chỉ chạy khi Q1 & Q2 xong: cdk.evilDone == 2 hoặc evilVal == -5)
                    elseif evilVal == -5 or cdk.evilDone == 2 then
                        Engine.ActiveCDKMode = "Yama3"
                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local hellDim = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("HellDimension")

                        -- KIỂM TRA ĐANG Ở TRONG HELL DIMENSION (PIPELINE TUẦN TỰ 3 ĐUỐC & DIỆT SẠCH TỪNG ĐỢT QUÁI)
                        if hellDim and hrp and hellDim:FindFirstChild("Spawn") and (hrp.Position - hellDim.Spawn.Position).Magnitude <= 1500 then
                            Engine.WaitReaper = false
                            Engine.BringMob = true
                            _G.BringMobs = true

                            -- 1. QUÉT TOÀN BỘ QUÁI HELL CÒN SỐNG TRONG KHÔNG GIAN HELL DIMENSION
                            local hellMobs = {}
                            local enemies = workspace:FindFirstChild("Enemies")
                            if enemies then
                                local centerPos = hellDim.Spawn.Position
                                for _, mob in ipairs(enemies:GetChildren()) do
                                    if mob:IsA("Model") then
                                        local hum = mob:FindFirstChildOfClass("Humanoid")
                                        local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart or mob:FindFirstChild("Head")
                                        if hum and hum.Health > 0 and mRoot then
                                            if (mRoot.Position - centerPos).Magnitude <= 800 then
                                                table.insert(hellMobs, mob)
                                            end
                                        end
                                    end
                                end
                            end

                            -- 2. NẾU CÒN QUÁI: KHÓA DÍNH & TIÊU DIỆT HẾT SẠCH TRƯỚC KHI CHO PHÉP THẮP ĐUỐC TIẾP THEO
                            if #hellMobs > 0 then
                                local targetMob = hellMobs[1]
                                Engine.CurrentCombatTarget = targetMob
                                local mRoot = targetMob:FindFirstChild("HumanoidRootPart") or targetMob.PrimaryPart
                                if mRoot then
                                    lblStatus.Text = string.format("Trạng thái: ⚔️ [CDK YAMA 3 - HELL] Phát hiện %d quái Hell -> Fast Attack tiêu diệt sạch...", #hellMobs)
                                    local combatCF = mRoot.CFrame * CFrame.new(0, 25, 0)
                                    if (hrp.Position - combatCF.Position).Magnitude > 15 then
                                        TweenToPosition(combatCF.Position, CONFIG.TweenSpeed)
                                    else
                                        hrp.CFrame = CFrame.lookAt(combatCF.Position, mRoot.Position)
                                        hrp.AssemblyLinearVelocity = Vector3.zero
                                        hrp.AssemblyAngularVelocity = Vector3.zero
                                    end
                                end
                                ForceEquipMelee()
                                continue
                            end

                            -- 3. KHI ĐÃ SẠCH BÓNG QUÁI: KIỂM TRA VÀ THẮP TUẦN TỰ TỪNG ĐUỐC (ĐUỐC 1 -> ĐUỐC 2 -> ĐUỐC 3)
                            local function GetActiveTorchPrompt(torchInst)
                                if not torchInst then return nil end
                                local prompt = torchInst:FindFirstChildOfClass("ProximityPrompt", true)
                                if prompt and prompt.Enabled then
                                    return prompt
                                end
                                return nil
                            end

                            local torches = {
                                { Inst = hellDim:FindFirstChild("Torch1"), Name = "Đuốc 1" },
                                { Inst = hellDim:FindFirstChild("Torch2"), Name = "Đuốc 2" },
                                { Inst = hellDim:FindFirstChild("Torch3"), Name = "Đuốc 3" }
                            }

                            local pendingTorch = nil
                            local pendingPrompt = nil

                            for _, t in ipairs(torches) do
                                local p = GetActiveTorchPrompt(t.Inst)
                                if p then
                                    pendingTorch = t
                                    pendingPrompt = p
                                    break
                                end
                            end

                            if pendingTorch and pendingPrompt then
                                Engine.CurrentCombatTarget = nil
                                local torchPart = pendingTorch.Inst:FindFirstChild("Particles")
                                    or pendingTorch.Inst:FindFirstChildWhichIsA("BasePart", true)
                                    or pendingTorch.Inst.PrimaryPart
                                local targetPos = torchPart and torchPart.Position or pendingPrompt.Parent.Position

                                lblStatus.Text = string.format("Trạng thái: 🔥 [CDK YAMA 3 - HELL] Sạch quái! Đang bay tới thắp %s...", pendingTorch.Name)
                                local dist = (hrp.Position - targetPos).Magnitude

                                if dist > 6 then
                                    TweenToPosition(targetPos, CONFIG.TweenSpeed)
                                end

                                if (hrp.Position - targetPos).Magnitude <= 15 then
                                    pendingPrompt.HoldDuration = 0
                                    pcall(function() fireproximityprompt(pendingPrompt) end)
                                    task.wait(0.5)
                                end
                                continue
                            end

                            -- 4. KHI ĐÃ SẠCH QUÁI & CẢ 3 ĐUỐC ĐỀU ĐÃ XONG: TWEEN ĐẾN EXIT & VÒNG LẶP ANCHOR/UNANCHOR 1S ĐẾN KHI OUT HELL
                            Engine.CurrentCombatTarget = nil
                            local exit = hellDim:FindFirstChild("Exit")
                            if exit then
                                local exitPos = exit:IsA("Model") and exit:GetPivot().Position or (exit:IsA("BasePart") and exit.Position or exit:GetPivot().Position)

                                lblStatus.Text = "Trạng thái: 🚪 [CDK YAMA 3 - HELL] Đã xong 3 đuốc & quái! Đang bay tới Exit..."
                                TweenToPosition(exitPos, CONFIG.TweenSpeed)

                                hrp.CFrame = CFrame.new(exitPos)
                                hrp.Anchored = true
                                task.wait(1.0)

                                while Engine.IsRunning do
                                    local currentChar = LocalPlayer.Character
                                    local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
                                    if not currentHrp then break end

                                    local inHell = hellDim and hellDim:FindFirstChild("Spawn") and (currentHrp.Position - hellDim.Spawn.Position).Magnitude <= 1500
                                    if not inHell then break end

                                    -- Sau 1s vẫn ở Hell -> Unanchor hoàn toàn (Unload giả) 1s để kích hoạt touch trigger
                                    lblStatus.Text = "Trạng thái: 🚪 [CDK YAMA 3 - HELL] Sau 1s vẫn ở Hell -> Unanchor hoàn toàn (Unload giả) 1s..."
                                    Engine.NoClipActive = false
                                    currentHrp.Anchored = false
                                    currentHrp.AssemblyLinearVelocity = Vector3.zero
                                    currentHrp.AssemblyAngularVelocity = Vector3.zero

                                    local head = currentChar:FindFirstChild("Head")
                                    if head and head:FindFirstChild("axiom_bv") then head.axiom_bv:Destroy() end
                                    local s1 = currentHrp:FindFirstChild("__AxiomFlightStabilizer")
                                    if s1 then s1:Destroy() end
                                    local s2 = currentHrp:FindFirstChild("__AxiomHoverStabilizer")
                                    if s2 then s2:Destroy() end

                                    for _, part in ipairs(currentChar:GetDescendants()) do
                                        if part:IsA("BasePart") then
                                            part.CanCollide = true
                                            part.CanTouch = true
                                        end
                                    end
                                    task.wait(1.0)

                                    currentChar = LocalPlayer.Character
                                    currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
                                    if not currentHrp then break end

                                    inHell = hellDim and hellDim:FindFirstChild("Spawn") and (currentHrp.Position - hellDim.Spawn.Position).Magnitude <= 1500
                                    if not inHell then break end

                                    -- Thử lại: Bật noclip ngắn hạn để Tween đến Exit -> Anchor 1s
                                    lblStatus.Text = "Trạng thái: 🚪 [CDK YAMA 3 - HELL] Thử lại: Tween đến Exit -> Anchor 1s..."
                                    Engine.NoClipActive = true
                                    TweenToPosition(exitPos, CONFIG.TweenSpeed)
                                    currentHrp.CFrame = CFrame.new(exitPos)
                                    currentHrp.Anchored = true
                                    task.wait(1.0)
                                end

                                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                    LocalPlayer.Character.HumanoidRootPart.Anchored = false
                                end
                                lblStatus.Text = "Trạng thái: 🟢 [CDK YAMA 3] Đã thoát khỏi Hell Dimension thành công!"
                            end
                        else
                            -- Ở NGOÀI THẾ GIỚI CHÍNH (SEA 3) - CHỜ & TANK SOUL REAPER
                            local soulReaper = (workspace:FindFirstChild("Enemies") and workspace.Enemies:FindFirstChild("Soul Reaper"))
                                or workspace:FindFirstChild("Soul Reaper")
                                or ReplicatedStorage:FindFirstChild("Soul Reaper")

                            local bp = LocalPlayer:FindFirstChild("Backpack")
                            local essence = (bp and bp:FindFirstChild("Hallow Essence")) or (char and char:FindFirstChild("Hallow Essence"))

                            -- KHI CÓ SOUL REAPER: KÍCH HOẠT WAITREAPER, DẬP TẮT FAST ATTACK, GỠ SẠCH VŨ KHÍ & ÁP SÁT CHỊU ĐÒN
                            if soulReaper and soulReaper:FindFirstChild("HumanoidRootPart") then
                                Engine.WaitReaper = true
                                Engine.BringMob = false
                                _G.BringMobs = false
                                ClearAllMagnetMobs()
                                Engine.CurrentCombatTarget = nil
                                ForceUnequipAll()

                                lblStatus.Text = "Trạng thái: 👻 [CDK YAMA 3] Soul Reaper đã Spawn! KHÓA VŨ KHÍ | TẮT ATTACK -> Giữ cự ly 5 studs chịu đòn..."
                                local srRoot = soulReaper:FindFirstChild("HumanoidRootPart")
                                TweenToPosition((srRoot.CFrame * CFrame.new(0, 0, 5)).Position, CONFIG.TweenSpeed)

                            -- NẾU CÓ HALLOW ESSENCE: CẮM BỆ TẾ TRIỆU HỒI
                            elseif essence then
                                Engine.WaitReaper = false
                                Engine.CurrentCombatTarget = nil
                                lblStatus.Text = "Trạng thái: 🔮 [CDK YAMA 3] Có Hallow Essence! Đem đến bệ tế triệu hồi Soul Reaper..."
                                local altarPos = Vector3.new(-8932.3, 146.8, 6062.5)
                                TweenToPosition(altarPos, CONFIG.TweenSpeed)
                                if essence.Parent == bp and char then
                                    local hum = char:FindFirstChildOfClass("Humanoid")
                                    if hum then hum:EquipTool(essence) end
                                end

                            -- CHƯA CÓ SOUL REAPER: TWEEN ĐẾN HAUNTED CASTLE KIỂM TRA
                            else
                                Engine.WaitReaper = false
                                local distToHaunted = hrp and (hrp.Position - POS_HAUNTED_CASTLE).Magnitude or 9999

                                if distToHaunted > 120 then
                                    lblStatus.Text = string.format("Trạng thái: 🏰 [CDK YAMA 3] Đang tween đến Haunted Castle kiểm tra Soul Reaper (Cách: %.0f studs)...", distToHaunted)
                                    TweenToPosition(POS_HAUNTED_CASTLE, CONFIG.TweenSpeed)
                                else
                                    -- ĐÃ ĐẾN HAUNTED CASTLE NHƯNG SOUL REAPER CHƯA SPAWN -> KÍCH HOẠT NIGHT HUB HOP SOUL REAPER
                                    Engine.CurrentCombatTarget = nil
                                    lblStatus.Text = "Trạng thái: 🌐 [CDK YAMA 3] Đã đến Haunted Castle nhưng Soul Reaper CHƯA spawn -> Bật Night Hub Hop Boss Soul Reaper... " .. timeDisplay
                                    DispatchNightHubInstant("SoulReaper")
                                end
                            end
                        end
                    end
                elseif not cdk.TushitaDone then
                    -- =========================================================
                    -- [TỰ ĐỘNG 3 NHIỆM VỤ TUSHITA CDK (GOOD DOOR)]
                    -- =========================================================
                    Engine.WaitReaper = false
                    local goodVal = cdk.currentGood
                    Engine.CurrentGood = goodVal

                    -- Kiểm tra mở cổng Good Door
                    if tostring(commF:InvokeServer("CDKQuest", "OpenDoor")) ~= "opened" then
                        lblStatus.Text = "Trạng thái: 🚪 [CDK TUSHITA] Đang mở cổng Good Door..."
                        pcall(function()
                            commF:InvokeServer("CDKQuest", "OpenDoor")
                            task.wait(0.3)
                            commF:InvokeServer("CDKQuest", "OpenDoor", true)
                        end)
                        task.wait(0.5)
                        continue
                    end

                    -- Khởi động Trial Good (Tushita) nếu chưa có active trial và chưa xong
                    if not cdk.TushitaDone and (not getgenv().CDK_LATCH.ActiveGood or getgenv().CDK_LATCH.ActiveGood >= 0) then
                        lblStatus.Text = string.format("Trạng thái: 📜 [CDK TUSHITA] Bắt đầu nhận Trial Good (Tushita)...")
                        local startRes = nil
                        pcall(function()
                            startRes = commF:InvokeServer("CDKQuest", "StartTrial", "Good")
                        end)

                        local valG = tonumber(startRes)
                        if type(startRes) == "table" then
                            valG = tonumber(startRes.Good or startRes[1])
                        end

                        if valG then
                            if valG == -3 then
                                getgenv().CDK_LATCH.ActiveGood = -3
                            elseif valG == -4 then
                                getgenv().CDK_LATCH.Tushita1Done = true
                                getgenv().CDK_LATCH.ActiveGood = -4
                            elseif valG == -5 then
                                getgenv().CDK_LATCH.Tushita1Done = true
                                getgenv().CDK_LATCH.Tushita2Done = true
                                getgenv().CDK_LATCH.ActiveGood = -5
                            elseif valG == 3 or valG == 4 then
                                getgenv().CDK_LATCH.Tushita1Done = true
                                getgenv().CDK_LATCH.Tushita2Done = true
                                getgenv().CDK_LATCH.Tushita3Done = true
                                getgenv().CDK_LATCH.TushitaCompleted = true
                                getgenv().CDK_LATCH.ActiveGood = nil
                            end
                        end
                        cdk = GetCDKQuestStatus()
                        goodVal = tonumber(cdk.currentGood) or -1
                        Engine.CurrentGood = goodVal
                    end

                    -- =========================================================
                    -- NHIỆM VỤ 1: DOCK LEGEND (GOOD == -3) // TWEEN ĐẾN BOAT DEALER
                    -- =========================================================
                    if goodVal == -3 or cdk.goodDone == 0 then
                        Engine.ActiveCDKMode = "Tushita1"
                        Engine.CurrentCombatTarget = nil
                        Engine.BringMob = false
                        _G.BringMobs = false
                        ClearAllMagnetMobs()

                        local targetDealer = findClosestUnvisitedBoatDealer()
                        if not targetDealer then
                            table.clear(Engine.VisitedDealers)
                            lblStatus.Text = "Trạng thái: ⛵ [CDK TUSHITA 1] Đang quét lại các bến thuyền Boat Dealer..."
                            task.wait(0.5)
                            continue
                        end

                        local targetPos = targetDealer.Position
                        lblStatus.Text = string.format("Trạng thái: ⛵ [CDK TUSHITA 1] Tween đến Boat Dealer gần nhất (%.0f studs)...", targetDealer.Distance)
                        safeFlyToPoint(CFrame.new(targetPos + Vector3.new(0, 3, 0)))

                        local root = getRoot()
                        if root and (root.Position - targetPos).Magnitude <= 18 then
                            lblStatus.Text = "Trạng thái: ⛵ [CDK TUSHITA 1] Đang gửi lệnh Pardon Me tới Boat Dealer..."
                            task.wait(0.5)

                            local dealerModel = targetDealer.Model
                            if not dealerModel then
                                local npcs = workspace:FindFirstChild("NPCs")
                                if npcs then
                                    for _, npc in ipairs(npcs:GetChildren()) do
                                        if npc:IsA("Model") and string.find(npc.Name:lower(), "boat dealer") and not string.find(npc.Name:lower(), "luxury") then
                                            local nPart = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart")
                                            if nPart and (nPart.Position - targetPos).Magnitude <= 40 then
                                                dealerModel = npc
                                                break
                                            end
                                        end
                                    end
                                    if not dealerModel then
                                        dealerModel = npcs:FindFirstChild("Boat Dealer")
                                    end
                                end
                            end

                            if dealerModel then
                                executePardonMeInteraction(dealerModel)
                                table.insert(Engine.VisitedDealers, targetPos)
                                task.wait(0.8)
                            else
                                table.insert(Engine.VisitedDealers, targetPos)
                            end
                        end

                    -- =========================================================
                    -- NHIỆM VỤ 2: SENSE OF DUTY (GOOD == -4) // PIRATE RAID CASTLE
                    -- =========================================================
                    elseif goodVal == -4 or cdk.goodDone == 1 then
                        Engine.ActiveCDKMode = "Tushita2"
                        Engine.BringMob = true
                        _G.BringMobs = true
                        equipCombatTool()

                        local root = getRoot()
                        if not root then continue end

                        local raidMobs = getActiveCastleRaidMobs()

                        if #raidMobs > 0 then
                            table.sort(raidMobs, function(a, b)
                                local rA = a:FindFirstChild("HumanoidRootPart") or a.PrimaryPart
                                local rB = b:FindFirstChild("HumanoidRootPart") or b.PrimaryPart
                                if rA and rB and rA:IsA("BasePart") and rB:IsA("BasePart") then
                                    return (rA.Position - root.Position).Magnitude < (rB.Position - root.Position).Magnitude
                                end
                                return false
                            end)

                            local targetMob = raidMobs[1]
                            Engine.CurrentCombatTarget = targetMob

                            local mRoot = (targetMob:FindFirstChild("HumanoidRootPart") or targetMob.PrimaryPart) :: BasePart?
                            if mRoot then
                                lblStatus.Text = string.format("Trạng thái: ⚔️ [CDK TUSHITA 2] Castle Raid: Diệt %s (%d con còn lại)...", targetMob.Name, #raidMobs)
                                flyAndHoverAbove(mRoot)
                            end
                        else
                            Engine.CurrentCombatTarget = nil
                            ClearAllMagnetMobs()

                            local distToPark = (root.Position - CASTLE_TARGET_CFRAME.Position).Magnitude
                            if distToPark > 15 then
                                lblStatus.Text = "Trạng thái: 🏰 [CDK TUSHITA 2] Castle Raid: Di chuyển đến Sea Castle túc trực..."
                                safeFlyToPoint(CASTLE_TARGET_CFRAME)
                            else
                                root.CFrame = CASTLE_TARGET_CFRAME
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                                lblStatus.Text = "Trạng thái: 🏰 [CDK TUSHITA 2] Không có Pirate Raid -> Bật Night Hub Hop Castle Raid... " .. timeDisplay
                                DispatchNightHubInstant("CastleRaid")
                            end
                        end

                    -- =========================================================
                    -- NHIỆM VỤ 3: SOULLESS (GOOD == -5) // HEAVENLY WAVE SEQUENCER
                    -- =========================================================
                    elseif goodVal == -5 or cdk.goodDone == 2 then
                        Engine.ActiveCDKMode = "Tushita3"
                        local root = getRoot()
                        if not root then continue end

                        local map = workspace:FindFirstChild("Map")
                        local hDim = map and map:FindFirstChild("HeavenlyDimension")
                        local isInsideHeavenly = false

                        if hDim and hDim:FindFirstChild("Spawn") and (root.Position - hDim.Spawn.Position).Magnitude <= 1500 then
                            isInsideHeavenly = true
                        elseif root.Position.Y > 4500 and (root.Position - HEAVENLY_TORCHES[1].Position).Magnitude <= 3500 then
                            isInsideHeavenly = true
                        end

                        -- // --------------------------------------------------
                        -- // CASE A: TRONG HEAVENLY DIMENSION (THẮP ĐUỐC -> WAVE -> ĐUỐC KẾ)
                        -- // --------------------------------------------------
                        if isInsideHeavenly then
                            Engine.QueenMissingScans = 0
                            Engine.BringMob = true
                            _G.BringMobs = true
                            equipCombatTool()

                            if not Engine.WasInsideHeavenly then
                                Engine.WasInsideHeavenly = true
                                Engine.HeavenlyTorchIndex = 1
                            end

                            -- 1. ƯU TIÊN SỐ 1: NẾU CÒN QUÁI TRONG WAVE -> DIỆT SẠCH
                            local hMobs = getHeavenlyMobs()
                            if #hMobs > 0 then
                                table.sort(hMobs, function(a, b)
                                    local rA = a:FindFirstChild("HumanoidRootPart") or a.PrimaryPart
                                    local rB = b:FindFirstChild("HumanoidRootPart") or b.PrimaryPart
                                    if rA and rB and rA:IsA("BasePart") and rB:IsA("BasePart") then
                                        return (rA.Position - root.Position).Magnitude < (rB.Position - root.Position).Magnitude
                                    end
                                    return false
                                end)

                                local mob = hMobs[1]
                                Engine.CurrentCombatTarget = mob
                                local mRoot = (mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart) :: BasePart?
                                if mRoot then
                                    lblStatus.Text = string.format("Trạng thái: ⚔️ [CDK TUSHITA 3 - HEAVENLY] Diệt quái Wave (%d con còn lại)...", #hMobs)
                                    flyAndHoverAbove(mRoot)
                                end
                                continue
                            end

                            -- 2. SẠCH QUÁI WAVE HIỆN TẠI -> THẮP ĐUỐC KẾ TIẾP (1 -> 2 -> 3)
                            Engine.CurrentCombatTarget = nil
                            ClearAllMagnetMobs()

                            if Engine.HeavenlyTorchIndex <= #HEAVENLY_TORCHES then
                                local currentTorchCF = HEAVENLY_TORCHES[Engine.HeavenlyTorchIndex]
                                local distToTorch = (root.Position - currentTorchCF.Position).Magnitude

                                if distToTorch > 8 then
                                    lblStatus.Text = string.format("Trạng thái: 🔥 [CDK TUSHITA 3 - HEAVENLY] Di chuyển đến Đuốc #%d/3...", Engine.HeavenlyTorchIndex)
                                    safeFlyToPoint(currentTorchCF)
                                else
                                    lblStatus.Text = string.format("Trạng thái: 🔥 [CDK TUSHITA 3 - HEAVENLY] Kích hoạt Đuốc #%d/3 & đợi quái spawn...", Engine.HeavenlyTorchIndex)

                                    pcall(function()
                                        local prompts = getUnlitHeavenlyPrompts()
                                        for _, prompt in ipairs(prompts) do
                                            local pPart = prompt.Parent
                                            local pPos = pPart and (pPart:IsA("BasePart") and pPart.Position or pPart:GetPivot().Position)
                                            if pPos and (pPos - currentTorchCF.Position).Magnitude <= 25 then
                                                prompt.HoldDuration = 0
                                                fireproximityprompt(prompt)
                                                prompt:InputHoldBegin()
                                                task.wait(0.2)
                                                prompt:InputHoldEnd()
                                            end
                                        end
                                    end)

                                    task.wait(1.0)
                                    Engine.HeavenlyTorchIndex = Engine.HeavenlyTorchIndex + 1
                                end
                                continue
                            end

                            -- 3. HOÀN THÀNH CẢ 3 ĐUỐC & SẠCH QUÁI -> TWEEN VỀ EXIT & VÒNG LẶP ANCHOR/UNANCHOR 1S ĐẾN KHI OUT HEAVEN
                            Engine.CurrentCombatTarget = nil
                            local exitPart = hDim and hDim:FindFirstChild("Exit")
                            local exitCF = exitPart and exitPart:GetPivot() or CFrame.new(-22695.7, 5270.9, 3814.4)
                            local exitPos = exitCF.Position

                            lblStatus.Text = "Trạng thái: 🚪 [CDK TUSHITA 3 - HEAVENLY] Đã thắp xong 3 đuốc & sạch quái! Đang bay tới Exit..."
                            TweenToPosition(exitPos, CONFIG.TweenSpeed)

                            root.CFrame = exitCF
                            root.Anchored = true
                            task.wait(1.0)

                            while Engine.IsRunning do
                                local currentChar = LocalPlayer.Character
                                local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
                                if not currentHrp then break end

                                local stillInHeaven = false
                                if hDim and hDim:FindFirstChild("Spawn") and (currentHrp.Position - hDim.Spawn.Position).Magnitude <= 1500 then
                                    stillInHeaven = true
                                elseif currentHrp.Position.Y > 4500 and (currentHrp.Position - HEAVENLY_TORCHES[1].Position).Magnitude <= 3500 then
                                    stillInHeaven = true
                                end

                                if not stillInHeaven then break end

                                -- Sau 1s vẫn ở Heaven -> Unanchor hoàn toàn (Unload giả) 1s để kích hoạt touch trigger
                                lblStatus.Text = "Trạng thái: 🚪 [CDK TUSHITA 3 - HEAVENLY] Sau 1s vẫn ở Heaven -> Unanchor hoàn toàn (Unload giả) 1s..."
                                Engine.NoClipActive = false
                                currentHrp.Anchored = false
                                currentHrp.AssemblyLinearVelocity = Vector3.zero
                                currentHrp.AssemblyAngularVelocity = Vector3.zero

                                local head = currentChar:FindFirstChild("Head")
                                if head and head:FindFirstChild("axiom_bv") then head.axiom_bv:Destroy() end
                                local s1 = currentHrp:FindFirstChild("__AxiomFlightStabilizer")
                                if s1 then s1:Destroy() end
                                local s2 = currentHrp:FindFirstChild("__AxiomHoverStabilizer")
                                if s2 then s2:Destroy() end

                                for _, part in ipairs(currentChar:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part.CanCollide = true
                                        part.CanTouch = true
                                    end
                                end
                                task.wait(1.0)

                                currentChar = LocalPlayer.Character
                                currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
                                if not currentHrp then break end

                                stillInHeaven = false
                                if hDim and hDim:FindFirstChild("Spawn") and (currentHrp.Position - hDim.Spawn.Position).Magnitude <= 1500 then
                                    stillInHeaven = true
                                elseif currentHrp.Position.Y > 4500 and (currentHrp.Position - HEAVENLY_TORCHES[1].Position).Magnitude <= 3500 then
                                    stillInHeaven = true
                                end

                                if not stillInHeaven then break end

                                -- Thử lại: Bật noclip ngắn hạn để Tween đến Exit -> Anchor 1s
                                lblStatus.Text = "Trạng thái: 🚪 [CDK TUSHITA 3 - HEAVENLY] Thử lại: Tween đến Exit -> Anchor 1s..."
                                Engine.NoClipActive = true
                                TweenToPosition(exitPos, CONFIG.TweenSpeed)
                                currentHrp.CFrame = exitCF
                                currentHrp.Anchored = true
                                task.wait(1.0)
                            end

                            Engine.NoClipActive = true
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                LocalPlayer.Character.HumanoidRootPart.Anchored = false
                            end
                            lblStatus.Text = "Trạng thái: 🟢 [CDK TUSHITA 3] Đã thoát khỏi Heavenly Dimension thành công!"
                            continue
                        end

                        -- // --------------------------------------------------
                        -- // CASE B: NGOÀI BẢN ĐỒ — CAKE QUEEN RADAR & AUTO LOW-SERVER HOP
                        -- // --------------------------------------------------
                        Engine.WasInsideHeavenly = false
                        equipCombatTool()

                        local queenData = resolveCakeQueenTelemetry()

                        if queenData.Found and queenData.Entity and queenData.RootPart then
                            Engine.QueenMissingScans = 0
                            Engine.CurrentCombatTarget = queenData.Entity
                            lblStatus.Text = string.format("Trạng thái: 🍰 [CDK TUSHITA 3] Đang Fast Attack Cake Queen (%s) [HP: %.0f/%.0f]...", queenData.Source, queenData.Health, queenData.MaxHealth)
                            flyAndHoverAbove(queenData.RootPart)
                            continue
                        end

                        if queenData.Found and queenData.Source == "ReplicatedStorage" then
                            Engine.QueenMissingScans = 0
                            Engine.CurrentCombatTarget = nil
                            ClearAllMagnetMobs()

                            local distToQueenSpawn = (root.Position - CAKE_QUEEN_SPAWN.Position).Magnitude
                            if distToQueenSpawn > 15 then
                                lblStatus.Text = "Trạng thái: 🍰 [CDK TUSHITA 3] Cake Queen ở ReplicatedStorage -> Di chuyển tới Cake Land..."
                                safeFlyToPoint(CAKE_QUEEN_SPAWN)
                            else
                                lblStatus.Text = "Trạng thái: 🍰 [CDK TUSHITA 3] Đang túc trực tại Cake Land chờ Cake Queen xuất hiện..."
                            end
                            continue
                        end

                        Engine.CurrentCombatTarget = nil
                        ClearAllMagnetMobs()
                        Engine.QueenMissingScans = Engine.QueenMissingScans + 1

                        if Engine.QueenMissingScans >= 6 then
                            lblStatus.Text = "Trạng thái: 🌐 [CDK TUSHITA 3] Server không có Cake Queen (6/6) -> Kích hoạt Hop Low Server..."
                            Engine:HopLowServer()
                        else
                            lblStatus.Text = string.format("Trạng thái: 🍰 [CDK TUSHITA 3] Server chưa có Cake Queen (Xác nhận %d/6) -> Chuẩn bị Hop...", Engine.QueenMissingScans)
                        end
                    end
                else
                    -- =========================================================
                    -- [NHIỆM VỤ CUỐI: AUTO GET CDK - CURSED SKELETON BOSS] [90% PORT]
                    -- =========================================================
                    local hasCDK = Inventory:HasItem("cursed dual katana")
                    if hasCDK then
                        Engine.WaitReaper = false
                        Engine.BringMob = false
                        _G.BringMobs = false
                        ClearAllMagnetMobs()
                        Engine.CurrentCombatTarget = nil
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        if root then clearFlightStabilizer(root) end
                        lblStatus.Text = "Trạng thái: 👑 [CDK HOÀN TẤT] 🎉 BẠN ĐÃ SỞ HỮU CURSED DUAL KATANA RỒI!"
                    else
                        Engine.WaitReaper = false
                        Engine.ActiveCDKMode = "CDK_Boss"
                        Engine.BringMob = true
                        _G.BringMobs = true

                        local root = getRoot()
                        if not root then continue end

                        -- 1. GỬI REMOTE ĐỒNG BỘ TIẾN ĐỘ & KÍCH HOẠT TRIAL BOSS
                        pcall(function()
                            commF:InvokeServer("CDKQuest", "Progress", "Good")
                            commF:InvokeServer("CDKQuest", "Progress", "Evil")
                            commF:InvokeServer("CDKQuest", "StartTrial", "Boss")
                            commF:InvokeServer("CDKQuest", "SpawnBoss")
                        end)

                        -- 2. QUÉT TÌM CURSED SKELETON BOSS TRÊN TOÀN MAP
                        local bossMob = nil
                        local bossRoot = nil
                        local bossHum = nil

                        local function inspectBoss(container)
                            if not container then return end
                            for _, child in ipairs(container:GetChildren()) do
                                if child:IsA("Model") then
                                    local nameLow = child.Name:lower()
                                    if string.find(nameLow, "cursed skeleton") or string.find(nameLow, "skeleton boss") then
                                        local hum = child:FindFirstChildOfClass("Humanoid")
                                        local r = child:FindFirstChild("HumanoidRootPart") or child.PrimaryPart
                                        if hum and hum.Health > 0 and r then
                                            bossMob = child
                                            bossRoot = r
                                            bossHum = hum
                                            return
                                        end
                                    end
                                end
                            end
                        end

                        inspectBoss(workspace:FindFirstChild("Enemies"))
                        if not bossMob then inspectBoss(workspace:FindFirstChild("Characters")) end
                        if not bossMob then inspectBoss(workspace) end

                        -- 3. NẾU BOSS ĐÃ XUẤT HIỆN: TRANG BỊ YAMA/TUSHITA & KHÓA BAY 20 STUDS TRÊN ĐẦU FAST ATTACK 24/7
                        if bossMob and bossRoot and bossHum then
                            Engine.CurrentCombatTarget = bossMob

                            -- Thống nhất trang bị kiếm Tushita để khóa dính và diệt Cursed Skeleton Boss
                            EquipSpecificSword("Tushita")

                            lblStatus.Text = string.format("Trạng thái: 💀 [CDK FINAL] 20-Stud Overhead Lock Cursed Skeleton Boss (HP: %.0f/%.0f)...", bossHum.Health, bossHum.MaxHealth)
                            flyAndHoverAbove(bossRoot)
                        else
                            -- 4. CHƯA CÓ BOSS: TWEEN ĐẾN ĐIỆN THỜ CURSED (-12318, 601, -6538) & ÁP SÁT BOSSDOOR
                            Engine.CurrentCombatTarget = nil
                            ClearAllMagnetMobs()

                            local CF_CURSED_STAGING = CFrame.new(-12318.193359375, 601.95184326172, -6538.662109375)
                            local distToStaging = (root.Position - CF_CURSED_STAGING.Position).Magnitude

                            if distToStaging > 25 then
                                lblStatus.Text = string.format("Trạng thái: 🚪 [CDK FINAL] Bay đến điện thờ Cursed Altar (Cách: %.0f studs)...", distToStaging)
                                safeFlyToPoint(CF_CURSED_STAGING)
                            else
                                root.CFrame = CF_CURSED_STAGING

                                local bossDoor = nil
                                pcall(function()
                                    bossDoor = workspace.Map.Turtle.Cursed.BossDoor
                                end)

                                local doorCF = CF_CURSED_STAGING * CFrame.new(0, 0, -35)
                                if bossDoor then
                                    doorCF = bossDoor:IsA("BasePart") and bossDoor.CFrame or bossDoor:GetPivot()
                                end
                                safeFlyToPoint(doorCF)

                                lblStatus.Text = "Trạng thái: 🚪 [CDK FINAL] Đang túc trực tại BossDoor & mở cổng nhận Trial..."
                                pcall(function()
                                    commF:InvokeServer("CDKQuest", "OpenDoor", "Boss")
                                    commF:InvokeServer("CDKQuest", "StartTrial", "Boss")
                                    commF:InvokeServer("CDKQuest", "SpawnBoss")
                                end)
                            end
                        end
                    end
                end
            end
        end

        task.wait(0.2)
    end
end)

-- =========================================================================
-- UNLOAD KERNEL
-- =========================================================================
function Engine:Unload()
    self.IsRunning = false
    self.CharacterLoaded = false
    self.FastAttackActive = false
    self.BringMob = false
    _G.BringMobs = false
    self.NoClipActive = false
    self.NightHubRunning = false
    self.IsHopping = false
    self.MirrorTeleported = false
    self.HauntedStagingReached = false
    self.CurrentCombatTarget = nil
    self.WaitReaper = false
    self.MasteryNearAccumulator = 0
    self.CurrentGood = 0
    self.VisitedDealers = {}
    self.QueenMissingScans = 0
    self.HeavenlyTorchIndex = 1
    self.WasInsideHeavenly = false

    if self.CurrentTween then pcall(function() self.CurrentTween:Cancel() end) end
    ClearAllMagnetMobs()

    local char = LocalPlayer.Character
    if char then
        local head = char:FindFirstChild("Head")
        if head and head:FindFirstChild("axiom_bv") then head.axiom_bv:Destroy() end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("__AxiomFlightStabilizer") then hrp.__AxiomFlightStabilizer:Destroy() end
        if hrp and hrp:FindFirstChild("__AxiomHoverStabilizer") then hrp.__AxiomHoverStabilizer:Destroy() end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.CanTouch = true
            end
        end
    end

    for _, conn in ipairs(self.Connections) do if conn and typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end end
    for _, th in ipairs(self.Threads) do if th and coroutine.status(th) ~= "dead" then pcall(task.cancel, th) end end
    for _, inst in ipairs(self.Instances) do pcall(function() inst:Destroy() end) end

    getgenv()._AxiomTushitaMaster = nil
end

btnUnload.MouseButton1Click:Connect(function() Engine:Unload() end)
