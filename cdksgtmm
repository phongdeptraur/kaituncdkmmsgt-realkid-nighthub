                        hits[#hits + 1], hits[#hits + 2] = { m, p }, m
                        main = main or m:FindFirstChild("Head") or p
                    end
                end
            end
        end
    end
    if not main then return end
    if S.noAttack then
        Unequip()
        return
    end
    local tool = Equip(S.weapon)
    if S.noAttack or not tool then return end
    pcall(function()
        NetM:RemoteEvent("RegisterAttack", true):FireServer(0)
        NetM:RemoteEvent("RegisterHit", true):FireServer(main, hits, {}, "078da5141")
    end)
    pcall(function()
        Net["RE/RegisterAttack"]:FireServer()
        Net["RE/RegisterHit"]:FireServer(main, hits, {}, tostring(LP.UserId):sub(2, 4) .. tostring(os.clock()):sub(3, 7))
    end)
    if ObfR then
        pcall(function()
            local k = string.gsub("RE/RegisterHit", ".", function(ch)
                return string.char(bit32.bxor(string.byte(ch), math.floor(workspace:GetServerTimeNow() / 10 % 10) + 1))
            end)
            ObfR:FireServer(k, bit32.bxor(ObfId + 909090, Net.seed:InvokeServer() * 2), main, hits)
