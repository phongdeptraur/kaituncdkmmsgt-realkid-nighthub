local function LaunchRealKid(delaySec)
    task.spawn(function()
        if delaySec and delaySec > 0 then task.wait(delaySec) end
        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/realkidhub/realkid/refs/heads/main/main.lua"))()
        end)
    end)
end

local function LaunchNightHub(delaySec)
    task.spawn(function()
        if delaySec and delaySec > 0 then task.wait(delaySec) end
        pcall(function()
            -- Tự động kích hoạt Hook JSON trước khi tải Night Hub để chống crash parser
            pcall(function()
                local HS = cloneref and cloneref(game:GetService("HttpService")) or game:GetService("HttpService")
                _G.AxiomOriginalJSONDecode = _G.AxiomOriginalJSONDecode or hookfunction(HS.JSONDecode, function(...)
                    local a, b = pcall(_G.AxiomOriginalJSONDecode, ...)
                    return a and b or { whitelisted = true, success = true, authenticated = true, status = 200 }
                end)
            end)
            loadstring(game:HttpGet("https://raw.githubusercontent.com/WhiteX1208/Scripts/main/HopScript.luau"))()
        end)
    end)
end

