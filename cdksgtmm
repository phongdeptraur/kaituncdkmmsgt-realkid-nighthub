local function CheckAndTriggerInitialSubmergedMode()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not hrp then return false end

    local dist = (hrp.Position - POS_SUBMERGED_ISLAND).Magnitude
    if dist <= SUBMERGED_ISLAND_RADIUS then
        Engine.RealkidRunning = true
        Engine.NightHubRunning = false
        getgenv()._NightHubExecuted = true

        lblStatus.Text = "Trạng thái: 🫐 Đang ở Submerged! Ghi config RealKidHub -> Đợi 1s và nạp Auto Berry..."
        WriteRealKidConfig(REALKID_CONFIG_BERRY)
        LaunchRealKid(1.0)

        task.spawn(function()
            for remaining = 40, 1, -1 do
                if not Engine.IsRunning then break end
                lblStatus.Text = string.format("Trạng thái: 🫐 RealKid Auto Berry đang chạy... Hop Low Server sau: %d giây!", remaining)
                task.wait(1)
            end

            if Engine.IsRunning then
                lblStatus.Text = "Trạng thái: 🌐 Hết 40 giây Auto Berry! Bắt đầu Hop Low Server..."
                Engine:HopLowServer()
            end
        end)

        return true
    end
    return false
end

