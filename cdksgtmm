local function getRoot(): BasePart?
    local char = LocalPlayer.Character
    return (char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)) :: BasePart?
end

local function getFlightStabilizer(root: BasePart): BodyVelocity
    local bv = root:FindFirstChild("__AxiomHoverStabilizer") :: BodyVelocity?
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "__AxiomHoverStabilizer"
        bv.Velocity = Vector3.zero
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Parent = root
    end
    return bv
end

local function clearFlightStabilizer(root: BasePart)
    local bv = root:FindFirstChild("__AxiomHoverStabilizer")
    if bv then bv:Destroy() end
end

local function flyAndHoverAbove(targetPart: BasePart)
    local root = getRoot()
    if not root or not targetPart or not targetPart.Parent then return end

    local targetPosition = targetPart.Position + Vector3.new(0, HOVER_OFFSET_Y, 0)
    local targetCFrame = CFrame.lookAt(targetPosition, targetPart.Position)

    local bv = getFlightStabilizer(root)
    bv.Velocity = Vector3.zero

    local dist = (root.Position - targetPosition).Magnitude

    if dist > 14 then
        local duration = math.clamp(dist / LOCKED_TWEEN_SPEED, 0.05, 120)
        local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCFrame })

        local noclipConn = RunService.Stepped:Connect(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            local char = LocalPlayer.Character
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then
                        p.CanCollide = false
                    end
                end
            end
        end)

        tween:Play()
        tween.Completed:Wait()
        noclipConn:Disconnect()
    else
        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function safeFlyToPoint(targetCFrame: CFrame)
    local root = getRoot()
    if not root then return end

    local dist = (root.Position - targetCFrame.Position).Magnitude
    if dist <= 12 then
        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        return
    end

    local bv = getFlightStabilizer(root)
    bv.Velocity = Vector3.zero

    local duration = math.clamp(dist / LOCKED_TWEEN_SPEED, 0.05, 120)
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCFrame })

    local noclipConn = RunService.Stepped:Connect(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then
                    p.CanCollide = false
                end
            end
        end
    end)

    tween:Play()
    tween.Completed:Wait()
    noclipConn:Disconnect()
end

local function isDealerVisited(pos: Vector3): boolean
    for _, visitedPos in ipairs(Engine.VisitedDealers) do
        if (pos - visitedPos).Magnitude <= 150 then
            return true
        end
    end
    return false
end

local function findClosestUnvisitedBoatDealer()
    local root = getRoot()
    local myPos = root and root.Position or Vector3.zero
    local candidates = {}

    local npcsFolder = workspace:FindFirstChild("NPCs")
    if npcsFolder then
        for _, npc in ipairs(npcsFolder:GetChildren()) do
            if npc:IsA("Model") then
                local nameLower = npc.Name:lower()
                if string.find(nameLower, "boat dealer") and not string.find(nameLower, "luxury") then
                    local nRoot = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart")
                    if nRoot and nRoot:IsA("BasePart") then
                        local pos = nRoot.Position
                        if not isDealerVisited(pos) then
                            table.insert(candidates, {
                                Model = npc,
                                Position = pos,
                                Distance = (pos - myPos).Magnitude
                            })
                        end
                    end
                end
            end
        end
    end

    for _, dockPos in ipairs(DOCK_ANCHOR_NODES) do
        if not isDealerVisited(dockPos) then
            local alreadyRepresented = false
            for _, c in ipairs(candidates) do
                if (c.Position - dockPos).Magnitude <= 180 then
                    alreadyRepresented = true
                    break
                end
            end
            if not alreadyRepresented then
                table.insert(candidates, {
                    Model = nil,
                    Position = dockPos,
                    Distance = (dockPos - myPos).Magnitude
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)

    return candidates[1]
end

