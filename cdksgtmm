local LastCommFInventoryPoll = 0
local IsScanningInventory = false

function Inventory:FastScan()
    if IsScanningInventory then return end
    IsScanningInventory = true

    pcall(function()
        local char = LocalPlayer.Character
        local bp = LocalPlayer:FindFirstChild("Backpack")

        -- 1. Quét nhanh Tool trên nhân vật / Backpack (0ms)
        for _, container in ipairs({ char, bp }) do
            if container then
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") then
                        local name = item.Name
                        local low = name:lower()
                        if low:find("valkyrie") then self.PermanentOwned.Valkyrie = true end
                        if low:find("yama") then self.PermanentOwned.Yama = true end
                        if low:find("tushita") then self.PermanentOwned.Tushita = true end
                        if low:find("fractal") or low:find("mirror") then self.PermanentOwned.Fractal = true end
                        self.Weapons[name] = { Mastery = self.MaxMastery[low] or 0, Quantity = 1 }
                    end
                end
            end
        end

        -- 2. Đồng bộ siêu tốc qua ItemReplicationService (0ms)
        local quantities = FetchIRSItems("QUANTITY")
        local masteries = FetchIRSItems("MASTERY")
        local masteryMap = {}
        for k, entry in pairs(masteries) do
            if type(entry) == "table" then
                local idKey = tostring(entry.ItemId or k)
                masteryMap[idKey] = tonumber(entry.Value or entry.Mastery) or 0
            elseif type(entry) == "number" then
                masteryMap[tostring(k)] = entry
            end
        end

        if HasTableEntries(quantities) then
            for k, itemEntry in pairs(quantities) do
                local rawId = (type(itemEntry) == "table" and (itemEntry.ItemId or itemEntry.Name or itemEntry.Item)) or k
                if rawId then
                    local itemId = tostring(rawId)
                    local count = (type(itemEntry) == "table" and tonumber(itemEntry.Value or itemEntry.Count)) or tonumber(itemEntry) or 1
                    local label = ResolveItemName(rawId)
                    local lowLabel, lowId = label:lower(), itemId:lower()

                    if lowLabel:find("valkyrie") or lowId:find("valkyrie") then self.PermanentOwned.Valkyrie = true end
                    if lowLabel:find("yama") or lowId:find("yama") then self.PermanentOwned.Yama = true end
                    if lowLabel:find("tushita") or lowId:find("tushita") then self.PermanentOwned.Tushita = true end
                    if lowLabel:find("fractal") or lowLabel:find("mirror") or lowId:find("fractal") or lowId:find("mirror") then self.PermanentOwned.Fractal = true end

                    self.Weapons[label] = { Mastery = masteryMap[itemId] or 0, Quantity = count }
                end
            end
        end

        -- 3. Dự phòng gọi CommF getInventory có giãn cách 10s (chống spam lag)
        local now = os.clock()
        local missingKeyItems = not (self.PermanentOwned.Tushita and self.PermanentOwned.Valkyrie and self.PermanentOwned.Fractal and self.PermanentOwned.Yama)
        if missingKeyItems and (now - LastCommFInventoryPoll >= 10.0) and not HasTableEntries(quantities) then
            LastCommFInventoryPoll = now
            local invList = SafeInvokeInventory(GetCommF(), 1.5)
            if type(invList) == "table" then
                for _, item in pairs(invList) do
                    local name = tostring(item.Name or item.Item or "")
                    local lowName = name:lower()
                    local count = tonumber(item.Count or item.Value or 1) or 1
                    local mast = tonumber(item.Mastery or 0) or 0
                    if lowName:find("valkyrie") then self.PermanentOwned.Valkyrie = true end
                    if lowName:find("yama") then self.PermanentOwned.Yama = true end
                    if lowName:find("tushita") then self.PermanentOwned.Tushita = true end
                    if lowName:find("fractal") or lowName:find("mirror") then self.PermanentOwned.Fractal = true end
                    self.Weapons[name] = { Mastery = mast, Quantity = count }
                end
            end
        end
    end)

    IsScanningInventory = false
end

