local function Fly(pos, abort, desc)
    if not S.Run or S.RK or S.Main or S.FragFarm or S.Hopping then return false end
    local r, h = Root()
    if not r or not h or h.Health <= 0 then return false end
    h.Sit = false
    Float(true)

    local snapCount = 0
    local snapPos = nil

    while S.Run and not S.RK and not S.Main and not S.FragFarm and not S.Hopping do
        r, h = Root()
        if not r or not h or h.Health <= 0 or (abort and abort()) then return false end
        local d = (r.Position - pos).Magnitude
        if d <= 15 then
            r.CFrame = CF(pos)
            break
        end

        local tw = TweenService:Create(r, TweenInfo.new(d / SPEED, Enum.EasingStyle.Linear), { CFrame = CF(pos) })
        curTw = tw
        tw:Play()

        local lastDist = d
        local checkT = os.clock()
        local rubberbanded = false

        while S.Run and tw.PlaybackState == Enum.PlaybackState.Playing do
            task.wait(0.05)
            r, h = Root()
            if not S.Run or not r or not h or h.Health <= 0 or S.RK or S.Main or S.FragFarm or S.Hopping or (abort and abort()) then
                tw:Cancel()
                return false
            end
            if S.noAttack then Unequip() end
            r.AssemblyLinearVelocity = V3()
            local curDist = (r.Position - pos).Magnitude
            if desc then Say(("%s (còn %.0fm)"):format(desc, curDist)) end

            if os.clock() - checkT >= 0.22 then
                checkT = os.clock()
                if curDist >= lastDist - 8 then
                    if snapPos and (r.Position - snapPos).Magnitude < 45 then
                        snapCount = snapCount + 1
                    else
                        snapPos = r.Position
                        snapCount = 1
                    end

                    if snapCount >= 4 then
                        tw:Cancel()
                        if S.target then
                            Float(true)
                            r.AssemblyLinearVelocity = V3()
                            task.wait(0.15)
                        else
                            Float(false)
                            Say("Bị giật vị trí 4 lần -> Dừng 1s về Verified Spot...")
                            local waitT = os.clock()
                            while S.Run and os.clock() - waitT < 1 do
                                if S.RK or S.Main or S.FragFarm or S.Hopping or (abort and abort()) then
                                    return false
                                end
                                task.wait(0.05)
                            end
                        end
                        snapCount = 0
                        snapPos = nil
                        r, h = Root()
                        if not S.Run or not r or not h or h.Health <= 0 or (abort and abort()) then
                            return false
                        end
                        h.Sit = false
                        Float(true)
                        rubberbanded = true
                        break
                    end
                elseif curDist < lastDist - 25 then
                    snapCount = 0
                end
                lastDist = curDist
            end
        end

        if not rubberbanded then
            r = Root()
            if S.Run and r and (r.Position - pos).Magnitude <= 25 then
                r.CFrame = CF(pos)
            end
            break
        end
    end
    return S.Run
end

-- Thoát khỏi Cursed Ship (Sea 2) và Submerged Island (Sea 3) trước khi Tween hoặc bật RealKid
local function EscapeZones(targetPos, abort)
    local r = Root()
    if not r or not S.Run or S.Hopping then return false end
    -- Sea 2: Đang ở trong Cursed Ship (xung quanh 4000 stud điểm 909.51, 125.37, 32864.02)
    if Sea() == 2 and (r.Position - P.Ship).Magnitude <= 4000 then
        if not targetPos or (targetPos - P.Ship).Magnitude > 4000 then
            if Fly(P.Ship, abort, "Đang tới cửa rời Cursed Ship") then
                pcall(function()
                    local v = (type(vector) == "table" and type(vector.create) == "function")
                        and vector.create(-6508.55810546875, 89.03500366210938, -132.83999633789062)
                        or P.ShipOut
                    RS:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer("requestEntrance", v)
                end)
                task.wait(1.2)
            else
                return false
            end
        end
    end
    -- Sea 3: Đang ở dưới Submerged Island (xung quanh 3000 stud điểm 11279.25, -2138.93, 9873.44)
    r = Root()
    if r and Sea() == 3 and (r.Position - P.Sub).Magnitude <= 3000 then
        if not targetPos or (targetPos - P.Sub).Magnitude > 3000 then
            if Fly(P.SubTp, abort, "Đang ra tàu ngầm rời Submerged Island") then
