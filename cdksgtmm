function Inventory:HasItem(target)
    target = target:lower()
    if target:find("valkyrie") and self.PermanentOwned.Valkyrie then return true end
    if target:find("yama") and self.PermanentOwned.Yama then return true end
    if target:find("tushita") and self.PermanentOwned.Tushita then return true end
    if target:find("fractal") and self.PermanentOwned.Fractal then return true end
    if target:find("guitar") then return true end

    -- Kiểm tra trực tiếp trong Backpack & Character (0ms)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    for _, container in ipairs({ char, bp }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower():find(target) then
                    return true
                end
            end
        end
    end

    for name in pairs(self.Weapons) do
        if name:lower():find(target) then return true end
    end
    return false
end

function Inventory:GetMastery(swordName)
    local key = swordName:lower()
    local cached = self.MaxMastery[key] or 0
    local char, bp = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
    local itemTool = (char and char:FindFirstChild(swordName)) or (bp and bp:FindFirstChild(swordName))
    if itemTool and itemTool:FindFirstChild("Level") then
        local liveLv = tonumber(itemTool.Level.Value) or 0
        if liveLv > cached then
            cached = liveLv
            self.MaxMastery[key] = liveLv
        end
        for name, data in pairs(self.Weapons) do
            if name:lower():find(key) then
                data.Mastery = math.max(tonumber(data.Mastery) or 0, cached)
            end
        end
        return cached
    end
    for name, data in pairs(self.Weapons) do
        if name:lower():find(key) then
            local m = tonumber(data.Mastery) or 0
            if m > cached then
                cached = m
                self.MaxMastery[key] = m
            end
        end
    end
    return cached
end

