local CASTLE_POS = Vector3.new(-5545, 314, -2964)
local CASTLE_ALT_POS = Vector3.new(-5000, 350, -3035)

local function ScanEntityMobFuzzy(targetSubName)
    targetSubName = string.lower(targetSubName)
    local containers = { workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Characters"), ReplicatedStorage }
    for _, container in ipairs(containers) do
        if container then
            for _, mob in ipairs(container:GetChildren()) do
                if mob:IsA("Model") and string.find(string.lower(mob.Name), targetSubName, 1, true) then
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    local hrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                    if hum and hum.Health > 0 and hrp then
                        return mob, hum, hrp
                    end
                end
            end
        end
    end
    return nil, nil, nil
end

local function IsInHeavenlyDimension()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local map = workspace:FindFirstChild("Map")
    local hd = (map and (map:FindFirstChild("HeavenlyDimension") or map:FindFirstChild("Heavenly Dimension") or map:FindFirstChild("HeavenDimension")))
               or workspace:FindFirstChild("HeavenlyDimension")
               or workspace:FindFirstChild("Heavenly Dimension")
    if hd then
        local primary = hd.PrimaryPart or hd:FindFirstChildWhichIsA("BasePart", true)
        if primary and (hrp.Position - primary.Position).Magnitude < 3000 then
            return true
        end
        return true
    end

    return false
end

local function ScanCastlePirateRaidRobust()
    local raidMobCount = 0
    local containers = { workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Characters"), ReplicatedStorage }
    for _, container in ipairs(containers) do
        if container then
            for _, mob in ipairs(container:GetChildren()) do
                if mob:IsA("Model") and not mob:GetAttribute("IsBoss") then
                    local hrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        local d1 = (hrp.Position - CASTLE_POS).Magnitude
                        local d2 = (hrp.Position - CASTLE_ALT_POS).Magnitude
                        if (d1 <= 1200 or d2 <= 1200) then
                            local mobNameLower = string.lower(mob.Name)
                            local isPirateName = string.find(mobNameLower, "pirate", 1, true) or string.find(mobNameLower, "raid", 1, true)
                            local lv = mob:GetAttribute("Level") or (mob:FindFirstChild("Level") and tonumber(mob.Level.Value)) or 0

                            if isPirateName or (lv > 0 and lv <= 1700) or (lv == 0 and d1 <= 800) then
                                raidMobCount = raidMobCount + 1
                            end
                        end
                    end
                end
            end
        end
    end
    return raidMobCount
end

local function UpdateCDKTargetSensors()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    -- 1. Quét Soul Reaper (Yama 3)
    local srModel, srHum, srHrp = ScanEntityMobFuzzy("soul reaper")
    local hellDimension = (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("HellDimension")) or workspace:FindFirstChild("HellDimension")
    local sr = CDKTargetsState.Targets["Soul Reaper"]
    if srModel and srHum and srHrp then
        sr.Found = true
        sr.Health = math.floor(srHum.Health)
        sr.MaxHealth = math.max(1, math.floor(srHum.MaxHealth))
        sr.Distance = hrp and math.floor((hrp.Position - srHrp.Position).Magnitude) or 0
        sr.Model = srModel
        sr.Extra = (hellDimension and "Hell Dimension Active") or "Spawned in Castle"
    else
        sr.Found = false
        sr.Health = 0
        sr.MaxHealth = 0
        sr.Distance = 0
        sr.Model = nil
        sr.Extra = (hellDimension and "Hell Dimension Active") or "Not Spawned"
    end

    -- 2. Quét Cake Queen (Tushita 3)
    local cqModel, cqHum, cqHrp = ScanEntityMobFuzzy("cake queen")
    local inHeaven = IsInHeavenlyDimension()
    local cq = CDKTargetsState.Targets["Cake Queen"]
    if cqModel and cqHum and cqHrp then
        cq.Found = true
        cq.Health = math.floor(cqHum.Health)
        cq.MaxHealth = math.max(1, math.floor(cqHum.MaxHealth))
        cq.Distance = hrp and math.floor((hrp.Position - cqHrp.Position).Magnitude) or 0
        cq.Model = cqModel
        cq.Extra = (inHeaven and "Heaven Dimension Open") or "Alive at Ice Cream Land"
    else
        cq.Found = false
        cq.Health = 0
        cq.MaxHealth = 0
        cq.Distance = 0
        cq.Model = nil
        cq.Extra = (inHeaven and "Heaven Dimension Open") or "Not Spawned"
    end

    -- 3. Quét Castle Pirate Raid (Tushita 2)
    local mobCount = ScanCastlePirateRaidRobust()
    local timeSince = os.time() - CDKTargetsState.LastRaidAlert
    local isRaidActive = (mobCount > 0) or (CDKTargetsState.RaidActive and timeSince < 360)
    local cr = CDKTargetsState.Targets["Castle Raid"]

    cr.Found = isRaidActive
    cr.MobCount = mobCount
    cr.Distance = hrp and math.floor((hrp.Position - CASTLE_POS).Magnitude) or 0

    if mobCount > 0 then
        cr.Extra = string.format("Active: %d Mobs Alive", mobCount)
    elseif CDKTargetsState.RaidActive and timeSince < 360 then
        cr.Extra = string.format("Alert Active (~%ds ago)", timeSince)
    else
        cr.Extra = "No Pirate Raid"
        CDKTargetsState.RaidActive = false
    end

    return CDKTargetsState.Targets
end

