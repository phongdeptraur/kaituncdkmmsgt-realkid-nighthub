-- Kiểm tra Full Moon hợp lệ: Bắt buộc có MoonTextureId 9709149431 VÀ đang trời tối (18:00 -> trước 05:00)
local function CheckFullMoonNight()
    local clock = Lighting.ClockTime
    local isNight = (clock >= 18 or clock < 5)
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then
        return nil, string.format("Chưa tải xong Sky trong Lighting (ClockTime: %.2f)", clock), 0
    end

    local moonId = tostring(sky.MoonTextureId or "")
    local hasFullMoonTex = moonId:find("9709149431", 1, true) ~= nil
    if not hasFullMoonTex then
        return false, string.format("Không phải Full Moon (MoonTextureId: %s, ClockTime: %.2f)", moonId, clock), 0
    end

    if not isNight then
        return false, string.format("Có texture Full Moon (9709149431) nhưng đang trời sáng (ClockTime: %.2f - ngoài khung 18:00-05:00)", clock), 0
    end

    local remMin = (5 - clock) % 24
    return true, string.format("Full Moon hợp lệ (Trời tối, ClockTime: %.2f, còn ~%.1f phút)", clock, remMin), remMin
end
