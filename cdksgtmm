local function SafeReadJsonFile(filePath)
    if typeof(isfile) ~= "function" or not isfile(filePath) then return nil end
    local decoder = _G.AxiomOriginalJSONDecode or HttpService.JSONDecode
    for _ = 1, 3 do
        local ok, raw = pcall(readfile, filePath)
        if ok and type(raw) == "string" and #raw > 2 then
            local okDec, data = pcall(decoder, HttpService, raw)
            if okDec and type(data) == "table" and data.whitelisted == nil then
                return data
            end
        end
        task.wait(0.05)
    end
    return nil
end

