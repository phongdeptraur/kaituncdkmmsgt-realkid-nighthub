local function ResolveHazeIslandCFrame(islandOrMobName)
    local nameLower = islandOrMobName:lower()
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    if worldOrigin then
        local enemySpawns = worldOrigin:FindFirstChild("EnemySpawns")
        if enemySpawns then
            for _, sp in ipairs(enemySpawns:GetChildren()) do
                if string.find(sp.Name:lower(), nameLower) and sp:IsA("BasePart") then return sp.CFrame end
            end
        end
        local playerSpawns = worldOrigin:FindFirstChild("PlayerSpawns")
        if playerSpawns then
            for _, tf in ipairs(playerSpawns:GetChildren()) do
                for _, sm in ipairs(tf:GetChildren()) do
                    if string.find(sm.Name:lower(), nameLower) then
                        local p = sm:FindFirstChildWhichIsA("BasePart", true)
                        if p then return p.CFrame end
                    end
                end
            end
        end
    end
    for _, child in ipairs(ReplicatedStorage:GetChildren()) do
        if string.find(child.Name:lower(), nameLower) then
            local p = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChildWhichIsA("BasePart", true)
            if p and p:IsA("BasePart") and p.Position.Magnitude > 100 then return p.CFrame end
        end
    end
    for nodeName, pos in pairs(VERIFIED_ISLAND_NODES) do
        if string.find(nameLower, nodeName:lower()) or string.find(nodeName:lower(), nameLower) then
            return CFrame.new(pos)
        end
    end
    return nil
end

local function PullSealedKatanaFlow(currentKills)
    if CheckHasYama() then
        Inventory.PermanentOwned.Yama = true
        return true
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distToKatana = (hrp.Position - POS_SEALED_KATANA).Magnitude
    if distToKatana > 25 then
        lblStatus.Text = string.format("Trạng thái: 🗡️ [YAMA] Đã diệt %d/30 Elite! Bay đến Thác Nước rút kiếm (%.0f studs)...", currentKills, distToKatana)
        TweenToPosition(POS_SEALED_KATANA, CONFIG.TweenSpeed)
    else
        local enemies = workspace:FindFirstChild("Enemies")
        local nearbyZombie, shortestDist = nil, 200
        if enemies then
            for _, mob in ipairs(enemies:GetChildren()) do
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                if hum and hum.Health > 0 and mRoot then
                    local d = (mRoot.Position - POS_SEALED_KATANA).Magnitude
                    if d <= 200 and d < shortestDist then shortestDist = d; nearbyZombie = mob end
                end
            end
        end
        if nearbyZombie then
            Engine.CurrentCombatTarget = nearbyZombie
            local zRoot = nearbyZombie:FindFirstChild("HumanoidRootPart") or nearbyZombie.PrimaryPart
            if zRoot then
                lblStatus.Text = string.format("Trạng thái: 🧟 Dọn quái gần Thác Nước: %s...", nearbyZombie.Name)
                FlyOverTarget(zRoot)
                ForceEquipMelee()
            end
        else
            Engine.CurrentCombatTarget = nil
            hrp.CFrame = CFrame.new(POS_SEALED_KATANA)
            hrp.AssemblyLinearVelocity = Vector3.zero
            lblStatus.Text = string.format("Trạng thái: 🗡️ [YAMA] Đang rút Sealed Katana... (%d/30 Elite)", currentKills)
            pcall(function()
                local hitbox = workspace.Map.Waterfall.SealedKatana.Hitbox
                local cd = hitbox:FindFirstChildOfClass("ClickDetector") or hitbox.Parent:FindFirstChildWhichIsA("ClickDetector", true)
                if cd and typeof(fireclickdetector) == "function" then fireclickdetector(cd, 0) end
            end)
            if CheckHasYama() then Inventory.PermanentOwned.Yama = true end
        end
    end
    return Inventory.PermanentOwned.Yama
end

