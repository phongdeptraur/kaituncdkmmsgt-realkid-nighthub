        State.CurrentTask = string.format(
            "👻 [SGT - Sea 2] Đang farm Ectoplasm (%d/250) với RealKid [Né clone 5/60s]...",
            ecto
        )
        StartRealKidWithMode("FarmMatSGT")
        return
    elseif State.FarmingEctoWithRealKid then
        State.FarmingEctoWithRealKid = false
        State.CurrentTask = "🎉 Đã đủ 250/250 Ectoplasm khi đang chạy RealKid! Đang Hop Low để refresh RealKid..."
        HopLowPlayerServer()
        task.wait(3)
        return
    end

-- 2. Dark Fragment (cần 1) tại Sea 2
    if darkFrag < 1 then
        State.NeedRemainInSea2 = true
        if not isSea2 then
            TeleportToSea2()
            return
        end

        -- Nhường toàn bộ quyền điều khiển vật lý & đánh nhanh cho Axiom
        Engine.RealKidMainRunning = false
        Engine.RealKidHopRunning = false
        Engine.NoClipActive = true
        Engine.FastAttackActive = true
        Engine.DesiredSword = nil

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Sit = false end
        hrp.Anchored = false

        -- Kiểm tra nếu có Darkbeard trong server (cả trong Enemies lẫn ReplicatedStorage)
        local dbAct = ScanCrossContinentalBoss({ "Darkbeard" })
        if dbAct or IsDarkbeardSpawned() then
            while Engine.IsRunning and State.Running and CheckIsSea2() do
                local act, hp, maxHp, isInWs, dbModel, dbRoot, dbHum = ScanCrossContinentalBoss({ "Darkbeard" })
                if not act and not IsDarkbeardSpawned() then
                    if Engine.CurrentTween then
                        pcall(function() Engine.CurrentTween:Cancel() end)
                        Engine.CurrentTween = nil
                    end
                    Engine.IsTweening = false
                    Engine.CurrentCombatTarget = nil
                    SyncItemsPreTeamAndInGame()
                    break
                end

                Engine.RealKidMainRunning = false
                Engine.RealKidHopRunning = false
                Engine.NoClipActive = true
                Engine.FastAttackActive = true
                Engine.CurrentCombatTarget = dbModel

                local myChar = LocalPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

                if myHrp and myHum and myHum.Health > 0 then
                    if myHum.Sit then myHum.Sit = false end
                    myHrp.Anchored = false

                    -- Giữ bộ chống rơi (__AxiomFlightStabilizer) luôn bật để nhân vật lơ lửng trên đầu Boss
                    local stabilizer = myHrp:FindFirstChild("__AxiomFlightStabilizer") or Instance.new("BodyVelocity")
                    stabilizer.Name = "__AxiomFlightStabilizer"
                    stabilizer.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                    stabilizer.Velocity = Vector3.zero
                    stabilizer.Parent = myHrp

                    -- Tự động bật Buso Haki và cầm vũ khí Melee/Sword
                    if not myChar:FindFirstChild("HasBuso") then
                        local cf = GetCommF()
                        if cf then pcall(function() cf:InvokeServer("Buso") end) end
                    end
                    local eqTool = myChar:FindFirstChildOfClass("Tool")
                    if not eqTool or (eqTool.ToolTip ~= "Melee" and eqTool.ToolTip ~= "Sword") then
                        local bp = LocalPlayer:FindFirstChild("Backpack")
                        if bp then
                            for _, item in ipairs(bp:GetChildren()) do
                                if item:IsA("Tool") and (item.ToolTip == "Melee" or item.ToolTip == "Sword") then
                                    pcall(function() myHum:EquipTool(item) end)
                                    break
                                end
                            end
                        end
                    end

                    -- Lấy trực tiếp tọa độ của Darkbeard (không qua điểm trung gian Dark Arena)
                    local bossPos = (dbRoot and dbRoot.Position)
                        or (dbModel and dbModel:IsA("Model") and dbModel:GetPivot().Position)

                    if bossPos then
                        local hoverY = (CONFIG and CONFIG.HoverDistanceY) or 18
                        local targetAboveBoss = bossPos + Vector3.new(0, hoverY, 0)
                        local dist = (myHrp.Position - targetAboveBoss).Magnitude

                        State.CurrentTask = string.format(
                            "⚔️ [SGT - Sea 2] Đang tiêu diệt Darkbeard [HP: %.0f/%.0f | Cách: %.0f studs]...",
                            tonumber(hp) or 0,
                            tonumber(maxHp) or 500000,
                            dist
                        )
                        if Engine.StatusLabel then
                            Engine.StatusLabel.Text = "Trạng thái: " .. State.CurrentTask
                        end

                        if dist <= 25 then
                            -- Đã ở gần Boss -> Hủy Tween cũ và khóa cứng vị trí ngay trên đầu Boss
                            if Engine.CurrentTween then
                                pcall(function() Engine.CurrentTween:Cancel() end)
                                Engine.CurrentTween = nil
                            end
                            Engine.IsTweening = false
                            myHrp.CFrame = CFrame.new(targetAboveBoss)
                            myHrp.AssemblyLinearVelocity = Vector3.zero
                            myHrp.AssemblyAngularVelocity = Vector3.zero
                        else
                            -- Đang ở xa hoặc Boss vừa nhảy đi chỗ khác -> Tween thẳng tới đầu Boss và tự cập nhật nếu Boss di chuyển
                            if Engine.CurrentTween then
                                pcall(function() Engine.CurrentTween:Cancel() end)
                                Engine.CurrentTween = nil
                            end
                            Engine.IsTweening = true
                            local speed = (CONFIG and CONFIG.TweenSpeed) or 170
                            local duration = math.max(dist / speed, 0.05)
                            local tw = TweenService:Create(
                                myHrp,
                                TweenInfo.new(duration, Enum.EasingStyle.Linear),
                                { CFrame = CFrame.new(targetAboveBoss) }
                            )
                            Engine.CurrentTween = tw
                            tw:Play()

                            -- Theo dõi trong lúc bay: nếu đã tới gần (<= 20 studs) hoặc Boss di chuyển lệch > 20 studs thì cập nhật đường bay mới ngay
                            local startGoal = targetAboveBoss
                            while Engine.IsRunning and State.Running and tw.PlaybackState == Enum.PlaybackState.Playing do
                                task.wait(0.05)
                                local curChar = LocalPlayer.Character
                                local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
                                local curHum = curChar and curChar:FindFirstChildOfClass("Humanoid")
                                if not curHrp or not curHum or curHum.Health <= 0 then
                                    pcall(function() tw:Cancel() end)
                                    break
                                end
                                curHrp.AssemblyLinearVelocity = Vector3.zero
                                curHrp.AssemblyAngularVelocity = Vector3.zero

                                local nowAct, _, _, _, nowModel, nowRoot = ScanCrossContinentalBoss({ "Darkbeard" })
                                if not nowAct then
                                    pcall(function() tw:Cancel() end)
                                    break
                                end
                                Engine.CurrentCombatTarget = nowModel
                                local nowBossPos = (nowRoot and nowRoot.Position)
                                    or (nowModel and nowModel:IsA("Model") and nowModel:GetPivot().Position)

                                if nowBossPos then
                                    local nowTargetAbove = nowBossPos + Vector3.new(0, hoverY, 0)
                                    -- Nếu đã bay sát đầu Boss hoặc Boss nhảy sang vị trí mới cách điểm cũ > 20 studs -> Ngắt để khóa theo vị trí mới
                                    if (curHrp.Position - nowTargetAbove).Magnitude <= 20 or (nowTargetAbove - startGoal).Magnitude > 20 then
                                        pcall(function() tw:Cancel() end)
                                        break
                                    end
                                end
                            end
                            Engine.IsTweening = false
                        end
                    end
                end

                task.wait(0.05)
            end
            return
        end

        -- Nếu KHÔNG có Darkbeard trong server -> Pre-Tween tới điểm chờ rồi chạy RealKidHop
        Engine.CurrentCombatTarget = nil
        if not State.DarkbeardPreTweenDone then
            local distToPrePos = (hrp.Position - SGT_DARKBEARD_PRE_POS.Position).Magnitude
            if distToPrePos > 25 then
                State.CurrentTask = string.format("🛸 [SGT - Sea 2] Đang Pre-Tween tới điểm chờ Darkbeard (còn %.0f studs)...", distToPrePos)
                if Engine.StatusLabel then
                    Engine.StatusLabel.Text = "Trạng thái: " .. State.CurrentTask
                end
                local ok = TweenToPosition(SGT_DARKBEARD_PRE_POS.Position, CONFIG.TweenSpeed, { "Darkbeard" }, false, true)
                local curHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if ok or (curHrp and (curHrp.Position - SGT_DARKBEARD_PRE_POS.Position).Magnitude <= 25) then
                    State.DarkbeardPreTweenDone = true
                end
                return
            else
                State.DarkbeardPreTweenDone = true
            end
        end

        State.CurrentTask = "🔍 [SGT - Sea 2] Không có Darkbeard -> Chạy RealKidHop [Destination: Darkbeard]..."
        StartRealKidHop("Darkbeard")
        return
    end

    -- 3. Đã đủ Ectoplasm & Dark Fragment -> Sang Sea 3
    State.NeedRemainInSea2 = false
    if isSea2 then
        State.CurrentTask = "✅ Đã đủ 250 Ectoplasm & 1 Dark Fragment! Đang Teleport về Sea 3..."
        TeleportToSea3()
        return
    end

    if not isSea3 then
        TeleportToSea3()
        return
    end

    -- 4. Bones (cần 500) tại Sea 3
    if bones < 500 then
        State.FarmingBonesWithRealKid = true
        pcall(function() Engine:UpdateBonesSession(true) end)
        State.CurrentTask = string.format(
            "🦴 [SGT - Sea 3] Đang farm Bones (%d/500) với RealKid [Né clone 5/60s]...",
            bones
        )
        StartRealKidWithMode("FarmMatSGT")
        return
    elseif State.FarmingBonesWithRealKid then
        State.FarmingBonesWithRealKid = false
        State.CurrentTask = "🎉 Đã đủ 500/500 Bones khi đang chạy RealKid! Đang Hop Low để refresh RealKid..."
        HopLowPlayerServer()
        task.wait(3)
        return
    end

    -- 5. Đủ 3 nguyên liệu -> Check Full Moon & Lấy SGT
    if IsFullMoonNow() then
        State.WasDoingSGTFullMoon = true
        State.CurrentTask = "🌕 [SGT - Sea 3] Đã có Full Moon & đủ 3 nguyên liệu! Bật RealKid [AutoSkullGuitar: true]..."
        if Engine.StatusLabel then
            Engine.StatusLabel.Text = "Trạng thái: " .. State.CurrentTask
        end
        StartRealKidWithMode("AutoSGT")
    else
        -- Nếu trước đó đang chạy AutoSGT trong Full Moon mà bị hết Full Moon giữa chừng:
        if State.WasDoingSGTFullMoon or Engine.RealKidMainRunning then
            State.WasDoingSGTFullMoon = false
            Engine.RealKidMainRunning = false
            LastRealKidConfigJson = nil
            -- Ghi đè tắt AutoSkullGuitar trong file save của RealKidMain để tránh xung đột
            WriteRealKidMainConfig({
                AutoFarmMaterialSkullGuitar = false,
                AutoSkullGuitar             = false,
            })
            -- Mở khóa RealKidHop để cho phép khởi chạy lại ngay trong server hiện tại
            RealKidHopState.IsLaunching = false
            RealKidHopState.LaunchedInServer = false
            getgenv()._RealKidHopLaunchedJob = nil
            Engine.CurrentRealKidDest = nil
        end

        State.CurrentTask = "🌑 [SGT - Sea 3] Hết/Chưa có Full Moon -> Bật RealKidHop [Destination: Full Moon]..."
        if Engine.StatusLabel then
            Engine.StatusLabel.Text = "Trạng thái: " .. State.CurrentTask
        end
        StartRealKidHop("Full Moon")
    end
end

local function CalculateOptimalRoute(targetPos)
    if not IS_SEA_3 then return nil end -- Không dùng cổng Sea 3 khi đang ở Sea 2!
    -- Chỉ cho phép dùng Smart Portal khi đã sở hữu Valkyrie Helmet
    if not CanUsePortalTween() then return nil end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local currentPos = root.Position
    local targetV3 = (typeof(targetPos) == "CFrame" and targetPos.Position) or targetPos
    local directDist = (targetV3 - currentPos).Magnitude
    if directDist < 1200 then return nil end

    local portals = PORTAL_NETWORK[GetCurrentSea()] or PORTAL_NETWORK[3] or {}
    local bestPortal = nil
    local bestTotalDist = directDist
    local tikiUnlocked = CheckTikiBossKilled()

    for _, portal in ipairs(portals) do
        -- Nếu chưa kill Tiki Boss (false): cấm 2 cổng Castle <-> Tiki, chỉ dùng các cổng khác
        local isTikiPortal = (portal.Name == "Castle -> Tiki Outpost" or portal.Name == "Tiki -> Castle Portal")
        if not isTikiPortal or tikiUnlocked then
            local distToGate = (portal.Gate - currentPos).Magnitude
            local distFromExit = (targetV3 - portal.ExitArrival).Magnitude
            local totalWithPortal = distToGate + distFromExit
            if totalWithPortal < (bestTotalDist - 600) then
                bestTotalDist = totalWithPortal
                bestPortal = portal
            end
        end
    end
    return bestPortal
end

local function DirectTweenSegment(targetPos, token, abortBossPatterns, abortOnIndraApi)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not Engine.IsRunning or (token and Engine.CurrentTweenToken ~= token) then return false end

    -- [FIX TWEEN]: Đứng dậy, hủy Sit, unanchor và dọn dẹp các lực kéo rác do RealKid để lại
    if hum then
        hum.Sit = false
    end
    hrp.Anchored = false

    for _, obj in ipairs(hrp:GetChildren()) do
        if (obj:IsA("BodyMover") or obj:IsA("AlignPosition") or obj:IsA("LinearVelocity") or obj:IsA("VectorForce")) and obj.Name ~= "__AxiomFlightStabilizer" then
            pcall(function() obj:Destroy() end)
        end
    end

    if Engine.CurrentTween then
        pcall(function() Engine.CurrentTween:Cancel() end)
        Engine.CurrentTween = nil
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    local stabilizer = hrp:FindFirstChild("__AxiomFlightStabilizer") or Instance.new("BodyVelocity")
    stabilizer.Name = "__AxiomFlightStabilizer"
    stabilizer.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    stabilizer.Velocity = Vector3.zero
    stabilizer.Parent = hrp

    Engine.IsTweening = true
    Engine.NoClipActive = true
    local targetV3 = (typeof(targetPos) == "CFrame" and targetPos.Position) or targetPos
    local dist = (hrp.Position - targetV3).Magnitude
    if dist <= 15 then
        hrp.CFrame = CFrame.new(targetV3)
        Engine.IsTweening = false
        if hum and hum.Parent then pcall(function() hum.PlatformStand = false end) end
        return true
    end

    local speed = (CONFIG and CONFIG.TweenSpeed) or 170
    local duration = math.max(dist / speed, 0.05)
    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetV3) })
    Engine.CurrentTween = tw

    local completed = false
    local conn
    conn = tw.Completed:Connect(function()
        completed = true
        if conn then conn:Disconnect() end
    end)
    tw:Play()

    while not completed and Engine.IsRunning and (not token or Engine.CurrentTweenToken == token) do
        task.wait(0.05)
        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        local myHum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not myHum or myHum.Health <= 0 then
            pcall(function() tw:Cancel() end)
            if conn then conn:Disconnect() end
            Engine.IsTweening = false
            return false
        end
        if myHum.Sit then myHum.Sit = false end
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        if abortBossPatterns and ScanBossEntity(abortBossPatterns) then
            pcall(function() tw:Cancel() end)
            if conn then conn:Disconnect() end
            Engine.IsTweening = false
            if myHum and myHum.Parent then pcall(function() myHum.PlatformStand = false end) end
            return false
        end

        if abortOnIndraApi and (#GetValidNightServers("Rip Indra") > 0 or ScanBossEntity({ "rip_indra", "rip_indra True Form" })) then
            pcall(function() tw:Cancel() end)
            if conn then conn:Disconnect() end
            Engine.IsTweening = false
            if myHum and myHum.Parent then pcall(function() myHum.PlatformStand = false end) end
            return false
        end

        if (hrp.Position - targetV3).Magnitude <= 15 then
            pcall(function() tw:Cancel() end)
            completed = true
            break
        end
    end

    if conn then conn:Disconnect() end
    Engine.IsTweening = false
    if hum and hum.Parent then pcall(function() hum.PlatformStand = false end) end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    return completed
end

local function EscapeSubmergeIsland(token)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    if (hrp.Position - POS_SUBMERGE_CENTER).Magnitude <= 2000 then
        if Engine.StatusLabel then
            Engine.StatusLabel.Text = "Trạng thái: 🌊 Đang ở Submerged Island! Thoát về Sea Castle..."
        end
        local ok = DirectTweenSegment(POS_SUBMERGE_TELEPORT, token)
        if ok and (not token or Engine.CurrentTweenToken == token) then
            pcall(function()
                ReplicatedStorage:WaitForChild("Modules", 5):WaitForChild("Net", 5):WaitForChild("RF/SubmarineTransportation", 5):InvokeServer("InitiateTeleport", "Sea Castle")
            end)
            task.wait(1.5)
        end
        return true
    end
    return false
end

TweenToPosition = function(targetPos, speed, abortBossPatterns, abortOnIndraApi, forceAxiom)
    if not Engine.IsRunning then return false end
    if (Engine.RealKidMainRunning or Engine.RealKidHopRunning) and not forceAxiom then return false end
    if forceAxiom then
        Engine.RealKidMainRunning = false
        Engine.RealKidHopRunning = false
        Engine.NoClipActive = true
    end
    Engine.CurrentTweenToken = (Engine.CurrentTweenToken or 0) + 1
    local token = Engine.CurrentTweenToken

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    EscapeSubmergeIsland(token)
    if Engine.CurrentTweenToken ~= token then return false end

    local targetV3 = (typeof(targetPos) == "CFrame" and targetPos.Position) or targetPos
    -- Chỉ tính toán cổng Smart Portal nếu đã có Valkyrie Helmet, nếu chưa có thì tween thẳng như thường
    local bestPortal = CanUsePortalTween() and CalculateOptimalRoute(targetV3) or nil

    if bestPortal then
        if Engine.StatusLabel then
            Engine.StatusLabel.Text = string.format("Trạng thái: 🌀 Smart Portal: Bay tới %s...", bestPortal.Name)
        end
        local gatePos = bestPortal.Gate + Vector3.new(0, 3, 0)
        local gateOk = DirectTweenSegment(gatePos, token, abortBossPatterns, abortOnIndraApi)
        if not gateOk or Engine.CurrentTweenToken ~= token then return false end

        local hrpCurrent = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrpCurrent then
            hrpCurrent.CFrame = CFrame.new(gatePos)
            task.wait(0.1)
        end

        local commF = GetCommF()
        if commF then
            for _ = 1, 4 do
                pcall(function() commF:InvokeServer("requestEntrance", bestPortal.RemoteExit) end)
                task.wait(0.2)
                local ch = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if ch and (ch.Position - bestPortal.Gate).Magnitude > 200 then break end
            end
        end

        local waitTicks = 0
        repeat
            task.wait(0.1)
            waitTicks = waitTicks + 1
            local curHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        until not curHrp or (curHrp.Position - bestPortal.Gate).Magnitude > 200 or waitTicks > 20 or Engine.CurrentTweenToken ~= token

        if Engine.CurrentTweenToken ~= token then return false end
    end

    return DirectTweenSegment(targetV3, token, abortBossPatterns, abortOnIndraApi)
end

local function FlyOverTarget(targetPart, abortOnIndraApi)
    if Engine.RealKidMainRunning or Engine.RealKidHopRunning then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetPart or not targetPart.Parent then return end

    local targetCombatPos = targetPart.Position + Vector3.new(0, CONFIG.HoverDistanceY, 0)
    if (hrp.Position - targetCombatPos).Magnitude > 22 then
        TweenToPosition(targetCombatPos, CONFIG.TweenSpeed, nil, abortOnIndraApi)
    else
        hrp.CFrame = CFrame.lookAt(targetCombatPos, targetPart.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function VerifyBossAbsent(patterns)
    for _ = 1, 3 do
        local found, _, _, hum = ScanBossEntity(patterns)
        if found and (not hum or hum.Health > 0) then
            return false
        end
        task.wait(0.25)
    end
    return true
end

