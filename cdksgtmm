-- =========================================================================
local function executeAntiRubberbandFlight(myRoot: BasePart, initialTargetCFrame: CFrame)
    local targetCFrame = initialTargetCFrame * CFrame.new(0, 18, 0)
    local distance = (myRoot.Position - targetCFrame.Position).Magnitude
    local duration = math.max(distance / CONFIG.TweenSpeed, 0.1)

    myRoot.Anchored = false

    local flightStabilizer = myRoot:FindFirstChild("__AxiomFlightStabilizer") or Instance.new("BodyVelocity")
    flightStabilizer.Name = "__AxiomFlightStabilizer"
    flightStabilizer.Velocity = Vector3.zero
    flightStabilizer.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flightStabilizer.Parent = myRoot

    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    local activeTween = TweenService:Create(myRoot, tweenInfo, { CFrame = targetCFrame })

    local flightLoopConn = RunService.Stepped:Connect(function()
        if myRoot and myRoot.Parent then
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
        end

        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)

    activeTween:Play()
    activeTween.Completed:Wait()

    flightLoopConn:Disconnect()
    if flightStabilizer and flightStabilizer.Parent then
        flightStabilizer:Destroy()
    end

    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    myRoot.Anchored = false
end

