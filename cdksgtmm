local function AutoSelectMarinesTeam()
    local attempts = 30
    while attempts > 0 and (not LocalPlayer.Team or LocalPlayer.Team.Name ~= "Marines") do
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local commF = remotes and remotes:FindFirstChild("CommF_")
            if commF then commF:InvokeServer("SetTeam", "Marines") end

            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then
                local chooseTeam = pg:FindFirstChild("ChooseTeam") or (pg:FindFirstChild("Main") and pg.Main:FindFirstChild("ChooseTeam"))
                if chooseTeam then
