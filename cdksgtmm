                        seen[m] = true
                        dimTargets[#dimTargets + 1] = { m = m, p = p }
                    end
                end
            end
        end
        if #dimTargets < 2 then
            local enemies = workspace:FindFirstChild("Enemies")
            for _, m in ipairs(enemies and enemies:GetChildren() or {}) do
                if #dimTargets >= 2 then break end
                if m ~= c and m:IsA("Model") and not seen[m] and not (S.isDimBlacklisted and S.isDimBlacklisted(m)) then
                    local h, p = m:FindFirstChildOfClass("Humanoid"), m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
                    if h and p and h.Health > 0 and (r.Position - p.Position).Magnitude <= 120 then
                        seen[m] = true
                        dimTargets[#dimTargets + 1] = { m = m, p = p }
                    end
                end
            end
        end
        for _, item in ipairs(dimTargets) do
            hits[#hits + 1], hits[#hits + 2] = { item.m, item.p }, item.m
            main = main or item.m:FindFirstChild("Head") or item.p
        end
