local STEPS = {
    { "GetCDK", "Yama", Yama },
    { "GetMM", "Mirror Fractal", Fractal }, { "GetSGT", "Skull Guitar", SGT }, { "GetCDK", "Cursed Dual Katana", CDK },
}
local function Step()
    if S.cur ~= "CDK - Tushita Q3" and S.cur ~= "CDK - Boss Cuối" then
        S.weapon = nil
    end
    S.target, S.cdkStatus, S.farmStatus, S.sgtStatus = nil, nil, nil, nil
    if not EnsureSwordStat() then return end
    local cf = G.AutoConfig
    if (cf.GetMM and not Has("Valkyrie Helm")) or (cf.GetCDK and not Has("Tushita")) then
        if ReleaseEliteClaim then pcall(ReleaseEliteClaim) end
        return Indra()
    end
    for _, s in ipairs(STEPS) do
        if G.AutoConfig[s[1]] and not Has(s[2]) then
            if s[2] ~= "Yama" and ReleaseEliteClaim then pcall(ReleaseEliteClaim) end
            if S.RK and S.RK ~= s[2] and not (s[2] == "Cursed Dual Katana" and tostring(S.RK):sub(1, 6) == "CDK - ") then
                return HopLow("Đã xong " .. tostring(S.RK) .. " -> Hop Low qua " .. s[2])
            end
            S.cur = s[2]
            Say()
            return s[3]()
        end
    end
    S.noAttack = false
    ReleaseServerClaim()
    if ReleaseEliteClaim then pcall(ReleaseEliteClaim) end
    S.cur = "HOÀN TẤT"
    Say("Đã lấy đủ toàn bộ vật phẩm!")
end

