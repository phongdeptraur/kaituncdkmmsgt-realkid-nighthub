local function TweenToPosition(targetPos, speed)
    if not Engine.IsRunning or Engine.IsHopping or Engine.RealkidRunning then return nil end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    if Engine.CurrentTween then
        pcall(function() Engine.CurrentTween:Cancel() end)
        Engine.CurrentTween = nil
    end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    local head = char:FindFirstChild("Head")
    if head and not head:FindFirstChild("axiom_bv") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "axiom_bv"
        bv.MaxForce = Vector3.new(0, math.huge, 0)
        bv.Velocity = Vector3.zero
        bv.Parent = head
    end

    Engine.IsTweening = true
    local reached = false

    while Engine.IsRunning and not reached and not Engine.IsHopping and not Engine.RealkidRunning do
        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then break end

        local currentDist = (hrp.Position - targetPos).Magnitude
        if currentDist <= 6 then
            reached = true
            break
        end

        local duration = currentDist / (speed or 220)
        local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
        Engine.CurrentTween = tw
        tw:Play()

        local lagbackTriggered = false
        local lastDistToTarget = currentDist

        local monitorConn
        monitorConn = RunService.Heartbeat:Connect(function()
            if not Engine.IsRunning or not hrp or not hrp.Parent or Engine.IsHopping or Engine.RealkidRunning then
                if monitorConn then monitorConn:Disconnect() end
                return
            end

            local distNow = (hrp.Position - targetPos).Magnitude
            if distNow - lastDistToTarget > 25 then
                lagbackTriggered = true
                if monitorConn then monitorConn:Disconnect() end
            else
                if distNow < lastDistToTarget then
                    lastDistToTarget = distNow
                end
            end
        end)

        while tw.PlaybackState == Enum.PlaybackState.Playing and not lagbackTriggered and not Engine.IsHopping and not Engine.RealkidRunning do
            task.wait(0.05)
        end

        if monitorConn then monitorConn:Disconnect() end

        if lagbackTriggered then
            pcall(function() tw:Cancel() end)
            hrp.AssemblyLinearVelocity = Vector3.zero
            lblStatus.Text = "Trạng thái: ⚠️ Bị giật Lagback! Tạm dừng 1s để ổn định vị trí..."
            task.wait(1)
            lblStatus.Text = "Trạng thái: 🚀 Tiếp tục Tween đến mục tiêu..."
        else
            if (hrp.Position - targetPos).Magnitude <= 8 then
                reached = true
            end
            break
        end
    end

    Engine.IsTweening = false
    return true
end

