    if not t and os.clock() - bagT > 1.5 then
        bagT = os.clock()
        Inv("LoadItem", n)
        t = LP.Backpack:WaitForChild(n, 0.5) or InBag(n)
    end
    if forceEquip and not S.noAttack and t and t.Parent == LP.Backpack then
        local _, h = Root()
        if h then pcall(function() h:EquipTool(t) end) end
    end
    return t
end
