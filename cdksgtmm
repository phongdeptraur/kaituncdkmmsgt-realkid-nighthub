-- =========================================================================
local function SafeInvokeServer(remote, timeout, ...)
    if not remote then return nil end
    timeout = timeout or 1.2
    local done, result = false, nil
    local args = { ... }
    task.spawn(function()
        local ok, res = pcall(function()
            return remote:InvokeServer(unpack(args))
        end)
        if ok then result = res end
        done = true
    end)
    local deadline = os.clock() + timeout
    while not done and os.clock() < deadline do
        task.wait(0.04)
    end
    return result
end

local function SafeRequire(inst, timeout)
    if not inst or not inst:IsA("ModuleScript") then return nil end
    -- Thử require trực tiếp trong pcall trước (0ms nếu module đã load)
    local directOk, directRes = pcall(require, inst)
    if directOk and directRes then return directRes end

    timeout = timeout or 0.6
    local done, result = false, nil
    task.spawn(function()
        local ok, res = pcall(require, inst)
        if ok then result = res end
        done = true
    end)
    local deadline = os.clock() + timeout
    while not done and os.clock() < deadline do
        task.wait(0.04)
    end
    return result
end

local function SafeInvokeInventory(commF, timeout)
    return SafeInvokeServer(commF, timeout or 1.5, "getInventory")
end

