local function LogHopReason(reason)
    pcall(function()
        if isfolder and makefolder then
            if not isfolder("CDKProgress") then makefolder("CDKProgress") end
            if not isfolder(HOP_REASON_DIR) then makefolder(HOP_REASON_DIR) end
        end
        local safeUser = tostring(LP and LP.Name or "Unknown"):gsub("[^%w_%-]", "_")
        local filePath = HOP_REASON_DIR .. "/" .. safeUser .. ".txt"
        local ts = os.date("%Y-%m-%d %H:%M:%S")
        local jid = tostring(game.JobId or "N/A")
        local stage = tostring(S and S.cur or "Khởi tạo")
        local line = string.format("[%s] [JobId: %s] [Bước: %s] Lý do: %s\n", ts, jid, stage, tostring(reason or "Không rõ lý do"))

        if appendfile and isfile and isfile(filePath) then
            appendfile(filePath, line)
        else
            local old = ""
            if isfile and readfile and isfile(filePath) then
                old = readfile(filePath) or ""
            end
            if writefile then
                writefile(filePath, old .. line)
            end
        end
    end)
end

