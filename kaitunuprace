local function TweenStepTowards(targetCFrame: CFrame, speed: number?)

    if IsInCursedShip and IsInCursedShip() and (targetCFrame.Position - CURSED_SHIP_INTERIOR_POS).Magnitude > 3000 then
        if EscapeCursedShip then EscapeCursedShip() end
    end

    local char = LocalPlayer.Character
