local function ProcessNativePullLever()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- 0. Kiểm tra xem Cửa Đền đã mở hay chưa. Nếu đã mở -> Dừng ngay lập tức
    if IsTempleDoorOpened() then
        warn("[AXIOM V4] >>> CHECK TEMPLE DOOR = TRUE: Đã hoàn tất kéo cần! Dừng pull lever. <<<")
        if App then App.CurrentActivity = "✅ Temple Door Đã Mở (Kéo cần xong!)" end
        return true
    end

    -- 1. Kiểm tra tiến trình RaceV4Progress từ Server
    local okProgress, response = pcall(function()
        return commF:InvokeServer("RaceV4Progress", "Check")
    end)

    if not okProgress then
        warn("[AXIOM V4] Lỗi gọi Remote RaceV4Progress Check: " .. tostring(response))
        return false
    end

    -- Step 1: Bắt đầu chuỗi nhiệm vụ V4
    if response == 1 then
        warn("[AXIOM V4] Step 1: Kích hoạt RaceV4Progress [Begin]...")
        if App then App.CurrentActivity = "📜 [V4 Progress] Step 1: RaceV4Progress Begin..." end
        commF:InvokeServer("RaceV4Progress", "Begin")
        task.wait(0.5)
        return false

    -- Step 2: Dịch chuyển lên đỉnh Great Tree & Teleport vào Temple
    elseif response == 2 then
        local distToSummit = subFunction:GetDistance(GREAT_TREE_SUMMIT.Position)
        if distToSummit <= 10 then
            warn("[AXIOM V4] Step 2: Đã ở đỉnh Great Tree -> Kích hoạt Teleport...")
            if App then App.CurrentActivity = "🌀 [V4 Progress] Step 2: Teleporting into Temple..." end
            commF:InvokeServer("RaceV4Progress", "Teleport")
            task.wait(1.0)
        else
            warn(string.format("[AXIOM V4] Step 2: Đang bay lên đỉnh Great Tree (Cách %d studs)...", math.floor(distToSummit)))
            if App then App.CurrentActivity = string.format("🏃 [V4 Progress] Đang bay lên đỉnh Great Tree (%d studs)...", math.floor(distToSummit)) end
            tweenModule:to(GREAT_TREE_SUMMIT)
        end
        return false

    -- Step 3: Giao tiếp bia đá cổ đại
    elseif response == 3 then
        warn("[AXIOM V4] Step 3: Kích hoạt RaceV4Progress [Continue]...")
        if App then App.CurrentActivity = "📜 [V4 Progress] Step 3: RaceV4Progress Continue..." end
        commF:InvokeServer("RaceV4Progress", "Continue")
        task.wait(0.5)
        return false

    -- Step 4: Đảo Mirage đang xuất hiện -> Tiến hành nghi thức nhìn trăng & nhặt Gear
    elseif subFunction:checkmirage() then
        if App then App.CurrentActivity = "🌕 [V4 Mirage] Đang xử lý đảo Mirage & Blue Gear..." end

        local cFrame = subFunction:HighestPoint() and subFunction:HighestPoint().CFrame
        if not cFrame then
            local mystic = Workspace.Map:FindFirstChild("MysticIsland")
            cFrame = mystic and (mystic:GetPivot() * CFrame.new(0, 500, 0)) or CFrame.new(-10000000, 31, 37016.25)
        end

        local v7 = subFunction:getbluegear()

        if v7 then
            -- [A] Blue Gear đã xuất hiện -> Nhặt gear
            if v7.Transparency == 0 and not v7.CanCollide then
                warn("[AXIOM V4] Phát hiện Blue Gear đã kích hoạt! Tiến hành bay tới nhặt...")
                while v7 and v7.Transparency == 0 and not v7.CanCollide do
                    task.wait()
                    tweenModule:to(v7.CFrame, true)
                end
                task.wait(0.5)
                return false
            else
                -- [B] Blue Gear chưa kích hoạt -> Bay lên đỉnh cao nhất, nhìn Mặt Trăng & Bật V3
                while subFunction:checkmirage() do
                    task.wait()

                    if subFunction:GetDistance(cFrame) <= 50 then
                        local clock = game:GetService("Lighting").ClockTime
                        if clock >= 18 or clock < 5 then
                            local currentCamera = Workspace.CurrentCamera
                            local position = currentCamera.CFrame.Position
                            local Lighting = game:GetService("Lighting")
                            local position2 = position + Lighting:GetMoonDirection()

                            currentCamera.CFrame = CFrame.lookAt(position, position2)
                            commE:FireServer("ActivateAbility")
                        end
                    else
                        tweenModule:to(cFrame)
                    end

                    local gearCheck = subFunction:getbluegear()
                    if not subFunction:checkmirage() or (gearCheck and gearCheck.Transparency == 0 and not gearCheck.CanCollide) then
                        break
                    end
                end
            end
        else
            -- Chưa tìm thấy Gear Instance -> Di chuyển tới đỉnh núi
            if subFunction:GetDistance(cFrame) > 50 then
                tweenModule:to(cFrame)
            end
        end
        return false

    -- Step 5: Tự động Hop server nếu được cấu hình
    elseif getgenv().AutoPullLeverHop then
        warn("[AXIOM V4] Không có Mirage trên server -> Kích hoạt AutoPullLeverHop...")
        if App then App.CurrentActivity = "🌐 [V4 Lever] Server không có Mirage -> Đang Hop server..." end
        subFunction:Hop()
        task.wait(3)
        return false

    -- Step 6: Đã đủ điều kiện & vượt qua các bước đối thoại -> Thực hiện kéo cần bí mật
    else
        if (hrp.Position - TEMPLE_INTERIOR_POS).Magnitude > 1000 then
            warn("[AXIOM V4] Đang vào trong Temple of Time (requestEntrance)...")
            pcall(function()
                commF:InvokeServer("requestEntrance", TEMPLE_INTERIOR_POS)
            end)
            task.wait(0.8)
        end

        EnsureTempleRendered()
        local temple = Workspace.Map:FindFirstChild("Temple of Time")
        local lever = temple and temple:FindFirstChild("Lever")
        local leverPart = lever and (lever:FindFirstChild("Part") or lever:FindFirstChildWhichIsA("BasePart", true))
        local targetCF = leverPart and (leverPart.CFrame * CFrame.new(0, 1.5, 0)) or LEVER_WALL_CFRAME

        if (hrp.Position - targetCF.Position).Magnitude > 5 then
            tweenModule:to(targetCF)
        else
            TriggerLeverPrompts()
            task.wait(0.2)

            if IsTempleDoorOpened() then
                warn("[AXIOM V4] >>> CHECK TEMPLE DOOR = TRUE: HOÀN TẤT KÉO CẦN! DỪNG SCRIPT. <<<\")
                if App then App.CurrentActivity = "✅ Temple Door Đã Mở (Kéo cần xong!)" end
                return true
            end
        end
    end

    return false
end

