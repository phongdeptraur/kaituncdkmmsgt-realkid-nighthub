-- // [AXIOM CO-OP IMMUNITY GATE]: Khóa cứng tuyệt đối - Chỉ khi ĐÃ CÓ V2 và ĐANG LÀM V3 mới chạy Coop (Skypiea & Ghoul)

local function IsEligibleForCoop(): boolean
    local myTarget = CleanRaceStr(App and App.TargetRace or TARGET_RACE or "")
    local isSkyTarget = (myTarget:find("sky") or myTarget:find("angel")) ~= nil
    local isGhoulTarget = (myTarget:find("ghoul")) ~= nil

    -- [CHỐT CHẶN TỐI CAO]: Nếu target race KHÔNG PHẢI Skypiea/Ghoul -> CẤM TOÀN BỘ COOP

    -- Dù nhân vật hiện tại có đang cầm race Skypiea hay Ghoul cũng tuyệt đối KHÔNG tham gia

    if not (isSkyTarget or isGhoulTarget) then
        return false
    end

    local curRace = CleanRaceStr(GetCurrentRace and GetCurrentRace() or "")

    if isSkyTarget and not (curRace:find("sky") or curRace:find("angel")) then
        return false
    end

    if isGhoulTarget and not curRace:find("ghoul") then
        return false
    end

    -- [CHỐT CHẶN V2 & V3]: BẮT BUỘC ĐÃ CÓ V2 VÀ ĐANG LÀM V3 (CHƯA CÓ V3) MỚI ĐƯỢC CHẠY COOP

    local hasV2 = (App and App.HasV2Confirmed) or (CheckRaceV2 and CheckRaceV2())

    if not hasV2 then
        return false
    end

    local hasV3 = (App and App.HasV3Confirmed) or (CheckCyborgV3 and CheckCyborgV3())

    if hasV3 then
        return false
    end

    return true
end

