local function EscapeCursedShip()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local exitCFrame = CFrame.new(923.21, 126.97, 32852.83)
    local door = Workspace:FindFirstChild("GhostShipInterior") and Workspace.GhostShipInterior:FindFirstChild("Teleport")
    if door then
        exitCFrame = door.CFrame
    end

    -- Fast tween to exit threshold
    if typeof(AxiomTween) == "function" then
        AxiomTween(exitCFrame)
    elseif typeof(ToCFrame) == "function" then
        ToCFrame(exitCFrame)
    else
        root.CFrame = exitCFrame
    end
    task.wait(0.3)

    -- Trigger exit portal interaction
    if door and door:FindFirstChild("TouchInterest") then
        pcall(function()
            firetouchinterest(root, door, 0)
            task.wait(0.05)
            firetouchinterest(root, door, 1)
        end)
    end

    -- Await physical teleport into exterior ocean coordinates
    local escapeStart = tick()
    while IsInCursedShip() and tick() - escapeStart < 5 do
        root.CFrame = exitCFrame
        if door and door:FindFirstChild("TouchInterest") then
            pcall(function()
                firetouchinterest(root, door, 0)
                firetouchinterest(root, door, 1)
            end)
        end
        task.wait(0.3)
    end

    -- Crucial streaming shield: give exterior map chunks time to replicate
    task.wait(1.5)
    EnsureChestsTagged()
end

local function GetNearestTaggedChest()
    EnsureChestsTagged()
    local tagged = CollectionService:GetTagged("_ChestTagged")
    local huge = math.huge
    local nearest = nil
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local myPos = root.Position
    local inShip = IsInCursedShip(myPos)

    for i = 1, #tagged do
        local chest = tagged[i]
        if chest and chest.Parent and not chest:GetAttribute("IsDisabled") then
            -- Night Hub standard: verify active TouchInterest/TouchTransmitter
            local touch = chest:FindFirstChild("TouchInterest") or chest:FindFirstChildWhichIsA("TouchTransmitter", true)
            if touch then
                local chestPivot = chest:GetPivot().Position
                local chestInShip = IsInCursedShip(chestPivot)
                -- Realm isolation: do not calculate distance across dimensional boundaries
                if inShip == chestInShip then
                    local dist = (chestPivot - myPos).Magnitude
                    if dist < huge then
                        nearest = chest
                        huge = dist
                    end
                end
            end
        end
    end
    return nearest
end

