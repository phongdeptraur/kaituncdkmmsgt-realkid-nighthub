function AxiomBossHop:HopToTarget(endpointInput, filterCb)

    local data, err = self:FetchServers(endpointInput)

    if not data or not data.Servers or #data.Servers == 0 then
        return false
    end

    local chosen = self:FindLowestServerBottomUp(data.Servers, filterCb)

    if not chosen then
        return false
    end

    App.CurrentActivity = string.format("🚀 [Hop API] Đang kết nối Job: %s (%d players)...", chosen.JobId:sub(1, 8), chosen.Players)

    self:TeleportTo(chosen.JobId, chosen.PlaceId)

    return true
end

