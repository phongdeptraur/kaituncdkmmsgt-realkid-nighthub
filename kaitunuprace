local function TweenToPosition(targetPos: Vector3)

    if IsInCursedShip and IsInCursedShip() and (targetPos - CURSED_SHIP_INTERIOR_POS).Magnitude > 3000 then
        if EscapeCursedShip then EscapeCursedShip() end
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)

    if not root then return end

    root.Anchored = false

    if GetStabilizer then GetStabilizer(root).Velocity = Vector3.zero end

    local dist = (root.Position - targetPos).Magnitude

    if dist < 1.5 then return end

    -- KHÓA CỨNG CHUẨN XÁC 170 STUD/S (TRIỆT TIÊU CLAMP 8S TRÁNH BAY QUÁ NHANH KHI RA NGOÀI)

    local duration = math.max(dist / 170, 0.05)
    local ts = game:GetService("TweenService")
    local tw = ts:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })

    tw:Play()

    tw.Completed:Wait()

    root.Anchored = false

    if GetStabilizer then GetStabilizer(root).Velocity = Vector3.zero end
end

local function EvaluateCoopRoles()

    if SyncDualTargetRace then SyncDualTargetRace() end

    if not IsEligibleForCoop() then
        App.CoopRole = "none"

        App.CurrentHelperPeer = nil

        pcall(function()

            local myName = tostring(LocalPlayer.Name)

            if isfile and writefile and readfile and HttpService and isfile("Axiom_Coop_Sessions.json") then
                local ok, data = pcall(function() return HttpService:JSONDecode(readfile("Axiom_Coop_Sessions.json")) end)

                if ok and type(data) == "table" and data[myName] then
                    data[myName] = nil

                    writefile("Axiom_Coop_Sessions.json", HttpService:JSONEncode(data))
                end
            end

            local cFolder = workspace:FindFirstChild("AxiomCoopPresence")
            local myNode = cFolder and cFolder:FindFirstChild(myName)

            if myNode then myNode:Destroy() end
        end)

        return
    end

    if os.clock() - lastCoopSync < 2.0 then return end

    lastCoopSync = os.clock()

    local myTarget = CleanRaceStr(App and App.TargetRace or TARGET_RACE or "")
    local isGhoulTarget = (myTarget:find("ghoul")) ~= nil
    local myRace = isGhoulTarget and "ghoul" or "skypiea"
    local myName = tostring(LocalPlayer.Name)
    local myJob = tostring(game.JobId)
    local myPlayerCount = #Players:GetPlayers()
    local myV3Status = CheckCyborgV3()
    local myV2Status = CheckRaceV2()
    local mySea = IsSea2() and 2 or (IsSea3() and 3 or 1)
    local now = os.time()
    local COOP_TIMEOUT = 180 -- [QUÉT TỰ ĐỘNG]: Xóa sổ mọi tín hiệu quá 3 phút (180s)
    local sessions = {}
    local sessionFile = "Axiom_Coop_Sessions.json"

    -- 1. Đọc và thanh lọc triệt để File IPC chung (Lọc sạch acc không phải target Sky/Ghoul hoặc > 180s)

    if isfile and writefile and readfile and HttpService then
        pcall(function()

            if isfile(sessionFile) then
                local ok, data = pcall(function() return HttpService:JSONDecode(readfile(sessionFile)) end)

                if ok and type(data) == "table" then sessions = data end
            end

            for acc, info in pairs(sessions) do
                local hb = (type(info) == "table" and tonumber(info.Heartbeat)) or 0
                local accTarget = ACCOUNT_RACE_MAP[acc] or (type(info) == "table" and info.TargetRace) or ""
                local cleanAccTarget = CleanRaceStr(accTarget)
                local isCoopTarget = (cleanAccTarget:find("sky") or cleanAccTarget:find("angel") or cleanAccTarget:find("ghoul")) ~= nil
                local isDoneV3 = type(info) == "table" and (info.HasV3 == true or info.Role == "done")
                local isSea3 = type(info) == "table" and (tonumber(info.Sea) == 3)

                if type(info) ~= "table" or hb == 0 or (now - hb > COOP_TIMEOUT) or (not isCoopTarget) or isDoneV3 or isSea3 or (acc == myName and (not IsEligibleForCoop() or CheckCyborgV3())) then
                    sessions[acc] = nil
                end
            end

            sessions[myName] = {
                Name = myName,
                Race = myRace,
                TargetRace = myTarget,
                JobId = myJob,
                PlayerCount = myPlayerCount,
                HasV3 = myV3Status,
                HasV2 = myV2Status,
                Role = App.CoopRole or "none",
                STT = App.CoopSTT,
                QueueTime = App.QueueTime,
                Sea = mySea,
                Heartbeat = now
            }

            writefile(sessionFile, HttpService:JSONEncode(sessions))
        end)
    end

    -- 2. Quét dọn Node rác trong Workspace AxiomCoopPresence (Xóa node > 3 phút hoặc không phải target Sky/Ghoul)

    pcall(function()

        local cFolder = workspace:FindFirstChild("AxiomCoopPresence")

        if not cFolder then
            cFolder = Instance.new("Folder")

            cFolder.Name = "AxiomCoopPresence"

            cFolder.Parent = workspace
        end

        local myNode = cFolder:FindFirstChild(myName) or Instance.new("Configuration")

        myNode.Name = myName

        myNode:SetAttribute("Race", myRace)

        myNode:SetAttribute("TargetRace", myTarget)

        myNode:SetAttribute("JobId", myJob)

        myNode:SetAttribute("HasV3", myV3Status)

        myNode:SetAttribute("HasV2", myV2Status)

        myNode:SetAttribute("Role", App.CoopRole or "none")

        myNode:SetAttribute("Heartbeat", now)

        myNode.Parent = cFolder

        for _, node in ipairs(cFolder:GetChildren()) do
            if node:IsA("Configuration") then
                local hb = tonumber(node:GetAttribute("Heartbeat")) or 0
                local nName = node.Name
                local accTarget = ACCOUNT_RACE_MAP[nName] or tostring(node:GetAttribute("TargetRace") or "")
                local cleanAccTarget = CleanRaceStr(accTarget)
                local isCoopTarget = (cleanAccTarget:find("sky") or cleanAccTarget:find("angel") or cleanAccTarget:find("ghoul")) ~= nil

                if (now - hb > COOP_TIMEOUT) or hb == 0 or (not isCoopTarget) then
                    pcall(function() node:Destroy() end)

                    sessions[nName] = nil
                else
                    if not sessions[nName] then
                        sessions[nName] = {
                            Name = nName,
                            Race = tostring(node:GetAttribute("Race") or ""),
                            TargetRace = cleanAccTarget,
                            JobId = tostring(node:GetAttribute("JobId") or ""),
                            HasV3 = (node:GetAttribute("HasV3") == true),
                            HasV2 = (node:GetAttribute("HasV2") == true),
                            Role = tostring(node:GetAttribute("Role") or "none"),
                            Heartbeat = hb
                        }
                    end
                end
            else
                pcall(function() node:Destroy() end)
            end
        end
    end)

    -- 3. Gom danh sách acc Sky/Ghoul V2 còn sống (BẮT BUỘC TARGET RACE PHẢI LÀ SKY/GHOUL)

    local candidateList = {}
    local ghoulV2Count = 0

    for accName, data in pairs(sessions) do
        local hb = (type(data) == "table" and tonumber(data.Heartbeat)) or 0
        local accTarget = ACCOUNT_RACE_MAP[accName] or (type(data) == "table" and data.TargetRace) or ""
        local cleanAccTarget = CleanRaceStr(accTarget)
        local isCoopTarget = (cleanAccTarget:find("sky") or cleanAccTarget:find("angel") or cleanAccTarget:find("ghoul")) ~= nil

        if hb > 0 and (now - hb <= COOP_TIMEOUT) and isCoopTarget then
            local r = CleanRaceStr(data.Race)

            if (r:find("sky") or r:find("angel") or r:find("ghoul")) and data.HasV2 then
                table.insert(candidateList, data)

                if r:find("ghoul") and not data.HasV3 then
                    ghoulV2Count = ghoulV2Count + 1
                end
            end
        else
            sessions[accName] = nil
        end
    end

    table.sort(candidateList, function(a, b) return tostring(a.Name) < tostring(b.Name) end)

    -- 4. ĐIỀU PHỐI MULTI-HELPRACE ĐỘNG (<12: 1 Help, >=12: 2 Help, >=24: 3 Help, >=36: 4 Help...)

    local needHelpCount = 0

    for _, cand in ipairs(candidateList) do
        if not cand.HasV3 then
            needHelpCount = needHelpCount + 1
        end
    end

    if needHelpCount == 0 then
        App.CoopRole = "done"

        App.HelperIndex = nil

        App.CoopSTT = nil

        App.CurrentHelperPeer = nil

        pcall(function()

            if sessions[myName] then
                sessions[myName].Role = "done"

                sessions[myName].Heartbeat = os.time()

                if isfile and writefile and HttpService then
                    writefile(sessionFile, HttpService:JSONEncode(sessions))
                end
            end
        end)

        return
    end

    -- Tính toán số lượng HelpRace cần thiết theo mốc 12 acc V2 Ghoul

    local totalGhoul = math.max(ghoulV2Count, needHelpCount)
    local maxHelpers = 1

    if isGhoulTarget then
        maxHelpers = math.max(1, math.floor(totalGhoul / 12) + 1)
    end

    -- Thu thập các HelpRace đang active và còn sống

    local activeHelpers = {}

    for _, cand in ipairs(candidateList) do
        if cand.Role == "helprace" and cand.HelperIndex then
            local hIdx = tonumber(cand.HelperIndex)

            if hIdx and hIdx >= 1 and hIdx <= maxHelpers and not activeHelpers[hIdx] then
                activeHelpers[hIdx] = cand
            end
        end
    end

    -- Sắp xếp pool ứng viên: Ưu tiên tài khoản đã có V3 làm Helper trước, sau đó theo QueueTime/Tên

    local helperPool = {}

    for _, cand in ipairs(candidateList) do table.insert(helperPool, cand) end

    table.sort(helperPool, function(a, b)

        if (a.HasV3 == true) ~= (b.HasV3 == true) then
            return a.HasV3 == true
        end

        local qa = tonumber(a.QueueTime) or 0
        local qb = tonumber(b.QueueTime) or 0

        if qa ~= 0 and qb ~= 0 and math.abs(qa - qb) > 2 then
            return qa < qb
        end

        return tostring(a.Name) < tostring(b.Name)
    end)

    local electedHelpers = {}
    local electedHelperNames = {}

    for hIdx = 1, maxHelpers do
        if activeHelpers[hIdx] and not electedHelperNames[activeHelpers[hIdx].Name] then
            electedHelpers[hIdx] = activeHelpers[hIdx]

            electedHelperNames[activeHelpers[hIdx].Name] = hIdx
        else
            for _, cand in ipairs(helperPool) do
                if not electedHelperNames[cand.Name] then
                    electedHelpers[hIdx] = cand

                    electedHelperNames[cand.Name] = hIdx

                    break
                end
            end
        end
    end

    App.ElectedHelpers = electedHelpers

    -- Thiết lập Role & HelperIndex cho tài khoản hiện tại

    if electedHelperNames[myName] then
        App.CoopRole = "helprace"

        App.HelperIndex = electedHelperNames[myName]

        App.CoopSTT = nil

        App.CurrentHelperPeer = electedHelpers[App.HelperIndex]
    else
        App.CoopRole = myV3Status and "done" or "uprace"

        App.HelperIndex = nil
    end

    -- [CHỐT CHẶN KHÁC SERVER CHO CÁC HELPRACE]: Helper sau nếu trùng server với Helper trước -> Hop Server ngay

    if App.CoopRole == "helprace" and App.HelperIndex and App.HelperIndex > 1 then
        for prevIdx = 1, App.HelperIndex - 1 do
            local prevH = electedHelpers[prevIdx]

            if prevH and prevH.JobId and prevH.JobId ~= "" and prevH.JobId == tostring(game.JobId) and not App.IsHopping then
                App.CurrentActivity = string.format("🌐 [Coop HelpRace %d] Trùng server với HelpRace %d (%s)! Đang Hop Server khác...", App.HelperIndex, prevIdx, prevH.Name)

                TriggerLowServerHop(true)

                return
            end
        end
    end

    -- // [AXIOM COOP STT & STICKY HELPER ROUTER]:

    -- UpRace vào server của Helper nào thì KHÓA CỨNG (STICKY) tuyệt đối không nhảy sang Helper khác

    local upraceList = {}

    for _, cand in ipairs(candidateList) do
        if not electedHelperNames[cand.Name] and not cand.HasV3 then
            table.insert(upraceList, cand)
        end
    end

    table.sort(upraceList, function(a, b)

        local qa = tonumber(a.QueueTime) or 0
        local qb = tonumber(b.QueueTime) or 0

        if qa ~= 0 and qb ~= 0 and math.abs(qa - qb) > 2 then
            return qa < qb
        end

        return tostring(a.Name) < tostring(b.Name)
    end)

    if App.CoopRole == "uprace" then
        local curJob = tostring(game.JobId)

        -- 1. Nếu đang ở cùng server với 1 HelpRace cụ thể -> Khóa cứng (Sticky) vào HelpRace đó ngay lập tức!

        for hIdx, hData in pairs(electedHelpers) do
            if hData.JobId and hData.JobId ~= "" and hData.JobId == curJob then
                App.AssignedHelperName = hData.Name

                App.AssignedHelperIndex = hIdx

                break
            end
        end

        -- 2. Nếu HelpRace đã gán không còn tồn tại hoặc quá hạn -> Giải phóng khóa để gán lại

        if App.AssignedHelperName and not electedHelperNames[App.AssignedHelperName] then
            App.AssignedHelperName = nil

            App.AssignedHelperIndex = nil
        end

        -- 3. Tìm vị trí của mình trong danh sách UpRace toàn cục

        local myGlobalIdx = 1

        for idx, cand in ipairs(upraceList) do
            if cand.Name == myName then
                myGlobalIdx = idx

                break
            end
        end

        -- 4. Nếu chưa vào server của Helper nào: Phân bổ cân bằng theo Modulo (% maxHelpers)

        if not App.AssignedHelperName then
            local targetHIdx = ((myGlobalIdx - 1) % maxHelpers) + 1
            local targetH = electedHelpers[targetHIdx] or electedHelpers[1]

            if targetH then
                App.AssignedHelperName = targetH.Name

                App.AssignedHelperIndex = targetHIdx
            end
        end

        -- Gán CurrentHelperPeer tương ứng với Helper đã khóa

        App.CurrentHelperPeer = nil

        if App.AssignedHelperName then
            for _, h in pairs(electedHelpers) do
                if h.Name == App.AssignedHelperName then
                    App.CurrentHelperPeer = h

                    break
                end
            end
        end

        if not App.CurrentHelperPeer then
            App.CurrentHelperPeer = electedHelpers[1]
        end

        -- 5. Lập danh sách UpRace cùng nhóm với Helper của mình để tính STT cục bộ

        local myClusterUpraces = {}

        for idx, cand in ipairs(upraceList) do
            local candSession = sessions[cand.Name]
            local candAssignedName = candSession and candSession.AssignedHelperName

            if candAssignedName then
                if candAssignedName == App.AssignedHelperName then
                    table.insert(myClusterUpraces, cand)
                end
            else
                local candHIdx = ((idx - 1) % maxHelpers) + 1

                if candHIdx == (App.AssignedHelperIndex or 1) then
                    table.insert(myClusterUpraces, cand)
                end
            end
        end

        App.CoopSTT = nil

        for idx, cand in ipairs(myClusterUpraces) do
            if cand.Name == myName then
                App.CoopSTT = idx

                break
            end
        end

        if not App.CoopSTT then
            App.CoopSTT = 1
        end
    end

    -- Lưu lại trạng thái sạch sẽ nhất

    pcall(function()

        if sessions[myName] then
            sessions[myName].Role = App.CoopRole

            sessions[myName].HelperIndex = App.HelperIndex

            sessions[myName].AssignedHelperName = App.AssignedHelperName

            sessions[myName].AssignedHelperIndex = App.AssignedHelperIndex

            sessions[myName].STT = App.CoopSTT

            sessions[myName].Heartbeat = os.time()

            if isfile and writefile and HttpService then
                writefile(sessionFile, HttpService:JSONEncode(sessions))
            end
        end

        local cFolder = workspace:FindFirstChild("AxiomCoopPresence")
        local myNode = cFolder and cFolder:FindFirstChild(myName)

        if myNode then
            myNode:SetAttribute("Role", App.CoopRole)

            myNode:SetAttribute("HelperIndex", App.HelperIndex or 0)

            myNode:SetAttribute("AssignedHelperName", App.AssignedHelperName or "")

            myNode:SetAttribute("Heartbeat", os.time())
        end
    end)
end

