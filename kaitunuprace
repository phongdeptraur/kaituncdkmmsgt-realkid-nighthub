-- Universal Network Query with Multi-Route Resolution & Active Fallback

function AxiomBossHop:FetchServers(endpointInput)

    if not request_ and not game.HttpGet then return nil, "Missing request function" end

    local endpoints = (type(endpointInput) == "table") and endpointInput or { endpointInput }
    local lastErr = "No response"
    local bestResult = nil
    local candidateList = {}

    if type(endpointInput) == "table" and endpointInput._active then
        table.insert(candidateList, endpointInput._active)

        for _, ep in ipairs(endpoints) do
            if ep ~= endpointInput._active then
                table.insert(candidateList, ep)
            end
        end
    else
        candidateList = endpoints
    end

    for _, ep in ipairs(candidateList) do
        local url = string.format("%s/%s", self.BaseUrl, ep)
        local raw = nil
        local statusCode = 0

        if request_ then
            for attempt = 1, 2 do
                local success, res = pcall(function()

                    return request_({
                        Url = url,
                        Method = "GET",
                        Headers = {
                            ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
                            ["Accept"] = "application/json",
                            ["Cache-Control"] = "no-cache"
                        }
                    })
                end)

                if success and res then
                    statusCode = res.StatusCode or res.status or (res.Success and 200 or 0)

                    if statusCode == 200 then
                        raw = res.Body or res.body or (type(res) == "string" and res)

                        break
                    elseif statusCode == 429 then
                        task.wait(0.5)
                    end
                end
            end
        end

        if not raw or raw == "" then
            local success, res = pcall(function()

                return game:HttpGet(url)
            end)

            if success and res and res ~= "" then
                raw = res

                statusCode = 200
            end
        end

        if raw and raw ~= "" then
            local ok, payload = pcall(HttpService.JSONDecode, HttpService, raw)

            if ok and type(payload) == "table" then
                local validServers = {}
                local dataList = payload.data or payload.servers or payload.Servers or (type(payload) == "table" and payload)

                if type(dataList) == "table" then
                    for _, entry in ipairs(dataList) do
                        if type(entry) == "table" and (entry.JobId or entry.job_id) then
                            local jId = entry.JobId or entry.job_id
                            local rawJobId = self:DecryptJobId(jId) or jId

                            if rawJobId then
                                table.insert(validServers, {
                                    JobId = tostring(rawJobId),
                                    Players = tonumber(entry.Players or entry.players or entry.count) or 0,
                                    PlaceId = entry.PlaceId or entry.placeId or game.PlaceId,
                                    Sea = entry.Sea or entry.sea or 3,
                                    Age = entry.Age or 0
                                })
                            end
                        end
                    end
                end

                local totalCount = #validServers

                if payload.count and type(payload.count) == "number" and payload.count > totalCount then
                    totalCount = payload.count
                end

                local currentResult = {
                    Count = totalCount,
                    Servers = validServers,
                    ActiveEndpoint = ep
                }

                if totalCount > 0 then
                    if type(endpointInput) == "table" then
                        endpointInput._active = ep
                    end

                    return currentResult
                elseif not bestResult then
                    bestResult = currentResult
                end
            end
        else
            lastErr = "HTTP " .. tostring(statusCode)
        end
    end

    if bestResult then
        return bestResult
    end

    return nil, lastErr
end

-- FindLowestServerBottomUp với Lenient Sea Matching & Dual Fallback

function AxiomBossHop:FindLowestServerBottomUp(servers, customFilter)

    if not servers or #servers == 0 then return nil end

    local currentSea = workspace:GetAttribute("MAP")
    local candidates = {}
    local function MatchesSea(serverSea)

        if not currentSea or not serverSea then return true end

        if tostring(serverSea) == tostring(currentSea) then return true end

        local sNum = tonumber(tostring(serverSea):match("%d+"))
        local cNum = tonumber(tostring(currentSea):match("%d+"))

        if sNum and cNum and sNum == cNum then return true end

        if sNum == 3 or tostring(serverSea):find("3") then return true end

        return false
    end

    -- Pass 1: Lọc chuẩn đầy đủ (Chưa thăm + Khớp Sea + Dưới 12 người + Thoát Custom Filter)

    for i = 1, #servers do
        local s = servers[i]
        local isDiffJob = s.JobId ~= tostring(game.JobId)
        local notVisited = not self:IsVisited(s.JobId)
        local seaMatch = MatchesSea(s.Sea)
        local validPlayers = s.Players < 12
        local customPass = not customFilter or customFilter(s)

        if isDiffJob and notVisited and seaMatch and validPlayers and customPass then
            table.insert(candidates, s)
        end
    end

    -- Fallback 1: Nếu đã ghé thăm hết danh sách gần đây -> Cho phép lặp lại server đã thăm

    if #candidates == 0 then
        for i = 1, #servers do
            local s = servers[i]
            local isDiffJob = s.JobId ~= tostring(game.JobId)
            local seaMatch = MatchesSea(s.Sea)
            local validPlayers = s.Players < 12
            local customPass = not customFilter or customFilter(s)

            if isDiffJob and seaMatch and validPlayers and customPass then
                table.insert(candidates, s)
            end
        end
    end

    -- Fallback 2: Nếu Map Attribute không set -> Bỏ qua kiểm tra Sea, lấy toàn bộ server < 12

    if #candidates == 0 then
        for i = 1, #servers do
            local s = servers[i]
            local isDiffJob = s.JobId ~= tostring(game.JobId)
            local validPlayers = s.Players < 12
            local customPass = not customFilter or customFilter(s)

            if isDiffJob and validPlayers and customPass then
                table.insert(candidates, s)
            end
        end
    end

    if #candidates == 0 then return nil end

    -- Sắp xếp và chọn server ít người nhất từ dưới lên (Bottom-Up)

    local minPlayers = math.huge

    for _, s in ipairs(candidates) do
        if s.Players < minPlayers then
            minPlayers = s.Players
        end
    end

    for i = #candidates, 1, -1 do
        if candidates[i].Players == minPlayers then
            return candidates[i]
        end
    end

    return candidates[#candidates]
end

function AxiomBossHop:TeleportTo(JOB_ID, targetPlaceId)

    repeat task.wait() until game:IsLoaded()

    if JOB_ID and JOB_ID ~= "" and JOB_ID ~= tostring(game.JobId) then
        self:RecordServer(JOB_ID)

        local destinationPlace = targetPlaceId or game.PlaceId
        local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        local joined = false

        if sb then
            joined = pcall(function()

                sb:InvokeServer("teleport", JOB_ID)
            end)
        end

        if not joined then
            pcall(function()

                TeleportService:TeleportToPlaceInstance(destinationPlace, JOB_ID, LocalPlayer)
            end)
        end
    end
end

