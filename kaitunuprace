local function ShouldPauseFastAttack()
    -- [AXIOM GUARD]: Triệt tiêu Fast Attack hoàn toàn khi đang farm Law / Raid Order
    if (State and State.AutoLaw) or (App and App.State and App.State.AutoLaw) or _G.AutoLaw or _G.FarmLaw then
