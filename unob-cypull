local function AuthenticateKeyFile(): boolean
    local keyFilePath = "cypull_keysave.txt"
    
    if not (isfile and isfile(keyFilePath)) then
        return false
    end

    local fileContent: string? = nil
    pcall(function()
        fileContent = readfile(keyFilePath)
    end)

    if not fileContent then
        return false
    end

    -- Làm sạch khoảng trắng và ký tự xuống dòng
    local sanitizedKey = fileContent:gsub("^%s*(.-)%s*$", "%1")
    return VALID_KEYS[sanitizedKey] == true
end

