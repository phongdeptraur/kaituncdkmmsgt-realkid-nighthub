            loadstring(game:HttpGet("https://raw.githubusercontent.com/WhiteX1208/Scripts/refs/heads/main/HopScript.luau"))()
        end)
    end
end

-- [[ 6. CHU TRÌNH ĐIỀU KHIỂN CHÍNH ]] --
local logicThread = task.spawn(function()
    Runtime.CurrentState = "Selecting Marine Team..."
    
    while Runtime.IsRunning do
        if autoSelectMarines() then break end
        task.wait(0.5)
    end

    Runtime.CurrentState = "Waiting for Character Spawn..."
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    Runtime.Character = char
    char:WaitForChild("HumanoidRootPart", 20)
    char:WaitForChild("Humanoid", 20)
    
    local data = LocalPlayer:WaitForChild("Data", 20)
    if data then
        data:WaitForChild("Fragments", 20)
        data:WaitForChild("Race", 20)
    end

    task.wait(1.5)

    while Runtime.IsRunning do
        local currentSea = getCurrentSea()
        local race = getRace()
        local frags = getFragments()
        local hasCyborg = (race == "Cyborg")
        local hasV3 = isRaceV3()

        -- CASE 1: Chưa có Cyborg
        if not hasCyborg then
            if frags < 10000 then
                Runtime.CurrentState = "No Cyborg & Frags < 10k -> Farm Cake Prince (Sea 3)"
                if currentSea ~= 3 then
                    teleportToSea(3)
                    break
                else
                    saveAndRunNightHub({
                        ["Select Boss"] = "Cake Prince",
                        ["Auto Hop Find Boss"] = true,
                        ["Start Farm Boss"] = true
                    })

                    while Runtime.IsRunning do
                        task.wait(3)
                        local updatedFrags = getFragments()
                        if updatedFrags >= 10000 then
                            Runtime.CurrentState = "Frags >= 10k! Moving to Sea 2..."
                            teleportToSea(2)
                            break
                        end
                    end
                    break
                end
            else
                -- Frags >= 10,000
                if currentSea ~= 2 then
                    Runtime.CurrentState = "Frags >= 10k -> Teleporting to Sea 2"
                    teleportToSea(2)
                    break
                else
                    Runtime.CurrentState = "Running RealKid Auto Cyborg in Sea 2"
                    saveAndRunRealKid({ ["auto_cyborg"] = true })

                    while Runtime.IsRunning do
                        task.wait(3)
                        local curRace = getRace()
                        local curFrags = getFragments()

                        if curRace == "Cyborg" then
                            Runtime.CurrentState = "Cyborg Unlocked! Transitioning..."
                            break
                        end

                        if curFrags < 1000 then
                            Runtime.CurrentState = "Frags < 1k during Cyborg -> Return Sea 3"
                            teleportToSea(3)
                            break
                        end
                    end
                end
            end

        -- CASE 2: Đã có Cyborg nhưng chưa V3
        elseif hasCyborg and not hasV3 then
            if currentSea ~= 2 then
                Runtime.CurrentState = "Cyborg (Not V3) -> Moving to Sea 2"
                teleportToSea(2)
                break
            else
                Runtime.CurrentState = "Running RealKid AutoUpgradeRaceV3 in Sea 2"
                saveAndRunRealKid({ ["AutoUpgradeRaceV3"] = true })

                while Runtime.IsRunning do
                    task.wait(3)
                    if isRaceV3() then
                        Runtime.CurrentState = "Race V3 Unlocked!"
                        break
                    end
                end
            end

        -- CASE 3: Đã có Cyborg V3
        elseif hasCyborg and hasV3 then
            if currentSea ~= 3 then
                Runtime.CurrentState = "Cyborg V3 Ready -> Moving to Sea 3"
                teleportToSea(3)
                break
            else
                Runtime.CurrentState = "Sea 3: Running RealKid Lever + Night Hub Mirage"
                saveAndRunRealKid({ ["AutoPullLever"] = true })
                saveAndRunNightHub({ ["Auto Hop Mirage Island"] = true })
                break
            end
        end

        task.wait(2)
    end
end)
table.insert(Runtime.Threads, logicThread)
