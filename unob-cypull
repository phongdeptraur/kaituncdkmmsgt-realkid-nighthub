local function ensureNightHubKey()
    local keyPath = "NightHubKey.bin"
    local expectedKey = "NightHub_c5Rz2UiC1t8E"
    local needsWrite = true

    if isfile and isfile(keyPath) then
        local content = nil
        pcall(function()
            content = readfile(keyPath)
        end)
        if content and content:gsub("%s+", "") == expectedKey then
            needsWrite = false
        end
    end

    if needsWrite and writefile then
        pcall(function()
            writefile(keyPath, expectedKey)
        end)
    end
end

local function teleportToSea(seaNumber: number)
    local cur = getCurrentSea()
    if cur == seaNumber then return end

    local targetPlaceId = (seaNumber == 2) and SEA_2_ID or SEA_3_ID
    local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")

    if commF then
        if seaNumber == 2 then
            pcall(function() commF:InvokeServer("TravelDressrosa") end)
        elseif seaNumber == 3 then
            pcall(function() commF:InvokeServer("TravelZou") end)
        end
    end

    task.wait(2)
    TeleportService:Teleport(targetPlaceId, LocalPlayer)
end

